<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<main style="min-height:80vh;display:flex;align-items:flex-start;justify-content:center;padding:2rem 1rem;background:#fff;">
  <section style="width:100%;max-width:672px;">
    <h1 style="margin:0 0 4rem;text-align:center;font-size:2rem;font-weight:800;line-height:1.2;color:#050505;">
      Sign up
    </h1>

    <div style="display:grid;gap:1.25rem;">
      <a href="/auth/register" class="text-decoration-none" style="display:flex;align-items:center;justify-content:space-between;gap:1.5rem;min-height:122px;padding:1.5rem 2.125rem;border:1px solid #e4e4e4;border-radius:22px;color:#050505;background:#fff;">
        <span>
          <span style="display:block;font-size:1.5rem;font-weight:600;line-height:1.25;color:#050505;">For customers</span>
          <span style="display:block;margin-top:.25rem;font-size:1.375rem;line-height:1.25;color:#6f6f6f;">Book salons and spas near you</span>
        </span>
        <i class="bi bi-arrow-right" style="flex:0 0 auto;font-size:2rem;color:#050505;"></i>
      </a>

      <a href="/auth/registerMer" class="text-decoration-none" style="display:flex;align-items:center;justify-content:space-between;gap:1.5rem;min-height:122px;padding:1.5rem 2.125rem;border:1px solid #e4e4e4;border-radius:22px;color:#050505;background:#fff;">
        <span>
          <span style="display:block;font-size:1.5rem;font-weight:600;line-height:1.25;color:#050505;">For professionals</span>
          <span style="display:block;margin-top:.25rem;font-size:1.375rem;line-height:1.25;color:#6f6f6f;">Manage and grow your business</span>
        </span>
        <i class="bi bi-arrow-right" style="flex:0 0 auto;font-size:2rem;color:#050505;"></i>
      </a>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
