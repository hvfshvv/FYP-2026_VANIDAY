<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5 col-lg-4">
        <div class="text-center mb-5">
          <a href="/" class="text-decoration-none">
            <span style="font-size:1.5rem;font-weight:800;color:var(--ink);letter-spacing:-.03em;">
              <i class="bi bi-flower1 me-1" style="color:var(--accent);"></i>uniday
            </span>
          </a>
          <p style="color:var(--muted);margin-top:.5rem;margin-bottom:0;font-size:.875rem;">Choose a new password.</p>
        </div>

        <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
          <% if (error) { %>
            <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
              <i class="bi bi-exclamation-circle me-2"></i><%= error %>
            </div>
          <% } %>
          <% if (success) { %>
            <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
              <i class="bi bi-check-circle me-2"></i><%= success %>
            </div>
          <% } %>

          <% if (token) { %>
            <form action="/auth/reset-password/<%= token %>" method="POST">
              <div class="mb-3">
                <label class="form-label" style="font-weight:600;font-size:.875rem;">New Password</label>
                <input type="password" name="password" class="form-control rounded-xl" placeholder="Min. 6 characters" minlength="6" required autofocus />
              </div>
              <div class="mb-4">
                <label class="form-label" style="font-weight:600;font-size:.875rem;">Confirm Password</label>
                <input type="password" name="confirm_password" class="form-control rounded-xl" placeholder="Re-enter password" minlength="6" required />
              </div>
              <button type="submit" class="btn btn-primary w-100 py-2 btn-pill" style="font-weight:700;">
                <i class="bi bi-key me-2"></i>Reset Password
              </button>
            </form>
          <% } %>

          <div style="border-top:1px solid var(--border);margin:1.25rem 0;"></div>
          <p class="text-center small mb-0" style="color:var(--muted);">
            <a href="/auth/login" style="font-weight:700;color:var(--accent);">Back to sign in</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
