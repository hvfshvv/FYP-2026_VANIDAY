<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-6">
        <div class="card border-0 text-center" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2.5rem;">
          <div class="icon-circle-lg mx-auto mb-3" style="width:72px;height:72px;background:var(--warn-bg);">
            <i class="bi bi-hourglass-split" style="font-size:2rem;color:var(--warn);"></i>
          </div>

          <p class="section-label">Merchant Verification</p>
          <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.75rem;">
            Application Under Review
          </h2>

          <% if (submitted) { %>
          <div class="rounded-xl mb-3 p-3 text-start" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
            <i class="bi bi-check-circle me-2"></i>Your merchant application has been submitted.
          </div>
          <% } %>

          <p style="color:var(--muted);font-size:1rem;line-height:1.65;margin:0 auto 1.5rem;max-width:56ch;">
            Please allow 3-5 business days for Uniday to verify your company details. You will be able to access the merchant dashboard once an admin approves your account.
          </p>

          <div class="d-flex justify-content-center gap-2 flex-wrap">
            <a href="/marketplace" class="btn btn-outline-secondary btn-pill">
              <i class="bi bi-grid me-1"></i>Browse Marketplace
            </a>
            <% if (user) { %>
            <a href="/auth/logout" class="btn btn-primary btn-pill">
              <i class="bi bi-box-arrow-right me-1"></i>Sign Out
            </a>
            <% } else { %>
            <a href="/auth/login" class="btn btn-primary btn-pill">
              <i class="bi bi-box-arrow-in-right me-1"></i>Back to Login
            </a>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
