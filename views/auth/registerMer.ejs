<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="text-center mb-5">
          <a href="/" class="text-decoration-none">
            <span style="font-size:1.5rem;font-weight:800;color:var(--ink);letter-spacing:-.03em;">
              <i class="bi bi-flower1 me-1" style="color:var(--accent);"></i>uniday
            </span>
          </a>
          <p style="color:var(--muted);margin-top:.5rem;margin-bottom:0;font-size:.875rem;">Create your merchant account today.</p>
        </div>

        <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
          <% if (typeof query !== 'undefined' && query && query.registered) { %>
          <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
            <i class="bi bi-check-circle me-2"></i>Account created! Please sign in.
          </div>
          <% } %>
          <% if (error) { %>
          <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
            <i class="bi bi-exclamation-circle me-2"></i><%= error %>
          </div>
          <% } %>

          <form action="/auth/register" method="POST">
            <input type="hidden" name="role" value="merchant" />
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Full Name</label>
              <input type="text" name="full_name" class="form-control rounded-xl" placeholder="e.g. Sarah Lim" required autofocus />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Business Name</label>
              <input type="text" name="merchant_name" class="form-control rounded-xl" placeholder="e.g. Glow Studio" required />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Business UEN</label>
              <input
                type="text"
                name="business_uen"
                class="form-control rounded-xl"
                placeholder="e.g. 123456789"
                minlength="9"
                maxlength="10"
                pattern="[A-Za-z0-9]{9,10}"
                inputmode="numeric"
                title="Business UEN must be 9 to 10 letters or numbers."
                required
              />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Business Location</label>
              <input type="text" name="address" class="form-control rounded-xl" placeholder="e.g. 23 Orchard Centre, Singapore 676767" required />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Email Address</label>
              <input type="email" name="email" class="form-control rounded-xl" placeholder="you@example.com" required />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Business Contact</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone me-1"></i>+65</span>
                <input type="text" name="phone" class="form-control" placeholder="9XXXXXXX" />
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Password</label>
              <input type="password" name="password" class="form-control rounded-xl" placeholder="Min. 6 characters" minlength="6" required />
            </div>
            <div class="mb-4">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Business Category</label>
              <select name="category" class="form-select rounded-xl" required>
                <option value="" selected disabled>Select a category</option>
                <option value="Hair">Hair</option>
                <option value="Nails">Nails</option>
                <option value="Facial">Facial</option>
                <option value="Massage">Massage</option>
                <option value="Wellness">Wellness</option>
                <option value="BodyAestheitcs">BodyAestheitcs</option>
                <option value="Spa">Spa</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 btn-pill" style="font-weight:700;">
              <i class="bi bi-shop me-2"></i>Create Merchant Account
            </button>
          </form>

          <div style="border-top:1px solid var(--border);margin:1.25rem 0;"></div>
          <p class="text-center small mb-0" style="color:var(--muted);">
            Already have an account?
            <a href="/auth/login" style="font-weight:700;color:var(--accent);">Sign in</a>
          </p>
        </div>

        <p class="text-center small mt-3 mb-0" style="color:var(--ghost);">
          <i class="bi bi-shield-check me-1" style="color:var(--success);"></i>
          Your data is safe with Uniday
        </p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
