<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="text-center mb-5">
          <%- include('../partials/unidayLogo', { className: 'justify-content-center', size: 'sm' }) %>
          <p style="color:var(--muted);margin-top:.5rem;margin-bottom:0;font-size:.875rem;"><%= t('auth.registerSubtitle') %></p>
        </div>

        <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
          <% if (error) { %>
          <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
            <i class="bi bi-exclamation-circle me-2"></i><%= error %>
          </div>
          <% } %>

          <form action="/auth/register" method="POST" autocomplete="off">
            <input type="hidden" name="role" value="customer" />
            <% if (typeof query !== 'undefined' && query && query.next) { %>
              <input type="hidden" name="next" value="<%= query.next %>" />
            <% } %>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('booking.fullName') %></label>
              <input type="text" name="full_name" class="form-control rounded-xl" placeholder="e.g. Sarah Lim" required />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('auth.emailAddress') %></label>
              <input type="email" name="register_email" class="form-control rounded-xl" placeholder="you@example.com"
                autocomplete="new-password" autocorrect="off" autocapitalize="none" spellcheck="false" inputmode="email"
                required />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('booking.phoneNumber') %> <span style="color:var(--muted);font-weight:500;">(<%= t('booking.optional') %>)</span></label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone me-1"></i>+65</span>
                <input
                  type="tel"
                  name="phone"
                  class="form-control"
                  placeholder="9XXXXXXX"
                  inputmode="numeric"
                  minlength="8"
                  maxlength="8"
                  pattern="[0-9]{8}"
                  title="<%= t('auth.phoneDigits') %>"
                />
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('admin.customers.birthday') %></label>
              <input type="date" name="date_of_birth" class="form-control rounded-xl" max="<%= new Date().toISOString().slice(0, 10) %>" />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('auth.password') %></label>
              <input type="password" name="register_password" class="form-control rounded-xl" placeholder="<%= t('auth.minChars') %>" autocomplete="new-password" minlength="6" required />
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 btn-pill" style="font-weight:700;">
              <i class="bi bi-person-plus me-2"></i>Create Account
            </button>
          </form>

          <div style="border-top:1px solid var(--border);margin:1.25rem 0;"></div>
          <p class="text-center small mb-0" style="color:var(--muted);">
            Already have an account?
            <a href="/auth/login<%= typeof query !== 'undefined' && query && query.next ? ('?next=' + encodeURIComponent(query.next)) : '' %>" style="font-weight:700;color:var(--accent);"><%= t('auth.signIn') %></a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
