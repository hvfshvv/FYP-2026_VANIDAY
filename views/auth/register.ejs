<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5">
        <div class="text-center mb-5">
          <a href="/" class="text-decoration-none">
            <span style="font-size:1.5rem;font-weight:800;color:var(--ink);letter-spacing:-.03em;">
              <i class="bi bi-flower1 me-1" style="color:var(--accent);"></i>vaniday
            </span>
          </a>
          <p style="color:var(--muted);margin-top:.5rem;margin-bottom:0;font-size:.875rem;">Create your free account today.</p>
        </div>

        <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
          <% if (error) { %>
          <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
            <i class="bi bi-exclamation-circle me-2"></i><%= error %>
          </div>
          <% } %>

          <form action="/auth/register" method="POST">
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Full Name</label>
              <input type="text" name="full_name" class="form-control rounded-xl" placeholder="e.g. Sarah Lim" required />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Email Address</label>
              <input type="email" name="email" class="form-control rounded-xl" placeholder="you@example.com" required />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Phone</label>
              <div class="input-group">
                <span class="input-group-text"><i class="bi bi-telephone me-1"></i>+65</span>
                <input type="text" name="phone" class="form-control" placeholder="9XXXXXXX" />
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Password</label>
              <input type="password" name="password" class="form-control rounded-xl" placeholder="Min. 6 characters" minlength="6" required />
            </div>
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">I am a</label>
              <select name="role" class="form-select rounded-xl" id="roleSelect" onchange="toggleMerchantFields()">
                <option value="customer">Customer</option>
                <option value="merchant">Merchant / Business Owner</option>
              </select>
            </div>

            <div id="merchantFields" style="display:none;">
              <div class="p-3 rounded-xl mb-3" style="background:var(--accent-light);border:1.5px solid rgba(225,29,72,.15);">
                <p style="font-weight:700;font-size:.8125rem;color:var(--accent);margin-bottom:.75rem;">
                  <i class="bi bi-shop me-1"></i>Business Details
                </p>
                <div class="mb-2">
                  <label class="form-label" style="font-size:.875rem;">Business Name</label>
                  <input type="text" name="merchant_name" class="form-control rounded-xl" placeholder="e.g. Glam Studio" />
                </div>
                <div>
                  <label class="form-label" style="font-size:.875rem;">Business Address</label>
                  <input type="text" name="address" class="form-control rounded-xl" placeholder="e.g. 10 Orchard Road, Singapore" />
                </div>
              </div>
            </div>

            <button type="submit" class="btn btn-primary w-100 py-2 btn-pill" style="font-weight:700;">
              <i class="bi bi-person-plus me-2"></i>Create Account
            </button>
          </form>

          <div style="border-top:1px solid var(--border);margin:1.25rem 0;"></div>
          <p class="text-center small mb-0" style="color:var(--muted);">
            Already have an account?
            <a href="/auth/login" style="font-weight:700;color:var(--accent);">Sign in</a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function toggleMerchantFields() {
  document.getElementById('merchantFields').style.display =
    document.getElementById('roleSelect').value === 'merchant' ? 'block' : 'none';
}
</script>

<%- include('../partials/footer') %>
