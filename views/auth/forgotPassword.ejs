<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5 col-lg-4">
        <div class="text-center mb-5">
          <%- include('../partials/unidayLogo', { className: 'justify-content-center', size: 'sm' }) %>
          <p style="color:var(--muted);margin-top:.5rem;margin-bottom:0;font-size:.875rem;"><%= t('auth.forgotSubtitle') %></p>
        </div>

        <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
          <% if (error) { %>
            <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
              <i class="bi bi-exclamation-circle me-2"></i><%= error %>
            </div>
          <% } %>

          <% if (submitted) { %>
            <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
              <i class="bi bi-check-circle me-2"></i>
              <% if (typeof resetEmailSent !== 'undefined' && resetEmailSent) { %>
                If that email exists, a reset link has been sent.
              <% } else { %>
                If that email exists, you will be taken to reset your password.
              <% } %>
            </div>
          <% } %>

          <% if (resetLink) { %>
            <div class="rounded-xl mb-3 p-3" style="background:var(--warn-bg);color:var(--warn);font-size:.875rem;">
              <i class="bi bi-info-circle me-2"></i><%= t('auth.emailNotConfigured') %>
            </div>
            <a href="<%= resetLink %>" class="btn btn-outline-secondary w-100 btn-pill mb-3">
              <i class="bi bi-key me-2"></i><%= t('auth.openResetLink') %>
            </a>
          <% } %>

          <form action="/auth/forgot-password" method="POST">
            <div class="mb-4">
              <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('auth.emailAddress') %></label>
              <input type="email" name="email" class="form-control rounded-xl" placeholder="you@example.com" required autofocus />
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 btn-pill" style="font-weight:700;">
              <i class="bi bi-key me-2"></i><%= t('auth.resetPassword') %>
            </button>
          </form>

          <div style="border-top:1px solid var(--border);margin:1.25rem 0;"></div>
          <p class="text-center small mb-0" style="color:var(--muted);">
            <%= t('auth.rememberedPassword') %>
            <a href="/auth/login" style="font-weight:700;color:var(--accent);"><%= t('auth.signIn') %></a>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
