<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-5 col-lg-4">
        <div class="text-center mb-5">
          <%- include('../partials/unidayLogo', { className: 'justify-content-center', size: 'sm' }) %>
          <p style="color:var(--muted);margin-top:.5rem;margin-bottom:0;font-size:.875rem;">Welcome back — sign in to continue.</p>
        </div>

        <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
          <% if (typeof query !== 'undefined' && query && query.registered) { %>
          <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
            <i class="bi bi-check-circle me-2"></i>
            <% if (query.verify) { %>
              Account created. Please verify your email before signing in.
            <% } else { %>
              Account created! Please sign in.
            <% } %>
          </div>
          <% } %>
          <% if (typeof query !== 'undefined' && query && query.verified) { %>
          <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
            <i class="bi bi-check-circle me-2"></i>Email verified. You can sign in now.
          </div>
          <% } %>
          <% if (typeof query !== 'undefined' && query && query.reason === 'member_email') { %>
          <div class="rounded-xl mb-3 p-3" style="background:var(--warn-bg);color:var(--warn);font-size:.875rem;">
            <i class="bi bi-exclamation-circle me-2"></i>This email is already registered. Please log in to continue and earn loyalty points.
          </div>
          <% } %>
          <% if (error) { %>
          <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
            <i class="bi bi-exclamation-circle me-2"></i><%= error %>
          </div>
          <% } %>
          <% if (typeof verificationLink !== 'undefined' && verificationLink) { %>
          <a href="<%= verificationLink %>" class="btn btn-outline-secondary w-100 btn-pill mb-3" style="font-weight:700;">
            <i class="bi bi-envelope-check me-2"></i>Open Verification Link
          </a>
          <% } %>

          <form action="/auth/login<%= typeof query !== 'undefined' && query && query.next ? ('?next=' + encodeURIComponent(query.next)) : '' %>" method="POST">
            <div class="mb-3">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Email Address</label>
              <input type="email" name="email" class="form-control rounded-xl" placeholder="you@example.com" required autofocus />
            </div>
            <div class="mb-4">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Password</label>
              <input type="password" name="password" class="form-control rounded-xl" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 py-2 btn-pill" style="font-weight:700;">
              <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
            </button>
            <button type="submit" formaction="/auth/reset-password" formmethod="POST" formnovalidate class="btn btn-outline-secondary w-100 py-2 btn-pill mt-3" style="font-weight:700;">
              <i class="bi bi-key me-2"></i>Reset Password
            </button>
          </form>

          <div style="border-top:1px solid var(--border);margin:1.25rem 0;"></div>
          <p class="text-center small mb-0" style="color:var(--muted);">
            Don't have an account?
            <a href="/auth/start" style="font-weight:700;color:var(--accent);">Sign up free</a>
          </p>
        </div>

        <p class="text-center small mt-3 mb-0" style="color:var(--ghost);">
          <i class="bi bi-shield-check me-1" style="color:var(--success);"></i>
          Your data is safe with Uniday
        </p>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
