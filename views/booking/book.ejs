<%
  const merchantName =
    (typeof merchant !== 'undefined' &&
      merchant &&
      merchant.merchant_name) ||
    'Selected Merchant';

  const merchantAddress =
    (typeof merchant !== 'undefined' &&
      merchant &&
      merchant.address) ||
    'Singapore';

  const bookingServices =
    (typeof serviceList !== 'undefined' &&
      Array.isArray(serviceList))
      ? serviceList
      : [];

  const selectedId =
    (typeof selectedService !== 'undefined' &&
      selectedService &&
      selectedService.service_id)
      ? String(selectedService.service_id)
      : (bookingServices[0]
          ? String(bookingServices[0].service_id)
          : '');

  const activeService =
    bookingServices.find(
      service => String(service.service_id) === selectedId
    ) ||
    bookingServices[0] ||
    null;

  const activePrice = activeService
    ? Number(activeService.price)
    : 0;

  const staffList =
    (typeof staff !== 'undefined' && Array.isArray(staff))
      ? staff
      : [];
%>

<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<main style="background:var(--canvas); min-height:80vh; padding:3rem 1rem;">
  <div class="container" style="max-width:980px;">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <p class="section-label mb-2">Booking</p>
        <h2 style="font-weight:800; letter-spacing:-.03em; color:var(--ink); margin-bottom:.25rem;">
          Complete Your Booking
        </h2>
        <p style="color:var(--muted); margin:0;">
          <%= merchantName %> · <%= merchantAddress %>
        </p>
      </div>

      <a href="/book/viewBookings" class="btn btn-outline-secondary btn-pill">
        <i class="bi bi-clock-history me-1"></i>My Bookings
      </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="rounded-xl p-3 mb-4" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>

    <form action="/book/confirm" method="POST" class="row g-4">
      <input type="hidden" name="merchant_id" value="<%= merchant ? merchant.merchant_id : '' %>" />

      <section class="col-lg-7">

        <!-- Service Selection -->
        <div class="card border-0 mb-4" style="box-shadow:var(--shadow); border-radius:var(--r-xl);">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              Select Service
            </h5>

            <% if (!bookingServices.length) { %>
              <p style="color:var(--muted); margin:0;">No active services are available for this merchant.</p>
            <% } %>

            <% bookingServices.forEach(service => { %>
              <label
                class="d-flex align-items-center justify-content-between gap-3 mb-2 p-3"
                style="border:1px solid var(--border); border-radius:var(--r); background:var(--surface); cursor:pointer;"
              >
                <span>
                  <input
                    type="radio"
                    name="service_id"
                    value="<%= service.service_id %>"
                    data-name="<%= service.service_name %>"
                    data-price="<%= Number(service.price) %>"
                    data-duration="<%= service.duration_mins || 60 %>"
                    <%= activeService && String(service.service_id) === String(activeService.service_id) ? 'checked' : '' %>
                    required
                  />
                  <span style="font-weight:700; color:var(--ink); margin-left:.5rem;">
                    <%= service.service_name %>
                  </span>
                </span>

                <span style="font-family:var(--font-mono); font-weight:700; color:var(--accent);">
                  S$<%= Number(service.price).toFixed(2) %>
                </span>
              </label>
            <% }) %>
          </div>
        </div>

        <!-- Date & Time -->
        <div class="card border-0" style="box-shadow:var(--shadow); border-radius:var(--r-xl);">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              Select Date &amp; Time
            </h5>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" style="font-weight:600; font-size:.875rem;">
                  Date
                </label>
                <input
                  class="form-control rounded-xl"
                  type="date"
                  name="booking_date"
                  id="bookingDate"
                  required
                />
              </div>

              <div class="col-md-6">
                <label class="form-label" style="font-weight:600; font-size:.875rem;">
                  Time
                </label>
                <select
                  class="form-control rounded-xl"
                  name="booking_time"
                  id="bookingTime"
                  required
                >
                  <option value="">Select a date first</option>
                </select>
              </div>
            </div>

            <div
              id="bookingDateError"
              style="display:none; color:var(--danger); font-size:.8125rem; margin-top:.75rem;"
            >
              <i class="bi bi-exclamation-circle me-1"></i>
              Please choose a date and time that is not in the past.
            </div>
          </div>
        </div>

        <!-- Staff Selection -->
        <div class="card border-0 mt-4" style="box-shadow:var(--shadow); border-radius:var(--r-xl);">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              <i class="bi bi-person me-1"></i>
              Select Staff (Optional)
            </h5>

            <div class="row g-3">
              <div class="col-md-4">
                <button
                  type="button"
                  class="staff-option selected d-flex flex-column align-items-center justify-content-center text-center h-100 p-3"
                  onclick="selectStaff(this)"
                  style="border:1px solid var(--accent); border-radius:var(--r); background:var(--accent-light); cursor:pointer; min-height:112px; width:100%;"
                >
                  <input
                    type="radio"
                    name="staff_id"
                    value=""
                    checked
                    style="position:absolute; opacity:0;"
                  >

                  <span style="display:inline-flex; align-items:center; justify-content:center; width:48px; height:48px; border-radius:999px; background:white; color:var(--accent); font-size:1.4rem; margin-bottom:.75rem;">
                    <i class="bi bi-person"></i>
                  </span>

                  <span style="font-weight:700; color:var(--ink); font-size:.875rem;">
                    No Preference
                  </span>
                </button>
              </div>

              <% staffList.forEach(member => { %>
                <div class="col-md-4">
                  <button
                    type="button"
                    class="staff-option d-flex flex-column align-items-center justify-content-center text-center h-100 p-3"
                    onclick="selectStaff(this)"
                    style="border:1px solid var(--border); border-radius:var(--r); background:var(--surface); cursor:pointer; min-height:112px; width:100%;"
                  >
                    <input
                      type="radio"
                      name="staff_id"
                      value="<%= member.staff_id %>"
                      style="position:absolute; opacity:0;"
                    >

                    <span style="display:inline-flex; align-items:center; justify-content:center; width:48px; height:48px; border-radius:999px; background:var(--accent-light); color:var(--accent); font-size:1.4rem; margin-bottom:.75rem;">
                      <i class="bi bi-person"></i>
                    </span>

                    <span style="font-weight:700; color:var(--ink); font-size:.875rem;">
                      <%= member.full_name %>
                    </span>

                    <% if (member.role) { %>
                      <span style="font-size:.72rem; color:var(--muted); margin-top:.25rem;">
                        <%= member.role %>
                      </span>
                    <% } %>
                  </button>
                </div>
              <% }) %>
            </div>
          </div>
        </div>

        <!-- Special Requests -->
        <div class="card border-0 mt-4" style="box-shadow:var(--shadow); border-radius:var(--r-xl);">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              <i class="bi bi-chat-left me-1"></i>
              Special Requests
            </h5>

            <textarea
              name="special_requests"
              class="form-control rounded-xl"
              rows="4"
              placeholder="Any special requests or notes..."
              style="resize:vertical;"
            ></textarea>
          </div>
        </div>

      </section>

      <!-- Right Summary -->
      <aside class="col-lg-5">
        <div class="card border-0" style="box-shadow:var(--shadow); border-radius:var(--r-xl); position:sticky; top:90px;">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              Booking Summary
            </h5>

            <div class="mb-3">
              <p style="color:var(--muted); font-size:.8rem; margin-bottom:.25rem;">Merchant</p>
              <p style="font-weight:700; color:var(--ink); margin:0;"><%= merchantName %></p>
            </div>

            <div class="mb-3">
              <p style="color:var(--muted); font-size:.8rem; margin-bottom:.25rem;">Service</p>
              <p id="summaryService" style="font-weight:700; color:var(--ink); margin:0;">
                <%= activeService ? activeService.service_name : 'No service selected' %>
              </p>
            </div>

            <div class="mb-3">
              <p style="color:var(--muted); font-size:.8rem; margin-bottom:.25rem;">Date &amp; Time</p>
              <p id="summaryDateTime" style="font-weight:700; color:var(--ink); margin:0;">
                Select a date and time
              </p>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 mb-4" style="border-top:1px solid var(--border);">
              <span style="font-weight:800; color:var(--ink);">Total</span>
              <span id="summaryTotal" style="font-family:var(--font-mono); font-weight:800; color:var(--accent); font-size:1.25rem;">
                S$<%= activePrice.toFixed(2) %>
              </span>
            </div>

            <button
              class="btn btn-primary btn-pill w-100 py-2"
              type="submit"
              style="font-weight:800;"
              <%= !activeService ? 'disabled' : '' %>
            >
              Proceed to Payment
            </button>
          </div>
        </div>
      </aside>
    </form>
  </div>
</main>

<script>
  const bookingDate = document.getElementById('bookingDate');
  const bookingTime = document.getElementById('bookingTime');

  const serviceInputs =
    document.querySelectorAll('input[name="service_id"]');

  const error =
    document.getElementById('bookingDateError');

  document.querySelectorAll('.staff-option').forEach(option => {
    option.style.transition =
      'border-color .15s, background .15s, box-shadow .15s';

    if (option.classList.contains('selected')) {
      option.style.borderColor = 'var(--accent)';
      option.style.background = 'var(--accent-light)';
      option.style.boxShadow = '0 0 0 3px var(--accent-mid)';
    }
  });

  function pad2(value) {
    return String(value).padStart(2, '0');
  }

  function localDateValue(date = new Date()) {
    return (
      date.getFullYear() +
      '-' +
      pad2(date.getMonth() + 1) +
      '-' +
      pad2(date.getDate())
    );
  }

  function selectedSlot() {
    if (!bookingDate.value || !bookingTime.value) {
      return null;
    }

    return new Date(
      bookingDate.value + 'T' + bookingTime.value
    );
  }

  function validateSlot() {
    bookingDate.min = localDateValue();

    if (!bookingDate.value || !bookingTime.value) {
      error.style.display = 'none';
      return false;
    }

    const slot = selectedSlot();

    const valid =
      slot && slot >= new Date();

    error.style.display =
      valid ? 'none' : 'block';

    return valid;
  }

  function updateSummary() {
    const service =
      document.querySelector(
        'input[name="service_id"]:checked'
      );

    if (service) {
      document.getElementById(
        'summaryService'
      ).textContent = service.dataset.name;

      document.getElementById(
        'summaryTotal'
      ).textContent =
        'S$' +
        Number(service.dataset.price).toFixed(2);
    }

    document.getElementById(
      'summaryDateTime'
    ).textContent =
      bookingDate.value && bookingTime.value
        ? bookingDate.value +
          ' at ' +
          bookingTime.value.slice(0, 5)
        : 'Select a date and time';
  }

  function selectStaff(button) {
    document.querySelectorAll('.staff-option').forEach(option => {
      option.classList.remove('selected');

      option.style.borderColor =
        'var(--border)';

      option.style.background =
        'var(--surface)';

      option.style.boxShadow = 'none';

      option.querySelector(
        'input[name="staff_id"]'
      ).checked = false;
    });

    button.classList.add('selected');

    button.style.borderColor =
      'var(--accent)';

    button.style.background =
      'var(--accent-light)';

    button.style.boxShadow =
      '0 0 0 3px var(--accent-mid)';

    button.querySelector(
      'input[name="staff_id"]'
    ).checked = true;

    loadAvailableSlots();
  }

  async function loadAvailableSlots() {
    const merchantId =
      document.querySelector(
        'input[name="merchant_id"]'
      ).value;

    const service =
      document.querySelector(
        'input[name="service_id"]:checked'
      );

    const staff =
      document.querySelector(
        'input[name="staff_id"]:checked'
      );

    const date = bookingDate.value;

    bookingTime.innerHTML =
      '<option value="">Loading slots...</option>';

    if (!merchantId || !service || !date) {
      bookingTime.innerHTML =
        '<option value="">Select a date first</option>';

      return;
    }

    const params = new URLSearchParams({
      merchantId,
      serviceId: service.value,
      bookingDate: date
    });

    if (staff && staff.value) {
      params.append('staffId', staff.value);
    }

    try {
      const response = await fetch(
        '/book/api/slots?' + params.toString()
      );

      const slots = await response.json();

      if (!slots.length) {
        bookingTime.innerHTML =
          '<option value="">No slots available</option>';

        updateSummary();
        return;
      }

      bookingTime.innerHTML = slots.map(slot => {
        return `
          <option value="${slot.start_time}">
            ${slot.label}
          </option>
        `;
      }).join('');

      updateSummary();

    } catch (err) {
      console.error(err);

      bookingTime.innerHTML =
        '<option value="">Unable to load slots</option>';
    }
  }

  bookingDate.min = localDateValue();

  bookingDate.addEventListener('change', () => {
    loadAvailableSlots();
    updateSummary();
  });

  bookingTime.addEventListener('change', () => {
    validateSlot();
    updateSummary();
  });

  document.querySelectorAll(
    'input[name="staff_id"]'
  ).forEach(input => {
    input.addEventListener(
      'change',
      loadAvailableSlots
    );
  });

  serviceInputs.forEach(input => {
    input.addEventListener('change', () => {
      const merchantId =
        document.querySelector(
          'input[name="merchant_id"]'
        ).value;

      window.location.href =
        `/book?merchantId=${merchantId}&serviceId=${input.value}`;
    });
  });

  document.querySelector('form').addEventListener(
    'submit',
    event => {
      if (!validateSlot()) {
        event.preventDefault();
      }
    }
  );

  updateSummary();
</script>

<%- include('../partials/footer') %>
