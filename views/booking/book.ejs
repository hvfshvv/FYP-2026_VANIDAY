<%
  const merchantName =
    (typeof merchant !== 'undefined' &&
      merchant &&
      merchant.merchant_name) ||
    t('portalBooking.selectedMerchant');

  const merchantAddress =
    (typeof merchant !== 'undefined' &&
      merchant &&
      merchant.address) ||
    t('common.singapore');

  const bookingServices =
    (typeof serviceList !== 'undefined' &&
      Array.isArray(serviceList))
      ? serviceList
      : [];

  const selectedId =
    (typeof selectedService !== 'undefined' &&
      selectedService &&
      selectedService.service_id)
      ? String(selectedService.service_id)
      : (bookingServices[0]
          ? String(bookingServices[0].service_id)
          : '');

  const activeService =
    bookingServices.find(
      service => String(service.service_id) === selectedId
    ) ||
    bookingServices[0] ||
    null;

  const activePrice = activeService
    ? Number(activeService.price)
    : 0;

  const staffList =
    (typeof staff !== 'undefined' && Array.isArray(staff))
      ? staff
      : [];

  const currentStaffId =
    (typeof selectedStaffId !== 'undefined' && selectedStaffId)
      ? String(selectedStaffId)
      : '';
%>

<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<main style="background:var(--canvas); min-height:80vh; padding:3rem 1rem;">
  <div class="container" style="max-width:980px;">

    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
      <div>
        <p class="section-label mb-2"><%= t('bookings.section') %></p>
        <h2 style="font-weight:800; letter-spacing:-.03em; color:var(--ink); margin-bottom:.25rem;">
          <%= t('portalBooking.complete') %>
        </h2>
        <p style="color:var(--muted); margin:0;">
          <%= merchantName %> · <%= merchantAddress %>
        </p>
      </div>

      <a href="/book/viewBookings" class="btn btn-outline-secondary btn-pill">
        <i class="bi bi-clock-history me-1"></i><%= t('booking.myBookings') %>
      </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="rounded-xl p-3 mb-4" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>

    <form action="/book/confirm" method="POST" class="row g-4" id="portalBookingForm">
      <input type="hidden" name="merchant_id" value="<%= merchant ? merchant.merchant_id : '' %>" />

      <section class="col-lg-7">

        <!-- Service Selection -->
        <div class="card border-0 mb-4" style="box-shadow:var(--shadow); border-radius:var(--r-xl);">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              <%= t('portalBooking.selectService') %>
            </h5>

            <% if (!bookingServices.length) { %>
              <p style="color:var(--muted); margin:0;"><%= t('portalBooking.noServices') %></p>
            <% } %>

            <% if (activeService) { %>
              <label
                class="d-flex align-items-center justify-content-between gap-3 mb-3 p-3"
                style="border:1px solid var(--accent); border-radius:var(--r); background:var(--accent-light); cursor:pointer;"
              >
                <span>
                  <input
                    type="radio"
                    name="service_id"
                    value="<%= activeService.service_id %>"
                    data-name="<%= serviceText(activeService, 'name') || activeService.service_name %>"
                    data-price="<%= Number(activeService.price) %>"
                    data-duration="<%= activeService.duration_mins || 60 %>"
                    checked
                    required
                  />
                  <span style="font-weight:800; color:var(--ink); margin-left:.5rem;">
                    <%= serviceText(activeService, 'name') || activeService.service_name %>
                  </span>
                </span>

                <span style="font-family:var(--font-mono); font-weight:800; color:var(--accent);">
                  S$<%= Number(activeService.price).toFixed(2) %>
                </span>
              </label>

              <% const otherServices = bookingServices.filter(service => String(service.service_id) !== String(activeService.service_id)); %>
              <% if (otherServices.length) { %>
                <details>
                  <summary style="cursor:pointer; font-weight:800; color:var(--accent); list-style:none;">
                    <i class="bi bi-chevron-down me-1"></i><%= t('portalBooking.viewOtherServices') %>
                  </summary>

                  <div style="margin-top:.75rem;">
                    <% otherServices.forEach(service => { %>
                      <label
                        class="d-flex align-items-center justify-content-between gap-3 mb-2 p-3"
                        style="border:1px solid var(--border); border-radius:var(--r); background:var(--surface); cursor:pointer;"
                      >
                        <span>
                          <input
                            type="radio"
                            name="service_id"
                            value="<%= service.service_id %>"
                            data-name="<%= serviceText(service, 'name') || service.service_name %>"
                            data-price="<%= Number(service.price) %>"
                            data-duration="<%= service.duration_mins || 60 %>"
                          />
                          <span style="font-weight:700; color:var(--ink); margin-left:.5rem;">
                            <%= serviceText(service, 'name') || service.service_name %>
                          </span>
                        </span>

                        <span style="font-family:var(--font-mono); font-weight:700; color:var(--accent);">
                          S$<%= Number(service.price).toFixed(2) %>
                        </span>
                      </label>
                    <% }) %>
                  </div>
                </details>
              <% } %>
            <% } %>
          </div>
        </div>

        <!-- Date & Time -->
        <div class="card border-0" style="box-shadow:var(--shadow); border-radius:var(--r-xl);">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              <%= t('portalBooking.selectDateTime') %>
            </h5>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" style="font-weight:600; font-size:.875rem;">
                  <%= t('common.date') %>
                </label>
                <input
                  class="form-control rounded-xl"
                  type="date"
                  name="booking_date"
                  id="bookingDate"
                  required
                />
              </div>

              <div class="col-md-6">
                <label class="form-label" style="font-weight:600; font-size:.875rem;">
                  <%= t('common.time') %>
                </label>
                <select
                  class="form-control rounded-xl"
                  name="booking_time"
                  id="bookingTime"
                  required
                >
                  <option value=""><%= t('portalBooking.selectDateFirst') %></option>
                </select>
              </div>
            </div>

            <div
              id="bookingDateError"
              style="display:none; color:var(--danger); font-size:.8125rem; margin-top:.75rem;"
            >
              <i class="bi bi-exclamation-circle me-1"></i>
              <%= t('booking.validation.futureTime') %>
            </div>
          </div>
        </div>

        <!-- Staff Selection -->
        <div class="card border-0 mt-4" style="box-shadow:var(--shadow); border-radius:var(--r-xl);">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              <i class="bi bi-person me-1"></i>
              <%= t('portalBooking.selectStaffOptional') %>
            </h5>

            <div class="row g-3" id="staffOptionsGrid">
              <div class="col-md-4">
                <button
                  type="button"
                  class="staff-option <%= !currentStaffId ? 'selected' : '' %> d-flex flex-column align-items-center justify-content-center text-center h-100 p-3"
                  data-staff-name="<%= t('common.noPreference') %>"
                  onclick="selectStaff(this)"
                  style="border:1px solid var(--accent); border-radius:var(--r); background:var(--accent-light); cursor:pointer; min-height:112px; width:100%;"
                >
                  <input
                    type="radio"
                    name="staff_id"
                    value=""
                    <%= !currentStaffId ? 'checked' : '' %>
                    style="position:absolute; opacity:0;"
                  >

                  <span style="display:inline-flex; align-items:center; justify-content:center; width:48px; height:48px; border-radius:999px; background:white; color:var(--accent); font-size:1.4rem; margin-bottom:.75rem;">
                    <i class="bi bi-person"></i>
                  </span>

                  <span style="font-weight:700; color:var(--ink); font-size:.875rem;">
                    <%= t('common.noPreference') %>
                  </span>
                </button>
              </div>

              <% staffList.forEach(member => { %>
                <div class="col-md-4">
                  <button
                    type="button"
                    class="staff-option <%= String(member.staff_id) === currentStaffId ? 'selected' : '' %> d-flex flex-column align-items-center justify-content-center text-center h-100 p-3"
                    data-staff-name="<%= member.full_name %>"
                    onclick="selectStaff(this)"
                    style="border:1px solid var(--border); border-radius:var(--r); background:var(--surface); cursor:pointer; min-height:112px; width:100%;"
                  >
                    <input
                      type="radio"
                      name="staff_id"
                      value="<%= member.staff_id %>"
                      <%= String(member.staff_id) === currentStaffId ? 'checked' : '' %>
                      style="position:absolute; opacity:0;"
                    >

                    <span style="display:inline-flex; align-items:center; justify-content:center; width:48px; height:48px; border-radius:999px; background:var(--accent-light); color:var(--accent); font-size:1.4rem; margin-bottom:.75rem;">
                      <i class="bi bi-person"></i>
                    </span>

                    <span style="font-weight:700; color:var(--ink); font-size:.875rem;">
                      <%= member.full_name %>
                    </span>

                    <% if (member.role) { %>
                      <span style="font-size:.72rem; color:var(--muted); margin-top:.25rem;">
                        <%= member.role %>
                      </span>
                    <% } %>
                  </button>
                </div>
              <% }) %>
            </div>
            <p id="staffAvailabilityNote" class="small mt-3 mb-0" style="color:var(--muted);">
              <%= t('portalBooking.staffInitial') %>
            </p>
          </div>
        </div>

        <!-- Special Requests -->
        <div class="card border-0 mt-4" style="box-shadow:var(--shadow); border-radius:var(--r-xl);">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              <i class="bi bi-chat-left me-1"></i>
              <%= t('portalBooking.specialRequests') %>
            </h5>

            <textarea
              name="special_requests"
              class="form-control rounded-xl"
              rows="4"
              placeholder="<%= t('portalBooking.specialRequestsPlaceholder') %>"
              style="resize:vertical;"
            ></textarea>
          </div>
        </div>

        <% if (typeof cancellationPolicySummary !== 'undefined' && cancellationPolicySummary) { %>
          <div class="rounded-xl p-4 mt-4" style="background:#fff;border:1px solid var(--border);box-shadow:var(--shadow-sm);">
            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-3">
              <div>
                <p class="section-label mb-1"><%= t('bookings.cancellationPolicy') %></p>
                <p style="color:var(--muted);font-size:.875rem;margin:0;">Refunds depend on how early the booking is cancelled.</p>
              </div>
              <a href="/legal/cancellation-refund-policy" target="_blank" rel="noopener" style="color:var(--accent);font-weight:800;font-size:.85rem;">View full policy</a>
            </div>
            <div class="d-flex flex-column gap-2">
              <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;border:1px solid var(--border);border-radius:var(--r);padding:.85rem;background:var(--surface);">
                <div>
                  <p style="font-weight:800;color:var(--ink);margin:0;">More than 24 hours</p>
                  <p style="color:var(--muted);font-size:.78rem;margin:.1rem 0 0;">Before appointment</p>
                </div>
                <p style="font-family:var(--font-mono);font-weight:800;color:var(--success);margin:0;white-space:nowrap;">95% refund</p>
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;border:1px solid var(--border);border-radius:var(--r);padding:.85rem;background:var(--surface);">
                <div>
                  <p style="font-weight:800;color:var(--ink);margin:0;">6-24 hours</p>
                  <p style="color:var(--muted);font-size:.78rem;margin:.1rem 0 0;">Before appointment</p>
                </div>
                <p style="font-family:var(--font-mono);font-weight:800;color:#c2410c;margin:0;white-space:nowrap;">50% refund</p>
              </div>
              <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;border:1px solid var(--border);border-radius:var(--r);padding:.85rem;background:var(--surface);">
                <div>
                  <p style="font-weight:800;color:var(--ink);margin:0;">Under 6 hours or no-show</p>
                  <p style="color:var(--muted);font-size:.78rem;margin:.1rem 0 0;">Before appointment</p>
                </div>
                <p style="font-family:var(--font-mono);font-weight:800;color:var(--danger);margin:0;white-space:nowrap;">No refund</p>
              </div>
            </div>
            <p style="color:var(--ink);font-weight:700;margin:.9rem 0 0;font-size:.9rem;">
              <i class="bi bi-info-circle me-1" style="color:var(--accent);"></i>
              Rescheduling is allowed until 6 hours before the appointment if needed, subject to merchant availability.
            </p>
          </div>
        <% } %>

      </section>

      <!-- Right Summary -->
      <aside class="col-lg-5">
        <div class="card border-0" style="box-shadow:var(--shadow); border-radius:var(--r-xl); position:sticky; top:90px;">
          <div class="card-body p-4">
            <h5 style="font-weight:800; color:var(--ink); margin-bottom:1rem;">
              <%= t('booking.bookingSummary') %>
            </h5>

            <div class="mb-3">
              <p style="color:var(--muted); font-size:.8rem; margin-bottom:.25rem;"><%= t('common.merchant') %></p>
              <p style="font-weight:700; color:var(--ink); margin:0;"><%= merchantName %></p>
            </div>

            <div class="mb-3">
              <p style="color:var(--muted); font-size:.8rem; margin-bottom:.25rem;"><%= t('common.service') %></p>
              <p id="summaryService" style="font-weight:700; color:var(--ink); margin:0;">
                <%= activeService ? (serviceText(activeService, 'name') || activeService.service_name) : t('portalBooking.noServiceSelected') %>
              </p>
            </div>

            <div class="mb-3">
              <p style="color:var(--muted); font-size:.8rem; margin-bottom:.25rem;"><%= t('common.staff') %></p>
              <p id="summaryStaff" style="font-weight:700; color:var(--ink); margin:0;">
                <%= t('common.noPreference') %>
              </p>
            </div>

            <div class="mb-3">
              <p style="color:var(--muted); font-size:.8rem; margin-bottom:.25rem;"><%= t('booking.steps.dateTime') %></p>
              <p id="summaryDateTime" style="font-weight:700; color:var(--ink); margin:0;">
                <%= t('portalBooking.selectDateTimeSummary') %>
              </p>
            </div>

            <div class="d-flex justify-content-between align-items-center pt-3 mb-4" style="border-top:1px solid var(--border);">
              <span style="font-weight:800; color:var(--ink);"><%= t('common.total') %></span>
              <span id="summaryTotal" style="font-family:var(--font-mono); font-weight:800; color:var(--accent); font-size:1.25rem;">
                S$<%= activePrice.toFixed(2) %>
              </span>
            </div>

            <label
              for="bookingPolicyAcknowledgement"
              id="bookingPolicyAcknowledgementBox"
              class="d-flex align-items-start gap-2 p-3 mb-3"
              style="border:1px solid var(--border);border-radius:var(--r);background:var(--surface);cursor:pointer;transition:border-color .15s, box-shadow .15s, background .15s;"
            >
              <input
                id="bookingPolicyAcknowledgement"
                type="checkbox"
                style="width:1.05rem;height:1.05rem;accent-color:var(--accent);flex:0 0 auto;margin-top:.15rem;"
              />
              <span style="color:var(--ink);font-weight:700;font-size:.86rem;line-height:1.45;">
                I understand and agree to Uniday's cancellation and refund policy for this booking.
              </span>
            </label>
            <p id="bookingPolicyAcknowledgementError" class="small mb-3" style="display:none;color:var(--danger);">
              <i class="bi bi-exclamation-circle me-1"></i>Please tick the policy acknowledgement before proceeding to payment.
            </p>

            <button
              id="bookingSubmitButton"
              class="btn btn-primary btn-pill w-100 py-2"
              type="submit"
              style="font-weight:800;"
              <%= !activeService ? 'disabled' : '' %>
            >
              <%= t('portalBooking.proceedPayment') %>
            </button>
          </div>
        </div>
      </aside>
    </form>
  </div>
</main>

<script>
  const bookingDate = document.getElementById('bookingDate');
  const bookingTime = document.getElementById('bookingTime');
  const bookingPolicyAcknowledgement = document.getElementById('bookingPolicyAcknowledgement');
  const bookingPolicyAcknowledgementBox = document.getElementById('bookingPolicyAcknowledgementBox');
  const bookingPolicyAcknowledgementError = document.getElementById('bookingPolicyAcknowledgementError');
  const bookingSubmitButton = document.getElementById('bookingSubmitButton');
  const maxAdvanceBookingDays = 365;

  const serviceInputs =
    document.querySelectorAll('input[name="service_id"]');

  const error =
    document.getElementById('bookingDateError');

  function hasSelectedService() {
    return Boolean(document.querySelector('input[name="service_id"]:checked'));
  }

  function hasAcceptedBookingPolicy() {
    return !bookingPolicyAcknowledgement || bookingPolicyAcknowledgement.checked;
  }

  function updateBookingSubmitState() {
    if (!bookingSubmitButton) return;
    bookingSubmitButton.disabled = !hasSelectedService();
  }

  function setBookingPolicyErrorState(show) {
    if (bookingPolicyAcknowledgementError) {
      bookingPolicyAcknowledgementError.style.display = show ? 'block' : 'none';
    }

    if (bookingPolicyAcknowledgementBox) {
      bookingPolicyAcknowledgementBox.style.borderColor = show ? 'var(--danger)' : 'var(--border)';
      bookingPolicyAcknowledgementBox.style.boxShadow = show ? '0 0 0 3px var(--danger-bg)' : 'none';
      bookingPolicyAcknowledgementBox.style.background = show ? '#fff' : 'var(--surface)';
    }
  }

  function requireBookingPolicyAccepted() {
    if (hasAcceptedBookingPolicy()) {
      setBookingPolicyErrorState(false);
      return true;
    }

    setBookingPolicyErrorState(true);

    if (bookingPolicyAcknowledgementBox) {
      bookingPolicyAcknowledgementBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    if (bookingPolicyAcknowledgement) {
      bookingPolicyAcknowledgement.focus({ preventScroll: true });
    }

    return false;
  }

  function styleStaffOption(option) {
    option.style.transition =
      'border-color .15s, background .15s, box-shadow .15s';

    if (option.classList.contains('selected')) {
      option.style.borderColor = 'var(--accent)';
      option.style.background = 'var(--accent-light)';
      option.style.boxShadow = '0 0 0 3px var(--accent-mid)';
    }
  }

  document.querySelectorAll('.staff-option').forEach(styleStaffOption);

  function pad2(value) {
    return String(value).padStart(2, '0');
  }

  function localDateValue(date = new Date()) {
    return (
      date.getFullYear() +
      '-' +
      pad2(date.getMonth() + 1) +
      '-' +
      pad2(date.getDate())
    );
  }

  function maxBookableDateValue() {
    const maxDate = new Date();
    maxDate.setDate(maxDate.getDate() + maxAdvanceBookingDays);
    return localDateValue(maxDate);
  }

  function selectedSlot() {
    if (!bookingDate.value || !bookingTime.value) {
      return null;
    }

    return new Date(
      bookingDate.value + 'T' + bookingTime.value
    );
  }

  function validateSlot() {
    bookingDate.min = localDateValue();
    bookingDate.max = maxBookableDateValue();

    if (!bookingDate.value || !bookingTime.value) {
      error.style.display = 'none';
      return false;
    }

    const slot = selectedSlot();
    const withinBookingWindow = bookingDate.value <= bookingDate.max;

    const valid =
      slot && slot >= new Date() && withinBookingWindow;

    if (!withinBookingWindow) {
      error.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>Bookings can only be made within the next 12 months.';
    } else {
      error.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>Please choose a date and time that is not in the past.';
    }

    error.style.display =
      valid ? 'none' : 'block';

    return valid;
  }

  function updateSummary() {
    const service =
      document.querySelector(
        'input[name="service_id"]:checked'
      );

    if (service) {
      document.getElementById(
        'summaryService'
      ).textContent = service.dataset.name;

      document.getElementById(
        'summaryTotal'
      ).textContent =
        'S$' +
        Number(service.dataset.price).toFixed(2);
    }

    const selectedStaff = document.querySelector(
      'input[name="staff_id"]:checked'
    );

    const selectedStaffOption = selectedStaff
      ? selectedStaff.closest('.staff-option')
      : null;

    document.getElementById(
      'summaryStaff'
    ).textContent = selectedStaffOption
      ? selectedStaffOption.dataset.staffName || window.t('common.noPreference')
      : window.t('common.noPreference');

    document.getElementById(
      'summaryDateTime'
    ).textContent =
      bookingDate.value && bookingTime.value
        ? bookingDate.value +
          ' at ' +
          bookingTime.value.slice(0, 5)
        : window.t('portalBooking.selectDateTimeSummary');
  }

  function updateBookingAction() {
    const selectedOption = bookingTime.options[bookingTime.selectedIndex];
    const isWaitlist = selectedOption && selectedOption.dataset.available === 'false';
    const submitButton = bookingSubmitButton;
    submitButton.textContent = isWaitlist ? 'Join Waitlist' : window.t('portalBooking.proceedPayment');
    submitButton.classList.toggle('btn-outline-primary', isWaitlist);
    submitButton.classList.toggle('btn-primary', !isWaitlist);
    updateBookingSubmitState();
    return isWaitlist;
  }

  function selectStaff(button) {
    document.querySelectorAll('.staff-option').forEach(option => {
      option.classList.remove('selected');

      option.style.borderColor =
        'var(--border)';

      option.style.background =
        'var(--surface)';

      option.style.boxShadow = 'none';

      option.querySelector(
        'input[name="staff_id"]'
      ).checked = false;
    });

    button.classList.add('selected');

    button.style.borderColor =
      'var(--accent)';

    button.style.background =
      'var(--accent-light)';

    button.style.boxShadow =
      '0 0 0 3px var(--accent-mid)';

    button.querySelector(
      'input[name="staff_id"]'
    ).checked = true;

    updateSummary();
    loadAvailableSlots();
  }

  function staffOptionTemplate(member) {
    if (!member) {
      return `
        <div class="col-md-4">
          <button
            type="button"
            class="staff-option selected d-flex flex-column align-items-center justify-content-center text-center h-100 p-3"
            data-staff-name="${window.t('common.noPreference')}"
            onclick="selectStaff(this)"
            style="border:1px solid var(--accent); border-radius:var(--r); background:var(--accent-light); cursor:pointer; min-height:112px; width:100%; box-shadow:0 0 0 3px var(--accent-mid);"
          >
            <input type="radio" name="staff_id" value="" checked style="position:absolute; opacity:0;">
            <span style="display:inline-flex; align-items:center; justify-content:center; width:48px; height:48px; border-radius:999px; background:white; color:var(--accent); font-size:1.4rem; margin-bottom:.75rem;">
              <i class="bi bi-person"></i>
            </span>
            <span style="font-weight:700; color:var(--ink); font-size:.875rem;">${window.t('common.noPreference')}</span>
          </button>
        </div>
      `;
    }

    const name = escapeHtml(member.full_name || window.t('common.staff'));
    const role = member.role
      ? `<span style="font-size:.72rem; color:var(--muted); margin-top:.25rem;">${escapeHtml(member.role)}</span>`
      : '';

    return `
      <div class="col-md-4">
        <button
          type="button"
          class="staff-option d-flex flex-column align-items-center justify-content-center text-center h-100 p-3"
          data-staff-name="${name}"
          onclick="selectStaff(this)"
          style="border:1px solid var(--border); border-radius:var(--r); background:var(--surface); cursor:pointer; min-height:112px; width:100%;"
        >
          <input type="radio" name="staff_id" value="${member.staff_id}" style="position:absolute; opacity:0;">
          <span style="display:inline-flex; align-items:center; justify-content:center; width:48px; height:48px; border-radius:999px; background:var(--accent-light); color:var(--accent); font-size:1.4rem; margin-bottom:.75rem;">
            <i class="bi bi-person"></i>
          </span>
          <span style="font-weight:700; color:var(--ink); font-size:.875rem;">${name}</span>
          ${role}
        </button>
      </div>
    `;
  }

  function escapeHtml(value) {
    return String(value || '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function renderStaffOptions(availableStaff) {
    const grid = document.getElementById('staffOptionsGrid');
    const note = document.getElementById('staffAvailabilityNote');
    const currentStaff = document.querySelector('input[name="staff_id"]:checked');
    const currentStaffId = currentStaff ? currentStaff.value : '';
    const canKeepCurrent = currentStaffId && availableStaff.some(member => String(member.staff_id) === currentStaffId);

    grid.innerHTML = [
      staffOptionTemplate(null),
      ...availableStaff.map(staffOptionTemplate)
    ].join('');

    if (canKeepCurrent) {
      const input = grid.querySelector(`input[name="staff_id"][value="${currentStaffId}"]`);
      if (input) {
        const option = input.closest('.staff-option');
        grid.querySelectorAll('.staff-option').forEach(item => {
          item.classList.remove('selected');
          item.style.borderColor = 'var(--border)';
          item.style.background = 'var(--surface)';
          item.style.boxShadow = 'none';
          item.querySelector('input[name="staff_id"]').checked = false;
        });
        option.classList.add('selected');
        option.style.borderColor = 'var(--accent)';
        option.style.background = 'var(--accent-light)';
        option.style.boxShadow = '0 0 0 3px var(--accent-mid)';
        input.checked = true;
        updateSummary();
      }
    } else {
      document.querySelectorAll('.staff-option').forEach(styleStaffOption);
      updateSummary();
    }

    if (note) {
      note.textContent = availableStaff.length
        ? window.t('booking.staffAvailable', { count: availableStaff.length, plural: availableStaff.length === 1 ? '' : 's' })
        : window.t('booking.staffFallback');
      note.style.color = availableStaff.length ? 'var(--muted)' : 'var(--danger)';
    }
  }

  async function loadAvailableStaff() {
    const merchantId = document.querySelector('input[name="merchant_id"]').value;
    const service = document.querySelector('input[name="service_id"]:checked');
    const date = bookingDate.value;
    const time = bookingTime.value;

    if (!merchantId || !service || !date || !time) {
      renderStaffOptions([]);
      const note = document.getElementById('staffAvailabilityNote');
      if (note) {
        note.textContent = window.t('portalBooking.staffInitial');
        note.style.color = 'var(--muted)';
      }
      return;
    }

    try {
      const params = new URLSearchParams({
        merchantId,
        serviceId: service.value,
        bookingDate: date,
        bookingTime: time,
      });

      const response = await fetch('/book/api/staff?' + params.toString());
      const availableStaff = await response.json();
      renderStaffOptions(availableStaff);
    } catch (err) {
      console.error(err);
      renderStaffOptions([]);
    }
  }

  async function loadAvailableSlots() {
    const merchantId =
      document.querySelector(
        'input[name="merchant_id"]'
      ).value;

    const service =
      document.querySelector(
        'input[name="service_id"]:checked'
      );

    const staff =
      document.querySelector(
        'input[name="staff_id"]:checked'
      );

    const date = bookingDate.value;

    bookingTime.innerHTML =
      '<option value="">' + window.t('common.loading') + '</option>';

    if (!merchantId || !service || !date) {
      bookingTime.innerHTML =
        '<option value="">' + window.t('portalBooking.selectDateFirst') + '</option>';

      return;
    }

    const params = new URLSearchParams({
      merchantId,
      serviceId: service.value,
      bookingDate: date
    });

    if (staff && staff.value) {
      params.append('staffId', staff.value);
    }

    try {
      const response = await fetch(
        '/book/api/slots?' + params.toString()
      );

      const slots = await response.json();

      if (!slots.length) {
        bookingTime.innerHTML =
          '<option value="">' + window.t('booking.validation.noSlots') + '</option>';

        await loadAvailableStaff();
        updateSummary();
        return;
      }

      bookingTime.innerHTML = slots.map(slot => {
        const time = String(slot.start_time).slice(0, 5);
        const isAvailable = slot.is_available !== false;
        const queue = Number(slot.waitlist_count || 0);
        const suffix = isAvailable
          ? ''
          : ` — Fully booked · ${queue ? queue + ' waiting' : 'Join waitlist'}`;
        return `
          <option value="${slot.start_time}" data-available="${isAvailable ? 'true' : 'false'}">
            ${slot.label || time}${suffix}
          </option>
        `;
      }).join('');

      // Keep full slots visible in chronological order, but default to the
      // next slot that can actually be booked. Joining a waitlist should be
      // an explicit choice made by opening the dropdown and selecting it.
      const firstAvailableOption = Array.from(bookingTime.options)
        .find(option => option.dataset.available === 'true');
      if (firstAvailableOption) {
        bookingTime.value = firstAvailableOption.value;
      }

      if (updateBookingAction()) {
        renderStaffOptions([]);
      } else {
        await loadAvailableStaff();
      }
      updateSummary();

    } catch (err) {
      console.error(err);

      bookingTime.innerHTML =
        '<option value="">' + window.t('booking.validation.unableTimes') + '</option>';
    }
  }

  bookingDate.min = localDateValue();
  bookingDate.max = maxBookableDateValue();

  bookingDate.addEventListener('change', () => {
    if (bookingDate.value && bookingDate.value > bookingDate.max) {
      bookingDate.value = bookingDate.max;
      error.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>Bookings can only be made within the next 12 months.';
      error.style.display = 'block';
    }
    loadAvailableSlots();
    updateSummary();
  });

  bookingTime.addEventListener('change', () => {
    validateSlot();
    if (updateBookingAction()) {
      renderStaffOptions([]);
    } else {
      loadAvailableStaff();
    }
    updateSummary();
  });

  document.querySelectorAll(
    'input[name="staff_id"]'
  ).forEach(input => {
    input.addEventListener(
      'change',
      loadAvailableSlots
    );
  });

  serviceInputs.forEach(input => {
    input.addEventListener('change', () => {
      const merchantId =
        document.querySelector(
          'input[name="merchant_id"]'
        ).value;

      window.location.href =
        `/book?merchantId=${merchantId}&serviceId=${input.value}`;
    });
  });

  if (bookingPolicyAcknowledgement) {
    bookingPolicyAcknowledgement.addEventListener('change', () => {
      if (bookingPolicyAcknowledgement.checked) {
        setBookingPolicyErrorState(false);
      }
      updateBookingSubmitState();
    });
  }

  document.getElementById('portalBookingForm').addEventListener(
    'submit',
    event => {
      if (!requireBookingPolicyAccepted()) {
        event.preventDefault();
        return;
      }

      if (!validateSlot()) {
        event.preventDefault();
        return;
      }

      const selectedOption = bookingTime.options[bookingTime.selectedIndex];
      if (selectedOption && selectedOption.dataset.available === 'false') {
        event.currentTarget.action = '/book/waitlist';
      }
    }
  );

  updateSummary();
  updateBookingSubmitState();
</script>

<%- include('../partials/footer') %>
