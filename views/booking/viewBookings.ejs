<%- include('../partials/header') %>

<style>
  .booking-entry-details {
    min-width: 0;
  }

  .booking-entry-actions {
    flex: 0 0 240px;
    margin-left: auto;
    text-align: right;
  }

  .booking-entry {
    scroll-margin-top: 110px;
    transition: background-color .25s ease, box-shadow .25s ease;
  }

  .booking-entry.is-past {
    background: #F1E7EB;
    box-shadow: inset 4px 0 0 rgba(113, 113, 122, .35);
  }

  .booking-time-badge {
    background: var(--canvas);
    color: var(--muted);
    border: 1px solid var(--border);
  }

  .booking-time-badge.is-past {
    background: #D6C6CC;
    color: #3F3F46;
    border-color: #B8A7AE;
  }

  .booking-entry.is-targeted {
    background: var(--accent-light) !important;
    box-shadow: inset 4px 0 0 var(--accent);
  }

  @media (max-width: 767.98px) {
    .booking-entry-actions {
      flex: 1 1 100%;
    }
  }

  .booking-confirm-overlay {
    position: fixed;
    inset: 0;
    z-index: 1050;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    background: rgba(15, 23, 42, .36);
  }

  .booking-confirm-overlay.is-open {
    display: flex;
  }

  .booking-confirm-dialog {
    width: min(100%, 440px);
    border: 1px solid var(--border);
    border-radius: var(--r-xl);
    background: var(--surface);
    box-shadow: var(--shadow);
    padding: 1.5rem;
  }

  .booking-confirm-icon {
    width: 42px;
    height: 42px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--danger-bg);
    color: var(--danger);
    font-size: 1.1rem;
    margin-bottom: .85rem;
  }

  .booking-confirm-title {
    color: var(--ink);
    font-weight: 800;
    margin: 0 0 .5rem;
  }

  .booking-confirm-message {
    color: var(--muted);
    font-weight: 600;
    line-height: 1.5;
    margin: 0 0 1.25rem;
  }

  .booking-confirm-policy {
    display: none;
    border: 1px solid var(--border);
    border-radius: var(--r);
    background: var(--canvas);
    padding: .9rem 1rem;
    margin: 0 0 1.25rem;
    color: var(--ink);
    font-size: .9rem;
    font-weight: 700;
    line-height: 1.65;
  }

  .booking-confirm-policy.is-visible {
    display: block;
  }

  .booking-confirm-actions {
    display: flex;
    justify-content: flex-end;
    gap: .75rem;
  }

  @media (max-width: 480px) {
    .booking-confirm-actions {
      flex-direction: column-reverse;
    }

    .booking-confirm-actions .btn {
      width: 100%;
    }
  }
</style>

<%
  const bookingList = Array.isArray(bookings)
    ? bookings.filter(booking => effectiveStatus(booking) !== 'payment_failed')
    : [];
  const waitlistList = Array.isArray(waitlists) ? waitlists : [];
  const changeRequestList = (typeof changeRequests !== 'undefined' && Array.isArray(changeRequests)) ? changeRequests : [];
  const waitlistStatusStyles = {
    waiting:   { label: t('bookings.waiting'), bg: 'var(--warn-bg)', color: 'var(--warn)' },
    offered:   { label: t('bookings.slotOpen'), bg: 'var(--success-bg)', color: 'var(--success)' },
    confirmed: { label: t('bookings.confirmed'), bg: 'var(--success-bg)', color: 'var(--success)' },
    expired:   { label: t('bookings.offerExpired'), bg: 'var(--danger-bg)', color: 'var(--danger)' },
    cancelled: { label: t('bookings.cancelled'), bg: 'var(--canvas)', color: 'var(--muted)' },
    removed:   { label: t('bookings.removed'), bg: 'var(--canvas)', color: 'var(--muted)' },
  };

  function formatDate(value) {
    return new Date(value).toLocaleDateString(lang === 'zh' ? 'zh-CN' : (lang === 'ta' ? 'ta-IN' : 'en-SG'), {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  function formatTime(value) {
    return String(value || '').slice(0, 5);
  }

  function pendingExpiryIso(booking) {
    if (booking.payment_hold_expires_at) {
      const holdExpiresAt = new Date(booking.payment_hold_expires_at);
      if (!Number.isNaN(holdExpiresAt.getTime())) return holdExpiresAt.toISOString();
    }

    const createdAt = new Date(booking.created_at);
    if (Number.isNaN(createdAt.getTime())) return '';
    return new Date(createdAt.getTime() + 5 * 60 * 1000).toISOString();
  }

  function pendingRemainingSeconds(booking) {
    return Math.max(0, Number(booking.pending_remaining_seconds || 0));
  }

  function isPendingPaymentExpired(booking) {
    if (booking.status !== 'pending_payment') return false;
    if (typeof booking.pending_is_active !== 'undefined') {
      return Number(booking.pending_is_active) !== 1;
    }
    const expiresAt = new Date(pendingExpiryIso(booking)).getTime();
    return !Number.isNaN(expiresAt) && Date.now() >= expiresAt;
  }

  function effectiveStatus(booking) {
    return isPendingPaymentExpired(booking) ? 'payment_failed' : booking.status;
  }

  function bookingStartDate(booking) {
    const rawDate = new Date(booking.booking_date);
    if (Number.isNaN(rawDate.getTime())) return null;
    const year = rawDate.getFullYear();
    const month = String(rawDate.getMonth() + 1).padStart(2, '0');
    const day = String(rawDate.getDate()).padStart(2, '0');
    return new Date(`${year}-${month}-${day}T${formatTime(booking.booking_time)}:00`);
  }

  function bookingStartTime(booking) {
    const startsAt = bookingStartDate(booking);
    return startsAt && !Number.isNaN(startsAt.getTime()) ? startsAt.getTime() : 0;
  }

  function cancellationDeadlineIso(booking) {
    const startsAt = bookingStartDate(booking);
    if (!startsAt || Number.isNaN(startsAt.getTime())) return '';
    const hours = 6;
    return new Date(startsAt.getTime() - hours * 60 * 60 * 1000).toISOString();
  }

  function hoursUntilBooking(booking) {
    const startsAt = bookingStartDate(booking);
    if (!startsAt || Number.isNaN(startsAt.getTime())) return null;
    return (startsAt.getTime() - Date.now()) / (60 * 60 * 1000);
  }

  function refundPercentageForBooking(booking) {
    const hoursUntil = hoursUntilBooking(booking);
    if (!Number.isFinite(hoursUntil)) return 0;
    return hoursUntil > 24 ? 95 : (hoursUntil >= 6 ? 50 : 0);
  }

  function canRescheduleBooking(booking) {
    const hoursUntil = hoursUntilBooking(booking);
    return Number.isFinite(hoursUntil) && hoursUntil >= 6;
  }

  function fallbackCreatedTime(booking) {
    const createdAt = new Date(booking.created_at).getTime();
    return Number.isNaN(createdAt) ? 0 : createdAt;
  }

  const displayBookings = [...bookingList].sort((a, b) => {
    const bookingTimeDiff = bookingStartTime(b) - bookingStartTime(a);
    if (bookingTimeDiff) return bookingTimeDiff;

    return fallbackCreatedTime(b) - fallbackCreatedTime(a);
  });
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:980px;">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <p class="section-label mb-2"><%= t('bookings.section') %></p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('bookings.title') %></h2>
        <p style="color:var(--muted);margin:0;"><%= t('bookings.subtitle') %></p>
      </div>
      <a href="/#marketplace" class="btn btn-primary btn-pill">
        <i class="bi bi-calendar-plus me-2"></i><%= t('bookings.bookNow') %>
      </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="rounded-xl mb-3 p-3 booking-flash-message" data-auto-dismiss-flash style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;transition:opacity .25s ease, transform .25s ease;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="rounded-xl mb-3 p-3 booking-flash-message" data-auto-dismiss-flash style="background:var(--success-bg);color:var(--success);font-size:.875rem;transition:opacity .25s ease, transform .25s ease;">
        <i class="bi bi-check-circle me-2"></i><%= success %>
      </div>
    <% } %>

    <% if (changeRequestList.length) { %>
      <p class="section-label mb-2">Action required</p>
      <% changeRequestList.forEach(request => { %>
      <section class="card border-0 mb-4 p-4" style="box-shadow:var(--shadow);border-radius:var(--r-xl);border-left:4px solid var(--warn)!important;">
        <div class="d-flex flex-wrap justify-content-between gap-3">
          <div>
            <h5 style="font-weight:800;color:var(--ink);">Staff replacement proposed</h5>
            <p style="color:var(--ink);margin-bottom:.35rem;"><strong><%= request.merchant_name %></strong> proposes <strong><%= request.proposed_staff_name %></strong> for your <%= request.service_name %> appointment.</p>
            <p style="color:var(--muted);margin-bottom:.35rem;"><i class="bi bi-calendar3 me-1"></i><%= formatDate(request.booking_date) %> at <%= formatTime(request.booking_time) %></p>
            <p style="color:var(--muted);margin:0;">Reason: <%= request.reason %></p>
          </div>
          <div class="d-flex flex-wrap gap-2 align-items-start">
            <form action="/book/changes/<%= request.change_request_id %>/accept" method="POST"><button class="btn btn-primary btn-sm btn-pill">Accept replacement staff</button></form>
            <form action="/book/changes/<%= request.change_request_id %>/reschedule" method="POST"><button class="btn btn-outline-secondary btn-sm btn-pill">Choose another date/time</button></form>
            <form action="/book/changes/<%= request.change_request_id %>/cancel" method="POST" onsubmit="return confirm('Cancel this booking and receive a 100% refund?');"><button class="btn btn-outline-danger btn-sm btn-pill">Cancel with 100% refund</button></form>
          </div>
        </div>
      </section>
      <% }) %>
    <% } %>

    <% if (waitlistList.length) { %>
      <p class="section-label mb-2"><%= t('bookings.waitlist') %></p>
      <div class="card border-0 mb-4" style="box-shadow:var(--shadow);border-radius:var(--r-xl);overflow:hidden;">
        <% waitlistList.forEach((entry, index) => {
          const waitStatus = waitlistStatusStyles[entry.status] || waitlistStatusStyles.waiting;
          const isActiveWaitlist = ['waiting', 'offered'].includes(entry.status);
          const offerRemainingSeconds = Math.max(0, Number(entry.offer_remaining_seconds || 0));
        %>
        <div class="p-4" style="<%= index ? 'border-top:1px solid var(--border);' : '' %>">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div class="booking-entry-details flex-grow-1">
              <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <h5 style="font-weight:800;color:var(--ink);margin:0;"><%= serviceText(entry, 'name') || entry.service_name %></h5>
                <span class="badge rounded-pill" style="background:<%= waitStatus.bg %>;color:<%= waitStatus.color %>;"><%= waitStatus.label %></span>
                <% if (entry.status === 'waiting') { %>
                <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);">
                  <%= t('bookings.queueNumber', { number: entry.queue_position || 1 }) %>
                </span>
                <% } %>
                <% if (entry.status === 'offered') { %>
                <span class="badge rounded-pill waitlist-offer-timer" data-offer-remaining-seconds="<%= offerRemainingSeconds %>" style="background:var(--accent-light);color:var(--accent);border:1px solid rgba(225,29,72,.2);">
                  <i class="bi bi-hourglass-split me-1"></i><span data-waitlist-countdown>--:--</span> <%= t('bookings.left') %>
                </span>
                <% } %>
              </div>
              <p style="color:var(--muted);margin:0 0 .75rem;">
                <i class="bi bi-shop me-1"></i><%= entry.merchant_name %>
                <% if (entry.merchant_address) { %>
                  <span style="margin-left:.5rem;"><i class="bi bi-geo-alt me-1"></i><%= entry.merchant_address %></span>
                <% } %>
              </p>
              <div class="d-flex flex-wrap gap-3" style="color:var(--ink);font-size:.925rem;font-weight:600;">
                <span><i class="bi bi-calendar3 me-1" style="color:var(--accent);"></i><%= formatDate(entry.booking_date) %></span>
                <span><i class="bi bi-clock me-1" style="color:var(--accent);"></i><%= formatTime(entry.booking_time) %></span>
                <span><i class="bi bi-list-ol me-1" style="color:var(--accent);"></i><%= entry.status === 'waiting' ? t('bookings.position', { number: entry.queue_position || 1 }) : waitStatus.label %></span>
              </div>
            </div>
            <div class="booking-entry-actions">
              <% if (entry.status === 'offered' && entry.confirmed_booking_id) { %>
              <a href="/payment/checkout/<%= entry.confirmed_booking_id %>" class="btn btn-primary btn-sm btn-pill mb-2">
                <i class="bi bi-credit-card me-1"></i><%= t('notifications.actions.makePayment', {}, 'Make payment') %>
              </a>
              <% } else if (entry.status === 'offered') { %>
              <form action="/book/waitlist/<%= entry.waitlist_id %>/confirm" method="POST" class="mb-2">
                <button class="btn btn-primary btn-sm btn-pill">
                  <i class="bi bi-check2-circle me-1"></i><%= t('bookings.confirmSlot') %>
                </button>
              </form>
              <% } %>
              <% if (isActiveWaitlist) { %>
              <form
                action="/book/waitlist/<%= entry.waitlist_id %>/cancel"
                method="POST"
                class="js-cancel-confirm-form"
                data-confirm-first="<%= t('bookings.cancelWaitlistConfirm') %>"
                data-confirm-second="<%= t('bookings.cancelWaitlistSecondConfirm') %>"
              >
                <button class="btn btn-outline-danger btn-sm btn-pill">
                  <i class="bi bi-x-circle me-1"></i><%= t('bookings.cancelWaitlist') %>
                </button>
              </form>
              <% } else if (entry.confirmed_booking_id) { %>
              <span class="badge rounded-pill" style="background:var(--success-bg);color:var(--success);"><%= t('bookings.bookingNumber', { number: entry.confirmed_booking_id }) %></span>
              <% } %>
            </div>
          </div>
        </div>
        <% }) %>
      </div>
    <% } %>

    <% if (!bookingList.length && !waitlistList.length) { %>
      <div class="card border-0 text-center" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:3rem 1.5rem;">
        <div style="width:64px;height:64px;border-radius:999px;background:var(--accent-light);color:var(--accent);display:inline-flex;align-items:center;justify-content:center;font-size:1.75rem;margin-bottom:1rem;">
          <i class="bi bi-calendar2-heart"></i>
        </div>
        <h5 style="font-weight:800;color:var(--ink);"><%= t('bookings.noBookingsTitle') %></h5>
        <p style="color:var(--muted);margin:0 auto 1.25rem;max-width:420px;"><%= t('bookings.noBookingsBody') %></p>
        <a href="/#marketplace" class="btn btn-outline-secondary btn-pill"><%= t('bookings.exploreMerchants') %></a>
      </div>
    <% } else if (bookingList.length) { %>
      <p class="section-label mb-2"><%= t('bookings.history') %></p>
      <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);overflow:hidden;">
        <% displayBookings.forEach((booking, index) => {
          const sectionIndex = index;
          const bookingStatus = effectiveStatus(booking);
          const canContinuePayment = bookingStatus === 'pending_payment';
          const isPast = new Date(booking.booking_date) < new Date(new Date().toDateString());
          const canManage = !isPast && !['pending_payment', 'cancelled', 'payment_failed', 'completed', 'no_show'].includes(bookingStatus);
        %>
          <div id="booking-<%= booking.booking_id %>" class="p-4 booking-entry <%= isPast ? 'is-past' : '' %>" <%= booking.status === 'pending_payment' ? 'data-pending-payment-entry' : '' %> style="<%= sectionIndex ? 'border-top:1px solid var(--border);' : '' %>">
            <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
              <div class="booking-entry-details flex-grow-1">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                  <h5 style="font-weight:800;color:var(--ink);margin:0;"><%= serviceText(booking, 'name') || booking.service_name %></h5>
                  <span class="badge rounded-pill booking-time-badge <%= isPast ? 'is-past' : '' %>"><%= t('bookings.upcoming') %></span>
                  <% if (canContinuePayment) { %>
                    <span class="badge rounded-pill pending-payment-timer" data-expires-at="<%= pendingExpiryIso(booking) %>" data-remaining-seconds="<%= pendingRemainingSeconds(booking) %>" style="background:var(--accent-light);color:var(--accent);border:1px solid rgba(225,29,72,.2);">
                      <i class="bi bi-hourglass-split me-1"></i><span data-countdown>--:--</span> <%= t('bookings.left') %>
                    </span>
                  <% } %>
                </div>
                <p style="color:var(--muted);margin:0 0 .75rem;">
                  <i class="bi bi-shop me-1"></i><%= booking.merchant_name %>
                  <% if (booking.merchant_address) { %>
                    <span style="margin-left:.5rem;"><i class="bi bi-geo-alt me-1"></i><%= booking.merchant_address %></span>
                  <% } %>
                </p>
                <div class="d-flex flex-wrap gap-3" style="color:var(--ink);font-size:.925rem;font-weight:600;">
                  <span><i class="bi bi-calendar3 me-1" style="color:var(--accent);"></i><%= formatDate(booking.booking_date) %></span>
                  <span><i class="bi bi-clock me-1" style="color:var(--accent);"></i><%= formatTime(booking.booking_time) %></span>
                  <span><i class="bi bi-person-badge me-1" style="color:var(--accent);"></i><%= booking.staff_name || t('bookings.anyAvailableStaff') %></span>
                  <span><i class="bi bi-hourglass-split me-1" style="color:var(--accent);"></i><%= t('bookings.mins', { count: booking.duration_mins || 60 }) %></span>
                </div>
                <% if (canManage) { %>
                <div class="mt-3" style="display:flex;flex-wrap:wrap;align-items:center;gap:.75rem 1rem;">
                  <p style="color:var(--ink);font-size:.875rem;font-weight:800;margin:0;">
                    <%= t('bookings.reschedulePolicyShort') %>
                  </p>
                  <span
                    class="badge rounded-pill cancellation-policy-timer"
                    data-deadline-at="<%= cancellationDeadlineIso(booking) %>"
                    data-starts-at="<%= bookingStartDate(booking) ? bookingStartDate(booking).toISOString() : '' %>"
                    style="background:<%= refundPercentageForBooking(booking) > 0 ? 'var(--accent-light)' : 'var(--danger-bg)' %>;color:<%= refundPercentageForBooking(booking) > 0 ? 'var(--accent)' : 'var(--danger)' %>;"
                  >
                    <i class="bi bi-hourglass-split me-1"></i>
                    <span data-cancel-countdown><%= t('bookings.currentRefund', { refund: refundPercentageForBooking(booking).toFixed(0) }) %></span>
                  </span>
                </div>
                <% } %>
              </div>

              <div class="booking-entry-actions">
                <p style="color:var(--muted);font-size:.8rem;margin:0;"><%= t('bookings.total') %></p>
                <p style="color:var(--ink);font-weight:800;font-size:1.2rem;margin:0 0 .75rem;">S$<%= Number(booking.payable_amount || booking.total_amount || 0).toFixed(2) %></p>
                <% if (canContinuePayment) { %>
                  <a href="/payment/checkout/<%= booking.booking_id %>" class="btn btn-primary btn-sm btn-pill" data-payment-action><%= t('bookings.continuePayment') %></a>
                <% } else if (bookingStatus !== 'payment_failed' && booking.payment_status === 'paid') { %>
                  <div class="d-flex flex-column gap-2 align-items-end">
                    <a href="/payment/receipt/<%= booking.booking_id %>.pdf" class="btn btn-outline-secondary btn-sm btn-pill" download>
                      <i class="bi bi-download me-1"></i><%= t('bookings.downloadReceipt') %>
                    </a>
                  </div>
                <% } else { %>
                  <span class="badge rounded-pill" style="background:var(--canvas);color:var(--muted);border:1px solid var(--border);"><%= t('bookings.receiptUnavailable') %></span>
                <% } %>
                <% if (canManage) { %>
                  <div class="d-flex flex-wrap gap-2 justify-content-end mt-2">
                    <% if (canRescheduleBooking(booking)) { %>
                    <a href="/book/<%= booking.booking_id %>/reschedule" class="btn btn-outline-secondary btn-sm btn-pill">
                      <i class="bi bi-calendar-event me-1"></i><%= t('bookings.reschedule') %>
                    </a>
                    <% } %>
                    <%
                      const cancelRefundPercent = refundPercentageForBooking(booking);
                      const cancelSecondConfirm = t('bookings.cancelBookingRefundConfirm', {
                        refund: cancelRefundPercent.toFixed(0)
                      });
                    %>
                    <form
                      action="/book/<%= booking.booking_id %>/cancel"
                      method="POST"
                      class="js-cancel-confirm-form"
                      data-confirm-second="<%= cancelSecondConfirm %>"
                      data-policy-detail="<%= [
                        t('bookings.cancelPolicyText', { hours: 24, refund: 95 }),
                        t('bookings.cancelPolicyPartialText', { hours: 6, refund: 50 }),
                        t('bookings.cancelPolicyLateText')
                      ].join('\n') %>"
                    >
                      <button type="submit" class="btn btn-outline-danger btn-sm btn-pill" data-cancel-button>
                        <i class="bi bi-x-circle me-1"></i><%= t('bookings.cancel') %>
                      </button>
                    </form>
                  </div>
                <% } else { %>
                  <div class="d-flex flex-wrap gap-2 justify-content-end mt-2">
                    <% if (booking.status === 'completed') { %>
                      <% if (!booking.merchant_review_id) { %>
                      <a href="/book/<%= booking.booking_id %>/review" class="btn btn-primary btn-sm btn-pill">
                        <i class="bi bi-star me-1"></i><%= t('bookings.leaveReview') %>
                      </a>
                      <% } else { %>
                      <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);">
                        <i class="bi bi-star-fill me-1"></i><%= t('bookings.reviewed') %>
                      </span>
                      <% } %>
                    <% } %>
                    <a href="/book/<%= booking.booking_id %>/rebook" class="btn btn-outline-primary btn-sm btn-pill mt-2">
                      <i class="bi bi-arrow-clockwise me-1"></i><%= t('bookings.bookAgain') %>
                    </a>
                  </div>
                <% } %>
                </div>
                <% if (bookingStatus === 'cancelled') { %>
                  <div class="mt-3 rounded-xl p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>
                      <%= booking.cancelled_by === 'merchant' ? 'Cancelled by merchant' : (booking.cancelled_by === 'customer' ? 'Cancelled by you' : 'Booking cancelled') %>
                    </strong>
                    <% if (booking.cancellation_reason) { %>
                      <span> — <%= booking.cancellation_reason %></span>
                    <% } %>
                  </div>
                <% } %>
              </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<div class="booking-confirm-overlay" id="bookingCancelConfirm" role="dialog" aria-modal="true" aria-labelledby="bookingCancelConfirmTitle" aria-hidden="true">
  <div class="booking-confirm-dialog">
    <div class="booking-confirm-icon"><i class="bi bi-exclamation-triangle"></i></div>
    <h5 class="booking-confirm-title" id="bookingCancelConfirmTitle"><%= t('bookings.confirmCancellationTitle') %></h5>
    <p class="booking-confirm-message" id="bookingCancelConfirmMessage"></p>
    <div class="booking-confirm-policy" id="bookingCancelConfirmPolicy"></div>
    <div class="booking-confirm-actions">
      <button type="button" class="btn btn-outline-secondary btn-pill" id="bookingCancelConfirmNo"><%= t('bookings.keepBooking') %></button>
      <button type="button" class="btn btn-danger btn-pill" id="bookingCancelConfirmYes"><%= t('bookings.yesProceed') %></button>
    </div>
  </div>
</div>

<script>
  (() => {
    const flashes = Array.from(document.querySelectorAll('[data-auto-dismiss-flash]'));
    if (!flashes.length) return;

    const url = new URL(window.location.href);
    let changed = false;
    ['success', 'error'].forEach(key => {
      if (url.searchParams.has(key)) {
        url.searchParams.delete(key);
        changed = true;
      }
    });
    if (changed) {
      window.history.replaceState({}, '', url.pathname + url.search + url.hash);
    }

    window.setTimeout(() => {
      flashes.forEach(flash => {
        flash.style.opacity = '0';
        flash.style.transform = 'translateY(-6px)';
        window.setTimeout(() => flash.remove(), 260);
      });
    }, 3500);
  })();

  (() => {
    const confirmCopy = <%- JSON.stringify({
      fallbackMessage: t('bookings.cancelGenericConfirm')
    }).replace(/</g, '\\u003c') %>;
    const modal = document.getElementById('bookingCancelConfirm');
    const messageEl = document.getElementById('bookingCancelConfirmMessage');
    const policyEl = document.getElementById('bookingCancelConfirmPolicy');
    const cancelBtn = document.getElementById('bookingCancelConfirmNo');
    const confirmBtn = document.getElementById('bookingCancelConfirmYes');
    let pendingForm = null;
    let pendingMessages = [];
    let pendingIndex = 0;

    if (!modal || !messageEl || !policyEl || !cancelBtn || !confirmBtn) return;

    function closeModal() {
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      pendingForm = null;
      pendingMessages = [];
      pendingIndex = 0;
    }

    function showMessage() {
      messageEl.textContent = pendingMessages[pendingIndex] || confirmCopy.fallbackMessage;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
      confirmBtn.focus();
    }

    function openModal(form, messages) {
      pendingForm = form;
      pendingMessages = messages.filter(Boolean);
      pendingIndex = 0;
      const policyDetail = String(form.dataset.policyDetail || '').trim();
      policyEl.innerHTML = '';
      policyEl.classList.toggle('is-visible', Boolean(policyDetail));
      if (policyDetail) {
        policyDetail.split('\n').forEach(line => {
          const row = document.createElement('div');
          row.textContent = line;
          policyEl.appendChild(row);
        });
      }
      showMessage();
    }

    cancelBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', event => {
      if (event.target === modal) closeModal();
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && modal.classList.contains('is-open')) closeModal();
    });
    confirmBtn.addEventListener('click', () => {
      if (!pendingForm) return closeModal();
      pendingIndex += 1;
      if (pendingIndex < pendingMessages.length) {
        showMessage();
        return;
      }
      const form = pendingForm;
      closeModal();
      form.dataset.confirmed = '1';
      form.submit();
    });

    document.querySelectorAll('.js-cancel-confirm-form').forEach(form => {
      form.addEventListener('submit', event => {
        if (form.dataset.confirmed === '1') return;
        const firstMessage = form.dataset.confirmFirst || '';
        const secondMessage = form.dataset.confirmSecond || confirmCopy.fallbackMessage;

        event.preventDefault();
        openModal(form, [firstMessage, secondMessage]);
      });
    });
  })();

  (() => {
    const targetId = window.location.hash ? window.location.hash.slice(1) : '';
    if (!targetId || !targetId.startsWith('booking-')) return;

    window.setTimeout(() => {
      const target = document.getElementById(targetId);
      if (!target) return;
      target.scrollIntoView({ behavior: 'smooth', block: 'center' });
      target.classList.add('is-targeted');
      window.setTimeout(() => target.classList.remove('is-targeted'), 2800);
    }, 80);
  })();

  (() => {
    const timers = Array.from(document.querySelectorAll('.waitlist-offer-timer'));
    if (!timers.length) return;

    const render = () => {
      timers.forEach(timer => {
        const output = timer.querySelector('[data-waitlist-countdown]');
        if (!timer.dataset.startedAt) {
          timer.dataset.startedAt = String(Date.now());
        }
        const initialRemaining = Number(timer.dataset.offerRemainingSeconds || 0) * 1000;
        const elapsed = Date.now() - Number(timer.dataset.startedAt || Date.now());
        const remaining = Math.max(0, initialRemaining - elapsed);

        if (!remaining) {
          if (output) output.textContent = window.t('bookings.expired');
          timer.style.background = 'var(--danger-bg)';
          timer.style.color = 'var(--danger)';
          return;
        }

        const totalSeconds = Math.ceil(remaining / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = String(totalSeconds % 60).padStart(2, '0');
        if (output) output.textContent = `${minutes}:${seconds}`;
      });
    };

    render();
    setInterval(render, 1000);
  })();

  (() => {
    const timers = Array.from(document.querySelectorAll('.pending-payment-timer'));
    if (!timers.length) return;
    let reloadScheduled = false;

    const render = () => {
      timers.forEach(timer => {
        const output = timer.querySelector('[data-countdown]');
        if (!timer.dataset.startedAt) {
          timer.dataset.startedAt = String(Date.now());
        }
        const initialRemaining = Number(timer.dataset.remainingSeconds || 0) * 1000;
        const elapsed = Date.now() - Number(timer.dataset.startedAt || Date.now());
        const remaining = Math.max(0, initialRemaining - elapsed);
        const totalSeconds = Math.ceil(remaining / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = String(totalSeconds % 60).padStart(2, '0');

        if (output) output.textContent = `${minutes}:${seconds}`;
        if (totalSeconds <= 60) {
          timer.style.background = 'var(--danger-bg)';
          timer.style.color = 'var(--danger)';
          timer.style.borderColor = 'rgba(225,29,72,.25)';
        }
        if (!remaining) {
          const entry = timer.closest('[data-pending-payment-entry]');
          const paymentAction = entry ? entry.querySelector('[data-payment-action]') : null;

          if (paymentAction) paymentAction.remove();
          timer.innerHTML = '<i class="bi bi-hourglass-bottom me-1"></i>' + window.t('bookings.expired');
          if (!reloadScheduled) {
            reloadScheduled = true;
            setTimeout(() => window.location.reload(), 1500);
          }
        }
      });
    };

    render();
    setInterval(render, 1000);
  })();

  (() => {
    const timers = Array.from(document.querySelectorAll('.cancellation-policy-timer'));
    if (!timers.length) return;

    const currentRefundPercentage = timer => {
      const startsAt = new Date(timer.dataset.startsAt || '').getTime();
      if (Number.isNaN(startsAt)) return 0;
      const hoursUntil = (startsAt - Date.now()) / 3600000;
      return hoursUntil > 24 ? 95 : (hoursUntil >= 6 ? 50 : 0);
    };

    const render = () => {
      timers.forEach(timer => {
        const output = timer.querySelector('[data-cancel-countdown]');
        const refund = currentRefundPercentage(timer);

        if (output) output.textContent = window.t('bookings.currentRefund', { refund: String(Math.round(refund)) });
        if (refund <= 0) {
          timer.style.background = 'var(--danger-bg)';
          timer.style.color = 'var(--danger)';
          return;
        }

        timer.style.background = 'var(--accent-light)';
        timer.style.color = 'var(--accent)';
      });
    };

    render();
    setInterval(render, 60000);
  })();
</script>

<%- include('../partials/footer') %>
