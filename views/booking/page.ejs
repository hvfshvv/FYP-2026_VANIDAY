<% locals.hideCatNav = true %>
<%
  const state = typeof formState !== 'undefined' && formState ? formState : {};
  const loggedInCustomer = typeof user !== 'undefined' && user && user.role === 'customer';
  const selectedServiceId = state.service_id || '';
  const selectedDate = state.booking_date || '';
  const selectedBookingTime = state.booking_time ? String(state.booking_time).slice(0,5) : '';
  const selectedStaffId = state.staff_id || '';
  const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  }[char]));
%>
<%- include('../partials/header') %>

<div class="container py-4 booking-shell">
  <div class="booking-top-actions">
    <a href="/book/viewBookings" class="btn btn-outline-secondary btn-pill">
      <i class="bi bi-clock-history me-1"></i><%= t('booking.myBookings') %>
    </a>
  </div>

  <!-- Merchant Banner -->
  <div class="booking-merchant-hero">
    <div class="booking-merchant-main">
      <div class="booking-merchant-icon">
        <i class="bi bi-shop" style="font-size:1.4rem;color:#fff;"></i>
      </div>
      <div>
        <h4><%= qr.merchant_name %></h4>
        <p><i class="bi bi-geo-alt me-1"></i><%= qr.address || t('common.singapore') %></p>
      </div>
    </div>
    <span class="booking-qr-badge">
      <i class="bi bi-qr-code me-1"></i><%= t('booking.qrScanBooking') %>
    </span>
  </div>

  <div id="mobile-summary-bar" class="mobile-summary-bar" style="display:none!important;">
    <span id="msb-service">—</span>
    <span id="msb-price" class="msb-price">—</span>
  </div>

  <% if (error) { %>
  <div class="rounded-xl p-3 mb-4" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i><%= error %>
  </div>
  <% } %>

  <div class="row g-4 booking-layout">

    <!-- LEFT: Booking Wizard -->
    <div class="col-lg-8">

      <!-- Step Indicator -->
      <div class="step-indicator mb-4">
        <div class="step-item">
          <div class="step-bubble active" id="bubble-1">1</div>
          <div class="step-label active" id="label-1"><%= t('booking.steps.service') %></div>
        </div>
        <div class="step-line" id="line-1"></div>
        <div class="step-item">
          <div class="step-bubble" id="bubble-2">2</div>
          <div class="step-label" id="label-2"><%= t('booking.steps.dateTime') %></div>
        </div>
        <div class="step-line" id="line-2"></div>
        <div class="step-item">
          <div class="step-bubble" id="bubble-3">3</div>
          <div class="step-label" id="label-3"><%= t('booking.steps.details') %></div>
        </div>
      </div>

      <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="card-body p-4">
<form action="/book/<%= qr.qr_token %>/confirm" method="POST" id="bookingForm">
            <input type="hidden" name="service_id" id="hidden_service_id" />
            <input type="hidden" name="booking_time" id="hidden_booking_time" />
            <input type="hidden" id="merchant_id" value="<%= qr.merchant_id %>" />

            <!-- STEP 1 -->
            <div class="step-panel active" id="step-1">
              <h5 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;"><%= t('booking.chooseService') %></h5>
              <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.5rem;"><%= t('booking.chooseServiceHint') %></p>

              <div id="qrServiceSelection">
              <% services.forEach(s => { %>
              <div class="service-card"
                data-service-id="<%= s.service_id %>"
                data-service-name="<%= serviceText(s, 'name') %>"
                data-price="<%= s.price %>"
                data-duration="<%= s.duration_mins %>"
                data-selected="<%= String(s.service_id) === String(selectedServiceId) ? '1' : '0' %>"
                onclick="selectService(this)">
                <div>
                  <p style="font-weight:700;margin-bottom:.1rem;color:var(--ink);"><%= serviceText(s, 'name') %></p>
                  <small style="color:var(--muted);"><i class="bi bi-clock me-1"></i><%= t('common.minutes', { count: s.duration_mins }) %></small>
                  <% if (s.description) { %>
                  <br/><small style="color:var(--muted);"><%= serviceText(s, 'description') %></small>
                  <% } %>
                </div>
                <div class="text-end">
                  <div class="price">S$<%= Number(s.price).toFixed(2) %></div>
                  <i class="bi bi-check-circle-fill check-icon" style="display:none;color:var(--accent);"></i>
                </div>
              </div>
              <% }) %>
              </div>

              <div id="step1-error" style="display:none;color:var(--danger);font-size:.8125rem;margin-top:.75rem;">
                <i class="bi bi-exclamation-circle me-1"></i><%= t('booking.selectServiceError') %>
              </div>
              <button type="button" class="btn btn-primary btn-pill w-100 mt-4" style="font-weight:700;" onclick="nextStep(1)">
                <%= t('common.continue') %> <i class="bi bi-arrow-right ms-1"></i>
              </button>
            </div>

            <!-- STEP 2 -->
            <div class="step-panel" id="step-2">
              <h5 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;"><%= t('booking.pickDateTime') %></h5>
              <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.5rem;"><%= t('booking.pickDateTimeHint') %></p>

              <div class="mb-4">
                <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('common.date') %></label>
                <input type="date" name="booking_date" id="booking_date" class="form-control rounded-xl"
                  min="<%= new Date().toISOString().slice(0,10) %>" value="<%= selectedDate %>" required onchange="validateBookingDate(); updateAvailableTimes(); updateSummary(); updateAuthLinks()" />
              </div>

              <div class="mb-3">
                <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('booking.availableTimes') %></label>
                <div class="time-grid">
                  <div class="time-empty" id="time-empty" style="grid-column:1/-1;color:var(--muted);font-size:.875rem;padding:.75rem;border:1px dashed var(--border);border-radius:var(--r);text-align:center;">
                    <%= t('booking.selectDateForTimes') %>
                  </div>
                </div>
                <div id="step2-error" style="display:none;color:var(--danger);font-size:.8125rem;margin-top:.75rem;">
                  <i class="bi bi-exclamation-circle me-1"></i><%= t('booking.pickDateTimeError') %>
                </div>
              </div>

              <div class="mb-3">
                <label class="form-label" style="font-weight:600;font-size:.875rem;">
                  <%= t('booking.selectStaff') %> <span style="color:var(--muted);font-weight:400;">(<%= t('booking.optional') %>)</span>
                </label>
                <div class="row g-2" id="staffOptionsGrid">
                  <div class="col-12">
                    <div class="time-empty" style="color:var(--muted);font-size:.875rem;padding:.75rem;border:1px dashed var(--border);border-radius:var(--r);text-align:center;">
                      <%= t('booking.pickTimeForStaff') %>
                    </div>
                  </div>
                </div>
                <p id="staffAvailabilityNote" class="small mt-2 mb-0" style="color:var(--muted);">
                  <%= t('booking.staffAvailabilityInitial') %>
                </p>
              </div>

              <div class="d-flex gap-2 mt-4">
                <button type="button" class="btn btn-outline-secondary btn-pill w-50" style="font-weight:600;" onclick="prevStep(2)">
                  <i class="bi bi-arrow-left me-1"></i><%= t('common.back') %>
                </button>
                <button type="button" class="btn btn-primary btn-pill w-50" style="font-weight:700;" onclick="nextStep(2)">
                  <%= t('common.continue') %> <i class="bi bi-arrow-right ms-1"></i>
                </button>
              </div>
            </div>

            <!-- STEP 3 -->
            <div class="step-panel" id="step-3">
              <h5 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;"><%= t('booking.details') %></h5>
              <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.5rem;">
                <% if (loggedInCustomer) { %>
                <i class="bi bi-person-check-fill me-1" style="color:var(--success);"></i>
                <%- t('booking.loggedInAs', { name: '<strong>' + escapeHtml(user.full_name) + '</strong>' }) %>
                <% } else { %>
                <%= t('booking.guestHint') %>
                <% } %>
              </p>

              <% if (!loggedInCustomer) { %>
              <div class="p-3 rounded-xl mb-3" style="background:var(--accent-light);border:1.5px solid rgba(225,29,72,.15);">
                <p style="font-weight:700;color:var(--accent);font-size:.875rem;margin-bottom:.35rem;">
                  <i class="bi bi-stars me-1"></i><%= t('booking.memberBenefits') %>
                </p>
                <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.75rem;"><%= t('booking.guestBenefits') %></p>
                <div class="d-flex flex-column gap-2">
                  <label style="font-size:.875rem;color:var(--ink);font-weight:600;">
                    <input type="radio" name="booking_mode" value="guest" <%= state.booking_mode !== 'register' ? 'checked' : '' %> />
                    <%= t('booking.continueGuest') %>
                  </label>
                  <label style="font-size:.875rem;color:var(--ink);font-weight:600;">
                    <input type="radio" name="booking_mode" value="register" <%= state.booking_mode === 'register' ? 'checked' : '' %> />
                    <%= t('booking.createAccountBeforePayment') %>
                  </label>
                </div>
                <div class="d-flex flex-wrap gap-2 mt-3">
                  <a href="<%= loginUrl %>" id="loginForPointsLink" class="btn btn-outline-secondary btn-sm btn-pill">
                    <i class="bi bi-box-arrow-in-right me-1"></i><%= t('booking.loginForPoints') %>
                  </a>
                  <a href="<%= registerUrl %>" id="registerForPointsLink" class="btn btn-outline-secondary btn-sm btn-pill">
                    <i class="bi bi-person-plus me-1"></i><%= t('booking.register') %>
                  </a>
                </div>
              </div>
              <div id="member-email-warning" class="rounded-xl p-3 mb-3" style="display:none;background:var(--warn-bg);color:var(--warn);font-size:.875rem;">
                <i class="bi bi-exclamation-circle me-2"></i>
                <%= t('booking.emailRegistered') %>
              </div>
              <% } %>

              <div class="mb-3">
                <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('booking.fullName') %></label>
                <input type="text" name="full_name" class="form-control rounded-xl"
                  placeholder="<%= t('booking.fullNamePlaceholder') %>"
                  value="<%= loggedInCustomer ? user.full_name : (state.full_name || '') %>" required />
              </div>
              <div class="mb-3">
                <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('booking.phoneNumber') %></label>
                <div class="input-group">
                  <span class="input-group-text"><i class="bi bi-telephone me-1"></i>+65</span>
                  <input type="text" name="phone" class="form-control" placeholder="<%= t('booking.phonePlaceholder') %>"
                    value="<%= loggedInCustomer && user.phone ? user.phone.replace('+65','').trim() : (state.phone || '') %>" required />
                </div>
              </div>
              <div class="mb-4">
                <label class="form-label" style="font-weight:600;font-size:.875rem;">
                  <%= t('booking.email') %> <span style="color:var(--muted);font-weight:400;font-size:.8125rem;">(<%= t('booking.emailHelp') %>)</span>
                </label>
                <input type="email" name="email" id="booking_email" class="form-control rounded-xl"
                  placeholder="<%= t('booking.emailPlaceholder') %>"
                  value="<%= loggedInCustomer ? user.email : (state.email || '') %>" <%= loggedInCustomer ? 'readonly' : '' %> required />
                <% if (loggedInCustomer) { %>
                <p style="color:var(--muted);font-size:.75rem;margin:.4rem 0 0;"><%= t('booking.memberEmailLocked') %></p>
                <% } %>
              </div>

              <!-- Booking summary before submit -->
              <div class="p-3 rounded-xl mb-4" style="background:var(--accent-light);border:1.5px solid rgba(225,29,72,.15);">
                <p style="font-weight:700;font-size:.8125rem;color:var(--accent);margin-bottom:.75rem;">
                  <i class="bi bi-calendar-check me-1"></i><%= t('booking.bookingSummary') %>
                </p>
                <div class="summary-row"><span class="lbl"><%= t('common.service') %></span><span class="val" id="confirm-service" style="font-weight:700;">-</span></div>
                <div class="summary-row"><span class="lbl"><%= t('common.date') %></span><span class="val" id="confirm-date">-</span></div>
                <div class="summary-row"><span class="lbl"><%= t('common.time') %></span><span class="val" id="confirm-time">-</span></div>
                <div class="summary-row"><span class="lbl"><%= t('common.staff') %></span><span class="val" id="confirm-staff"><%= t('common.noPreference') %></span></div>
                <div class="summary-row total">
                  <span style="font-weight:700;"><%= t('common.total') %></span>
                  <span style="font-weight:700;color:var(--accent);font-family:var(--font-mono);" id="confirm-price">-</span>
                </div>
              </div>

              <div class="rounded-xl p-3 mb-3" style="background:#fff;border:1px solid var(--border);">
                <div class="d-flex align-items-start justify-content-between gap-2 mb-2">
                  <p class="section-label mb-0"><%= t('bookings.cancellationPolicy') %></p>
                  <a href="/legal/cancellation-refund-policy" target="_blank" rel="noopener" style="color:var(--accent);font-weight:800;font-size:.78rem;">View full policy</a>
                </div>
                <p style="color:var(--muted);font-size:.82rem;margin:0 0 .75rem;">Refunds depend on how early the booking is cancelled.</p>
                <div class="d-flex flex-column gap-2">
                  <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;border:1px solid var(--border);border-radius:var(--r);padding:.75rem;background:var(--surface);">
                    <span style="font-weight:800;color:var(--ink);font-size:.85rem;">More than 24 hours</span>
                    <span style="font-family:var(--font-mono);font-weight:800;color:var(--success);white-space:nowrap;">95% refund</span>
                  </div>
                  <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;border:1px solid var(--border);border-radius:var(--r);padding:.75rem;background:var(--surface);">
                    <span style="font-weight:800;color:var(--ink);font-size:.85rem;">6-24 hours</span>
                    <span style="font-family:var(--font-mono);font-weight:800;color:#c2410c;white-space:nowrap;">50% refund</span>
                  </div>
                  <div style="display:flex;align-items:center;justify-content:space-between;gap:1rem;border:1px solid var(--border);border-radius:var(--r);padding:.75rem;background:var(--surface);">
                    <span style="font-weight:800;color:var(--ink);font-size:.85rem;">Under 6 hours or no-show</span>
                    <span style="font-family:var(--font-mono);font-weight:800;color:var(--danger);white-space:nowrap;">No refund</span>
                  </div>
                </div>
                <p style="color:var(--ink);font-weight:700;margin:.75rem 0 0;font-size:.84rem;">
                  <i class="bi bi-info-circle me-1" style="color:var(--accent);"></i>
                  Rescheduling is allowed until 6 hours before the appointment if needed, subject to merchant availability.
                </p>
              </div>

              <label
                for="qrBookingPolicyAcknowledgement"
                id="qrBookingPolicyAcknowledgementBox"
                class="d-flex align-items-start gap-2 p-3 mb-2"
                style="border:1px solid var(--border);border-radius:var(--r);background:var(--surface);cursor:pointer;transition:border-color .15s, box-shadow .15s, background .15s;"
              >
                <input
                  id="qrBookingPolicyAcknowledgement"
                  name="policy_acknowledged"
                  value="1"
                  type="checkbox"
                  style="width:1.05rem;height:1.05rem;accent-color:var(--accent);flex:0 0 auto;margin-top:.15rem;"
                />
                <span style="color:var(--ink);font-weight:700;font-size:.86rem;line-height:1.45;">
                  I understand and agree to Uniday's cancellation and refund policy for this booking.
                </span>
              </label>
              <p id="qrBookingPolicyAcknowledgementError" class="small mb-4" style="display:none;color:var(--danger);">
                <i class="bi bi-exclamation-circle me-1"></i>Please tick the policy acknowledgement before proceeding to payment.
              </p>

              <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-secondary btn-pill w-50" style="font-weight:600;" onclick="prevStep(3)">
                  <i class="bi bi-arrow-left me-1"></i><%= t('common.back') %>
                </button>
                <button type="submit" class="btn btn-primary btn-pill w-50" style="font-weight:700;">
                  <i class="bi bi-lock me-1"></i><%= t('booking.confirmPay') %>
                </button>
              </div>
            </div>

          </form>
        </div>
      </div>
      <p class="text-center small mt-3" style="color:var(--muted);">
        <i class="bi bi-shield-check me-1" style="color:var(--success);"></i>
        <%= t('booking.securePayment') %>
      </p>
    </div>

    <!-- RIGHT: Live Summary Panel -->
    <div class="col-lg-4 d-none d-lg-block">
      <div style="position:sticky;top:80px;">
        <div class="summary-panel">
          <p style="font-weight:700;color:var(--accent);margin-bottom:1rem;">
            <i class="bi bi-receipt me-2"></i><%= t('booking.bookingSummary') %>
          </p>
          <div class="summary-row">
            <span class="lbl"><%= t('common.merchant') %></span>
            <span class="val"><%= qr.merchant_name %></span>
          </div>
          <div class="summary-row">
            <span class="lbl"><%= t('common.service') %></span>
            <span class="val" id="sum-service" style="color:var(--muted);font-style:italic;"><%= t('common.notSelected') %></span>
          </div>
          <div class="summary-row">
            <span class="lbl"><%= t('common.duration') %></span>
            <span class="val" id="sum-duration" style="color:var(--muted);">—</span>
          </div>
          <div class="summary-row">
            <span class="lbl"><%= t('common.date') %></span>
            <span class="val" id="sum-date" style="color:var(--muted);font-style:italic;"><%= t('common.notSelected') %></span>
          </div>
          <div class="summary-row">
            <span class="lbl"><%= t('common.time') %></span>
            <span class="val" id="sum-time" style="color:var(--muted);">—</span>
          </div>
          <div class="summary-row">
            <span class="lbl"><%= t('common.staff') %></span>
            <span class="val" id="sum-staff" style="color:var(--muted);"><%= t('common.noPreference') %></span>
          </div>
          <div class="summary-row total">
            <span style="font-weight:700;"><%= t('common.total') %></span>
            <span style="font-weight:700;font-size:1.1rem;color:var(--accent);font-family:var(--font-mono);" id="sum-price">—</span>
          </div>
        </div>

        <div class="card border-0 p-3 mt-3" style="box-shadow:var(--shadow-sm);border-radius:var(--r-lg);">
          <p style="font-weight:700;font-size:.875rem;color:var(--ink);margin-bottom:.5rem;">
            <i class="bi bi-info-circle me-1" style="color:var(--accent);"></i><%= t('booking.goodToKnow') %>
          </p>
          <ul style="font-size:.8125rem;color:var(--muted);margin-bottom:0;padding-left:1.25rem;">
            <li><%= t('booking.goodPayment') %></li>
            <li><%= t('booking.goodEmail') %></li>
            <li><%= t('booking.goodCancellation') %></li>
            <li><%= t('booking.goodArrival') %></li>
          </ul>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
let selectedService = null;
let selectedTime    = null;
let selectedStaffId = '';
let selectedStaffName = window.t('common.noPreference');
const initialServiceId = '<%= selectedServiceId %>';
const initialTime = '<%= selectedBookingTime %>';
const initialStaffId = '<%= selectedStaffId %>';
const loggedInCustomer = <%= loggedInCustomer ? 'true' : 'false' %>;
const maxAdvanceBookingDays = 365;
const dateLocale = { en: 'en-SG', ms: 'ms-SG', zh: 'zh-CN', ta: 'ta-IN' }['<%= lang %>'] || 'en-SG';

function pad2(value) {
  return String(value).padStart(2, '0');
}

function localDateValue(date = new Date()) {
  return date.getFullYear() + '-' + pad2(date.getMonth() + 1) + '-' + pad2(date.getDate());
}

function maxBookableDateValue() {
  const maxDate = new Date();
  maxDate.setDate(maxDate.getDate() + maxAdvanceBookingDays);
  return localDateValue(maxDate);
}

function getSelectedDateTime() {
  const date = document.getElementById('booking_date').value;
  if (!date || !selectedTime) return null;
  return new Date(date + 'T' + selectedTime + ':00');
}

function setStep2Error(message) {
  const error = document.getElementById('step2-error');
  error.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>' + message;
  error.style.display = 'block';
}

function clearStep2Error() {
  document.getElementById('step2-error').style.display = 'none';
}

function escapeHtml(value) {
  return String(value || '')
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#39;');
}

function staffOptionTemplate(member, selected = false) {
  const isAnyStaff = !member;
  const value = isAnyStaff ? '' : member.staff_id;
  const name = isAnyStaff ? window.t('common.noPreference') : escapeHtml(member.full_name || window.t('common.staff'));
  const role = !isAnyStaff && member.role
    ? `<span style="font-size:.72rem;color:var(--muted);margin-top:.2rem;">${escapeHtml(member.role)}</span>`
    : '';
  const selectedClass = selected ? ' selected' : '';
  const selectedStyles = selected
    ? 'border-color:var(--accent);background:var(--accent-light);box-shadow:0 0 0 3px var(--accent-mid);'
    : 'border-color:var(--border);background:var(--surface);';

  return `
    <div class="col-md-4 col-6">
      <button
        type="button"
        class="staff-option${selectedClass} d-flex flex-column align-items-center justify-content-center text-center h-100 p-3"
        data-staff-name="${name}"
        onclick="selectStaff(this)"
        style="border:1px solid var(--border);border-radius:var(--r);${selectedStyles}cursor:pointer;min-height:104px;width:100%;transition:border-color .15s, background .15s, box-shadow .15s;"
      >
        <input type="radio" name="staff_id" value="${value}" ${selected ? 'checked' : ''} style="position:absolute;opacity:0;">
        <span style="display:inline-flex;align-items:center;justify-content:center;width:42px;height:42px;border-radius:999px;background:${selected ? '#fff' : 'var(--accent-light)'};color:var(--accent);font-size:1.25rem;margin-bottom:.6rem;">
          <i class="bi bi-person"></i>
        </span>
        <span style="font-weight:700;color:var(--ink);font-size:.82rem;">${name}</span>
        ${role}
      </button>
    </div>
  `;
}

function setStaffSelection(button) {
  document.querySelectorAll('.staff-option').forEach(option => {
    option.classList.remove('selected');
    option.style.borderColor = 'var(--border)';
    option.style.background = 'var(--surface)';
    option.style.boxShadow = 'none';
    const input = option.querySelector('input[name="staff_id"]');
    if (input) input.checked = false;
  });

  button.classList.add('selected');
  button.style.borderColor = 'var(--accent)';
  button.style.background = 'var(--accent-light)';
  button.style.boxShadow = '0 0 0 3px var(--accent-mid)';
  const input = button.querySelector('input[name="staff_id"]');
  if (input) {
    input.checked = true;
    selectedStaffId = input.value;
  }
  selectedStaffName = button.dataset.staffName || window.t('common.noPreference');
}

function selectStaff(button) {
  setStaffSelection(button);
  updateSummary();
  updateAuthLinks();
}

function resetStaffOptions(message = window.t('booking.staffAvailabilityInitial')) {
  selectedStaffId = '';
  selectedStaffName = window.t('common.noPreference');
  const grid = document.getElementById('staffOptionsGrid');
  const note = document.getElementById('staffAvailabilityNote');
  if (grid) {
    grid.innerHTML = `
      <div class="col-12">
        <div class="time-empty" style="color:var(--muted);font-size:.875rem;padding:.75rem;border:1px dashed var(--border);border-radius:var(--r);text-align:center;">
          ${window.t('booking.pickTimeForStaff')}
        </div>
      </div>
    `;
  }
  if (note) {
    note.textContent = message;
    note.style.color = 'var(--muted)';
  }
}

function timePeriodFor(time) {
  const hour = Number(String(time || '00:00').slice(0, 2));
  if (hour < 12) return 'Morning';
  if (hour < 17) return 'Afternoon';
  return 'Evening';
}

function renderTimeSlots(slots) {
  let currentPeriod = '';

  return slots.map(slot => {
    const time = String(slot.start_time).slice(0, 5);
    const label = slot.label || time;
    const period = timePeriodFor(time);
    const heading = period !== currentPeriod
      ? `<div class="time-period-title">${period}</div>`
      : '';
    currentPeriod = period;

    return `${heading}<button type="button" class="time-btn" data-time="${time}" onclick="selectTime(this,'${time}')">${label}</button>`;
  }).join('');
}

function renderStaffOptions(availableStaff) {
  const staff = Array.isArray(availableStaff) ? availableStaff : [];
  const grid = document.getElementById('staffOptionsGrid');
  const note = document.getElementById('staffAvailabilityNote');
  const keepSelected = selectedStaffId && staff.some(member => String(member.staff_id) === String(selectedStaffId));

  if (!grid) return;

  grid.innerHTML = [
    staffOptionTemplate(null, !keepSelected),
    ...staff.map(member => staffOptionTemplate(member, keepSelected && String(member.staff_id) === String(selectedStaffId)))
  ].join('');

  const selectedOption = grid.querySelector('.staff-option.selected') || grid.querySelector('.staff-option');
  if (selectedOption) setStaffSelection(selectedOption);

  if (note) {
    note.textContent = staff.length
      ? window.t('booking.staffAvailable', { count: staff.length, plural: staff.length === 1 ? '' : 's' })
      : window.t('booking.staffFallback');
    note.style.color = staff.length ? 'var(--muted)' : 'var(--warn)';
  }

  updateSummary();
}

async function loadAvailableStaff() {
  const date = document.getElementById('booking_date').value;
  const merchantId = document.getElementById('merchant_id').value;

  if (!date || !selectedService || !selectedTime) {
    resetStaffOptions();
    updateSummary();
    return;
  }

  const params = new URLSearchParams({
    merchantId,
    serviceId: selectedService.id,
    bookingDate: date,
    bookingTime: selectedTime,
  });

  try {
    const response = await fetch('/book/api/staff?' + params.toString());
    const availableStaff = await response.json();
    renderStaffOptions(availableStaff);
  } catch (err) {
    console.error(err);
    resetStaffOptions(window.t('booking.validation.unableStaff'));
  }
}

function validateBookingDate() {
  const dateEl = document.getElementById('booking_date');
  const today = localDateValue();
  const maxDate = maxBookableDateValue();
  dateEl.min = today;
  dateEl.max = maxDate;

  if (dateEl.value && dateEl.value < today) {
    dateEl.value = today;
    selectedTime = null;
    document.getElementById('hidden_booking_time').value = '';
    document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('selected'));
    resetStaffOptions();
    setStep2Error(window.t('booking.validation.todayFuture'));
    return false;
  }
  if (dateEl.value && dateEl.value > maxDate) {
    dateEl.value = maxDate;
    selectedTime = null;
    document.getElementById('hidden_booking_time').value = '';
    document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('selected'));
    resetStaffOptions();
    setStep2Error('Bookings can only be made within the next 12 months.');
    return false;
  }
  return true;
}

async function updateAvailableTimes() {
  const date = document.getElementById('booking_date').value;
  const grid = document.querySelector('.time-grid');
  const merchantId = document.getElementById('merchant_id').value;

  selectedTime = null;
  document.getElementById('hidden_booking_time').value = '';
  resetStaffOptions();
  updateSummary();

  if (!date || !selectedService) {
    grid.innerHTML = '<div class="time-empty" style="grid-column:1/-1;color:var(--muted);font-size:.875rem;padding:.75rem;border:1px dashed var(--border);border-radius:var(--r);text-align:center;">' + window.t('booking.selectDateForTimes') + '</div>';
    return;
  }

  grid.innerHTML = '<div class="time-loading"><div class="time-loading-spinner"></div>' + window.t('common.loading') + '</div>';

  const params = new URLSearchParams({
    merchantId,
    serviceId: selectedService.id,
    bookingDate: date,
  });

  try {
    const response = await fetch('/book/api/slots?' + params.toString());
    const slots = await response.json();

    const availableSlots = slots.filter(slot => slot.is_available !== false);

    if (!availableSlots.length) {
      grid.innerHTML = '<div class="time-empty" style="grid-column:1/-1;color:var(--muted);font-size:.875rem;padding:.75rem;border:1px dashed var(--border);border-radius:var(--r);text-align:center;">' + window.t('booking.validation.noSlots') + '</div>';
      resetStaffOptions(window.t('booking.validation.noStaffDate'));
      return;
    }

    grid.innerHTML = renderTimeSlots(availableSlots);
  } catch (err) {
    console.error(err);
    grid.innerHTML = '<div class="time-empty" style="grid-column:1/-1;color:var(--danger);font-size:.875rem;padding:.75rem;border:1px dashed var(--border);border-radius:var(--r);text-align:center;">' + window.t('booking.validation.unableTimes') + '</div>';
  }
}

function validateSelectedDateTime() {
  if (!validateBookingDate()) return false;
  if (!document.getElementById('booking_date').value || !selectedTime) {
    setStep2Error(window.t('booking.pickDateTimeError'));
    return false;
  }
  if (getSelectedDateTime() < new Date()) {
    setStep2Error(window.t('booking.validation.futureTime'));
    return false;
  }
  clearStep2Error();
  return true;
}

function selectService(el) {
  document.querySelectorAll('.service-card').forEach(c => {
    c.classList.remove('selected');
    c.querySelector('.check-icon').style.display = 'none';
  });
  el.classList.add('selected');
  el.querySelector('.check-icon').style.display = 'inline';
  selectedService = {
    id:       el.dataset.serviceId,
    name:     el.dataset.serviceName,
    price:    parseFloat(el.dataset.price),
    duration: el.dataset.duration,
  };
  document.getElementById('hidden_service_id').value = selectedService.id;
  const selectionWrap = document.getElementById('qrServiceSelection');
  if (selectionWrap) selectionWrap.classList.add('service-selection-has-choice');
  updateAvailableTimes();
  updateSummary();
  updateAuthLinks();
}

function selectTime(el, time) {
  if (el.classList.contains('disabled')) {
    setStep2Error(window.t('booking.validation.futureTime'));
    return;
  }
  document.querySelectorAll('.time-btn').forEach(b => b.classList.remove('selected'));
  el.classList.add('selected');
  selectedTime = time;
  document.getElementById('hidden_booking_time').value = time;
  clearStep2Error();
  loadAvailableStaff();
  updateSummary();
  updateAuthLinks();
}

function updateMobileSummaryBar() {
  const bar = document.getElementById('mobile-summary-bar');
  if (!bar) return;

  if (!selectedService || window.innerWidth >= 992) {
    bar.style.setProperty('display', 'none', 'important');
    return;
  }

  document.getElementById('msb-service').textContent = selectedService.name;
  document.getElementById('msb-price').textContent   = 'S$' + selectedService.price.toFixed(2);
  bar.style.setProperty('display', 'flex', 'important');
}

function updateSummary() {
  if (selectedService) {
    document.getElementById('sum-service').textContent   = selectedService.name;
    document.getElementById('sum-service').style.cssText = 'font-weight:600;font-style:normal;';
    document.getElementById('sum-duration').textContent  = window.t('common.minutes', { count: selectedService.duration });
    document.getElementById('sum-price').textContent     = 'S$' + selectedService.price.toFixed(2);
    document.getElementById('confirm-service').textContent = selectedService.name;
    document.getElementById('confirm-price').textContent   = 'S$' + selectedService.price.toFixed(2);
  }
  updateMobileSummaryBar();
  const dateEl = document.getElementById('booking_date');
  if (dateEl && dateEl.value) {
    const d = new Date(dateEl.value + 'T00:00:00');
    const fmt = d.toLocaleDateString(dateLocale, { weekday:'short', day:'numeric', month:'short', year:'numeric' });
    document.getElementById('sum-date').textContent     = fmt;
    document.getElementById('sum-date').style.cssText   = 'font-weight:600;font-style:normal;';
    document.getElementById('confirm-date').textContent = fmt;
  }
  if (selectedTime) {
    document.getElementById('sum-time').textContent     = selectedTime;
    document.getElementById('sum-time').style.cssText   = 'font-weight:600;';
    document.getElementById('confirm-time').textContent = selectedTime;
  } else {
    document.getElementById('sum-time').textContent     = '-';
    document.getElementById('sum-time').style.cssText   = 'color:var(--muted);';
    document.getElementById('confirm-time').textContent = '-';
  }

  const staffText = selectedStaffName || window.t('common.noPreference');
  document.getElementById('sum-staff').textContent = staffText;
  document.getElementById('sum-staff').style.cssText = 'font-weight:600;';
  document.getElementById('confirm-staff').textContent = staffText;
}

function updateAuthLinks() {
  const loginLink = document.getElementById('loginForPointsLink');
  const registerLink = document.getElementById('registerForPointsLink');
  if (!loginLink && !registerLink) return;

  const params = new URLSearchParams();
  if (selectedService && selectedService.id) params.set('serviceId', selectedService.id);
  const dateValue = document.getElementById('booking_date').value;
  if (dateValue) params.set('bookingDate', dateValue);
  if (selectedTime) params.set('bookingTime', selectedTime);
  if (selectedStaffId) params.set('staffId', selectedStaffId);

  const next = window.location.pathname + (params.toString() ? '?' + params.toString() : '');
  if (loginLink) loginLink.href = '/auth/login?next=' + encodeURIComponent(next);
  if (registerLink) registerLink.href = '/auth/register?next=' + encodeURIComponent(next);
}

function setStep(n) {
  document.querySelectorAll('.step-panel').forEach(p => p.classList.remove('active'));
  document.getElementById('step-' + n).classList.add('active');
  for (let i = 1; i <= 3; i++) {
    const bubble = document.getElementById('bubble-' + i);
    const label  = document.getElementById('label-' + i);
    bubble.classList.remove('active','done');
    label.classList.remove('active','done');
    if (i < n) {
      bubble.classList.add('done');
      label.classList.add('done');
      bubble.innerHTML = '<i class="bi bi-check-lg"></i>';
    } else if (i === n) {
      bubble.classList.add('active');
      label.classList.add('active');
      bubble.textContent = i;
    } else {
      bubble.textContent = i;
    }
  }
  for (let i = 1; i <= 2; i++) {
    document.getElementById('line-' + i).classList.toggle('done', i < n);
  }
  window.scrollTo({ top: 0, behavior: 'smooth' });
}

function nextStep(current) {
  if (current === 1) {
    if (!selectedService) { document.getElementById('step1-error').style.display = 'block'; return; }
    document.getElementById('step1-error').style.display = 'none';
  }
  if (current === 2) {
    if (!validateSelectedDateTime()) return;
  }
  setStep(current + 1);
}
function prevStep(current) { setStep(current - 1); }

const qrBookingPolicyAcknowledgement = document.getElementById('qrBookingPolicyAcknowledgement');
const qrBookingPolicyAcknowledgementBox = document.getElementById('qrBookingPolicyAcknowledgementBox');
const qrBookingPolicyAcknowledgementError = document.getElementById('qrBookingPolicyAcknowledgementError');

function setQrBookingPolicyErrorState(show) {
  if (qrBookingPolicyAcknowledgementError) {
    qrBookingPolicyAcknowledgementError.style.display = show ? 'block' : 'none';
  }

  if (qrBookingPolicyAcknowledgementBox) {
    qrBookingPolicyAcknowledgementBox.style.borderColor = show ? 'var(--danger)' : 'var(--border)';
    qrBookingPolicyAcknowledgementBox.style.boxShadow = show ? '0 0 0 3px var(--danger-bg)' : 'none';
    qrBookingPolicyAcknowledgementBox.style.background = show ? '#fff' : 'var(--surface)';
  }
}

function requireQrBookingPolicyAccepted() {
  if (!qrBookingPolicyAcknowledgement || qrBookingPolicyAcknowledgement.checked) {
    setQrBookingPolicyErrorState(false);
    return true;
  }

  setQrBookingPolicyErrorState(true);
  if (qrBookingPolicyAcknowledgementBox) {
    qrBookingPolicyAcknowledgementBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  qrBookingPolicyAcknowledgement.focus({ preventScroll: true });
  return false;
}

if (qrBookingPolicyAcknowledgement) {
  qrBookingPolicyAcknowledgement.addEventListener('change', () => {
    if (qrBookingPolicyAcknowledgement.checked) setQrBookingPolicyErrorState(false);
  });
}

const initialServiceCard = initialServiceId
  ? document.querySelector('.service-card[data-service-id="' + initialServiceId + '"]')
  : document.querySelector('.service-card[data-selected="1"]');

if (initialServiceCard) {
  selectService(initialServiceCard);
}

validateBookingDate();
updateAvailableTimes().then(() => {
  if (!initialTime) return;
  const initialTimeButton = document.querySelector('.time-btn[data-time="' + initialTime + '"]');
  if (initialTimeButton) {
    selectedStaffId = initialStaffId;
    selectTime(initialTimeButton, initialTime);
  }
});

const emailInput = document.getElementById('booking_email');
if (emailInput && !loggedInCustomer) {
  let emailCheckTimer = null;
  emailInput.addEventListener('input', function() {
    clearTimeout(emailCheckTimer);
    const warning = document.getElementById('member-email-warning');
    if (warning) warning.style.display = 'none';

    emailCheckTimer = setTimeout(async () => {
      if (!emailInput.value || !emailInput.checkValidity()) return;
      try {
        const response = await fetch('/book/api/email-member?email=' + encodeURIComponent(emailInput.value));
        const result = await response.json();
        if (result.exists && result.isCustomer && warning) {
          warning.style.display = 'block';
        }
      } catch (err) {
        console.error(err);
      }
    }, 350);
  });
}

window.addEventListener('resize', updateMobileSummaryBar);

document.getElementById('bookingForm').addEventListener('submit', function(event) {
  if (!validateSelectedDateTime()) {
    event.preventDefault();
    setStep(2);
    return;
  }

  if (!requireQrBookingPolicyAccepted()) {
    event.preventDefault();
    setStep(3);
  }
});
</script>

