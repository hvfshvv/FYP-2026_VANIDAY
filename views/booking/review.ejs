<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const values = typeof formValues !== 'undefined' && formValues ? formValues : {};
  const merchantReviewWordLimit = 120;
  const selected = (name, value) => String(values[name] || '') === String(value) ? 'checked' : '';
  const optionSelected = (name, value) => String(values[name] || '') === String(value) ? 'selected' : '';
  const formatDate = value => new Date(value).toLocaleDateString(lang === 'zh' ? 'zh-CN' : (lang === 'ta' ? 'ta-IN' : 'en-SG'), { day: 'numeric', month: 'short', year: 'numeric' });
  const formatTime = value => String(value || '').slice(0, 5);
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:820px;">
    <a href="/book/viewBookings" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
      <i class="bi bi-arrow-left me-1"></i><%= t('review.back') %>
    </a>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
      <div>
        <p class="section-label mb-2"><%= t('review.label') %></p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('review.title') %></h2>
        <p style="color:var(--muted);margin:0;"><%= t('review.subtitle') %></p>
        <span class="d-inline-flex align-items-center gap-2 mt-3 px-3 py-2 rounded-pill" style="background:var(--accent-light);color:var(--accent);font-weight:800;font-size:.875rem;">
          <i class="bi bi-plus-circle"></i> <%= t('review.earn') %>
        </span>
      </div>
    </div>

    <% if (error) { %>
    <div class="rounded-xl p-3 mb-4" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
      <i class="bi bi-exclamation-circle me-2"></i><%= error %>
    </div>
    <% } %>

    <div class="card border-0 mb-4" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="card-body p-4">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;"><%= t('review.completedBooking') %></p>
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:.35rem;"><%= serviceText(booking, 'name') || booking.service_name %></h5>
        <p style="color:var(--muted);margin:0;">
          <i class="bi bi-shop me-1"></i><%= booking.merchant_name %>
          <span class="ms-2"><i class="bi bi-calendar3 me-1"></i><%= formatDate(booking.booking_date) %></span>
          <span class="ms-2"><i class="bi bi-clock me-1"></i><%= formatTime(booking.booking_time) %></span>
        </p>
      </div>
    </div>

    <form action="/book/<%= booking.booking_id %>/review" method="POST" enctype="multipart/form-data">
      <div class="card border-0 mb-4" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="card-body p-4">
          <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;"><%= t('review.merchantReview') %></h5>
          <p style="color:var(--muted);font-size:.875rem;margin-bottom:1rem;"><%= t('review.merchantHint', { merchant: booking.merchant_name }) %></p>

          <div class="rating-choice mb-3" role="radiogroup" aria-label="<%= t('review.merchantRating') %>">
            <% [5,4,3,2,1].forEach(value => { %>
            <input type="radio" id="merchant_rating_<%= value %>" name="merchant_rating" value="<%= value %>" <%= selected('merchant_rating', value) %> required>
            <label for="merchant_rating_<%= value %>" title="<%= t('review.stars', { count: value }) %>"><i class="bi bi-star-fill"></i></label>
            <% }) %>
          </div>

          <textarea
            id="merchant_review_text"
            name="merchant_review_text"
            class="form-control rounded-xl"
            rows="4"
            maxlength="900"
            data-word-limit="<%= merchantReviewWordLimit %>"
            required
            placeholder="<%= t('review.merchantPlaceholder') %>"
          ><%= values.merchant_review_text || '' %></textarea>
          <p id="merchantReviewWordCount" style="color:var(--muted);font-size:.78rem;margin:.45rem 0 0;"><%= t('review.words', { count: 0, limit: merchantReviewWordLimit }) %></p>

          <div class="mt-3">
            <label for="review_image" class="form-label" style="font-weight:800;color:var(--ink);"><%= t('review.photoReview') %></label>
            <input
              type="file"
              id="review_image"
              name="review_image"
              class="form-control rounded-xl"
              accept="image/jpeg,image/png,image/webp"
            >
            <p style="color:var(--muted);font-size:.78rem;margin:.5rem 0 0;"><%= t('review.photoHint') %></p>
          </div>

          <div id="reviewImagePreviewWrap" class="rounded-xl mt-3" style="display:none;background:#111;overflow:hidden;border:1px solid var(--border);">
            <img id="reviewImagePreview" alt="<%= t('review.previewAlt') %>" style="display:block;width:100%;height:min(46vh,420px);object-fit:contain;">
          </div>
        </div>
      </div>

      <div class="card border-0 mb-4" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="card-body p-4">
          <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;"><%= t('review.unidayFeedback') %></h5>
          <p style="color:var(--muted);font-size:.875rem;margin-bottom:1rem;"><%= t('review.unidayHint') %></p>

          <div class="rating-choice mb-3" role="radiogroup" aria-label="<%= t('review.platformRating') %>">
            <% [5,4,3,2,1].forEach(value => { %>
            <input type="radio" id="platform_rating_<%= value %>" name="platform_rating" value="<%= value %>" <%= selected('platform_rating', value) %> required>
            <label for="platform_rating_<%= value %>" title="<%= t('review.stars', { count: value }) %>"><i class="bi bi-star-fill"></i></label>
            <% }) %>
          </div>

          <div class="row g-3">
            <div class="col-md-5">
              <select name="platform_feedback_type" class="form-select rounded-xl">
                <option value="booking_experience" <%= optionSelected('platform_feedback_type', 'booking_experience') %>><%= t('review.bookingExperience') %></option>
                <option value="payment" <%= optionSelected('platform_feedback_type', 'payment') %>><%= t('review.payment') %></option>
                <option value="qr_checkin" <%= optionSelected('platform_feedback_type', 'qr_checkin') %>><%= t('review.qrCheckin') %></option>
                <option value="whatsapp" <%= optionSelected('platform_feedback_type', 'whatsapp') %>><%= t('review.whatsapp') %></option>
                <option value="general" <%= optionSelected('platform_feedback_type', 'general') %>><%= t('review.general') %></option>
              </select>
            </div>
            <div class="col-md-7">
              <textarea
                name="platform_feedback_text"
                class="form-control rounded-xl"
                rows="3"
                maxlength="1000"
                required
                placeholder="<%= t('review.platformPlaceholder') %>"
              ><%= values.platform_feedback_text || '' %></textarea>
            </div>
          </div>
        </div>
      </div>

      <button class="btn btn-primary btn-pill" style="font-weight:800;">
        <i class="bi bi-star me-1"></i><%= t('review.submit') %>
      </button>
    </form>
  </div>
</main>

<style>
  .rating-choice {
    display: inline-flex;
    flex-direction: row-reverse;
    gap: .35rem;
  }
  .rating-choice input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .rating-choice label {
    color: rgba(107, 99, 102, .35);
    cursor: pointer;
    font-size: 1.6rem;
    transition: color .15s, transform .15s;
  }
  .rating-choice label:hover,
  .rating-choice label:hover ~ label,
  .rating-choice input:checked ~ label {
    color: #f59e0b;
  }
  .rating-choice label:hover {
    transform: translateY(-1px);
  }
</style>

<script>
  (() => {
    const input = document.getElementById('review_image');
    const preview = document.getElementById('reviewImagePreview');
    const wrap = document.getElementById('reviewImagePreviewWrap');
    let previewUrl = '';

    if (!input || !preview || !wrap) return;

    input.addEventListener('change', () => {
      if (previewUrl) URL.revokeObjectURL(previewUrl);
      const file = input.files && input.files[0];
      if (!file) {
        preview.removeAttribute('src');
        wrap.style.display = 'none';
        return;
      }
      previewUrl = URL.createObjectURL(file);
      preview.src = previewUrl;
      wrap.style.display = 'block';
    });
  })();

  (() => {
    const textarea = document.getElementById('merchant_review_text');
    const output = document.getElementById('merchantReviewWordCount');
    if (!textarea || !output) return;

    const limit = Number(textarea.dataset.wordLimit || 120);
    const countWords = value => String(value || '').trim().split(/\s+/).filter(Boolean).length;
    const render = () => {
      const count = countWords(textarea.value);
      output.textContent = window.t('review.words', { count, limit });
      output.style.color = count > limit ? 'var(--danger)' : 'var(--muted)';
    };

    textarea.addEventListener('input', render);
    render();
  })();
</script>

<%- include('../partials/footer') %>
