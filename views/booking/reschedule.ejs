<%- include('../partials/header') %>

<%
  function formatDate(value) {
    return new Date(value).toLocaleDateString('en-SG', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  function dateInputValue(value) {
    if (value instanceof Date) {
      const year = value.getFullYear();
      const month = String(value.getMonth() + 1).padStart(2, '0');
      const day = String(value.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    return String(value || '').slice(0, 10);
  }

  function formatTime(value) {
    return String(value || '').slice(0, 5);
  }

  const today = new Date().toISOString().slice(0, 10);
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:720px;">
    <div class="mb-4">
      <a href="/book/viewBookings" class="text-decoration-none" style="color:var(--muted);font-weight:700;font-size:.875rem;">
        <i class="bi bi-arrow-left me-1"></i>Back to bookings
      </a>
      <p class="section-label mb-2 mt-3">Bookings</p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Reschedule Booking</h2>
      <p style="color:var(--muted);margin:0;">Choose a new date and time for your appointment.</p>
    </div>

    <% if (error) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>

    <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
      <div class="mb-4 pb-4" style="border-bottom:1px solid var(--border);">
        <div class="d-flex flex-wrap justify-content-between gap-3">
          <div>
            <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;"><%= booking.service_name %></h5>
            <p style="color:var(--muted);margin:0;">
              <i class="bi bi-shop me-1"></i><%= booking.merchant_name %>
              <% if (booking.merchant_address) { %>
                <span style="margin-left:.5rem;"><i class="bi bi-geo-alt me-1"></i><%= booking.merchant_address %></span>
              <% } %>
            </p>
          </div>
          <div class="text-md-end">
            <p style="color:var(--muted);font-size:.8rem;margin:0;">Current Slot</p>
            <p style="color:var(--ink);font-weight:800;margin:0;"><%= formatDate(booking.booking_date) %>, <%= formatTime(booking.booking_time) %></p>
          </div>
        </div>
      </div>

      <form action="/book/<%= booking.booking_id %>/reschedule" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" style="font-weight:600;font-size:.875rem;">New Date</label>
            <input type="date" name="booking_date" class="form-control rounded-xl" min="<%= today %>" value="<%= dateInputValue(booking.booking_date) %>" required />
          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-weight:600;font-size:.875rem;">New Time</label>
            <input type="time" name="booking_time" class="form-control rounded-xl" value="<%= formatTime(booking.booking_time) %>" required />
          </div>
        </div>

        <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
          <a href="/book/viewBookings" class="btn btn-outline-secondary btn-pill">Cancel</a>
          <button type="submit" class="btn btn-primary btn-pill">
            <i class="bi bi-calendar-check me-2"></i>Save New Slot
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
