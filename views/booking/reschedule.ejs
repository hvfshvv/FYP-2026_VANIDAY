<%- include('../partials/header') %>

<%
  function formatDate(value) {
    return new Date(value).toLocaleDateString(lang === 'zh' ? 'zh-CN' : (lang === 'ta' ? 'ta-IN' : 'en-SG'), {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  function dateInputValue(value) {
    if (value instanceof Date) {
      const year = value.getFullYear();
      const month = String(value.getMonth() + 1).padStart(2, '0');
      const day = String(value.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    }

    return String(value || '').slice(0, 10);
  }

  function formatTime(value) {
    return String(value || '').slice(0, 5);
  }

  const today = new Date().toISOString().slice(0, 10);
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:720px;">
    <div class="mb-4">
      <a href="/book/viewBookings" class="text-decoration-none" style="color:var(--muted);font-weight:700;font-size:.875rem;">
        <i class="bi bi-arrow-left me-1"></i><%= t('reschedule.back') %>
      </a>
      <p class="section-label mb-2 mt-3"><%= t('reschedule.section') %></p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('reschedule.title') %></h2>
      <p style="color:var(--muted);margin:0;"><%= t('reschedule.subtitle') %></p>
    </div>

    <% if (error) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>

    <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
      <div class="mb-4 pb-4" style="border-bottom:1px solid var(--border);">
        <div class="d-flex flex-wrap justify-content-between gap-3">
          <div>
            <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;"><%= serviceText(booking, 'name') || booking.service_name %></h5>
            <p style="color:var(--muted);margin:0;">
              <i class="bi bi-shop me-1"></i><%= booking.merchant_name %>
              <% if (booking.merchant_address) { %>
                <span style="margin-left:.5rem;"><i class="bi bi-geo-alt me-1"></i><%= booking.merchant_address %></span>
              <% } %>
            </p>
          </div>
          <div class="text-md-end">
            <p style="color:var(--muted);font-size:.8rem;margin:0;"><%= t('reschedule.currentSlot') %></p>
            <p style="color:var(--ink);font-weight:800;margin:0;"><%= formatDate(booking.booking_date) %>, <%= formatTime(booking.booking_time) %></p>
          </div>
        </div>
      </div>

      <form action="/book/<%= booking.booking_id %>/reschedule" method="POST">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('reschedule.newDate') %></label>
            <input type="date" name="booking_date" id="bookingDate" class="form-control rounded-xl" min="<%= today %>" value="<%= dateInputValue(booking.booking_date) %>" required />
          </div>
          <div class="col-md-6">
            <label class="form-label" style="font-weight:600;font-size:.875rem;"><%= t('reschedule.newTime') %></label>
            <input type="time" name="booking_time" id="bookingTime" class="form-control rounded-xl" value="<%= formatTime(booking.booking_time) %>" required />
          </div>
        </div>
        <div id="sameSlotError" class="rounded-xl mt-3 p-3" style="display:none;background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
          <i class="bi bi-exclamation-circle me-2"></i><%= t('reschedule.sameSlotError') %>
        </div>

        <div class="d-flex flex-wrap justify-content-end gap-2 mt-4">
          <a href="/book/viewBookings" class="btn btn-outline-secondary btn-pill"><%= t('reschedule.cancel') %></a>
          <button type="submit" class="btn btn-primary btn-pill">
            <i class="bi bi-calendar-check me-2"></i><%= t('reschedule.save') %>
          </button>
        </div>
      </form>
    </div>
  </div>
</main>

<script>
  const currentDate = '<%= dateInputValue(booking.booking_date) %>';
  const currentTime = '<%= formatTime(booking.booking_time) %>';
  const form = document.querySelector('form[action$="/reschedule"]');
  const bookingDate = document.getElementById('bookingDate');
  const bookingTime = document.getElementById('bookingTime');
  const sameSlotError = document.getElementById('sameSlotError');
  const maxAdvanceBookingDays = 365;

  function pad2(value) {
    return String(value).padStart(2, '0');
  }

  function localDateValue(date = new Date()) {
    return date.getFullYear() + '-' + pad2(date.getMonth() + 1) + '-' + pad2(date.getDate());
  }

  function maxBookableDateValue() {
    const maxDate = new Date();
    maxDate.setDate(maxDate.getDate() + maxAdvanceBookingDays);
    return localDateValue(maxDate);
  }

  bookingDate.max = maxBookableDateValue();

  function isSameSlot() {
    return bookingDate.value === currentDate && bookingTime.value.slice(0, 5) === currentTime;
  }

  function validateChangedSlot() {
    const sameSlot = isSameSlot();
    const tooFarAhead = bookingDate.value && bookingDate.value > bookingDate.max;
    if (tooFarAhead) {
      sameSlotError.innerHTML = '<i class="bi bi-exclamation-circle me-2"></i>Bookings can only be made within the next 12 months.';
      sameSlotError.style.display = 'block';
      return false;
    }
    sameSlotError.innerHTML = '<i class="bi bi-exclamation-circle me-2"></i>Please choose a different date or time from your current slot.';
    sameSlotError.style.display = sameSlot ? 'block' : 'none';
    return !sameSlot;
  }

  bookingDate.addEventListener('change', validateChangedSlot);
  bookingTime.addEventListener('change', validateChangedSlot);

  form.addEventListener('submit', event => {
    if (!validateChangedSlot()) {
      event.preventDefault();
    }
  });
</script>

<%- include('../partials/footer') %>
