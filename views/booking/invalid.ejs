<%- include('../partials/header') %>

<div style="min-height:80vh;display:flex;align-items:center;justify-content:center;padding:3rem 1rem;background:var(--canvas);">
  <div style="max-width:440px;width:100%;text-align:center;">
    <div class="icon-circle-lg mx-auto mb-4">
      <i class="bi bi-qr-code" style="font-size:2.25rem;color:var(--accent);"></i>
    </div>
    <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2.5rem;">
      <h3 style="font-weight:800;letter-spacing:-.025em;color:var(--ink);margin-bottom:.75rem;"><%= title %></h3>
      <p style="color:var(--muted);margin-bottom:2rem;line-height:1.65;">
        This QR code link is no longer active. The merchant may have regenerated their QR code or temporarily paused bookings.
      </p>
      <div class="d-flex flex-column gap-2">
        <a href="/" class="btn btn-primary btn-pill">
          <i class="bi bi-house me-2"></i>Back to Home
        </a>
        <a href="/marketplace" class="btn btn-outline-secondary btn-pill">
          <i class="bi bi-grid me-2"></i>Browse Marketplace
        </a>
      </div>
      <p style="color:var(--ghost);font-size:.8125rem;margin-top:1.5rem;margin-bottom:0;">
        <i class="bi bi-info-circle me-1"></i>Ask the merchant for their latest QR code.
      </p>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
