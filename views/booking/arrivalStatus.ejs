<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const styles = {
    arrived: { icon: 'bi-check-circle-fill', color: 'var(--success)', title: t('arrival.arrived') },
    already_arrived: { icon: 'bi-person-check-fill', color: '#1D4ED8', title: t('arrival.alreadyArrived') },
    no_active_booking: { icon: 'bi-calendar-x', color: 'var(--warn)', title: t('arrival.noActiveBooking') },
    invalid: { icon: 'bi-exclamation-triangle-fill', color: 'var(--danger)', title: t('arrival.invalid') },
  };
  const current = styles[state] || styles.invalid;
%>

<main style="min-height:80vh;display:flex;align-items:center;justify-content:center;padding:3rem 1rem;background:var(--canvas);">
  <section class="card border-0 text-center" style="width:100%;max-width:520px;box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2.5rem;">
    <div class="icon-circle-lg mx-auto mb-4" style="background:var(--accent-light);">
      <i class="bi <%= current.icon %>" style="font-size:2.25rem;color:<%= current.color %>;"></i>
    </div>

    <p class="section-label mb-2"><%= t('arrival.qr') %></p>
    <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.75rem;"><%= current.title %></h2>

    <% if (merchantName) { %>
      <p style="font-weight:700;color:var(--ink);margin-bottom:.5rem;"><%= merchantName %></p>
    <% } %>

    <p style="color:var(--muted);line-height:1.65;margin:0 auto 1.5rem;max-width:380px;"><%= message %></p>

    <% if (booking) { %>
      <div class="text-start mx-auto mb-4" style="max-width:360px;background:var(--accent-light);border:1px solid rgba(225,29,72,.12);border-radius:var(--r-lg);padding:1rem;">
        <p style="font-size:.75rem;color:var(--accent);font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:.5rem;"><%= t('arrival.booking') %></p>
        <p style="font-weight:700;color:var(--ink);margin-bottom:.25rem;"><%= serviceText(booking, 'name') || booking.service_name %></p>
        <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;">
          <i class="bi bi-calendar3 me-1"></i>
          <%= new Date(booking.slot_date).toLocaleDateString(lang === 'zh' ? 'zh-CN' : (lang === 'ta' ? 'ta-IN' : 'en-SG'),{day:'numeric',month:'short',year:'numeric'}) %>
          <span style="margin-left:.5rem;"><i class="bi bi-clock me-1"></i><%= String(booking.start_time).slice(0,5) %></span>
        </p>
      </div>
    <% } %>

    <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center">
      <a href="/book/viewBookings" class="btn btn-primary btn-pill">
        <i class="bi bi-clock-history me-1"></i><%= t('booking.myBookings') %>
      </a>
      <a href="/marketplace" class="btn btn-outline-secondary btn-pill">
        <i class="bi bi-grid me-1"></i><%= t('nav.marketplace') %>
      </a>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
