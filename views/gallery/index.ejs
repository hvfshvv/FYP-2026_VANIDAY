<%- include('../partials/header') %>
<style>
  .gallery-hero{background:linear-gradient(135deg,#fff1f4,#fff);border:1px solid rgba(225,29,72,.09);border-radius:26px;padding:2rem;box-shadow:var(--shadow)}
  .gallery-feed{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;align-items:start}
  .gallery-feed-card{background:#fff;border:1px solid var(--border);border-radius:16px;overflow:visible;box-shadow:0 10px 28px rgba(136,19,55,.07)}
  .gallery-feed-head{position:relative;display:flex;justify-content:space-between;align-items:center;padding:.8rem 1rem;background:#fff;border-radius:16px 16px 0 0}
  .gallery-feed-user{display:flex;align-items:center;gap:.65rem}.gallery-avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),#fb7185);color:#fff;font-weight:800}.gallery-feed-user p{font-weight:800;color:var(--ink);font-size:.86rem;margin:0}.gallery-feed-user small{color:var(--muted);font-size:.68rem}.gallery-feed-user small i{color:var(--success)}
  .gallery-feed-image{width:100%;height:min(48vh,350px);background:#111;display:grid;place-items:center;overflow:hidden}.gallery-feed-image img{display:block;width:100%;height:100%;object-fit:contain}
  .gallery-feed-actions{display:flex;justify-content:space-between;align-items:center;padding:.8rem 1rem .35rem}.gallery-feed-actions form{margin:0}.gallery-feed-actions button,.gallery-feed-actions a,.gallery-report-control summary{border:0;background:none;color:var(--ink);font-size:1.35rem;padding:0;line-height:1;cursor:pointer}.gallery-feed-actions .active{color:var(--accent)}
  .gallery-feed-copy{padding:0 1rem 1rem}.gallery-like-count{font-size:.78rem;font-weight:800;color:var(--ink);margin-bottom:.35rem}.gallery-caption{font-size:.84rem;color:var(--ink);margin-bottom:.75rem}.gallery-date{font-size:.66rem;text-transform:uppercase;color:var(--muted);margin:.75rem 0 0}
  .gallery-service-tag{display:flex;justify-content:space-between;align-items:center;border:1px solid var(--border);background:var(--canvas);border-radius:12px;padding:.65rem .75rem}.gallery-service-tag span{display:block;color:var(--accent);font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.gallery-service-tag strong{color:var(--ink);font-size:.8rem}.gallery-service-tag i{color:var(--success)}
  .gallery-report-control{position:relative}.gallery-report-control summary{list-style:none}.gallery-report-control summary::-webkit-details-marker{display:none}.gallery-report-menu{position:absolute;z-index:8;top:1.8rem;left:0;width:220px;background:#fff;padding:.8rem;border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow)}.gallery-report-menu label{font-size:.68rem;font-weight:800;color:var(--muted)}
  .gallery-owner-menu{position:relative}.gallery-owner-menu summary{list-style:none;cursor:pointer;color:var(--muted);padding:.25rem}.gallery-owner-menu summary::-webkit-details-marker{display:none}.gallery-owner-menu form{position:absolute;right:0;top:1.8rem;z-index:8;background:#fff;border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:.35rem;width:150px}.gallery-owner-menu button{width:100%;border:0;background:#fff;color:var(--danger);font-size:.75rem;font-weight:800;text-align:left;padding:.55rem;border-radius:8px}.gallery-owner-menu button:hover{background:var(--danger-bg)}
  @media(min-width:1500px){.gallery-feed{grid-template-columns:repeat(4,minmax(0,1fr))}}
  @media(max-width:991px){.gallery-feed{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:575px){.gallery-feed{grid-template-columns:1fr}.gallery-feed-card{border-radius:12px}.gallery-feed-image{height:min(52vh,420px)}}
</style>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:1240px;">
    <section class="gallery-hero mb-4"><div class="d-flex flex-wrap justify-content-between align-items-end gap-3"><div><p class="section-label mb-2">Verified Customer Results</p><h1 style="font-weight:800;letter-spacing:-.04em;color:var(--ink);margin-bottom:.35rem;">Inspiration Gallery</h1><p style="color:var(--muted);max-width:680px;margin:0;">Browse real results shared after completed appointments. Save inspiration and book with confidence.</p></div><% if(user&&user.role==='customer'){%><a href="/gallery/saved" class="btn btn-primary btn-pill"><i class="bi bi-bookmark-heart me-1"></i>Saved Inspiration</a><%}%></div></section>
    <% if(success){%><div class="rounded-xl p-3 mb-3" style="background:var(--success-bg);color:var(--success);"><i class="bi bi-check-circle me-2"></i><%=success%></div><%}%><% if(error){%><div class="rounded-xl p-3 mb-3" style="background:var(--danger-bg);color:var(--danger);"><%=error%></div><%}%>
    <nav class="service-filter-panel mb-4" aria-label="Filter gallery by category"><div class="service-filter-inner"><a href="/gallery" class="service-filter-link <%=!selectedCategory?'active':''%>"><i class="bi bi-grid-3x3-gap"></i>All</a><%categories.forEach(category=>{%><a href="/gallery?category=<%=encodeURIComponent(category)%>" class="service-filter-link <%=selectedCategory===category?'active':''%>"><%=category%></a><%})%></div></nav>
    <% if(!posts.length){%><div class="card border-0 text-center p-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);"><i class="bi bi-images" style="font-size:2.5rem;color:var(--accent);"></i><h5 class="mt-3" style="font-weight:800;">No inspiration posts yet</h5><p style="color:var(--muted);margin:0;">Completed customers can be the first to share a verified result.</p></div><%}else{%>
    <div class="gallery-feed"><%posts.forEach(post=>{%><%-include('_card',{post,returnTo:selectedCategory?'/gallery?category='+encodeURIComponent(selectedCategory):'/gallery',reportReasons})%><%})%></div><%}%>
  </div>
</main>
<%- include('../partials/footer') %>
