<article class="gallery-feed-card">
  <header class="gallery-feed-head">
    <div class="gallery-feed-user">
      <span class="gallery-avatar"><%= String(post.customer_name || 'C').charAt(0).toUpperCase() %></span>
      <div>
        <p><%= post.customer_name %></p>
        <small><i class="bi bi-patch-check-fill"></i> Verified visit &middot; <%= post.merchant_name %></small>
      </div>
    </div>
    <% if (user && user.role === 'customer' && String(user.customer_id || user.user_id) === String(post.customer_id)) { %>
      <details class="gallery-owner-menu">
        <summary aria-label="Post options"><i class="bi bi-three-dots"></i></summary>
        <form action="/gallery/<%= post.post_id %>/delete" method="POST" onsubmit="return confirm('Delete this Inspiration Gallery post?');">
          <button type="submit"><i class="bi bi-trash me-2"></i>Delete post</button>
        </form>
      </details>
    <% } %>
  </header>

  <div class="gallery-feed-image">
    <img src="<%= post.image_path %>" alt="<%= post.service_name %> result shared by <%= post.customer_name %>">
  </div>

  <div class="gallery-feed-actions">
    <div class="d-flex align-items-center gap-3">
      <% if (user && user.role === 'customer') { %>
      <form action="/gallery/<%= post.post_id %>/<%= Number(post.viewer_liked) ? 'unlike' : 'like' %>" method="POST">
        <input type="hidden" name="return_to" value="<%= returnTo %>">
        <button type="submit" class="<%= Number(post.viewer_liked) ? 'active' : '' %>" aria-label="<%= Number(post.viewer_liked) ? 'Unlike post' : 'Like post' %>" title="<%= Number(post.viewer_liked) ? 'Unlike this result' : 'Like this result' %>"><i class="bi <%= Number(post.viewer_liked) ? 'bi-heart-fill' : 'bi-heart' %>"></i></button>
      </form>
      <% } else { %>
      <a href="/auth/login?next=<%= encodeURIComponent(returnTo) %>" aria-label="Sign in to like"><i class="bi bi-heart"></i></a>
      <% } %>

      <% if (user && user.role === 'customer' && !Number(post.viewer_reported)) { %>
      <details class="gallery-report-control">
        <summary title="Report post"><i class="bi bi-flag"></i></summary>
        <form action="/gallery/<%= post.post_id %>/report" method="POST" class="gallery-report-menu">
          <input type="hidden" name="return_to" value="<%= returnTo %>">
          <label for="report-<%= post.post_id %>">Report reason</label>
          <select id="report-<%= post.post_id %>" name="reason" class="form-select form-select-sm" required>
            <% reportReasons.forEach(reason => { %><option value="<%= reason %>"><%= reason %></option><% }) %>
          </select>
          <button class="btn btn-outline-danger btn-sm btn-pill mt-2" type="submit">Submit report</button>
        </form>
      </details>
      <% } %>
    </div>

    <% if (user && user.role === 'customer') { %>
    <form action="/gallery/<%= post.post_id %>/<%= Number(post.viewer_saved) ? 'unsave' : 'save' %>" method="POST">
      <input type="hidden" name="return_to" value="<%= returnTo %>">
      <button type="submit" class="<%= Number(post.viewer_saved) ? 'active' : '' %>" aria-label="<%= Number(post.viewer_saved) ? 'Remove from Saved Inspiration' : 'Save to Saved Inspiration' %>" title="<%= Number(post.viewer_saved) ? 'Remove from Saved Inspiration' : 'Save to Saved Inspiration' %>"><i class="bi <%= Number(post.viewer_saved) ? 'bi-bookmark-fill' : 'bi-bookmark' %>"></i></button>
    </form>
    <% } else { %>
    <a href="/auth/login?next=<%= encodeURIComponent(returnTo) %>" aria-label="Sign in to save"><i class="bi bi-bookmark"></i></a>
    <% } %>
  </div>

  <div class="gallery-feed-copy">
    <p class="gallery-like-count"><%= Number(post.like_count || 0) %> like<%= Number(post.like_count || 0) === 1 ? '' : 's' %> &middot; <%= Number(post.save_count || 0) %> save<%= Number(post.save_count || 0) === 1 ? '' : 's' %></p>
    <% if (post.caption) { %><p class="gallery-caption"><strong><%= post.customer_name %></strong> <%= post.caption %></p><% } %>
    <div class="gallery-service-tag">
      <div><span><%= post.service_category || 'Beauty & Wellness' %></span><strong><%= post.service_name %></strong></div>
      <i class="bi bi-patch-check-fill" title="Verified completed booking"></i>
    </div>
    <div class="d-flex gap-2 mt-3">
      <a href="/marketplace/merchant/<%= post.merchant_id %>" class="btn btn-outline-secondary btn-sm btn-pill flex-grow-1">View Merchant</a>
      <a href="/book?merchantId=<%= post.merchant_id %>&serviceId=<%= post.service_id %>" class="btn btn-primary btn-sm btn-pill flex-grow-1">Book Service</a>
    </div>
    <p class="gallery-date"><%= new Date(post.created_at).toLocaleDateString('en-SG',{day:'numeric',month:'long',year:'numeric'}) %></p>
  </div>
</article>
