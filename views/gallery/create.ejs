<%- include('../partials/header') %>
<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;"><div class="container" style="max-width:760px;">
  <a href="/book/viewBookings" class="btn btn-outline-secondary btn-sm btn-pill mb-4"><i class="bi bi-arrow-left me-1"></i>My Bookings</a>
  <div class="card border-0 p-4 p-md-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <p class="section-label">Inspiration Gallery</p><h2 style="font-weight:800;color:var(--ink);">Share Your Result</h2>
    <p style="color:var(--muted);">Your post will be published immediately as a verified customer experience.</p>
    <% if (error) { %><div class="rounded-xl p-3 mb-3" style="background:var(--danger-bg);color:var(--danger);"><%= error %></div><% } %>
    <div class="rounded-xl p-3 mb-4" style="background:var(--accent-light);border:1px solid rgba(225,29,72,.12);">
      <p style="font-weight:800;color:var(--success);margin-bottom:.35rem;"><i class="bi bi-patch-check-fill me-1"></i>Verified Visit</p>
      <p style="font-weight:800;color:var(--ink);margin:0;"><%= booking.merchant_name %> &middot; <%= booking.service_name %></p>
      <p style="color:var(--muted);font-size:.8rem;margin:0;"><%= booking.service_category || 'Beauty & Wellness' %> &middot; <%= new Date(booking.booking_date).toLocaleDateString('en-SG',{day:'numeric',month:'short',year:'numeric'}) %></p>
    </div>
    <form action="/gallery/create/<%= booking.booking_id %>" method="POST" enctype="multipart/form-data">
      <div class="mb-3">
        <label class="form-label fw-bold" for="galleryImage">Result photo</label>
        <input class="form-control" id="galleryImage" type="file" name="gallery_image" accept="image/jpeg,image/png,image/webp" required>
        <div class="form-text">JPG, PNG, or WebP. Maximum 5MB. The full image is displayed without cropping.</div>
      </div>
      <div id="galleryImagePreviewWrap" class="rounded-xl mb-4" style="display:none;background:#111;overflow:hidden;border:1px solid var(--border);">
        <img id="galleryImagePreview" alt="Selected image preview" style="display:block;width:100%;height:min(62vh,520px);object-fit:contain;">
        <div class="p-2 text-center" style="background:#fff;color:var(--muted);font-size:.72rem;">Full image preview</div>
      </div>
      <div class="mb-4"><label class="form-label fw-bold" for="caption">Short caption</label><textarea class="form-control" id="caption" name="caption" rows="4" maxlength="300" placeholder="What did you love about the result?"><%= formValues.caption || '' %></textarea><div class="form-text">Maximum 300 characters. Merchant and service are tagged automatically.</div></div>
      <button class="btn btn-primary btn-pill w-100" type="submit"><i class="bi bi-images me-1"></i>Publish Verified Result</button>
    </form>
  </div>
</div></main>
<script>
  const galleryImageInput = document.getElementById('galleryImage');
  const galleryImagePreview = document.getElementById('galleryImagePreview');
  const galleryImagePreviewWrap = document.getElementById('galleryImagePreviewWrap');
  let galleryPreviewUrl = '';

  galleryImageInput.addEventListener('change', () => {
    if (galleryPreviewUrl) URL.revokeObjectURL(galleryPreviewUrl);
    const file = galleryImageInput.files && galleryImageInput.files[0];
    if (!file) {
      galleryImagePreviewWrap.style.display = 'none';
      return;
    }
    galleryPreviewUrl = URL.createObjectURL(file);
    galleryImagePreview.src = galleryPreviewUrl;
    galleryImagePreviewWrap.style.display = 'block';
  });
</script>
<%- include('../partials/footer') %>
