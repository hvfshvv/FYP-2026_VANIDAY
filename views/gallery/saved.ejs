<%- include('../partials/header') %>
<style>
  .gallery-feed{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1.25rem;align-items:start}
  .gallery-feed-card{background:#fff;border:1px solid var(--border);border-radius:16px;overflow:visible;box-shadow:0 10px 28px rgba(136,19,55,.07)}
  .gallery-feed-head{position:relative;display:flex;justify-content:space-between;align-items:center;padding:.8rem 1rem;background:#fff;border-radius:16px 16px 0 0}
  .gallery-feed-user{display:flex;align-items:center;gap:.65rem}.gallery-avatar{width:38px;height:38px;border-radius:50%;display:grid;place-items:center;background:linear-gradient(135deg,var(--accent),#fb7185);color:#fff;font-weight:800}.gallery-feed-user p{font-weight:800;color:var(--ink);font-size:.86rem;margin:0}.gallery-feed-user small{color:var(--muted);font-size:.68rem}.gallery-feed-user small i{color:var(--success)}
  .gallery-feed-image{width:100%;height:min(48vh,350px);background:#111;display:grid;place-items:center;overflow:hidden}.gallery-feed-image img{display:block;width:100%;height:100%;object-fit:contain}
  .gallery-feed-actions{display:flex;justify-content:space-between;align-items:center;padding:.8rem 1rem .35rem}.gallery-feed-actions form{margin:0}.gallery-feed-actions button,.gallery-feed-actions a,.gallery-report-control summary{border:0;background:none;color:var(--ink);font-size:1.35rem;padding:0;line-height:1;cursor:pointer}.gallery-feed-actions .active{color:var(--accent)}
  .gallery-feed-copy{padding:0 1rem 1rem}.gallery-like-count{font-size:.78rem;font-weight:800;color:var(--ink);margin-bottom:.35rem}.gallery-caption{font-size:.84rem;color:var(--ink);margin-bottom:.75rem}.gallery-date{font-size:.66rem;text-transform:uppercase;color:var(--muted);margin:.75rem 0 0}
  .gallery-service-tag{display:flex;justify-content:space-between;align-items:center;border:1px solid var(--border);background:var(--canvas);border-radius:12px;padding:.65rem .75rem}.gallery-service-tag span{display:block;color:var(--accent);font-size:.62rem;font-weight:800;text-transform:uppercase;letter-spacing:.06em}.gallery-service-tag strong{color:var(--ink);font-size:.8rem}.gallery-service-tag i{color:var(--success)}
  .gallery-report-control,.gallery-owner-menu{position:relative}.gallery-report-control summary,.gallery-owner-menu summary{list-style:none;cursor:pointer}.gallery-report-control summary::-webkit-details-marker,.gallery-owner-menu summary::-webkit-details-marker{display:none}.gallery-report-menu{position:absolute;z-index:8;top:1.8rem;left:0;width:220px;background:#fff;padding:.8rem;border:1px solid var(--border);border-radius:14px;box-shadow:var(--shadow)}.gallery-report-menu label{font-size:.68rem;font-weight:800;color:var(--muted)}
  .gallery-owner-menu form{position:absolute;right:0;top:1.8rem;z-index:8;background:#fff;border:1px solid var(--border);border-radius:12px;box-shadow:var(--shadow);padding:.35rem;width:150px}.gallery-owner-menu button{width:100%;border:0;background:#fff;color:var(--danger);font-size:.75rem;font-weight:800;text-align:left;padding:.55rem;border-radius:8px}
  @media(min-width:1500px){.gallery-feed{grid-template-columns:repeat(4,minmax(0,1fr))}}
  @media(max-width:991px){.gallery-feed{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:575px){.gallery-feed{grid-template-columns:1fr}.gallery-feed-image{height:min(52vh,420px)}}
</style>
<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;"><div class="container" style="max-width:1240px;">
  <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4"><div><p class="section-label">Your Collection</p><h2 style="font-weight:800;color:var(--ink);">Saved Inspiration</h2><p style="color:var(--muted);margin:0;">Only posts saved with the bookmark icon appear here. Hearting a post records a like.</p></div><a href="/gallery" class="btn btn-outline-secondary btn-pill"><i class="bi bi-arrow-left me-1"></i>Gallery</a></div>
  <% if(!posts.length){%><div class="card border-0 text-center p-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);"><i class="bi bi-bookmark-heart" style="font-size:2.5rem;color:var(--accent);"></i><h5 class="mt-3" style="font-weight:800;">Nothing bookmarked yet</h5><p style="color:var(--muted);">Use the bookmark icon on a gallery post to save it here.</p><a href="/gallery" class="btn btn-primary btn-pill mx-auto">Browse Gallery</a></div><%}else{%><div class="gallery-feed"><%posts.forEach(post=>{%><%-include('_card',{post,returnTo:'/gallery/saved',reportReasons})%><%})%></div><%}%>
</div></main>
<%- include('../partials/footer') %>
