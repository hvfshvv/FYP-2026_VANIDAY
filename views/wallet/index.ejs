<% locals.hideCatNav = true %>
<%- include('../partials/header') %>
<script src="https://js.stripe.com/v3/"></script>

<main class="container py-5" style="max-width:980px;">
  <div class="mb-4">
    <div>
      <p class="text-uppercase small mb-1" style="color:var(--accent);font-weight:800;letter-spacing:.08em;"><%= t('wallet.storedBalance') %></p>
      <h2 class="mb-1" style="font-weight:800;"><%= t('wallet.title') %></h2>
      <p class="mb-0" style="color:var(--muted);"><%= t('wallet.subtitle') %></p>
    </div>
  </div>

  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>
  <div id="wallet-error" class="alert alert-danger d-none"></div>

  <% if (paymentContext) { %>
    <% if (paymentContext.shortfall <= 0 && paymentContext.bookingId) { %>
      <div class="d-flex justify-content-end mb-4">
        <a href="/payment/checkout/<%= paymentContext.bookingId %>" class="btn btn-primary px-4"><i class="bi bi-arrow-left me-2"></i><%= t('wallet.backToPayment') %></a>
      </div>
    <% } else { %>
    <div class="alert mb-4 p-3 p-md-4" data-persist style="background:#fff7ed;border:1.5px solid #fed7aa;border-radius:16px;color:var(--ink);">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap">
        <div>
          <div style="font-weight:800;"><i class="bi bi-info-circle me-1" style="color:#c2410c;"></i> <%= t('wallet.topUpForBooking') %></div>
          <div class="small mt-1" style="color:var(--muted);"><%= t('wallet.insufficientNote') %></div>
        </div>
        <% if (paymentContext.bookingId) { %>
          <a href="/payment/checkout/<%= paymentContext.bookingId %>" class="btn btn-sm btn-primary"><i class="bi bi-arrow-left me-1"></i><%= t('wallet.backToPayment') %></a>
        <% } %>
      </div>
      <div class="row g-2 mt-2">
        <div class="col-sm-4"><span class="small d-block" style="color:var(--muted);"><%= t('wallet.amountDue') %></span><strong style="font-family:var(--font-mono);">S$<%= paymentContext.amountDue.toFixed(2) %></strong></div>
        <div class="col-sm-4"><span class="small d-block" style="color:var(--muted);"><%= t('wallet.currentBalance') %></span><strong style="font-family:var(--font-mono);">S$<%= Number(wallet.balance).toFixed(2) %></strong></div>
        <div class="col-sm-4"><span class="small d-block" style="color:var(--muted);"><%= t('wallet.additionalNeeded') %></span><strong style="font-family:var(--font-mono);color:#c2410c;">S$<%= paymentContext.shortfall.toFixed(2) %></strong></div>
      </div>
    </div>
    <% } %>
  <% } %>

  <div class="row g-4">
    <div class="col-lg-5">
      <section class="card border-0 h-100" style="border-radius:24px;box-shadow:var(--shadow);">
        <div class="card-body p-4">
          <span class="small" style="color:var(--muted);"><%= t('wallet.availableBalance') %></span>
          <div class="mt-2 mb-4" style="font:700 2.7rem var(--font-mono);color:var(--ink);">S$<%= Number(wallet.balance).toFixed(2) %></div>

          <h5 style="font-weight:800;"><%= t('wallet.topUpTitle') %></h5>
          <p class="small" style="color:var(--muted);"><%= t('wallet.topUpHint', { min: 'S$' + minTopup.toFixed(2), max: 'S$' + maxTopup.toFixed(2) }) %></p>
          <div class="d-grid gap-2" style="grid-template-columns:repeat(2,1fr);">
            <% allowedTopups.forEach((amount) => { %>
              <button type="button" class="btn <%= amount === suggestedTopup ? 'btn-primary' : 'btn-outline-secondary' %> wallet-amount" data-amount="<%= amount %>">S$<%= amount %></button>
            <% }) %>
          </div>

          <% if (exactShortfall) { %>
            <button type="button" class="btn <%= exactShortfall === suggestedTopup ? 'btn-primary' : 'btn-outline-secondary' %> wallet-amount w-100 mt-2" data-amount="<%= exactShortfall %>">
              Exact amount needed: S$<%= exactShortfall.toFixed(2) %>
            </button>
          <% } %>

          <div class="mt-3">
            <label for="custom-topup-amount" class="form-label small mb-1" style="font-weight:700;"><%= t('wallet.customAmount') %></label>
            <div class="input-group">
              <span class="input-group-text">S$</span>
              <input type="number" id="custom-topup-amount" class="form-control" min="<%= minTopup %>" max="<%= maxTopup %>" step="0.01" placeholder="<%= t('wallet.enterAmount') %>">
              <button type="button" id="use-custom-amount" class="btn btn-outline-secondary"><%= t('wallet.useAmount') %></button>
            </div>
            <div id="custom-amount-error" class="invalid-feedback"></div>
          </div>

          <div class="d-flex align-items-center gap-3 mt-3 p-3 rounded-4" style="background:linear-gradient(135deg,#fff1f5,#eef4ff);border:1px solid #fbcfe8;color:var(--ink);">
            <span class="d-inline-flex align-items-center justify-content-center flex-shrink-0 rounded-circle" style="width:42px;height:42px;background:#fff;color:var(--accent);box-shadow:0 4px 12px rgba(225,29,72,.12);">
              <i class="bi bi-stars"></i>
            </span>
            <div>
              <div style="font-weight:800;"><%= t('wallet.bonusTitle') %></div>
              <div class="small" style="color:var(--muted);"><%= t('wallet.bonusSub') %></div>
            </div>
          </div>

          <% if (bonusThreshold > 0 && bonusAmount > 0) { %>
            <div class="mt-3 p-2 rounded" style="background:#f0fdf4;color:#166534;font-size:.82rem;">
              <i class="bi bi-gift me-1"></i> <%= t('wallet.bonusOffer', { threshold: 'S$' + bonusThreshold.toFixed(2), bonus: 'S$' + bonusAmount.toFixed(2) }) %>
            </div>
          <% } %>

          <div class="d-flex gap-2 mt-4">
            <button type="button" id="select-card" class="btn btn-primary flex-fill"><i class="bi bi-credit-card me-1"></i> <%= t('wallet.card') %></button>
            <button type="button" id="select-paynow" class="btn btn-outline-secondary flex-fill"><i class="bi bi-qr-code me-1"></i> PayNow</button>
          </div>
          <div id="card-topup-panel">
            <div id="wallet-card-element" class="mt-3 p-3 rounded" style="border:1.5px solid var(--border);background:#fff;"></div>
            <button type="button" id="confirm-card-topup" class="btn btn-primary w-100 mt-3">
              <span id="card-confirm-label"><i class="bi bi-lock me-1"></i> <%= t('wallet.topUpAmount', { amount: 'S$' + suggestedTopup.toFixed(2) }) %></span>
              <span id="card-confirm-loading" class="d-none"><span class="spinner-border spinner-border-sm me-1"></span> <%= t('wallet.processing') %></span>
            </button>
          </div>
          <div id="paynow-topup-panel" class="d-none">
            <div class="mt-3 p-3 rounded small" style="background:var(--surface);border:1.5px solid var(--border);color:var(--muted);">
              <%= t('wallet.paynowNote') %>
            </div>
            <button type="button" id="confirm-paynow-topup" class="btn btn-primary w-100 mt-3">
              <i class="bi bi-qr-code me-1"></i> <%= t('wallet.topUpPaynow', { amount: 'S$' + suggestedTopup.toFixed(2) }) %>
            </button>
          </div>
          <p id="selected-label" class="small text-center mt-2 mb-0" style="color:var(--muted);"><%= t('wallet.selectedAmount', { amount: 'S$' + suggestedTopup.toFixed(2) }) %></p>
        </div>
      </section>
    </div>

    <div class="col-lg-7">
      <section class="card border-0" style="border-radius:24px;box-shadow:var(--shadow);">
        <div class="card-body p-4">
          <div class="d-flex justify-content-between align-items-center gap-3 mb-3">
            <h5 class="mb-0" style="font-weight:800;"><%= t('wallet.recentActivity') %></h5>
            <a href="<%= walletHistoryUrl %>" class="btn btn-sm btn-outline-secondary"><%= t('wallet.viewAll') %></a>
          </div>
          <% if (!transactions.length) { %>
            <p class="py-5 text-center" style="color:var(--muted);"><%= t('wallet.noActivity') %></p>
          <% } %>
          <% transactions.forEach(tx => {
            const outgoing = tx.transaction_type === 'payment';
            const pending = tx.status === 'pending';
            const completed = tx.status === 'completed';
            const failed = tx.status === 'failed' || tx.status === 'cancelled';
            const amountPrefix = completed ? (outgoing ? '-' : '+') : '';
            const amountColor = pending || failed
              ? 'var(--muted)'
              : outgoing
                ? 'var(--danger)'
                : 'var(--success)';
            const statusLabel = pending
              ? t('wallet.statusPending')
              : failed
                ? t('wallet.statusFailed')
                : t('bookings.completed');
            tx.status = statusLabel;
          %>
            <div class="d-flex justify-content-between align-items-center py-3 border-bottom gap-3">
              <div>
                <div style="font-weight:700;"><%= tx.description || t('wallet.txType.' + tx.transaction_type, {}, tx.transaction_type) %></div>
                <div class="small" style="color:var(--muted);"><%= new Date(tx.created_at).toLocaleString('en-SG') %> · <%= tx.status %></div>
              </div>
              <div class="text-end flex-shrink-0">
                <span style="font-family:var(--font-mono);font-weight:700;color:<%= amountColor %>;<%= failed ? 'text-decoration:line-through;' : '' %>">
                  <%= amountPrefix %>S$<%= Number(tx.amount).toFixed(2) %>
                </span>
                <% if (pending) { %><span class="badge rounded-pill text-bg-secondary d-block mt-1"><%= t('admin.payouts.status.pending') %></span><% } %>
                <% if (failed) { %><span class="badge rounded-pill text-bg-light d-block mt-1"><%= t('wallet.notCredited') %></span><% } %>
              </div>
            </div>
          <% }) %>
        </div>
      </section>
    </div>
  </div>
</main>

<script>
(function () {
  const amounts = document.querySelectorAll('.wallet-amount');
  const customAmount = document.getElementById('custom-topup-amount');
  const useCustomAmount = document.getElementById('use-custom-amount');
  const customAmountError = document.getElementById('custom-amount-error');
  const errorBox = document.getElementById('wallet-error');
  const label = document.getElementById('selected-label');
  const cardSelector = document.getElementById('select-card');
  const paynowSelector = document.getElementById('select-paynow');
  const cardPanel = document.getElementById('card-topup-panel');
  const paynowPanel = document.getElementById('paynow-topup-panel');
  const cardConfirmLabel = document.getElementById('card-confirm-label');
  const paynowConfirm = document.getElementById('confirm-paynow-topup');
  let selectedAmount = <%- JSON.stringify(suggestedTopup) %>;
  const paymentContext = <%- JSON.stringify(paymentContext) %>;
  const stripe = window.Stripe && '<%= stripePublishableKey || '' %>' ? Stripe('<%= stripePublishableKey || '' %>') : null;
  const card = stripe ? stripe.elements().create('card', { hidePostalCode: true }) : null;
  if (card) card.mount('#wallet-card-element');
  function showCustomAmountError(message) {
    customAmount.classList.add('is-invalid');
    customAmountError.textContent = message;
    customAmountError.style.display = 'block';
  }

  function clearCustomAmountError() {
    customAmount.classList.remove('is-invalid');
    customAmountError.textContent = '';
    customAmountError.style.display = '';
  }

  function selectAmount(amount, selectedButton = null, isCustom = false) {
    const normalized = Math.round(Number(amount) * 100) / 100;
    if (!Number.isFinite(normalized)) {
      const message = window.t('wallet.err.invalidAmount');
      if (isCustom) showCustomAmountError(message); else showError(message);
      return false;
    }
    if (normalized < <%= minTopup %>) {
      const message = window.t('wallet.err.minAmount', { min: 'S$<%= minTopup.toFixed(2) %>' });
      if (isCustom) showCustomAmountError(message); else showError(message);
      return false;
    }
    if (normalized > <%= maxTopup %>) {
      const message = window.t('wallet.err.maxAmount', { max: 'S$<%= maxTopup.toFixed(2) %>' });
      if (isCustom) showCustomAmountError(message); else showError(message);
      return false;
    }
    clearCustomAmountError();
    selectedAmount = normalized;
    amounts.forEach(item => {
      item.classList.remove('btn-primary');
      item.classList.add('btn-outline-secondary');
    });
    if (selectedButton) {
      selectedButton.classList.remove('btn-outline-secondary');
      selectedButton.classList.add('btn-primary');
    }
    label.textContent = window.t('wallet.selectedAmount', { amount: 'S$' + selectedAmount.toFixed(2) });
    cardConfirmLabel.innerHTML = '<i class="bi bi-lock me-1"></i> ' + window.t('wallet.topUpAmount', { amount: 'S$' + selectedAmount.toFixed(2) });
    paynowConfirm.innerHTML = '<i class="bi bi-qr-code me-1"></i> ' + window.t('wallet.topUpPaynow', { amount: 'S$' + selectedAmount.toFixed(2) });
    errorBox.classList.add('d-none');
    return true;
  }
  amounts.forEach(button => button.addEventListener('click', () => selectAmount(button.dataset.amount, button)));
  useCustomAmount.addEventListener('click', () => selectAmount(customAmount.value, null, true));
  customAmount.addEventListener('keydown', event => {
    if (event.key === 'Enter') {
      event.preventDefault();
      selectAmount(customAmount.value, null, true);
    }
  });
  customAmount.addEventListener('input', clearCustomAmountError);

  function selectMethod(method) {
    const isCard = method === 'card';
    cardSelector.className = `btn ${isCard ? 'btn-primary' : 'btn-outline-secondary'} flex-fill`;
    paynowSelector.className = `btn ${isCard ? 'btn-outline-secondary' : 'btn-primary'} flex-fill`;
    cardPanel.classList.toggle('d-none', !isCard);
    paynowPanel.classList.toggle('d-none', isCard);
    errorBox.classList.add('d-none');
  }
  cardSelector.addEventListener('click', () => selectMethod('card'));
  paynowSelector.addEventListener('click', () => selectMethod('paynow'));

  function showError(message) {
    errorBox.textContent = message;
    errorBox.classList.remove('d-none');
  }
  async function jsonPost(url, body) {
    const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
    const data = await response.json();
    if (!response.ok) throw new Error(data.error || 'Request failed.');
    return data;
  }

  document.getElementById('confirm-card-topup').addEventListener('click', async function () {
    this.disabled = true;
    cardConfirmLabel.classList.add('d-none');
    document.getElementById('card-confirm-loading').classList.remove('d-none');
    errorBox.classList.add('d-none');
    try {
      if (!stripe || !card) throw new Error('Stripe is not configured.');
      const setup = await jsonPost('/wallet/topup/card', { amount: selectedAmount });
      const result = await stripe.confirmCardPayment(setup.clientSecret, {
        payment_method: { card }
      });
      if (result.error) throw new Error(result.error.message);
      const confirmed = await jsonPost('/wallet/topup/card/confirm', { paymentIntentId: result.paymentIntent.id });
      if (paymentContext && paymentContext.bookingId) {
        const returnParams = new URLSearchParams({
          bookingId: String(paymentContext.bookingId),
          amountDue: Number(paymentContext.amountDue).toFixed(2)
        });
        window.location.href = `${confirmed.redirectUrl}&${returnParams.toString()}`;
      } else {
        window.location.href = confirmed.redirectUrl;
      }
    } catch (err) {
      showError(err.message);
      this.disabled = false;
      cardConfirmLabel.classList.remove('d-none');
      document.getElementById('card-confirm-loading').classList.add('d-none');
    }
  });

  document.getElementById('confirm-paynow-topup').addEventListener('click', async function () {
    this.disabled = true;
    errorBox.classList.add('d-none');
    try {
      const data = await jsonPost('/wallet/topup/paynow', {
        amount: selectedAmount,
        bookingId: paymentContext && paymentContext.bookingId,
        amountDue: paymentContext && paymentContext.amountDue
      });
      window.location.href = data.url;
    } catch (err) {
      showError(err.message);
      this.disabled = false;
    }
  });
})();
</script>

<%- include('../partials/footer') %>
