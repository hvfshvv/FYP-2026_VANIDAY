<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<!-- Customer favourites page: saved merchants first, then saved services. -->
<div
  class="section"
  style="padding-top:2.5rem;padding-bottom:2rem;border-bottom:1px solid var(--border);"
>
  <div class="container">

    <p class="section-label">
      <%= t('admin.table.customer') %>
    </p>

    <h1 style="
      font-size:2rem;
      font-weight:800;
      color:var(--ink);
      margin-bottom:.25rem;
    ">
      <%= t('nav.myFavourites') %>
    </h1>

    <p style="color:var(--muted);margin-bottom:0;">
      <%= t('fav.subtitle') %>
    </p>

  </div>
</div>

<div class="container" style="padding-top:2.5rem;padding-bottom:4rem;">

  <!-- Favourite merchants: full merchant cards saved by the customer. -->
  <div style="margin-bottom:4rem;">

    <div class="section-header">

      <div>

        <p class="section-label">
          <%= t('fav.merchantsLabel') %>
        </p>

        <h2 class="section-title">
          <%= t('fav.merchantsTitle') %>
        </h2>

        <p class="section-sub">
          <%= t('fav.merchantsSub') %>
        </p>

      </div>

    </div>

    <!-- Empty state shown when the customer has not saved any merchants. -->
    <div
      id="favourite-merchants-empty"
      class="text-center py-5"
      <%- merchants && merchants.length ? 'style="display:none;"' : '' %>
    >

        <div class="icon-circle-lg mx-auto mb-3">
          <i
            class="bi bi-heart"
            style="font-size:2rem;color:var(--accent);"
          ></i>
        </div>

        <h5 style="font-weight:700;color:var(--ink);">
          <%= t('fav.noMerchantsTitle') %>
        </h5>

        <p style="color:var(--muted);">
          <%= t('fav.noMerchantsBody') %>
        </p>

        <a
          href="/marketplace"
          class="btn btn-primary btn-pill"
        >
          <%= t('auth.browseMarketplace') %>
        </a>

    </div>

    <div id="favourite-merchants-grid" class="row g-3">
      <% if (merchants && merchants.length) { %>
        <% merchants.forEach(merchant => { %>

          <div
            class="col-md-6 col-lg-4 js-favourite-merchant-item"
            data-merchant-id="<%= merchant.merchant_id %>"
          >
            <div style="position:relative;max-width:340px;height:100%;">

              <a
                href="/marketplace/merchant/<%= merchant.merchant_id %>"
                class="merchant-card"
              >

                <% if (merchant.image_path) { %>

                  <div class="card-img-wrapper">
                    <img
                      src="<%= merchant.image_path %>"
                      class="card-img"
                      alt="<%= merchant.merchant_name %>"
                    >
                  </div>

                <% } else { %>

                  <div class="card-no-img">
                    <i class="bi bi-shop"></i>
                  </div>

                <% } %>

                <div class="card-body">

                  <div class="card-top">

                    <h6 class="card-title">
                      <%= merchant.merchant_name %>
                    </h6>

                  </div>

                <p class="card-meta">
                  <%= merchant.description || t('fav.defaultMerchantDesc') %>
                </p>

                <div class="discount-pill">
                  <i class="bi bi-grid"></i>
                  <%= merchant.category ? t('categories.' + merchant.category, {}, merchant.category) : t('admin.table.generalCategory') %>
                </div>

                <div class="info-row">

                  <i class="bi bi-geo-alt"></i>

                  <span>
                    <%= merchant.address || t('common.singapore') %>
                  </span>

                </div>

              </div>

            </a>

              <!-- Remove this merchant without reloading the favourites page. -->
              <form
                class="js-remove-merchant-favourite-form"
                action="/favourite/merchant/remove/<%= merchant.merchant_id %>"
                method="POST"
                style="position:absolute;top:12px;right:12px;z-index:5;"
              >
                <button
                  type="submit"
                  style="width:36px;height:36px;border-radius:999px;border:none;background:white;color:var(--accent);box-shadow:var(--shadow);display:inline-flex;align-items:center;justify-content:center;padding:0;"
                  aria-label="<%= t('fav.removeMerchantAria', { name: merchant.merchant_name }) %>"
                  title="<%= t('fav.removeFromFavourites') %>"
                >
                  <i class="bi bi-heart-fill"></i>
                </button>
              </form>

            </div>

          </div>

        <% }) %>
      <% } %>
    </div>

  </div>

  <!-- Favourite services: individual services saved from merchant details pages. -->
  <div id="favourite-services" style="scroll-margin-top:var(--nav-h);">

    <div class="section-header">

      <div>

        <p class="section-label">
          <%= t('merchant.nav.services') %>
        </p>

        <h2 class="section-title">
          <%= t('fav.servicesTitle') %>
        </h2>

        <p class="section-sub">
          <%= t('fav.servicesSub') %>
        </p>

        <!-- Category filter: reloads this page with ?category=... -->
        <div class="d-flex flex-wrap gap-2 mt-3 mb-4">

          <a
            href="/favourite#favourite-services"
            class="btn btn-sm btn-pill <%= !selectedCategory ? 'btn-primary' : 'btn-outline-secondary' %>"
          >
            <%= t('merchant.bookings.filterAll') %>
          </a>

          <% categories.forEach(category => { %>

            <a
              href="/favourite?category=<%= category %>#favourite-services"
              class="btn btn-sm btn-pill <%= selectedCategory === category ? 'btn-primary' : 'btn-outline-secondary' %>"
            >
              <%= t('categories.' + category, {}, category) %>
            </a>

          <% }) %>

        </div>

      </div>

    </div>

    <!-- Empty state changes slightly when a category filter is active. -->
    <% if (!services || services.length === 0) { %>

      <div class="text-center py-5">

        <div class="icon-circle-lg mx-auto mb-3">
          <i
            class="bi bi-heart-fill"
            style="font-size:2rem;color:var(--accent);"
          ></i>
        </div>

        <h5 style="font-weight:700;color:var(--ink);">
          <%= selectedCategory
            ? t('fav.noServicesInCategory', { category: t('categories.' + selectedCategory, {}, selectedCategory) })
            : t('fav.noServicesTitle') %>
        </h5>

        <p style="color:var(--muted);">
          <%= selectedCategory
            ? t('fav.noServicesInCategoryBody', { category: t('categories.' + selectedCategory, {}, selectedCategory) })
            : t('fav.noServicesBody') %>
        </p>

        <% if (selectedCategory) { %>

          <a
            href="/marketplace?category=<%= selectedCategory %>"
            class="btn btn-primary btn-pill"
          >
            <%= t('fav.browseCategory', { category: t('categories.' + selectedCategory, {}, selectedCategory) }) %>
          </a>

        <% } else { %>

          <a
            href="/marketplace"
            class="btn btn-primary btn-pill"
          >
            <%= t('auth.browseMarketplace') %>
          </a>

        <% } %>

      </div>

    <% } else { %>

      <div class="row g-3">

        <% services.forEach(service => { %>

          <div class="col-md-6 col-lg-4">

            <div class="promo-card h-100">

              <div class="d-flex justify-content-between align-items-start mb-2">

                <div class="flex-grow-1 me-3">

                  <h5 style="
                    font-weight:700;
                    color:var(--ink);
                    margin-bottom:.35rem;
                  ">
                    <%= service.service_name %>
                  </h5>

                  <p class="promo-merchant mb-0">
                    <i class="bi bi-shop me-1"></i>
                    <%= service.merchant_name %>
                  </p>

                </div>

                <div class="promo-discount">
                  $<%= Number(service.price).toFixed(0) %>
                </div>

              </div>

              <p class="small text-muted mb-3">
                <%= service.description || t('fav.noDescription') %>
              </p>

              <div class="discount-pill mb-3">
                <i class="bi bi-grid"></i>
                <%= service.category ? t('categories.' + service.category, {}, service.category) : t('admin.table.generalCategory') %>
              </div>

              <p class="promo-date">
                <i class="bi bi-clock me-1"></i>
                <%= t('bookings.mins', { count: service.duration_mins }) %>
              </p>

              <div class="d-flex gap-2 mt-3">

                <a
                  href="/book?merchantId=<%= service.merchant_id %>&serviceId=<%= service.service_id %>"
                  class="btn btn-primary btn-sm"
                >
                  <%= t('bookings.bookNow') %>
                </a>

                <!-- Remove only this saved service from the customer's favourites. -->
                <form
                  action="/favourite/service/remove/<%= service.service_id %>"
                  method="POST"
                >

                  <button
                    type="submit"
                    class="btn btn-outline-danger btn-sm"
                  >
                    <i class="bi bi-heart-fill"></i>
                  </button>

                </form>

              </div>

            </div>

          </div>

        <% }) %>

      </div>

    <% } %>

  </div>

</div>

<script>
window.addEventListener('DOMContentLoaded', () => {
  const params = new URLSearchParams(window.location.search);
  const servicesSection = document.getElementById('favourite-services');

  if (params.has('category') && servicesSection) {
    setTimeout(() => {
      servicesSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 200);
  }
});

document.addEventListener('submit', async (event) => {
  const form = event.target.closest('.js-remove-merchant-favourite-form');
  if (!form) return;

  event.preventDefault();
  event.stopPropagation();

  const button = form.querySelector('button[type="submit"]');
  const item = form.closest('.js-favourite-merchant-item');
  if (button) button.disabled = true;

  try {
    const response = await fetch(form.action, {
      method: 'POST',
      headers: {
        Accept: 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
      },
      body: new FormData(form),
    });

    const result = await response.json();
    if (!response.ok || !result.success || result.favourited) {
      throw new Error(result.error || 'Could not remove merchant from favourites.');
    }

    if (item) item.remove();

    const grid = document.getElementById('favourite-merchants-grid');
    const emptyState = document.getElementById('favourite-merchants-empty');
    if (grid && emptyState && !grid.querySelector('.js-favourite-merchant-item')) {
      emptyState.style.display = '';
    }
  } catch (err) {
    console.error(err);
    alert(err.message || 'Could not remove merchant from favourites.');
    if (button) button.disabled = false;
  }
});
</script>

<%- include('../partials/footer') %>
