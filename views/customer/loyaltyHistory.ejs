<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  function formatDateTime(value) {
    return new Date(value).toLocaleString('en-SG', {
      day: 'numeric', month: 'short', year: 'numeric',
      hour: 'numeric', minute: '2-digit',
    });
  }
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:900px;">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <p class="section-label mb-2"><%= t('loyalty.eyebrow') %></p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('loyalty.historyTitle') %></h2>
        <p style="color:var(--muted);margin:0;"><%= t('loyalty.historySub') %></p>
      </div>
      <a href="/loyalty" class="btn btn-outline-secondary btn-pill">
        <i class="bi bi-arrow-left me-2"></i><%= t('wallet.backToWallet') %>
      </a>
    </div>

    <div class="wallet-panel mb-4">
      <div class="d-flex justify-content-between align-items-center gap-3">
        <span style="color:var(--muted);font-weight:700;"><%= t('loyalty.availablePoints') %></span>
        <strong class="mono" style="font-size:1.75rem;color:var(--ink);"><%= Number(wallet.points_balance || 0) %></strong>
      </div>
    </div>

    <div class="wallet-panel">
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (!transactions.length) { %>
        <div class="text-center py-5">
          <div class="wallet-empty-icon mx-auto"><i class="bi bi-receipt"></i></div>
          <p style="color:var(--muted);margin:.75rem 0 0;"><%= t('loyalty.noActivity') %></p>
        </div>
      <% } %>

      <% transactions.forEach(item => {
        const points = Number(item.points_amount || 0);
        const isEarn = points > 0;
      %>
        <div class="wallet-activity-row d-flex gap-3 py-3">
          <div class="wallet-activity-icon <%= isEarn ? 'earn' : 'redeem' %>">
            <i class="bi <%= isEarn ? 'bi-plus-lg' : 'bi-ticket-perforated' %>"></i>
          </div>
          <div style="flex:1;">
            <div class="d-flex justify-content-between gap-3">
              <p style="font-weight:700;color:var(--ink);margin:0;"><%= item.description %></p>
              <span class="mono wallet-points-change <%= isEarn ? 'earn' : 'redeem' %>"><%= points > 0 ? '+' : '' %><%= points %></span>
            </div>
            <p class="small" style="color:var(--muted);margin:0;"><%= formatDateTime(item.created_at) %></p>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
