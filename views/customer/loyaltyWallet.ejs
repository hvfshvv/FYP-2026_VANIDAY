<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  // Formats a voucher discount value into a readable label.
  function fmtDiscount(type, value) {
    if (type === 'percent') return Number(value).toFixed(0) + '% off';
    return 'S$' + Number(value).toFixed(2) + ' off';
  }

  // Prepare display values and helper functions for the wallet page.
  const balance = Number(wallet.points_balance || 0);
  const lifetimeEarned = Number(wallet.lifetime_points_earned || 0);
  const lifetimeRedeemed = Number(wallet.lifetime_points_redeemed || 0);
  const lifetimeSpend = Number(tier.lifetimeSpend || 0);
  const nextTier = tier.nextTier || null;
  const tierProgress = nextTier
    ? Math.min(100, Math.round((lifetimeSpend / nextTier.minSpend) * 100))
    : 100;

  function formatDate(value) {
    return new Date(value).toLocaleDateString('en-SG', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }
%>

<!-- Loyalty wallet: customer points, tier progress, redeemable rewards and activity. -->
<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:1120px;">
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <p class="section-label mb-2">Loyalty points</p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('nav.loyaltyRewards') %></h2>
        <p style="color:var(--muted);margin:0;">Earn points equal to 10% of every booking total.</p>
      </div>
      <a href="/marketplace" class="btn btn-primary btn-pill">
        <i class="bi bi-calendar-plus me-2"></i>Earn More Points
      </a>
    </div>

    <!-- Success/error messages after reward redemption attempts. -->
    <% if (error) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
        <i class="bi bi-check-circle me-2"></i><%= success %>
      </div>
    <% } %>

    <!-- Wallet summary and tier progress. -->
    <section class="row g-3 mb-4">
      <div class="col-lg-5">
        <div class="wallet-panel wallet-panel-lg">
          <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
            <div>
              <p style="color:var(--muted);font-size:.875rem;margin:0 0 .25rem;">Available points</p>
              <h1 style="font-family:var(--font-mono);font-weight:800;font-size:3rem;letter-spacing:0;margin:0;color:var(--ink);"><%= balance %></h1>
            </div>
            <div class="wallet-hero-icon">
              <i class="bi bi-wallet2"></i>
            </div>
          </div>

          <div class="d-flex flex-wrap gap-2 mb-4">
            <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);font-size:.85rem;padding:.55rem .8rem;">
              <i class="bi <%= tier.icon %> me-1"></i><%= tier.name %> tier
            </span>
            <span class="badge rounded-pill" style="background:var(--canvas);color:var(--muted);border:1px solid var(--border);font-size:.85rem;padding:.55rem .8rem;">
              S$<%= lifetimeSpend.toFixed(2) %> lifetime spend
            </span>
          </div>

          <% if (nextTier) { %>
            <div class="d-flex justify-content-between small mb-2" style="color:var(--muted);font-weight:600;">
              <span><%= tier.name %></span>
              <span>S$<%= Number(tier.spendToNextTier || 0).toFixed(2) %> to <%= nextTier.name %></span>
            </div>
              <!-- Width is applied by the small script at the bottom of the page. -->
              <div class="progress" style="height:10px;">
              <div class="progress-bar wallet-tier-progress" role="progressbar" data-progress="<%= tierProgress %>" aria-valuenow="<%= tierProgress %>" aria-valuemin="0" aria-valuemax="100"></div>
            </div>
          <% } else { %>
            <div class="rounded-xl p-3" style="background:var(--success-bg);color:var(--success);font-weight:600;">
              <i class="bi bi-stars me-1"></i>You have reached the highest loyalty tier.
            </div>
          <% } %>
        </div>
      </div>

      <div class="col-lg-7">
        <div class="row g-3 h-100">
          <div class="col-sm-4">
            <div class="stat-card h-100">
              <div class="stat-label">Earned</div>
              <div class="stat-value"><%= lifetimeEarned %></div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="stat-card h-100">
              <div class="stat-label">Redeemed</div>
              <div class="stat-value"><%= lifetimeRedeemed %></div>
            </div>
          </div>
          <div class="col-sm-4">
            <div class="stat-card h-100">
              <div class="stat-label">Earn Rate</div>
              <div class="stat-value">10%</div>
            </div>
          </div>
          <div class="col-12">
            <div class="wallet-panel wallet-panel-sm">
              <p style="font-weight:800;color:var(--ink);margin:0 0 .75rem;">Tier ladder</p>
              <div class="d-flex flex-wrap gap-2">
                <% tiers.forEach(item => { %>
                  <% if (item.name === tier.name) { %>
                    <span class="badge rounded-pill wallet-tier-badge active"><%= item.name %> from S$<%= item.minSpend %></span>
                  <% } else { %>
                    <span class="badge rounded-pill wallet-tier-badge"><%= item.name %> from S$<%= item.minSpend %></span>
                  <% } %>
                <% }) %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Reward catalogue and recent point transactions. -->
    <section class="row g-4">
      <div class="col-lg-7">
        <div class="wallet-panel">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h5 style="font-weight:800;color:var(--ink);margin:0;">Redeem vouchers</h5>
            <span class="small" style="color:var(--muted);">Special vouchers unlock by tier</span>
          </div>

          <% if (!rewards.length) { %>
            <div class="text-center py-4">
              <div class="wallet-empty-icon mx-auto">
                <i class="bi bi-stars"></i>
              </div>
              <p style="color:var(--muted);margin:.75rem 0 0;">No loyalty vouchers are available right now.</p>
            </div>
          <% } else { %>
          <div class="row g-3">
            <!-- Each reward has flags from loyaltyModel.decorateRewards. -->
            <% rewards.forEach(reward => { %>
              <div class="col-md-6">
                <div class="wallet-reward-card <%= reward.redeemable ? '' : 'locked' %>">
                  <div class="d-flex justify-content-between gap-2 mb-2">
                    <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);"><%= reward.valueLabel %></span>
                    <span class="small mono" style="color:var(--muted);"><%= reward.pointsCost %> pts</span>
                  </div>
                  <h6 style="font-weight:800;color:var(--ink);margin-bottom:.35rem;"><%= reward.title %></h6>
                  <p class="small" style="color:var(--muted);margin-bottom:.85rem;"><%= reward.description %></p>
                  <p class="small" style="color:var(--muted);margin-bottom:1rem;">
                    <i class="bi bi-lock me-1"></i><%= reward.minTier %> tier
                  </p>

                  <% if (reward.redeemable) { %>
                    <form method="POST" action="/loyalty/redeem/<%= reward.id %>" onsubmit="return confirm('Redeem this voucher with your loyalty points?');">
                      <button class="btn btn-primary btn-sm btn-pill w-100" type="submit">
                        <i class="bi bi-ticket-perforated me-1"></i>Redeem
                      </button>
                    </form>
                  <% } else if (!reward.tierUnlocked) { %>
                    <button class="btn btn-outline-secondary btn-sm btn-pill w-100" disabled>
                      <i class="bi bi-lock me-1"></i>Tier Locked
                    </button>
                  <% } else { %>
                    <button class="btn btn-outline-secondary btn-sm btn-pill w-100" disabled>
                      <i class="bi bi-plus-circle me-1"></i><%= reward.pointsShort %> points short
                    </button>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
          <% } %>
        </div>
      </div>

      <div class="col-lg-5">
        <div class="wallet-panel">
          <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
            <h5 style="font-weight:800;color:var(--ink);margin:0;">Recent activity</h5>
            <a href="/loyalty/history" class="btn btn-outline-secondary btn-sm btn-pill">
              View all
            </a>
          </div>
          <!-- Recent point activity, newest first. -->
          <% if (!transactions.length) { %>
            <div class="text-center py-4">
              <div class="wallet-empty-icon">
                <i class="bi bi-receipt"></i>
              </div>
              <p style="color:var(--muted);margin:0;">Your point history will appear here.</p>
            </div>
          <% } else { %>
            <% transactions.forEach((item, index) => {
              const points = Number(item.points_amount || 0);
              const isEarn = points > 0;
            %>
              <div class="wallet-activity-row d-flex gap-3 py-3">
                <div class="wallet-activity-icon <%= isEarn ? 'earn' : 'redeem' %>">
                  <% if (isEarn) { %>
                    <i class="bi bi-plus-lg"></i>
                  <% } else { %>
                    <i class="bi bi-ticket-perforated"></i>
                  <% } %>
                </div>
                <div style="flex:1;">
                  <div class="d-flex justify-content-between gap-2">
                    <p style="font-weight:700;color:var(--ink);margin:0;"><%= item.description %></p>
                    <span class="mono wallet-points-change <%= isEarn ? 'earn' : 'redeem' %>"><%= points > 0 ? '+' : '' %><%= points %></span>
                  </div>
                  <p class="small" style="color:var(--muted);margin:0;"><%= formatDate(item.created_at) %></p>
                </div>
              </div>
            <% }) %>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Browse and claim available admin-created vouchers. -->
    <section class="mt-4 mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
          <p class="section-label mb-1">Browse vouchers</p>
          <h5 style="font-weight:800;color:var(--ink);margin:0;">Available Vouchers</h5>
        </div>
        <span class="small" style="color:var(--muted);"><%= (availableVouchers || []).length %> available</span>
      </div>

      <% if (!availableVouchers || !availableVouchers.length) { %>
        <div class="wallet-panel text-center py-4">
          <div class="wallet-empty-icon mx-auto"><i class="bi bi-ticket-perforated"></i></div>
          <p style="color:var(--muted);margin:.75rem 0 0;">No vouchers available right now. Check back soon.</p>
        </div>
      <% } else { %>
        <div class="row g-3">
          <% availableVouchers.forEach(v => { %>
            <div class="col-sm-6 col-lg-4 col-xl-3">
              <div class="wallet-reward-card h-100 d-flex flex-column <%= (v.already_claimed || v.is_full) ? 'locked' : '' %>">

                <div class="d-flex justify-content-between align-items-start mb-2 gap-2 flex-wrap">
                  <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);font-size:.8rem;">
                    <%= fmtDiscount(v.discount_type, v.discount_value) %>
                  </span>
                  <span class="badge rounded-pill" style="background:var(--canvas);color:var(--muted);border:1px solid var(--border);font-size:.75rem;">
                    <i class="bi bi-<%= v.voucher_type === 'platform' ? 'globe' : 'shop' %> me-1"></i><%= v.voucher_type === 'platform' ? 'Platform-wide' : (v.merchant_name || 'Merchant') %>
                  </span>
                </div>

                <h6 style="font-weight:800;color:var(--ink);margin-bottom:.35rem;">
                  <%= v.campaign_name || v.voucher_code %>
                </h6>

                <% if (v.min_spend) { %>
                  <p class="small" style="color:var(--muted);margin-bottom:.25rem;">
                    <i class="bi bi-wallet me-1"></i>Min. spend S$<%= Number(v.min_spend).toFixed(2) %>
                  </p>
                <% } %>

                <p class="small" style="color:var(--muted);margin-bottom:auto;padding-bottom:.85rem;">
                  <i class="bi bi-calendar3 me-1"></i>Expires <%= formatDate(v.end_date) %>
                </p>

                <% if (v.already_claimed) { %>
                  <button class="btn btn-outline-secondary btn-sm btn-pill w-100" disabled>
                    <i class="bi bi-check-circle me-1"></i>Already Claimed
                  </button>
                <% } else if (v.is_full) { %>
                  <button class="btn btn-outline-secondary btn-sm btn-pill w-100" disabled>
                    <i class="bi bi-x-circle me-1"></i>Fully Claimed
                  </button>
                <% } else { %>
                  <form method="POST" action="/loyalty/voucher/claim/<%= v.voucher_id %>">
                    <button class="btn btn-primary btn-sm btn-pill w-100" type="submit">
                      <i class="bi bi-ticket-perforated me-1"></i>Claim
                    </button>
                  </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
      <% } %>
    </section>

    <!-- Vouchers the customer has already claimed. -->
    <section class="mt-2 mb-2">
      <%
        const walletVouchers = Array.isArray(claimedVouchers) ? claimedVouchers : [];
        const voucherCounts = walletVouchers.reduce((acc, voucher) => {
          const status = voucher.display_status || 'expired';
          acc[status] = (acc[status] || 0) + 1;
          acc.all += 1;
          return acc;
        }, { active: 0, used: 0, expired: 0, all: 0 });
      %>
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-3 mb-3">
        <div>
          <p class="section-label mb-1">My wallet</p>
          <h5 style="font-weight:800;color:var(--ink);margin:0;">My Vouchers</h5>
        </div>
        <% if (walletVouchers.length) { %>
          <div class="d-flex flex-wrap gap-2" role="group" aria-label="Filter my vouchers">
            <button type="button" class="btn btn-primary btn-sm btn-pill voucher-filter-btn" data-voucher-filter="active">
              Active (<%= voucherCounts.active %>)
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm btn-pill voucher-filter-btn" data-voucher-filter="used">
              Used (<%= voucherCounts.used %>)
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm btn-pill voucher-filter-btn" data-voucher-filter="expired">
              Expired (<%= voucherCounts.expired %>)
            </button>
            <button type="button" class="btn btn-outline-secondary btn-sm btn-pill voucher-filter-btn" data-voucher-filter="all">
              All (<%= voucherCounts.all %>)
            </button>
          </div>
        <% } %>
      </div>

      <div class="wallet-panel">
        <% if (!walletVouchers.length) { %>
          <div class="text-center py-4">
            <div class="wallet-empty-icon mx-auto"><i class="bi bi-ticket-perforated"></i></div>
            <p style="color:var(--muted);margin:.75rem 0 0;">No vouchers claimed yet. Browse available vouchers above to get started.</p>
          </div>
        <% } else { %>
          <div class="row g-3" id="walletVoucherGrid">
            <% walletVouchers.forEach(cv => { %>
              <%
                const statusStyles = {
                  active:  { bg: 'var(--success-bg)', color: 'var(--success)',  label: 'Active'  },
                  used:    { bg: 'var(--canvas)',      color: 'var(--muted)',    label: 'Used'    },
                  expired: { bg: 'var(--warn-bg)',     color: 'var(--warn)',     label: 'Expired' },
                };
                const st = statusStyles[cv.display_status] || statusStyles.expired;
              %>
              <div class="col-md-6 col-lg-4 wallet-voucher-item" data-voucher-status="<%= cv.display_status %>" style="<%= cv.display_status === 'active' ? '' : 'display:none;' %>">
                <div class="wallet-reward-card <%= cv.display_status !== 'active' ? 'locked' : '' %>">
                  <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                    <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);">
                      <%= fmtDiscount(cv.discount_type, cv.discount_value) %>
                    </span>
                    <span class="badge rounded-pill small" style="background:<%= st.bg %>;color:<%= st.color %>;">
                      <%= st.label %>
                    </span>
                  </div>

                  <h6 style="font-weight:800;color:var(--ink);margin-bottom:.2rem;">
                    <%= cv.campaign_name || cv.voucher_code %>
                  </h6>

                  <p class="small mono" style="color:var(--muted);margin-bottom:.5rem;letter-spacing:.04em;">
                    <%= cv.voucher_code %>
                  </p>

                  <% if (cv.min_spend) { %>
                    <p class="small" style="color:var(--muted);margin-bottom:.35rem;">
                      <i class="bi bi-wallet me-1"></i>Min. spend S$<%= Number(cv.min_spend).toFixed(2) %>
                    </p>
                  <% } %>

                  <p class="small" style="color:var(--muted);margin-bottom:.35rem;">
                    <i class="bi bi-<%= cv.merchant_name ? 'shop' : 'globe' %> me-1"></i>
                    <%= cv.merchant_name || 'Platform-wide' %>
                  </p>

                  <p class="small" style="color:var(--muted);margin:0;">
                    <i class="bi bi-calendar3 me-1"></i>Expires <%= formatDate(cv.voucher_expiry) %>
                  </p>
                </div>
              </div>
            <% }) %>
          </div>
          <div id="walletVoucherEmptyFilter" class="text-center py-4" style="<%= voucherCounts.active ? 'display:none;' : '' %>">
            <div class="wallet-empty-icon mx-auto"><i class="bi bi-ticket-perforated"></i></div>
            <p style="color:var(--muted);margin:.75rem 0 0;">No active vouchers right now.</p>
          </div>
        <% } %>
      </div>
    </section>

  </div>
</main>

<script>
// CSS cannot read data-progress directly, so JS applies the progress width.
document.querySelectorAll('.wallet-tier-progress').forEach((bar) => {
  bar.style.width = `${bar.dataset.progress || 0}%`;
});

document.querySelectorAll('.voucher-filter-btn').forEach((button) => {
  button.addEventListener('click', () => {
    const filter = button.dataset.voucherFilter || 'active';
    let visibleCount = 0;

    document.querySelectorAll('.voucher-filter-btn').forEach((item) => {
      const active = item === button;
      item.classList.toggle('btn-primary', active);
      item.classList.toggle('btn-outline-secondary', !active);
    });

    document.querySelectorAll('.wallet-voucher-item').forEach((item) => {
      const visible = filter === 'all' || item.dataset.voucherStatus === filter;
      item.style.display = visible ? '' : 'none';
      if (visible) visibleCount += 1;
    });

    const empty = document.getElementById('walletVoucherEmptyFilter');
    if (empty) {
      const label = filter === 'all' ? 'matching' : filter;
      empty.querySelector('p').textContent = `No ${label} vouchers right now.`;
      empty.style.display = visibleCount ? 'none' : '';
    }
  });
});
</script>

<%- include('../partials/footer') %>
