<% locals.hideCatNav = true %>
<%- include('../partials/header') %>
<%
  const parseDate = value => {
    const parsed = value ? new Date(value) : null;
    return parsed && !Number.isNaN(parsed.getTime()) ? parsed : null;
  };
  const dateInputValue = value => {
    const parsed = parseDate(value);
    return parsed ? parsed.toISOString().slice(0, 10) : '';
  };
  const countryCodes = [
    { code: '+65', label: 'Singapore', flag: 'SG' },
    { code: '+60', label: 'Malaysia', flag: 'MY' },
    { code: '+62', label: 'Indonesia', flag: 'ID' },
    { code: '+66', label: 'Thailand', flag: 'TH' },
    { code: '+63', label: 'Philippines', flag: 'PH' },
    { code: '+84', label: 'Vietnam', flag: 'VN' },
    { code: '+91', label: 'India', flag: 'IN' },
    { code: '+86', label: 'China', flag: 'CN' },
    { code: '+852', label: 'Hong Kong', flag: 'HK' },
    { code: '+886', label: 'Taiwan', flag: 'TW' },
    { code: '+81', label: 'Japan', flag: 'JP' },
    { code: '+82', label: 'South Korea', flag: 'KR' },
    { code: '+61', label: 'Australia', flag: 'AU' },
    { code: '+44', label: 'United Kingdom', flag: 'UK' },
    { code: '+1', label: 'United States / Canada', flag: 'US/CA' },
  ];
  const rawPhone = String(accountUser.phone || '').trim();
  const matchedCountry = countryCodes
    .slice()
    .sort((a, b) => b.code.length - a.code.length)
    .find(country => rawPhone.startsWith(country.code));
  const selectedCountryCode = matchedCountry ? matchedCountry.code : '+65';
  const localPhone = rawPhone.startsWith(selectedCountryCode)
    ? rawPhone.slice(selectedCountryCode.length)
    : rawPhone.replace(/[^\d]/g, '');
  const firstName = String(accountUser.full_name || '').split(' ')[0] || t('account.customer');
%>

<main class="account-page">
  <div class="account-shell">
    <div class="account-heading">
      <div>
        <p class="section-label mb-2"><%= t('account.eyebrow') %></p>
        <h1><%= t('account.welcome', { name: firstName }) %></h1>
        <p><%= t('account.subtitle') %></p>
      </div>
    </div>

    <% if (success) { %>
    <div class="account-alert success"><i class="bi bi-check-circle"></i><%= success %></div>
    <% } %>
    <% if (error) { %>
    <div class="account-alert danger"><i class="bi bi-exclamation-circle"></i><%= error %></div>
    <% } %>

    <div class="account-grid">
      <section class="account-content">
        <div class="account-section">
          <div class="account-section-head">
            <div>
              <h2><%= t('account.sections.accountInfo') %></h2>
            </div>
          </div>

          <div class="account-info-grid">
            <div>
              <span><%= t('account.fields.name') %></span>
              <strong><%= accountUser.full_name %></strong>
            </div>
            <div>
              <span><%= t('account.fields.email') %></span>
              <strong><%= accountUser.email %></strong>
            </div>
            <div>
              <span><%= t('account.fields.phone') %></span>
              <strong><%= accountUser.phone || t('common.notSelected') %></strong>
              <a href="#accountPhoneField" class="account-inline-edit"><%= t('account.actions.editPhone') %></a>
            </div>
          </div>
        </div>

        <div class="account-two-col">
          <form class="account-section" method="POST" action="/account/profile">
            <div class="account-section-head">
              <div>
                <p class="section-label mb-1"><%= t('account.sections.profile') %></p>
                <h2><%= t('account.sections.editContact') %></h2>
              </div>
            </div>

            <label class="account-field">
              <span><%= t('account.fields.name') %></span>
              <input type="text" name="full_name" value="<%= accountUser.full_name || '' %>" maxlength="120" required>
            </label>

            <label class="account-field">
              <span><%= t('account.fields.phone') %></span>
              <div class="account-phone-row">
                <select class="account-country-select" name="country_code" aria-label="<%= t('account.fields.countryCode') %>">
                  <% countryCodes.forEach(country => { %>
                  <option value="<%= country.code %>" <%= country.code === selectedCountryCode ? 'selected' : '' %>><%= country.flag %>  <%= country.code %>  <%= country.label %></option>
                  <% }) %>
                </select>
                <input id="accountPhoneField" type="tel" name="phone_local" value="<%= localPhone %>" inputmode="tel" maxlength="20">
              </div>
            </label>

            <label class="account-field">
              <span><%= t('account.fields.dateOfBirth') %></span>
              <input type="date" name="date_of_birth" value="<%= dateInputValue(accountUser.date_of_birth) %>">
            </label>

            <button class="btn btn-primary btn-pill account-submit" type="submit">
              <i class="bi bi-save me-1"></i><%= t('account.actions.saveProfile') %>
            </button>
          </form>

          <form class="account-section" method="POST" action="/account/password" id="accountPasswordForm">
            <div class="account-section-head">
              <div>
                <p class="section-label mb-1"><%= t('account.sections.security') %></p>
                <h2><%= t('account.sections.changePassword') %></h2>
              </div>
            </div>

            <label class="account-field">
              <span><%= t('account.fields.currentPassword') %></span>
              <input type="password" name="current_password" id="currentPasswordField" autocomplete="current-password" required>
              <small class="account-field-note is-empty" id="currentPasswordNote"></small>
            </label>

            <label class="account-field">
              <span><%= t('account.fields.newPassword') %></span>
              <input type="password" name="new_password" id="newPasswordField" autocomplete="new-password" minlength="6" disabled required>
            </label>

            <label class="account-field">
              <span><%= t('account.fields.confirmPassword') %></span>
              <input type="password" name="confirm_password" id="confirmPasswordField" autocomplete="new-password" minlength="6" disabled required>
              <small class="account-field-note" id="confirmPasswordNote"></small>
            </label>

            <button class="btn btn-outline-secondary btn-pill account-submit" type="submit" id="passwordSubmitBtn" disabled>
              <i class="bi bi-shield-lock me-1"></i><%= t('account.actions.updatePassword') %>
            </button>
          </form>
        </div>
      </section>
    </div>
  </div>
</main>

<script>
(function setupAccountPasswordGate() {
  const copy = <%- JSON.stringify({
    valid: t('account.passwordGate.valid', {}, 'Valid'),
    invalid: t('account.passwordGate.invalid', {}, 'Invalid'),
    mismatch: t('account.passwordGate.mismatch', {}, 'Passwords do not match.'),
    checkFailed: t('account.passwordGate.checkFailed', {}, 'Could not check password.'),
  }).replace(/</g, '\\u003c') %>;
  const currentField = document.getElementById('currentPasswordField');
  const newField = document.getElementById('newPasswordField');
  const confirmField = document.getElementById('confirmPasswordField');
  const submitBtn = document.getElementById('passwordSubmitBtn');
  const currentNote = document.getElementById('currentPasswordNote');
  const confirmNote = document.getElementById('confirmPasswordNote');
  let passwordCheckTimer = null;
  let currentPasswordValid = false;

  if (!currentField || !newField || !confirmField || !submitBtn) return;

  function setNewPasswordEnabled(enabled) {
    currentPasswordValid = enabled;
    newField.disabled = !enabled;
    confirmField.disabled = !enabled;
    if (!enabled) {
      newField.value = '';
      confirmField.value = '';
    }
    updateSubmitState();
  }

  function updateSubmitState() {
    const newPassword = newField.value;
    const confirmPassword = confirmField.value;
    const matches = newPassword.length >= 6 && newPassword === confirmPassword;

    if (!currentPasswordValid) {
      submitBtn.disabled = true;
      confirmNote.textContent = '';
      return;
    }

    if (!newPassword && !confirmPassword) {
      confirmNote.textContent = '';
      confirmNote.className = 'account-field-note is-empty';
    } else if (!matches) {
      confirmNote.textContent = copy.mismatch;
      confirmNote.className = 'account-field-note danger';
    } else {
      confirmNote.textContent = '';
      confirmNote.className = 'account-field-note is-empty';
    }

    submitBtn.disabled = !matches;
  }

  async function verifyCurrentPassword() {
    const value = currentField.value;
    if (!value) {
      currentNote.textContent = '';
      currentNote.className = 'account-field-note is-empty';
      setNewPasswordEnabled(false);
      return;
    }

    currentNote.textContent = '';
    currentNote.className = 'account-field-note is-empty';

    try {
      const response = await fetch('/account/password/check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify({ current_password: value }),
      });
      const result = await response.json();
      if (result.valid) {
        currentNote.textContent = copy.valid;
        currentNote.className = 'account-field-note success';
        setNewPasswordEnabled(true);
      } else {
        currentNote.textContent = copy.invalid;
        currentNote.className = 'account-field-note danger';
        setNewPasswordEnabled(false);
      }
    } catch (err) {
      currentNote.textContent = copy.checkFailed;
      currentNote.className = 'account-field-note danger';
      setNewPasswordEnabled(false);
    }
  }

  currentField.addEventListener('input', () => {
    window.clearTimeout(passwordCheckTimer);
    setNewPasswordEnabled(false);
    passwordCheckTimer = window.setTimeout(verifyCurrentPassword, 450);
  });
  newField.addEventListener('input', updateSubmitState);
  confirmField.addEventListener('input', updateSubmitState);
})();
</script>

<%- include('../partials/footer') %>
