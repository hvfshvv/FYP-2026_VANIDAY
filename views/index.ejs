<!-- ═══════ MERCHANT CTA ═══════ -->
<!-- Combined marketplace section: browse merchants on the same page. -->
<section class="section" id="marketplace" style="background:var(--canvas);border-top:1px solid var(--border);scroll-margin-top:var(--nav-h);">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-label"><%= selectedCategory ? 'Filtered marketplace' : 'Marketplace' %></p>
        <h2 class="section-title"><%= selectedCategory ? selectedCategory + ' merchants' : 'Browse merchants' %></h2>
        <p class="section-sub">
          <%= selectedCategory
            ? 'Showing approved ' + selectedCategory.toLowerCase() + ' merchants in Singapore.'
            : 'Explore approved beauty and wellness merchants, then choose a service to book.' %>
        </p>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (selectedCategory) { %>
        <a href="/#marketplace" class="btn btn-outline-secondary btn-sm btn-pill" data-category-filter="">
          <i class="bi bi-x-lg me-1"></i>Clear filter
        </a>
        <% } %>
      </div>
    </div>

    <nav class="cat-strip marketplace-category-strip" aria-label="Browse merchants by category">
      <div class="cat-strip-inner">
        <% [
          { icon:'bi-scissors',    label:'Hair'       },
          { icon:'bi-brush',       label:'Nails'      },
          { icon:'bi-droplet',     label:'Facial'     },
          { icon:'bi-hand-index',  label:'Massage'    },
          { icon:'bi-heart-pulse', label:'Wellness'   },
          { icon:'bi-activity',    label:'Body'       },
          { icon:'bi-eye',         label:'Aesthetics' },
          { icon:'bi-droplet-half', label:'Spa'       },
        ].forEach(c => { %>
        <a
          href="/?category=<%= encodeURIComponent(c.label) %>#marketplace"
          class="cat-strip-link <%= selectedCategory === c.label ? 'active' : '' %>"
          data-category-filter="<%= c.label %>"
          aria-label="<%= c.label %> merchants"
        >
          <i class="bi <%= c.icon %>"></i><%= c.label %>
        </a>
        <% }) %>
      </div>
    </nav>

    <% if (!merchants || merchants.length === 0) { %>
      <div class="text-center py-5">
        <div class="icon-circle-lg mx-auto mb-3">
          <i class="bi bi-shop" style="font-size:2rem;color:var(--accent);"></i>
        </div>
        <h5 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;">
          <%= selectedCategory ? 'No ' + selectedCategory.toLowerCase() + ' merchants available' : 'No merchants available' %>
        </h5>
        <p style="color:var(--muted);">Please check back again soon.</p>
      </div>
    <% } else { %>
      <div class="row g-3">
        <% merchants.forEach(merchant => { %>
          <div class="col-lg-3 col-md-6">
            <a href="/marketplace/merchant/<%= merchant.merchant_id %><%= selectedCategory ? '?category=' + encodeURIComponent(selectedCategory) : '' %>" class="merchant-card" style="position:relative;">
              <% if (user && user.role === 'customer') { %>
                <% const isFav = favouriteMerchantIds && favouriteMerchantIds.includes(merchant.merchant_id); %>
                <form
                  class="js-merchant-favourite-form"
                  action="<%= isFav ? '/favourite/merchant/remove/' + merchant.merchant_id : '/favourite/merchant/' + merchant.merchant_id %>"
                  data-add-url="/favourite/merchant/<%= merchant.merchant_id %>"
                  data-remove-url="/favourite/merchant/remove/<%= merchant.merchant_id %>"
                  data-favourited="<%= isFav ? '1' : '0' %>"
                  method="POST"
                  style="position:absolute;top:12px;right:12px;z-index:5;"
                  onclick="event.stopPropagation();"
                >
                  <button type="submit" style="width:36px;height:36px;border-radius:999px;border:none;background:white;color:var(--accent);box-shadow:var(--shadow);">
                    <i class="bi <%= isFav ? 'bi-heart-fill' : 'bi-heart' %>"></i>
                  </button>
                </form>
              <% } %>

              <% if (merchant.image_path) { %>
                <div class="card-img-wrapper">
                  <img src="<%= merchant.image_path %>" class="card-img" alt="<%= merchant.merchant_name %>" loading="lazy" />
                </div>
              <% } else { %>
                <div class="card-no-img"><i class="bi bi-shop"></i></div>
              <% } %>

              <div class="card-body">
                <div class="card-top">
                  <h6 class="card-title"><%= merchant.merchant_name %></h6>
                </div>
                <p class="card-meta"><%= merchant.description || 'Beauty and wellness merchant' %></p>
                <div class="discount-pill">
                  <i class="bi bi-grid"></i><%= merchant.service_categories || merchant.category || 'General' %>
                </div>
                <div class="info-row">
                  <i class="bi bi-star-fill" style="color:#f59e0b;"></i>
                  <span><%= ratingText(merchant) %></span>
                </div>
                <div class="info-row">
                  <i class="bi bi-geo-alt"></i>
                  <span><%= merchant.address || 'Singapore' %></span>
                </div>
                <div class="info-row align-items-start" title="<%= merchant.operating_hours || 'Operating hours not set' %>">
                  <i class="bi bi-clock"></i>
                  <span>
                    <% operatingHoursLines(merchant).forEach(line => { %>
                      <span style="display:block;"><%= line %></span>
                    <% }) %>
                  </span>
                </div>
              </div>
            </a>
          </div>
        <% }) %>
      </div>
    <% } %>
  </div>
</section>

<script>
function scrollToCategories(e) {
  e.preventDefault();
  document.getElementById('marketplace').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

window.addEventListener('DOMContentLoaded', () => {
  const params = new URLSearchParams(window.location.search);
  const marketplace = document.getElementById('marketplace');

  if (params.has('category') && marketplace) {
    setTimeout(() => {
      marketplace.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }, 250);
  }
});

document.addEventListener('click', async (event) => {
  const link = event.target.closest('[data-category-filter]');
  if (!link || window.location.pathname !== '/') return;

  event.preventDefault();

  const category = link.dataset.categoryFilter;
  const url = category
    ? `/?category=${encodeURIComponent(category)}`
    : '/';

  try {
    const response = await fetch(url, {
      headers: { 'X-Requested-With': 'XMLHttpRequest' },
    });
    const html = await response.text();
    const doc = new DOMParser().parseFromString(html, 'text/html');
    const nextMarketplace = doc.getElementById('marketplace');
    const currentMarketplace = document.getElementById('marketplace');

    if (!nextMarketplace || !currentMarketplace) {
      window.location.href = link.href;
      return;
    }

    currentMarketplace.innerHTML = nextMarketplace.innerHTML;
    history.pushState(null, '', `${url}#marketplace`);
    currentMarketplace.scrollIntoView({ behavior: 'smooth', block: 'start' });
  } catch (err) {
    window.location.href = link.href;
  }
});

document.addEventListener('submit', async (event) => {
  const form = event.target.closest('.js-merchant-favourite-form');
  if (!form) return;

  event.preventDefault();
  event.stopPropagation();

  const button = form.querySelector('button[type="submit"]');
  const icon = form.querySelector('i');
  if (button) button.disabled = true;

  try {
    const response = await fetch(form.action, {
      method: 'POST',
      headers: {
        Accept: 'application/json',
        'X-Requested-With': 'XMLHttpRequest',
      },
      body: new FormData(form),
    });

    if (response.redirected) {
      window.location.href = response.url;
      return;
    }

    const result = await response.json();
    if (!response.ok || !result.success) {
      throw new Error(result.error || 'Could not update favourite.');
    }

    const favourited = Boolean(result.favourited);
    form.dataset.favourited = favourited ? '1' : '0';
    form.action = favourited
      ? (form.dataset.removeUrl || result.removeUrl)
      : (form.dataset.addUrl || result.addUrl);

    if (icon) {
      icon.classList.toggle('bi-heart-fill', favourited);
      icon.classList.toggle('bi-heart', !favourited);
    }
  } catch (err) {
    console.error(err);
    alert(err.message || 'Could not update favourite.');
  } finally {
    if (button) button.disabled = false;
  }
});

</script>

<%- include('partials/footer') %>
