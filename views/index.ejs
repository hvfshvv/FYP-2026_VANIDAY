<% locals.hideCatNav = true %>
<%- include('partials/header') %>

<!-- ═══════ HERO ═══════ -->
<section class="hero-section">
  <div class="container">
    <div class="hero-grid">

      <div class="anim-up">
        <p class="hero-eyebrow">Singapore's beauty platform</p>
        <h1 class="hero-title">
          Beauty &amp; wellness,<br/>
          <span style="color:var(--accent);">booked in seconds.</span>
        </h1>
        <p class="hero-sub">
          Discover top salons, spas, and wellness studios. Scan a QR code at the shop, choose your service, pay securely — no app required.
        </p>
        <div class="d-flex flex-wrap gap-2">
          <a href="#categories" class="btn btn-primary btn-pill btn-lg" onclick="scrollToCategories(event)">
            <i class="bi bi-grid me-1"></i>Browse services
          </a>
          <% if (!user) { %>
          <a href="/auth/register" class="btn btn-outline-secondary btn-pill btn-lg">
            <i class="bi bi-shop me-1"></i>List your business
          </a>
          <% } %>
        </div>
        <div class="hero-trust">
          <span><i class="bi bi-check-circle-fill"></i>No app needed</span>
          <span><i class="bi bi-check-circle-fill"></i>Instant booking</span>
          <span><i class="bi bi-check-circle-fill"></i>Secure payments</span>
        </div>
      </div>

      <div class="hero-visual anim-up anim-up-2 d-none d-lg-block">
        <div class="hero-img-grid">
          <img src="https://images.unsplash.com/photo-1560066984-138dadb4c035?w=500&h=460&fit=crop&auto=format" alt="Beauty salon interior" loading="eager" />
          <img src="https://images.unsplash.com/photo-1604654894610-df63bc536371?w=420&h=218&fit=crop&auto=format" alt="Nail treatment" loading="eager" />
          <img src="https://images.unsplash.com/photo-1519823551278-64ac92734fb1?w=420&h=218&fit=crop&auto=format" alt="Spa treatment" loading="lazy" />
        </div>
        <div class="hero-pill">
          <div>
            <p class="hero-pill-num">1,000+</p>
            <p class="hero-pill-text">Merchants<br/>on Uniday</p>
          </div>
          <div class="icon-circle" style="background:var(--accent-light);color:var(--accent);">
            <i class="bi bi-shop" style="font-size:1.25rem;"></i>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ═══════ HOW IT WORKS + QR — side by side ═══════ -->
<section class="section" style="background:var(--ink);">
  <div class="container">
    <div class="row g-5">

      <!-- Left: How it works -->
      <div class="col-lg-6 anim-up" style="border-right:1px solid rgba(255,255,255,.08);padding-right:3rem;">
        <p class="section-label" style="color:rgba(255,255,255,.45);">Simple process</p>
        <h2 class="section-title" style="color:#fff;letter-spacing:-.03em;">How Uniday works</h2>
        <p style="color:rgba(255,255,255,.55);margin-bottom:2rem;max-width:44ch;line-height:1.65;font-size:1rem;">
          From discovery to confirmed booking — the whole flow takes under five minutes.
        </p>
        <div class="d-flex flex-column gap-4">
          <% [
            ['bi-search',        '01', 'Discover',  'Browse hundreds of salons and wellness studios across Singapore.'],
            ['bi-calendar-check','02', 'Choose',    'Pick a service, date, and time that works for you.'],
            ['bi-credit-card',   '03', 'Pay & go',  'Secure Stripe payment — confirmation lands in your inbox instantly.'],
          ].forEach(([icon, num, title, desc]) => { %>
          <div class="d-flex align-items-start gap-3">
            <div class="icon-circle flex-shrink-0" style="background:rgba(225,29,72,.18);color:var(--accent);">
              <i class="bi <%= icon %>" style="font-size:1.05rem;"></i>
            </div>
            <div>
              <p style="font-weight:700;color:#fff;margin-bottom:.2rem;font-size:.9375rem;">
                <span style="color:var(--accent);font-family:var(--font-mono);font-size:.78rem;margin-right:.4rem;"><%= num %></span><%= title %>
              </p>
              <p style="color:rgba(255,255,255,.5);font-size:.875rem;margin-bottom:0;"><%= desc %></p>
            </div>
          </div>
          <% }) %>
        </div>
      </div>

      <!-- Right: QR cashless booking -->
      <div class="col-lg-6 anim-up anim-up-2" style="padding-left:3rem;">
        <p class="section-label" style="color:rgba(255,255,255,.45);">Key feature</p>
        <h2 class="section-title" style="color:#fff;letter-spacing:-.03em;">QR-based cashless booking</h2>
        <p style="color:rgba(255,255,255,.55);margin-bottom:2rem;max-width:44ch;line-height:1.65;font-size:1rem;">
          Walk in, scan the merchant's QR code, pick a service, and pay — all in under 60 seconds. No app, no hardware needed.
        </p>
        <div class="d-flex flex-column gap-4">
          <% [
            ['bi-phone',         'Scan',  "Point your phone camera at the merchant's QR code — no download needed."],
            ['bi-calendar-check','Book',  'Choose your service and a time slot that fits your schedule.'],
            ['bi-credit-card',   'Pay',   'Stripe-powered secure payment, confirmed instantly.'],
          ].forEach(([icon, title, desc]) => { %>
          <div class="d-flex align-items-start gap-3">
            <div class="icon-circle flex-shrink-0" style="background:rgba(225,29,72,.18);color:var(--accent);">
              <i class="bi <%= icon %>" style="font-size:1.05rem;"></i>
            </div>
            <div>
              <p style="font-weight:700;color:#fff;margin-bottom:.2rem;font-size:.9375rem;"><%= title %></p>
              <p style="color:rgba(255,255,255,.5);font-size:.875rem;margin-bottom:0;"><%= desc %></p>
            </div>
          </div>
          <% }) %>
        </div>
        <% if (!user) { %>
        <a href="/auth/register" class="btn btn-primary btn-pill mt-4">
          <i class="bi bi-shop me-2"></i>List your business free
        </a>
        <% } %>
      </div>

    </div>
  </div>
</section>

<!-- ═══════ CATEGORIES ═══════ -->
<section class="section" id="categories" style="scroll-margin-top:var(--nav-h);">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-label">Browse by type</p>
        <h2 class="section-title">What are you looking for?</h2>
        <p class="section-sub">Hundreds of services across Singapore — from a quick trim to a full spa day.</p>
      </div>
      <a href="/marketplace" class="btn btn-outline-secondary btn-sm btn-pill d-none d-md-inline-flex">View all</a>
    </div>
    <div class="cat-grid">
      <% [
        { icon:'bi-scissors',    label:'Hair',       desc:'Cuts · Colour · Styling'   },
        { icon:'bi-brush',       label:'Nails',      desc:'Manicure · Pedicure · Gel' },
        { icon:'bi-droplet',     label:'Facial',     desc:'Glow · Skin care'          },
        { icon:'bi-hand-index',  label:'Massage',    desc:'Body · Deep tissue'        },
        { icon:'bi-heart-pulse', label:'Wellness',   desc:'Yoga · Pilates'            },
        { icon:'bi-activity',    label:'Body',       desc:'Waxing · Toning'           },
        { icon:'bi-eye',         label:'Aesthetics', desc:'Lashes · Brows'            },
        { icon:'bi-flower2',     label:'Spa',        desc:'Luxury packages'           },
      ].forEach(c => { %>
      <a href="/marketplace" class="cat-card" aria-label="Browse <%= c.label %> services">
        <div class="cat-icon"><i class="bi <%= c.icon %>"></i></div>
        <p><%= c.label %></p>
        <p><%= c.desc %></p>
      </a>
      <% }) %>
    </div>
  </div>
</section>

<!-- ═══════ FEATURED + DEALS (tabbed) ═══════ -->
<% if (featured.length > 0 || promotions.length > 0) { %>
<section class="section" style="background:var(--surface);border-top:1px solid var(--border);">
  <div class="container">
    <div class="section-header">
      <div>
        <p class="section-label">Explore</p>
        <h2 class="section-title">Top merchants &amp; deals</h2>
        <p class="section-sub">Handpicked salons and limited-time offers from our top merchants.</p>
      </div>
      <div class="d-flex align-items-center gap-2 flex-wrap">
        <% if (featured.length > 0) { %>
        <button class="btn btn-primary btn-sm btn-pill" id="tab-featured-btn" onclick="switchTab('featured')">
          <i class="bi bi-stars me-1"></i>Featured
        </button>
        <% } %>
        <% if (promotions.length > 0) { %>
        <button class="btn <%= featured.length > 0 ? 'btn-outline-secondary' : 'btn-primary' %> btn-sm btn-pill" id="tab-deals-btn" onclick="switchTab('deals')">
          <i class="bi bi-tag me-1"></i>Hot deals
        </button>
        <% } %>
        <a href="/marketplace" class="btn btn-outline-secondary btn-sm btn-pill d-none d-md-inline-flex">View all</a>
      </div>
    </div>

    <% if (featured.length > 0) { %>
    <div id="tab-featured">
      <div class="row g-4">
        <% featured.forEach(listing => { %>
        <div class="col-md-6 col-lg-4">
          <a href="/marketplace" class="merchant-card">
            <% if (listing.image_path) { %>
            <img src="<%= listing.image_path %>" class="card-img" alt="<%= listing.merchant_name %>" loading="lazy" />
            <% } else { %>
            <div class="card-no-img"><i class="bi bi-shop"></i></div>
            <% } %>
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start mb-1">
                <h6 class="card-title mb-0"><%= listing.merchant_name %></h6>
                <span class="featured-badge ms-2"><i class="bi bi-star-fill" style="font-size:.55rem;"></i>Featured</span>
              </div>
              <p class="card-meta mb-2"><%= listing.description || 'Top-rated beauty salon' %></p>
              <% if (listing.promo_title) { %>
              <span class="badge mb-2" style="background:var(--accent-light);color:var(--accent);">
                <i class="bi bi-tag me-1"></i><%= listing.discount_pct %>% off
              </span>
              <% } %>
              <p class="card-meta mb-0"><i class="bi bi-geo-alt me-1"></i><%= listing.address || 'Singapore' %></p>
            </div>
          </a>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>

    <% if (promotions.length > 0) { %>
    <div id="tab-deals" style="<%= featured.length > 0 ? 'display:none' : '' %>">
      <div class="row g-3">
        <% promotions.forEach(promo => { %>
        <div class="col-md-6 col-lg-4">
          <div class="promo-card h-100">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div class="flex-grow-1 me-3">
                <p class="promo-title mb-0"><%= promo.title %></p>
                <p class="promo-merchant mb-1"><i class="bi bi-shop me-1"></i><%= promo.merchant_name %></p>
              </div>
              <div class="promo-discount flex-shrink-0"><%= promo.discount_pct %>%<br/><span style="font-size:.7rem;font-weight:700;">off</span></div>
            </div>
            <p class="small text-muted mb-2"><%= promo.description || '' %></p>
            <p class="promo-date mt-2"><i class="bi bi-calendar3 me-1"></i>Until <%= promo.end_date.toISOString().slice(0,10) %></p>
          </div>
        </div>
        <% }) %>
      </div>
    </div>
    <% } %>
  </div>
</section>
<% } %>

<!-- ═══════ MERCHANT CTA ═══════ -->
<% if (!user || user.role !== 'merchant') { %>
<section class="section" style="background:var(--ink);border-top:1px solid rgba(255,255,255,.06);">
  <div class="container">
    <div class="row align-items-center g-4">
      <div class="col-lg-7">
        <p class="section-label" style="color:rgba(255,255,255,.45);">For businesses</p>
        <h2 class="section-title mb-2" style="color:#fff;">Run a beauty or wellness business?</h2>
        <p class="section-sub" style="color:rgba(255,255,255,.55);">Join Uniday as a merchant — generate your QR code, manage services, create promotions, and get featured in the marketplace. Free to get started.</p>
      </div>
      <div class="col-lg-5 text-lg-end">
        <a href="/auth/register" class="btn btn-primary btn-lg btn-pill">
          List your business free <i class="bi bi-arrow-right ms-1"></i>
        </a>
      </div>
    </div>
  </div>
</section>
<% } %>

<script>
function scrollToCategories(e) {
  e.preventDefault();
  document.getElementById('categories').scrollIntoView({ behavior: 'smooth', block: 'start' });
}

function switchTab(tab) {
  const featuredPanel = document.getElementById('tab-featured');
  const dealsPanel    = document.getElementById('tab-deals');
  const featuredBtn   = document.getElementById('tab-featured-btn');
  const dealsBtn      = document.getElementById('tab-deals-btn');
  if (tab === 'featured') {
    if (featuredPanel) featuredPanel.style.display = '';
    if (dealsPanel)    dealsPanel.style.display    = 'none';
    if (featuredBtn)   featuredBtn.className = 'btn btn-primary btn-sm btn-pill';
    if (dealsBtn)      dealsBtn.className    = 'btn btn-outline-secondary btn-sm btn-pill';
  } else {
    if (featuredPanel) featuredPanel.style.display = 'none';
    if (dealsPanel)    dealsPanel.style.display    = '';
    if (featuredBtn)   featuredBtn.className = 'btn btn-outline-secondary btn-sm btn-pill';
    if (dealsBtn)      dealsBtn.className    = 'btn btn-primary btn-sm btn-pill';
  }
}
</script>

<%- include('partials/footer') %>
