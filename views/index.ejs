<!-- ═══════ FEATURED MERCHANTS ═══════ -->
<% if (promotions.length > 0) { %>
<section class="section deal-showcase-section" id="current-deals">
  <div class="container">
    <div class="deal-showcase-header">
      <div>
        <p class="section-label">Current deals</p>
        <h2 class="section-title">Current Deals</h2>
        <p class="section-sub">Limited-time promotions from approved merchants.</p>
      </div>
      <a href="#marketplace" class="deal-view-all">
        View all <i class="bi bi-chevron-right"></i>
      </a>
    </div>

    <div class="deal-showcase-wrap">
      <button class="deal-showcase-nav deal-showcase-prev" onclick="shiftCarousel('deal-showcase-carousel',-1)" aria-label="Previous promotions">
        <i class="bi bi-chevron-left"></i>
      </button>

      <div class="deal-showcase-carousel" id="deal-showcase-carousel">
        <% promotions.forEach((promo, index) => { %>
          <article class="deal-showcase-slide promo-carousel-item">
            <a href="/marketplace/merchant/<%= promo.merchant_id %>" class="deal-showcase-card <%= promo.image_path ? 'has-image' : '' %>">
              <div class="deal-discount-block">
                <span>Save</span>
                <strong><%= Number(promo.discount_pct || 0).toFixed(0) %>%</strong>
                <span>off</span>
                <% if (promo.min_spend) { %>
                  <small>Min S$<%= Number(promo.min_spend).toFixed(0) %></small>
                <% } %>
              </div>

              <div class="deal-copy-block">
                <span class="deal-kicker"><i class="bi bi-shop"></i><%= promo.merchant_name %></span>
                <h3><%= promo.title %></h3>
                <p><%= promo.description || 'Book this approved merchant deal before it ends.' %></p>
                <div class="deal-meta-row">
                  <span><i class="bi bi-calendar3"></i>Until <%= new Date(promo.end_date).toLocaleDateString('en-SG',{day:'numeric',month:'short'}) %></span>
                  <span><i class="bi bi-calendar-week"></i><%= promoDayLabel(promo.applicable_days) %></span>
                </div>
              </div>

              <div class="deal-visual-block">
                <% if (promo.image_path) { %>
                  <img src="<%= promo.image_path %>" alt="<%= promo.title %>" loading="<%= index === 0 ? 'eager' : 'lazy' %>" />
                <% } else { %>
                  <div class="deal-visual-fallback">
                    <i class="bi bi-tag"></i>
                  </div>
                <% } %>
              </div>
            </a>
          </article>
        <% }) %>
      </div>

      <button class="deal-showcase-nav deal-showcase-next" onclick="shiftCarousel('deal-showcase-carousel',1)" aria-label="Next promotions">
        <i class="bi bi-chevron-right"></i>
      </button>
    </div>

    <div class="deal-dots" aria-label="Promotion slides">
      <% promotions.forEach((promo, index) => { %>
        <button
          type="button"
          class="<%= index === 0 ? 'active' : '' %>"
          data-carousel-dot="deal-showcase-carousel"
          data-slide-index="<%= index %>"
          aria-label="Show promotion <%= index + 1 %>"
        ></button>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

