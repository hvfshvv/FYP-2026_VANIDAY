
<footer class="site-footer" role="contentinfo">
  <div class="footer-inner">
    <div class="footer-top">
      <div>
        <%- include('unidayLogo', { className: 'footer-logo', variant: 'light', size: 'sm' }) %>
        <p class="footer-tagline">Singapore's beauty &amp; wellness booking platform.</p>
      </div>
      <ul class="footer-links">
        <li><a href="/marketplace">Marketplace</a></li>
        <li><a href="/auth/registerMer">List your business</a></li>
        <li><a href="#">Privacy policy</a></li>
        <li><a href="#">Terms of service</a></li>
      </ul>
    </div>
    <div class="footer-bottom">
      <p class="footer-copy">&copy; <%= new Date().getFullYear() %> Uniday. All rights reserved.</p>
      <div class="footer-social">
        <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
        <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
        <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
      </div>
    </div>
  </div>
</footer>

<% if (typeof user !== 'undefined' && user) { %>
<div
  class="assistant-widget"
  id="assistantWidget"
  data-has-unread="<%= Number(locals.unreadNotificationCount || 0) > 0 ? 'true' : 'false' %>"
>
  <button class="assistant-launcher" id="assistantLauncher" type="button" aria-label="Open Uniday Assistant">
    <i class="bi bi-chat-dots"></i>
    <span>Assistant</span>
    <% if (Number(locals.unreadNotificationCount || 0) > 0) { %>
    <em aria-hidden="true"></em>
    <% } %>
  </button>

  <section class="assistant-panel" id="assistantPanel" aria-label="Uniday Assistant" aria-live="polite">
    <div class="assistant-panel-head">
      <strong>Uniday Assistant</strong>
      <div class="assistant-panel-actions">
        <a href="/assistant" aria-label="Open assistant inbox" title="Open assistant inbox">
          <i class="bi bi-box-arrow-up-right"></i>
        </a>
        <button type="button" id="assistantMinimize" aria-label="Minimize assistant" title="Minimize">
          <i class="bi bi-dash-lg"></i>
        </button>
      </div>
    </div>

    <div class="assistant-panel-body">
      <div class="assistant-avatar">
        <img src="/images/uniday-logo.png" alt="" />
      </div>
      <h2>Hi, how may I assist you today?</h2>
      <p class="assistant-intro">
        Hi, I&apos;m your Uniday Virtual Assistant. I&apos;ll keep you updated when your account or bookings change.
      </p>

      <% const assistantMessages = locals.assistantPreviewMessages || []; %>
      <% if (assistantMessages.length) { %>
      <div class="assistant-message-list">
        <% assistantMessages.forEach(message => { %>
        <article class="assistant-message">
          <p><%= message.message %></p>
          <small><%= new Date(message.created_at).toLocaleString('en-SG', { day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' }) %></small>
        </article>
        <% }) %>
      </div>
      <form action="/assistant/read-all" method="POST" class="assistant-read-form">
        <button type="submit" class="btn btn-primary btn-sm btn-pill">
          <i class="bi bi-check2-all"></i>Mark messages read
        </button>
      </form>
      <% } else { %>
      <div class="assistant-message assistant-message-empty">
        <p>No new messages right now. Booking updates will pop up here automatically.</p>
      </div>
      <% } %>
    </div>

    <form class="assistant-panel-input" id="assistantAskForm" action="/assistant/ask" method="POST">
      <input type="text" name="question" id="assistantQuestionInput" placeholder="Ask me anything" autocomplete="off" />
      <button type="submit" aria-label="Send question">
        <i class="bi bi-send"></i>
      </button>
    </form>
  </section>
</div>
<% } %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
<script>
(() => {
  const widget = document.getElementById('assistantWidget');
  if (!widget) return;

  const launcher = document.getElementById('assistantLauncher');
  const minimize = document.getElementById('assistantMinimize');
  const askForm = document.getElementById('assistantAskForm');
  const questionInput = document.getElementById('assistantQuestionInput');
  const messageList = widget.querySelector('.assistant-message-list');
  const body = widget.querySelector('.assistant-panel-body');
  const hasUnread = widget.dataset.hasUnread === 'true';
  const unreadCount = Number('<%= Number(locals.unreadNotificationCount || 0) %>');
  const lastSeenCount = Number(sessionStorage.getItem('unidayAssistantUnreadCount') || 0);

  function openAssistant() {
    widget.classList.add('open');
  }

  function closeAssistant() {
    widget.classList.remove('open');
    sessionStorage.setItem('unidayAssistantMinimized', 'true');
    sessionStorage.setItem('unidayAssistantUnreadCount', String(unreadCount));
  }

  minimize?.addEventListener('click', closeAssistant);

  launcher?.addEventListener('click', () => {
    if (widget.classList.contains('open')) closeAssistant();
    else openAssistant();
  });

  function appendAssistantMessage(text, className) {
    const list = messageList || document.createElement('div');
    if (!messageList) {
      list.className = 'assistant-message-list';
      body?.appendChild(list);
    }

    const item = document.createElement('article');
    item.className = `assistant-message ${className || ''}`.trim();
    const p = document.createElement('p');
    p.textContent = text;
    item.appendChild(p);
    list.appendChild(item);
    body?.scrollTo({ top: body.scrollHeight, behavior: 'smooth' });
  }

  askForm?.addEventListener('submit', async event => {
    event.preventDefault();
    const question = questionInput?.value.trim();
    if (!question) return;

    appendAssistantMessage(question, 'assistant-message-user');
    questionInput.value = '';

    try {
      const response = await fetch('/assistant/ask', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Accept': 'application/json',
          'X-Requested-With': 'XMLHttpRequest',
        },
        body: JSON.stringify({ question }),
      });
      const data = await response.json();
      appendAssistantMessage(data.answer || data.error || 'Assistant could not reply right now.');
    } catch (err) {
      appendAssistantMessage('Assistant could not reply right now.');
    }
  });

  if (hasUnread && (
    sessionStorage.getItem('unidayAssistantMinimized') !== 'true' ||
    unreadCount !== lastSeenCount
  )) {
    sessionStorage.removeItem('unidayAssistantMinimized');
    window.setTimeout(openAssistant, 350);
  }
})();
</script>
</body>
</html>
