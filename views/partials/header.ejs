<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' — Uniday' : 'Uniday' %></title>
  <meta name="description" content="Singapore's trusted beauty and wellness booking platform. Scan, book, pay in seconds." />
  <link rel="icon" type="image/png" href="/images/uniday-logo.png" />
  <link rel="apple-touch-icon" href="/images/uniday-logo.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="/css/style.css" rel="stylesheet" />
</head>
<body>

<nav class="site-nav" role="navigation" aria-label="Main navigation">
  <div class="nav-inner">
    <%- include('unidayLogo', { className: 'nav-logo', size: 'md' }) %>

    <ul class="nav-links" role="list">
      <% if (!user || user.role === 'customer') { %>
      <li><a href="/">Home</a></li>
      <li><a href="/#featured-listings" onclick="scrollToMarketplace(event)">Marketplace</a></li>
      <% } %>
      <% if (user && user.role === 'customer') { %>
      <li>
        <a href="/book/viewBookings" class="nav-bookings-link">
          View bookings
          <% if (Number(locals.pendingPaymentCount || 0) > 0) { %>
          <span class="nav-pending-badge"><%= pendingPaymentCount %></span>
          <% } %>
        </a>
      </li>
      <% } %>
      <% if (user && user.role === 'merchant' && user.verification_status === 'approved') { %>
      <li><a href="/merchant/dashboard">Dashboard</a></li>
      <li><a href="/merchant/services">Services</a></li>
      <li><a href="/merchant/promotions">Promotions</a></li>
      <% } %>
      <% if (user && user.role === 'admin') { %>
      <li><a href="/admin/dashboard">Dashboard</a></li>
      <li><a href="/admin/user-management">User Management</a></li>
      <% } %>
    </ul>

    <div class="nav-actions">
      <% if (user) { %>
      <% if (user.role === 'customer') { %>
      <a href="/favourite" class="nav-icon-action" aria-label="My Favourites" title="My Favourites">
        <i class="bi bi-heart"></i>
      </a>
      <a href="/loyalty" class="nav-icon-action" aria-label="My Wallet" title="My Wallet">
        <i class="bi bi-wallet2"></i>
      </a>
      <% } %>
      <span class="nav-user-pill"><i class="bi bi-person-circle"></i><%= user.full_name.split(' ')[0] %></span>
      <a href="/auth/logout" class="btn btn-outline-secondary btn-sm btn-pill">Sign out</a>
      <% } else { %>
      <a href="/auth/login" class="btn btn-outline-secondary btn-sm btn-pill">Sign In / Register</a>
      <% } %>
    </div>

    <button class="nav-hamburger" aria-label="Toggle menu" aria-expanded="false" id="hamburgerBtn" onclick="toggleMobileNav()">
      <i class="bi bi-list" id="hamburger-icon"></i>
    </button>
  </div>
</nav>

<div class="nav-mobile" id="mobileNav" role="navigation" aria-label="Mobile navigation">
  <% if (!user || user.role === 'customer') { %>
  <a href="/">Home</a>
  <a href="/#featured-listings" onclick="scrollToMarketplace(event)">Marketplace</a>
  <% } %>
  <% if (user && user.role === 'customer') { %>
  <a href="/book/viewBookings" class="nav-bookings-link">
    View bookings
    <% if (Number(locals.pendingPaymentCount || 0) > 0) { %>
    <span class="nav-pending-badge"><%= pendingPaymentCount %></span>
    <% } %>
  </a>
  <a href="/favourite">My Favourites</a>
  <a href="/loyalty">Wallet</a>
  <% } %>
  <% if (user && user.role === 'merchant' && user.verification_status === 'approved') { %>
  <a href="/merchant/dashboard">Dashboard</a>
  <a href="/merchant/services">Services</a>
  <a href="/merchant/promotions">Promotions</a>
  <% } %>
  <% if (user && user.role === 'admin') { %>
  <a href="/admin/dashboard">Dashboard</a>
  <a href="/admin/user-management">User Management</a>
  <% } %>
  <% if (user) { %>
  <a href="/auth/logout">Sign out</a>
  <% } else { %>
  <a href="/auth/login">Sign In / Register</a>
  <% } %>
</div>

<% if (!locals.hideCatNav) { %>
<nav class="cat-strip" aria-label="Browse by category">
  <div class="cat-strip-inner">
    <% [
      { icon:'bi-scissors',    label:'Hair'       },
      { icon:'bi-brush',       label:'Nails'      },
      { icon:'bi-droplet',     label:'Facial'     },
      { icon:'bi-hand-index',  label:'Massage'    },
      { icon:'bi-heart-pulse', label:'Wellness'   },
      { icon:'bi-activity',    label:'Body'       },
      { icon:'bi-eye',         label:'Aesthetics' },
      { icon:'bi-droplet-half', label:'Spa'       },
    ].forEach(c => { %>
    <a href="/?category=<%= encodeURIComponent(c.label) %>" class="cat-strip-link" aria-label="<%= c.label %> services">
      <i class="bi <%= c.icon %>"></i><%= c.label %>
    </a>
    <% }) %>
  </div>
</nav>
<% } %>

<script>
function toggleMobileNav() {
  const nav  = document.getElementById('mobileNav');
  const icon = document.getElementById('hamburger-icon');
  const btn  = document.getElementById('hamburgerBtn');
  const open = nav.classList.toggle('open');
  icon.className = open ? 'bi bi-x-lg' : 'bi bi-list';
  btn.setAttribute('aria-expanded', String(open));
  document.body.style.overflow = open ? 'hidden' : '';
}

function scrollToMarketplace(event) {
  const marketplace = document.getElementById('featured-listings') || document.getElementById('marketplace');

  if (!marketplace || window.location.pathname !== '/') {
    return;
  }

  event.preventDefault();
  marketplace.scrollIntoView({ behavior: 'smooth', block: 'start' });
  history.replaceState(null, '', `/#${marketplace.id}`);

  const nav = document.getElementById('mobileNav');
  const icon = document.getElementById('hamburger-icon');
  const btn = document.getElementById('hamburgerBtn');

  if (nav && nav.classList.contains('open')) {
    nav.classList.remove('open');
    if (icon) icon.className = 'bi bi-list';
    if (btn) btn.setAttribute('aria-expanded', 'false');
    document.body.style.overflow = '';
  }
}
</script>
