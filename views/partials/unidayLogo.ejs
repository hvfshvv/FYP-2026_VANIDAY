<%
  const logoHref = typeof href !== 'undefined' ? href : '/';
  const logoClass = typeof className !== 'undefined' ? className : 'uniday-logo';
  const logoVariant = typeof variant !== 'undefined' ? variant : 'default';
  const logoSize = typeof size !== 'undefined' ? size : 'md';
  const logoShowText = typeof showText !== 'undefined' ? showText : true;
%>

<a href="<%= logoHref %>" class="<%= logoClass %> uniday-logo uniday-logo-<%= logoVariant %> uniday-logo-<%= logoSize %>" aria-label="<%= t('misc.logoHome') %>">
  <img src="/images/uniday-logo.png" alt="<%= t('misc.logoAlt') %>" class="uniday-logo-mark" />
  <% if (logoShowText) { %>
  <span class="uniday-logo-text">uniday</span>
  <% } %>
</a>
