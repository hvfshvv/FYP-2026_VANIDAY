<% locals.hideCatNav = true %>
<%
  const bookingTotalAmount = Number(booking.total_amount);
  const bookingServicePrice = Number(booking.price);
  const checkoutBaseAmount = Number.isFinite(bookingTotalAmount) && bookingTotalAmount > 0
    ? bookingTotalAmount
    : (Number.isFinite(bookingServicePrice) && bookingServicePrice > 0 ? bookingServicePrice : 0);
  const bookingPayableAmount = Number(booking.payable_amount);
  const payableAmount = Number.isFinite(bookingPayableAmount) && bookingPayableAmount > 0
    ? bookingPayableAmount
    : Math.max(
        checkoutBaseAmount - Number(booking.discount_amount || 0) - Number(booking.voucher_discount_amount || 0),
        0
      );
%>
<%- include('../partials/header') %>

<script src="https://js.stripe.com/v3/"></script>
<link rel="stylesheet" href="/css/payment.css">

<div id="payment-data"
     data-booking-id="<%= booking.booking_id %>"
     data-stripe-key="<%= stripePublishableKey %>"
     data-pending-seconds="<%= booking.pending_remaining_seconds || 0 %>"
     hidden></div>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-6">
        <div class="text-center mb-4">
          <div class="icon-circle-lg mx-auto mb-3">
            <i class="bi bi-credit-card" style="font-size:2rem;color:var(--accent);"></i>
          </div>
          <h4 style="font-weight:800;letter-spacing:-.025em;color:var(--ink);margin-bottom:.25rem;"><%= t('payment.confirmPay') %></h4>
          <p style="color:var(--muted);font-size:.875rem;"><%= t('payment.reviewBeforePay') %></p>
        </div>

        <div id="checkout-timer-banner" class="d-none mb-3 p-3 rounded-xl text-center" style="background:#fff7ed;border:1.5px solid #fed7aa;">
          <i class="bi bi-hourglass-split me-1" style="color:#c2410c;"></i>
          <span style="font-weight:700;font-size:.875rem;color:#c2410c;">
            <%- t('payment.slotHeld', { time: '<span id="checkout-timer-display">5:00</span>' }) %>
          </span>
        </div>

        <div id="checkout-expired-banner" class="d-none mb-3 p-3 rounded-xl text-center" style="background:#fef2f2;border:1.5px solid #fecaca;">
          <i class="bi bi-x-circle me-1" style="color:#dc2626;"></i>
          <span style="font-weight:700;font-size:.875rem;color:#dc2626;">
            <%= t('payment.slotExpired') %> <a href="/" style="color:#dc2626;"><%= t('payment.makeNewBooking') %></a>.
          </span>
        </div>

        <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
          <div class="p-3 rounded-xl mb-4" style="background:var(--accent-light);border:1.5px solid rgba(225,29,72,.15);">
            <p style="font-weight:700;font-size:.8125rem;color:var(--accent);margin-bottom:.75rem;">
              <i class="bi bi-calendar-check me-1"></i><%= t('payment.bookingSummary') %>
            </p>
            <div class="summary-row"><span class="lbl"><%= t('common.merchant') %></span> <span class="val"><%= booking.merchant_name %></span></div>
            <div class="summary-row"><span class="lbl"><%= t('common.service') %></span>  <span class="val"><%= serviceText(booking, 'name') || booking.service_name %></span></div>
            <div class="summary-row"><span class="lbl"><%= t('common.staff') %></span>    <span class="val"><%= booking.staff_name || t('common.anyAvailableStaff') %></span></div>
            <div class="summary-row"><span class="lbl"><%= t('common.duration') %></span> <span class="val"><%= t('common.minutes', { count: booking.duration_mins }) %></span></div>
            <div class="summary-row"><span class="lbl"><%= t('common.date') %></span>     <span class="val"><%= new Date(booking.booking_date).toLocaleDateString(lang === 'zh' ? 'zh-CN' : (lang === 'ta' ? 'ta-IN' : 'en-SG'),{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></span></div>
            <div class="summary-row"><span class="lbl"><%= t('common.time') %></span>     <span class="val"><%= String(booking.booking_time).slice(0,5) %></span></div>
            <%
              const baseAmt      = checkoutBaseAmount;
              const discAmt      = Number(booking.discount_amount || 0);
              const voucherDiscAmt = Number(booking.voucher_discount_amount || 0);
              const hasPromo     = typeof appliedPromotion !== 'undefined' && appliedPromotion;
              const hasVoucher   = typeof appliedVoucher !== 'undefined' && appliedVoucher && voucherDiscAmt > 0;
            %>
            <div class="summary-row"><span class="lbl"><%= t('payment.originalPrice') %></span><span class="val" style="font-family:var(--font-mono);">S$<%= baseAmt.toFixed(2) %></span></div>
            <% if (hasPromo) { %>
            <div class="summary-row">
              <span class="lbl" style="color:var(--success);font-weight:600;">
                <i class="bi bi-tag-fill me-1"></i><%= t('payment.promotionDiscount') %>: <%= appliedPromotion.title %> (<%= Number(appliedPromotion.discount_pct) %>% <%= t('home.off') %>)
              </span>
              <span class="val" style="color:var(--success);font-family:var(--font-mono);font-weight:700;">-S$<%= discAmt.toFixed(2) %></span>
            </div>
            <% } else { %>
            <div class="summary-row">
              <span class="lbl"><%= t('payment.promotionDiscount') %></span>
              <span class="val" style="font-family:var(--font-mono);">-S$0.00</span>
            </div>
            <% } %>
            <% if (hasVoucher) { %>
            <div class="summary-row">
              <span class="lbl" style="color:#0369a1;font-weight:600;">
                <i class="bi bi-ticket-perforated-fill me-1"></i><%= t('payment.voucherDiscount') %>: <%= appliedVoucher.campaign_name || appliedVoucher.voucher_code %>
              </span>
              <span class="val" style="color:#0369a1;font-family:var(--font-mono);font-weight:700;">-S$<%= voucherDiscAmt.toFixed(2) %></span>
            </div>
            <% } else { %>
            <div class="summary-row">
              <span class="lbl"><%= t('payment.voucherDiscount') %></span>
              <span class="val" style="font-family:var(--font-mono);">-S$0.00</span>
            </div>
            <% } %>
            <div class="summary-row total">
              <span style="font-weight:700;"><%= t('payment.finalTotal') %></span>
              <span style="font-weight:700;color:var(--accent);font-size:1.2rem;font-family:var(--font-mono);">S$<%= payableAmount.toFixed(2) %></span>
            </div>
          </div>

          <% if (typeof cancellationPolicySummary !== 'undefined' && cancellationPolicySummary) { %>
          <div class="p-3 rounded-xl mb-4" style="background:#fff;border:1px solid var(--border);">
            <p style="font-weight:700;font-size:.8125rem;color:var(--accent);margin-bottom:.5rem;">
              <i class="bi bi-hourglass-split me-1"></i><%= t('payment.cancellationPolicy') %>
            </p>
            <p style="color:var(--ink);font-weight:700;margin:0;font-size:.875rem;"><%= cancellationPolicySummary %></p>
          </div>
          <% } %>

          <%
            const checkoutVouchers = (typeof voucherOptions !== 'undefined' && voucherOptions)
              ? voucherOptions
              : ((typeof eligibleVouchers !== 'undefined' && eligibleVouchers) ? eligibleVouchers : []);
            const appliedCvId = (typeof appliedVoucher !== 'undefined' && appliedVoucher) ? appliedVoucher.cv_id : null;
            const showVoucherSection = typeof user !== 'undefined' && user && user.role === 'customer';
            const voucherDiscountBase = Math.max(checkoutBaseAmount - Number(booking.discount_amount || 0), 0);
            const voucherUiState = voucher => {
              const minSpend = Number(voucher.min_spend || 0);
              const meetsMinSpend = !minSpend || checkoutBaseAmount >= minSpend;
              const discountValue = Number(voucher.discount_value || 0);
              const fallbackDiscount = voucher.discount_type === 'percent'
                ? voucherDiscountBase * discountValue / 100
                : discountValue;
              const discountAmount = Number.isFinite(Number(voucher.discountAmount))
                ? Number(voucher.discountAmount)
                : Math.min(Math.max(fallbackDiscount, 0), voucherDiscountBase);
              const hasServerUsable = typeof voucher.isUsable !== 'undefined';
              const isUsable = hasServerUsable
                ? (voucher.isUsable === true || voucher.isUsable === 'true' || voucher.isUsable === 1 || voucher.isUsable === '1')
                : (meetsMinSpend && discountAmount > 0);

              return {
                discountAmount,
                isUsable,
                unavailableReason: voucher.unavailableReason || (
                  !meetsMinSpend
                    ? `Minimum spend S$${minSpend.toFixed(2)} required`
                    : 'Not usable for this booking'
                ),
              };
            };
            const hasUsableVoucher = checkoutVouchers.some(v => voucherUiState(v).isUsable);
          %>
          <% if (showVoucherSection) { %>
          <div class="mb-4">
            <p style="font-weight:700;color:var(--ink);font-size:.875rem;margin-bottom:.5rem;">
              <i class="bi bi-ticket-perforated me-1" style="color:var(--accent);"></i><%= t('payment.applyVoucher') %>
            </p>

            <% if (!hasUsableVoucher) { %>
            <p class="voucher-empty mb-2"><%= t('payment.noEligibleVouchers') %></p>
            <% } %>

            <% if (checkoutVouchers.length > 0) { %>
            <div class="voucher-list">
              <% checkoutVouchers.forEach(v => { %>
              <%
                const discLabel = v.discount_type === 'percent'
                  ? Number(v.discount_value).toFixed(0) + '% off'
                  : 'S$' + Number(v.discount_value).toFixed(2) + ' off';
                const uiVoucher = voucherUiState(v);
                const shouldHighlightBestValue = v.isBestValue && (!appliedCvId || v.isApplied);
                const cardClasses = [
                  'voucher-option-card',
                  uiVoucher.isUsable ? '' : 'unavailable',
                  v.isApplied ? 'selected' : '',
                  shouldHighlightBestValue ? 'best' : ''
                ].filter(Boolean).join(' ');
              %>
              <% if (uiVoucher.isUsable) { %>
              <form action="/payment/apply-voucher/<%= booking.booking_id %>" method="POST" class="voucher-option-form">
                <input type="hidden" name="cvId" value="<%= v.cv_id %>">
                <button type="submit" class="<%= cardClasses %>">
              <% } else { %>
                <div class="<%= cardClasses %>" aria-disabled="true">
              <% } %>
                  <div class="voucher-option-top">
                    <span class="voucher-discount-pill"><%= discLabel %></span>
                    <div class="voucher-option-labels">
                      <% if (v.isApplied) { %>
                      <span class="voucher-state-pill selected"><i class="bi bi-check2"></i>Applied</span>
                      <% } %>
                      <% if (v.isBestValue) { %>
                      <span class="voucher-state-pill best"><i class="bi bi-stars"></i>Best Value</span>
                      <% } %>
                    </div>
                  </div>
                  <div class="voucher-option-main">
                    <span class="voucher-name"><%= v.campaign_name || v.voucher_code %></span>
                    <span class="voucher-expiry">Exp. <%= new Date(v.voucher_expiry).toLocaleDateString('en-SG',{day:'numeric',month:'short',year:'numeric'}) %></span>
                  </div>
                  <div class="voucher-meta">
                    <% if (v.min_spend) { %>
                    <span>Min. S$<%= Number(v.min_spend).toFixed(2) %></span>
                    <% } %>
                    <% if (uiVoucher.isUsable) { %>
                    <span>Saves S$<%= Number(uiVoucher.discountAmount || 0).toFixed(2) %></span>
                    <% } else { %>
                    <span class="voucher-reason"><%= uiVoucher.unavailableReason %></span>
                    <% } %>
                  </div>
              <% if (uiVoucher.isUsable) { %>
                </button>
              </form>
              <% } else { %>
                </div>
              <% } %>
              <% }) %>
            </div>
            <% } %>

            <% if (appliedCvId) { %>
            <form action="/payment/apply-voucher/<%= booking.booking_id %>" method="POST" class="mb-0 mt-2">
              <button type="submit" class="btn btn-sm btn-outline-secondary py-1 px-2" style="font-size:.78rem;">
                <i class="bi bi-x"></i> Remove voucher
              </button>
            </form>
            <% } %>

            <% if (locals.voucherError) { %>
            <p class="small mt-2 mb-0" style="color:var(--danger);"><i class="bi bi-exclamation-circle me-1"></i><%= voucherError %></p>
            <% } %>
          </div>
          <% } %>

          <div id="payment-error" class="alert alert-danger py-2 d-none mb-3" role="alert" style="font-size:.875rem;"></div>
          <% if (webhookError) { %>
            <div class="alert alert-warning py-2 mb-3" role="alert" style="font-size:.875rem;">
              <%= webhookError %>
            </div>
          <% } %>

          <p style="font-weight:700;color:var(--ink);font-size:.875rem;margin-bottom:.75rem;"><%= t('payment.paymentMethod') %></p>
          <div class="d-flex gap-2 mb-4">
            <button type="button" id="tab-stripe" class="pay-tab active" onclick="switchTab('stripe')">
              <i class="bi bi-credit-card me-1"></i><%= t('payment.card') %>
            </button>
            <button type="button" id="tab-paynow" class="pay-tab" onclick="switchTab('paynow')">
              <i class="bi bi-qr-code me-1"></i><%= t('payment.paynow') %>
            </button>
            <% if (paymentWallet) { %>
            <button type="button" id="tab-wallet" class="pay-tab" onclick="switchTab('wallet')">
              <i class="bi bi-wallet2 me-1"></i>Wallet
            </button>
            <% } %>
          </div>

          <div id="panel-stripe">
            <p class="small mb-2" style="color:var(--muted);">
              <i class="bi bi-lock-fill me-1"></i><%= t('payment.stripeSecure') %>
            </p>
            <div id="card-element-wrap" class="mb-1">
              <div id="payment-element"></div>
            </div>
            <div id="card-errors" class="text-danger small mb-3" style="min-height:1.2rem;" aria-live="polite"></div>

            <div class="p-2 rounded-xl mb-3" style="background:#f0fdf4;border:1px solid #bbf7d0;font-size:.78rem;color:#166534;">
              <i class="bi bi-info-circle me-1"></i>
              <strong><%= t('payment.testCard') %></strong> 4242 4242 4242 4242 &nbsp;|&nbsp; <%= t('payment.anyFutureDate') %> &nbsp;|&nbsp; <%= t('payment.anyCvc') %>
            </div>

            <button id="stripe-pay-btn" class="btn btn-primary btn-lg w-100 btn-pill py-3" style="font-size:1rem;font-weight:700;">
              <span id="stripe-lbl"><i class="bi bi-lock me-2"></i><%= t('payment.payAmount', { amount: payableAmount.toFixed(2) }) %></span>
              <span id="stripe-spin" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span><%= t('payment.processing') %></span>
            </button>
          </div>

          <div id="panel-paynow" class="d-none">
            <div class="p-3 rounded-xl mb-3" style="background:var(--surface);border:1.5px solid var(--border);">
              <div class="summary-row">
                <span class="lbl"><%= t('common.amount') %></span>
                <span class="val" style="font-family:var(--font-mono);font-weight:700;color:var(--accent);">S$<%= payableAmount.toFixed(2) %></span>
              </div>
              <div class="summary-row">
                <span class="lbl"><%= t('common.provider') %></span>
                <span class="val"><%= t('payment.paynowProvider') %></span>
              </div>
            </div>

            <ol class="small ps-3 mb-4" style="color:var(--muted);line-height:1.9;">
              <li><%= t('payment.paynowStep1') %></li>
              <li><%= t('payment.paynowStep2') %></li>
              <li><%= t('payment.paynowStep3') %></li>
              <li><%= t('payment.paynowStep4') %></li>
            </ol>

            <button id="paynow-pay-btn" class="btn btn-primary btn-lg w-100 btn-pill py-3" style="font-size:1rem;font-weight:700;">
              <span id="paynow-lbl"><i class="bi bi-qr-code me-2"></i><%= t('payment.continuePaynow') %></span>
              <span id="paynow-spin" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span><%= t('payment.openingStripe') %></span>
            </button>

            <p class="small text-center mt-2 mb-0" style="color:var(--muted);">
              <%= t('payment.paynowRedirect') %>
            </p>
          </div>

          <% if (paymentWallet) { %>
          <div id="panel-wallet" class="d-none">
            <div class="p-3 rounded-xl mb-3" style="background:var(--surface);border:1.5px solid var(--border);">
              <div class="summary-row"><span class="lbl">Wallet balance</span><span class="val" style="font-family:var(--font-mono);">S$<%= Number(paymentWallet.balance).toFixed(2) %></span></div>
              <div class="summary-row"><span class="lbl">Booking total</span><span class="val" style="font-family:var(--font-mono);color:var(--accent);">S$<%= payableAmount.toFixed(2) %></span></div>
            </div>
            <% if (Number(paymentWallet.balance) >= payableAmount) { %>
            <button id="wallet-pay-btn" class="btn btn-primary btn-lg w-100 btn-pill py-3">
              <span id="wallet-lbl"><i class="bi bi-wallet2 me-2"></i>Pay from wallet</span>
              <span id="wallet-spin" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span>Processing...</span>
            </button>
            <% } else { %>
            <div class="alert alert-warning mb-2">Insufficient balance. You need S$<%= (payableAmount - Number(paymentWallet.balance)).toFixed(2) %> more.</div>
            <a href="/wallet?amountDue=<%= encodeURIComponent(payableAmount.toFixed(2)) %>&bookingId=<%= encodeURIComponent(booking.booking_id) %>" class="btn btn-primary w-100">Top up payment wallet</a>
            <% } %>
          </div>
          <% } %>

          <p class="text-center small mt-4 mb-0" style="color:var(--muted);">
            <i class="bi bi-shield-check me-1" style="color:var(--success);"></i>
            <%= t('payment.secureNotice') %>
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="payment-success-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0" style="border-radius:var(--r-xl);box-shadow:var(--shadow);">
      <div class="modal-body text-center p-4">
        <div class="icon-circle-lg mx-auto mb-3" style="background:var(--success-bg);">
          <i class="bi bi-check-lg" style="font-size:2rem;color:var(--success);"></i>
        </div>
        <h5 style="font-weight:800;color:var(--success);margin-bottom:.35rem;"><%= t('payment.paymentSuccessful') %></h5>
        <p class="mb-0" style="color:var(--muted);font-size:.9rem;"><%= t('payment.redirecting') %></p>
      </div>
    </div>
  </div>
</div>

<script src="/js/payment.js"></script>
<script>
(function () {
  const data = document.getElementById('payment-data');
  let seconds = parseInt(data.dataset.pendingSeconds || '0', 10);
  const timerBanner = document.getElementById('checkout-timer-banner');
  const expiredBanner = document.getElementById('checkout-expired-banner');
  const display = document.getElementById('checkout-timer-display');

  if (seconds <= 0) {
    expiredBanner.classList.remove('d-none');
    return;
  }

  timerBanner.classList.remove('d-none');

  function tick() {
    if (seconds <= 0) {
      timerBanner.classList.add('d-none');
      expiredBanner.classList.remove('d-none');
      return;
    }
    const m = Math.floor(seconds / 60);
    const s = seconds % 60;
    display.textContent = m + ':' + String(s).padStart(2, '0');
    seconds--;
    setTimeout(tick, 1000);
  }

  tick();
})();
</script>
<%- include('../partials/footer') %>
