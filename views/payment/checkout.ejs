<% locals.hideCatNav = true %>
<% const payableAmount = Number(booking.payable_amount || booking.total_amount || booking.price); %>
<%- include('../partials/header') %>

<script src="https://js.stripe.com/v3/"></script>
<link rel="stylesheet" href="/css/payment.css">

<div id="payment-data"
     data-booking-id="<%= booking.booking_id %>"
     data-stripe-key="<%= stripePublishableKey %>"
     hidden></div>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-7 col-lg-6">
        <div class="text-center mb-4">
          <div class="icon-circle-lg mx-auto mb-3">
            <i class="bi bi-credit-card" style="font-size:2rem;color:var(--accent);"></i>
          </div>
          <h4 style="font-weight:800;letter-spacing:-.025em;color:var(--ink);margin-bottom:.25rem;">Confirm &amp; Pay</h4>
          <p style="color:var(--muted);font-size:.875rem;">Review your booking before completing payment.</p>
        </div>

        <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;">
          <div class="p-3 rounded-xl mb-4" style="background:var(--accent-light);border:1.5px solid rgba(225,29,72,.15);">
            <p style="font-weight:700;font-size:.8125rem;color:var(--accent);margin-bottom:.75rem;">
              <i class="bi bi-calendar-check me-1"></i>Booking Summary
            </p>
            <div class="summary-row"><span class="lbl">Merchant</span> <span class="val"><%= booking.merchant_name %></span></div>
            <div class="summary-row"><span class="lbl">Service</span>  <span class="val"><%= booking.service_name %></span></div>
            <div class="summary-row"><span class="lbl">Duration</span> <span class="val"><%= booking.duration_mins %> min</span></div>
            <div class="summary-row"><span class="lbl">Date</span>     <span class="val"><%= new Date(booking.booking_date).toLocaleDateString('en-SG',{weekday:'long',day:'numeric',month:'long',year:'numeric'}) %></span></div>
            <div class="summary-row"><span class="lbl">Time</span>     <span class="val"><%= String(booking.booking_time).slice(0,5) %></span></div>
            <div class="summary-row total">
              <span style="font-weight:700;">Total</span>
              <span style="font-weight:700;color:var(--accent);font-size:1.2rem;font-family:var(--font-mono);">S$<%= payableAmount.toFixed(2) %></span>
            </div>
          </div>

          <div id="payment-error" class="alert alert-danger py-2 d-none mb-3" role="alert" style="font-size:.875rem;"></div>
          <% if (webhookError) { %>
            <div class="alert alert-warning py-2 mb-3" role="alert" style="font-size:.875rem;">
              <%= webhookError %>
            </div>
          <% } %>

          <p style="font-weight:700;color:var(--ink);font-size:.875rem;margin-bottom:.75rem;">Payment Method</p>
          <div class="d-flex gap-2 mb-4">
            <button type="button" id="tab-stripe" class="pay-tab active" onclick="switchTab('stripe')">
              <i class="bi bi-credit-card me-1"></i>Credit / Debit Card
            </button>
            <button type="button" id="tab-paynow" class="pay-tab" onclick="switchTab('paynow')">
              <i class="bi bi-qr-code me-1"></i>PayNow / NETS QR
            </button>
          </div>

          <div id="panel-stripe">
            <p class="small mb-2" style="color:var(--muted);">
              <i class="bi bi-lock-fill me-1"></i>Card details are handled securely by Stripe. We never see your number.
            </p>
            <div id="card-element-wrap" class="mb-1">
              <div id="payment-element"></div>
            </div>
            <div id="card-errors" class="text-danger small mb-3" style="min-height:1.2rem;" aria-live="polite"></div>

            <div class="p-2 rounded-xl mb-3" style="background:#f0fdf4;border:1px solid #bbf7d0;font-size:.78rem;color:#166534;">
              <i class="bi bi-info-circle me-1"></i>
              <strong>Test card:</strong> 4242 4242 4242 4242 &nbsp;|&nbsp; Any future date &nbsp;|&nbsp; Any 3-digit CVC
            </div>

            <button id="stripe-pay-btn" class="btn btn-primary btn-lg w-100 btn-pill py-3" style="font-size:1rem;font-weight:700;">
              <span id="stripe-lbl"><i class="bi bi-lock me-2"></i>Pay S$<%= payableAmount.toFixed(2) %></span>
              <span id="stripe-spin" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span>Processing...</span>
            </button>
          </div>

          <div id="panel-paynow" class="d-none">
            <div class="p-3 rounded-xl mb-3" style="background:var(--surface);border:1.5px solid var(--border);">
              <div class="summary-row">
                <span class="lbl">Amount</span>
                <span class="val" style="font-family:var(--font-mono);font-weight:700;color:var(--accent);">S$<%= payableAmount.toFixed(2) %></span>
              </div>
              <div class="summary-row">
                <span class="lbl">Provider</span>
                <span class="val">Stripe PayNow sandbox</span>
              </div>
            </div>

            <ol class="small ps-3 mb-4" style="color:var(--muted);line-height:1.9;">
              <li>Tap <strong>Continue with PayNow</strong> to open Stripe's secure checkout.</li>
              <li>Choose <strong>PayNow</strong>, then click <strong>Generate QR code</strong>.</li>
              <li>In test mode, use Stripe's PayNow test page to approve the payment.</li>
              <li>After approval, Stripe will return you to Uniday with your booking confirmed.</li>
            </ol>

            <button id="paynow-pay-btn" class="btn btn-primary btn-lg w-100 btn-pill py-3" style="font-size:1rem;font-weight:700;">
              <span id="paynow-lbl"><i class="bi bi-qr-code me-2"></i>Continue with PayNow</span>
              <span id="paynow-spin" class="d-none"><span class="spinner-border spinner-border-sm me-2"></span>Opening Stripe...</span>
            </button>

            <p class="small text-center mt-2 mb-0" style="color:var(--muted);">
              You will be redirected to Stripe's secure sandbox checkout for the QR code.
            </p>
          </div>

          <p class="text-center small mt-4 mb-0" style="color:var(--muted);">
            <i class="bi bi-shield-check me-1" style="color:var(--success);"></i>
            Payments are processed securely. Uniday does not store card details.
          </p>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="payment-success-modal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0" style="border-radius:var(--r-xl);box-shadow:var(--shadow);">
      <div class="modal-body text-center p-4">
        <div class="icon-circle-lg mx-auto mb-3" style="background:var(--success-bg);">
          <i class="bi bi-check-lg" style="font-size:2rem;color:var(--success);"></i>
        </div>
        <h5 style="font-weight:800;color:var(--success);margin-bottom:.35rem;">Payment Successful</h5>
        <p class="mb-0" style="color:var(--muted);font-size:.9rem;">Your booking is confirmed. Redirecting...</p>
      </div>
    </div>
  </div>
</div>

<script src="/js/payment.js"></script>
<%- include('../partials/footer') %>
