<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div style="min-height:80vh;display:flex;align-items:center;padding:3rem 1rem;background:var(--canvas);">
  <div class="container">
    <div class="row justify-content-center">
      <div class="col-md-6 col-lg-5 text-center">
        <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2.5rem;">
          <div class="mb-4">
            <div class="icon-circle-lg mx-auto" style="background:var(--success-bg);">
              <i class="bi bi-check-lg" style="font-size:2.2rem;color:var(--success);"></i>
            </div>
          </div>
          <h3 style="font-weight:800;letter-spacing:-.025em;color:var(--success);margin-bottom:.5rem;">Booking Confirmed!</h3>
          <p style="color:var(--muted);margin-bottom:1.5rem;">Your payment was successful. See you there!</p>

          <% if (booking) { %>
          <%
            const _origAmt        = Number(booking.total_amount || booking.price || 0);
            const _discAmt        = Number(booking.discount_amount || 0);
            const _voucherDiscAmt = Number(booking.voucher_discount_amount || 0);
            const _paidAmt        = Number(booking.payable_amount || _origAmt);
          %>
          <div class="text-start p-3 rounded-xl mb-4" style="background:var(--surface);border:1.5px solid var(--border);">
            <div class="summary-row"><span class="lbl">Merchant</span><span class="val"><%= booking.merchant_name %></span></div>
            <div class="summary-row"><span class="lbl">Service</span><span class="val"><%= booking.service_name %></span></div>
            <div class="summary-row"><span class="lbl">Staff</span><span class="val"><%= booking.staff_name || 'Any Available Staff' %></span></div>
            <div class="summary-row"><span class="lbl">Date</span><span class="val"><%= new Date(booking.booking_date).toLocaleDateString('en-SG',{weekday:'short',day:'numeric',month:'long',year:'numeric'}) %></span></div>
            <div class="summary-row"><span class="lbl">Time</span><span class="val"><%= String(booking.booking_time).slice(0,5) %></span></div>
            <div class="summary-row">
              <span class="lbl">Booking ID</span>
              <span class="val" style="font-family:var(--font-mono);">#<%= booking.booking_id %></span>
            </div>
            <% if (typeof payment !== 'undefined' && payment) { %>
              <div class="summary-row">
                <span class="lbl">Payment Method</span>
                <span class="val"><%= payment.payment_method.replace('_', ' ').toUpperCase() %></span>
              </div>
              <div class="summary-row">
                <span class="lbl">Reference No</span>
                <span class="val" style="font-family:var(--font-mono);"><%= payment.payment_ref || payment.transaction_ref || ('#' + booking.booking_id) %></span>
              </div>
            <% } %>
            <% if ((_discAmt > 0 && booking.promo_title) || _voucherDiscAmt > 0) { %>
              <hr style="border-color:var(--border);margin:.5rem 0;">
              <div class="summary-row">
                <span class="lbl">Original Price</span>
                <span class="val" style="font-family:var(--font-mono);">S$<%= _origAmt.toFixed(2) %></span>
              </div>
              <% if (_discAmt > 0 && booking.promo_title) { %>
              <div class="summary-row">
                <span class="lbl" style="color:var(--success);font-weight:600;">
                  <i class="bi bi-tag-fill me-1"></i><%= booking.promo_title %> (<%= Number(booking.promo_discount_pct) %>% off)
                </span>
                <span class="val" style="color:var(--success);font-family:var(--font-mono);font-weight:700;">-S$<%= _discAmt.toFixed(2) %></span>
              </div>
              <% } %>
              <% if (_voucherDiscAmt > 0) { %>
              <div class="summary-row">
                <span class="lbl" style="color:#0369a1;font-weight:600;">
                  <i class="bi bi-ticket-perforated-fill me-1"></i><%= booking.voucher_name || 'Voucher' %>
                </span>
                <span class="val" style="color:#0369a1;font-family:var(--font-mono);font-weight:700;">-S$<%= _voucherDiscAmt.toFixed(2) %></span>
              </div>
              <% } %>
            <% } %>
            <div class="summary-row">
              <span class="lbl" style="font-weight:700;">Total Paid</span>
              <span class="val" style="font-weight:700;color:var(--accent);font-family:var(--font-mono);">S$<%= _paidAmt.toFixed(2) %></span>
            </div>
          </div>
          <% } %>

          <div class="p-3 rounded-xl mb-4" style="background:var(--accent-light);border:1.5px solid rgba(225,29,72,.15);">
            <p class="small mb-0" style="color:var(--accent);">
              <i class="bi bi-qr-code me-1"></i>
              When you arrive, scan the merchant's QR code again to confirm your arrival.
            </p>
          </div>

          <% if (booking && !booking.customer_id) { %>
          <div class="p-3 rounded-xl mb-4" style="background:var(--warn-bg);border:1.5px solid rgba(245,158,11,.2);">
            <p class="small mb-0" style="color:var(--warn);">
              <i class="bi bi-info-circle me-1"></i>
              This was booked as a guest. It will not appear in member booking history and does not earn loyalty points.
            </p>
          </div>
          <% } %>

          <% if (booking && booking.customer_id && typeof loyaltyEarned !== 'undefined' && loyaltyEarned > 0) { %>
          <div class="p-3 rounded-xl mb-4" style="background:var(--success-bg);border:1.5px solid rgba(16,185,129,.2);">
            <p class="small mb-0" style="color:var(--success);">
              <i class="bi bi-wallet2 me-1"></i>
              You earned <strong><%= loyaltyEarned %> loyalty points</strong> from this booking.
            </p>
          </div>
          <% } else if (booking && booking.customer_id) { %>
          <div class="p-3 rounded-xl mb-4" style="background:var(--accent-light);border:1.5px solid rgba(225,29,72,.15);">
            <p class="small mb-0" style="color:var(--accent);">
              <i class="bi bi-wallet2 me-1"></i>
              Loyalty points will be added after the merchant marks this appointment as completed.
            </p>
          </div>
          <% } %>

          <% if (booking && typeof payment !== 'undefined' && payment && payment.payment_status === 'paid') { %>
          <a href="/payment/receipt/<%= booking.booking_id %>.pdf" class="btn btn-outline-secondary btn-pill w-100 py-2 mb-2" download>
            <i class="bi bi-download me-2"></i>Download Receipt
          </a>
          <% } %>

          <% if (booking && booking.customer_id) { %>
          <a href="/loyalty" class="btn btn-outline-secondary btn-pill w-100 py-2 mb-2">
            <i class="bi bi-wallet2 me-2"></i>View Wallet
          </a>
          <a href="/book/viewBookings" class="btn btn-primary btn-pill w-100 py-2">
            <i class="bi bi-calendar-check me-2"></i>View Bookings
          </a>
          <% } else { %>
          <a href="/marketplace" class="btn btn-primary btn-pill w-100 py-2">
            <i class="bi bi-grid me-2"></i>Back to Marketplace
          </a>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
