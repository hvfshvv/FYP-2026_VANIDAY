<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:860px;">
    <p class="section-label mb-2"><%= t('legal.policyLabel') %></p>
    <h1 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);"><%= t('legal.cancellationRefundTitle') %></h1>
    <p style="color:var(--muted);max-width:720px;"><%= t('legal.cancellationRefundIntro') %></p>

    <section class="card border-0 mb-3" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="card-body p-4">
        <h2 style="font-size:1.1rem;font-weight:800;color:var(--ink);"><%= t('legal.customerCausedTitle') %></h2>
        <ul style="color:var(--ink);line-height:1.8;margin:0;">
          <li><%= t('legal.refundCustomerEarly') %></li>
          <li><%= t('legal.refundCustomerPartial') %></li>
          <li><%= t('legal.refundCustomerLate') %></li>
          <li><%= t('legal.refundNoShow') %></li>
        </ul>
      </div>
    </section>

    <section class="card border-0 mb-3" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="card-body p-4">
        <h2 style="font-size:1.1rem;font-weight:800;color:var(--ink);"><%= t('legal.merchantCausedTitle') %></h2>
        <p style="color:var(--ink);line-height:1.7;margin:0;"><%= t('legal.merchantCausedBody') %></p>
      </div>
    </section>

    <section class="card border-0 mb-3" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="card-body p-4">
        <h2 style="font-size:1.1rem;font-weight:800;color:var(--ink);"><%= t('legal.reschedulingTitle') %></h2>
        <ul style="color:var(--ink);line-height:1.8;margin:0;">
          <li><%= t('legal.rescheduleUntil') %></li>
          <li><%= t('legal.rescheduleAvailability') %></li>
          <li><%= t('legal.rescheduleNoCharge') %></li>
          <li><%= t('legal.reschedulePaymentTransfer') %></li>
        </ul>
      </div>
    </section>

    <section class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="card-body p-4">
        <h2 style="font-size:1.1rem;font-weight:800;color:var(--ink);"><%= t('legal.processingFeesTitle') %></h2>
        <p style="color:var(--ink);line-height:1.7;margin:0;"><%= t('legal.processingFeesBody') %></p>
      </div>
    </section>
  </div>
</main>

<%- include('../partials/footer') %>
