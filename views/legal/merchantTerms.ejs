<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:860px;">
    <p class="section-label mb-2"><%= t('merchantTerms.section') %></p>
    <h1 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);"><%= t('legal.merchantTermsTitle') %></h1>
    <p style="color:var(--muted);max-width:720px;"><%= t('merchantTerms.intro') %></p>

    <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="card-body p-4" style="color:var(--ink);line-height:1.75;">
        <p><%= t('merchantTerms.bodyAppointments') %></p>
        <p><%= t('merchantTerms.bodyRefundRules') %></p>
        <p><%= t('merchantTerms.bodyProcessingFees') %></p>
        <p><%= t('merchantTerms.bodyPayoutRules') %></p>
        <p><%= t('merchantTerms.bodyStricterSettings') %></p>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
