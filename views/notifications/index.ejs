<%- include('../partials/header') %>

<%
  const notificationList = Array.isArray(notifications) ? notifications : [];
  const typeMeta = {
    booking_created:     { icon: 'bi-credit-card', labelKey: 'notifications.labels.paymentNeeded', tone: 'warn' },
    booking_confirmed:   { icon: 'bi-calendar-check', labelKey: 'notifications.labels.booking', tone: 'success' },
    booking_cancelled:   { icon: 'bi-calendar-x', labelKey: 'notifications.labels.booking', tone: 'danger' },
    booking_rescheduled: { icon: 'bi-calendar-event', labelKey: 'notifications.labels.booking', tone: 'info' },
    payment_attempt_failed: { icon: 'bi-exclamation-triangle', labelKey: 'notifications.labels.payment', tone: 'warn' },
    payment_window_expired: { icon: 'bi-hourglass-bottom', labelKey: 'notifications.labels.payment', tone: 'danger' },
    payment_failed:      { icon: 'bi-exclamation-triangle', labelKey: 'notifications.labels.payment', tone: 'danger' },
    review_available:    { icon: 'bi-star', labelKey: 'notifications.labels.review', tone: 'accent' },
    review_reward:       { icon: 'bi-gift', labelKey: 'notifications.labels.rewards', tone: 'success' },
    waitlist_offer:      { icon: 'bi-hourglass-split', labelKey: 'notifications.labels.waitlist', tone: 'accent' },
    waitlist_joined:     { icon: 'bi-list-ol', labelKey: 'notifications.labels.waitlist', tone: 'info' },
    waitlist_offer_expired: { icon: 'bi-hourglass-bottom', labelKey: 'notifications.labels.waitlist', tone: 'danger' },
    waitlist_expired:   { icon: 'bi-calendar-x', labelKey: 'notifications.labels.waitlist', tone: 'danger' },
    waitlist_cancelled:  { icon: 'bi-x-circle', labelKey: 'notifications.labels.waitlist', tone: 'danger' },
    waitlist_removed:    { icon: 'bi-x-circle', labelKey: 'notifications.labels.waitlist', tone: 'danger' },
    signup:              { icon: 'bi-person-check', labelKey: 'notifications.labels.account', tone: 'success' },
  };

  function metaFor(notification) {
    const meta = typeMeta[notification.notification_type] || { icon: 'bi-bell', labelKey: 'notifications.labels.update', tone: 'info' };
    return { ...meta, label: t(meta.labelKey) };
  }

  function titleFor(notification) {
    const fallback = {
      booking_created: 'notifications.titles.bookingCreated',
      booking_confirmed: 'notifications.titles.bookingConfirmed',
      booking_cancelled: 'notifications.titles.bookingCancelled',
      booking_rescheduled: 'notifications.titles.bookingRescheduled',
      payment_attempt_failed: 'notifications.titles.paymentAttemptFailed',
      payment_window_expired: 'notifications.titles.paymentWindowExpired',
      payment_failed: 'notifications.titles.paymentFailed',
      review_available: 'notifications.titles.reviewAvailable',
      review_reward: 'notifications.titles.reviewReward',
      waitlist_offer: 'notifications.titles.waitlistOffer',
      waitlist_joined: 'notifications.titles.waitlistJoined',
      waitlist_offer_expired: 'notifications.titles.waitlistOfferExpired',
      waitlist_expired: 'notifications.titles.waitlistExpired',
      waitlist_cancelled: 'notifications.titles.waitlistCancelled',
      waitlist_removed: 'notifications.titles.waitlistRemoved',
    };
    return fallback[notification.notification_type] ? t(fallback[notification.notification_type]) : (notification.title || t('notifications.labels.update'));
  }

  function actionLabelFor(notification) {
    const map = {
      'Continue payment': 'notifications.actions.continuePayment',
      'Make payment': 'notifications.actions.makePayment',
      'Try payment again': 'notifications.actions.tryPaymentAgain',
      'Rate experience': 'notifications.actions.rateExperience',
      'View rewards': 'notifications.actions.viewRewards',
      'Confirm slot': 'notifications.actions.confirmSlot',
      'View waitlist': 'notifications.actions.viewWaitlist',
      'Book again': 'notifications.actions.bookAgain',
      'View booking': 'notifications.actions.viewBooking',
    };
    return t(map[notification.action_label] || '', {}, notification.action_label);
  }

  function toneStyle(tone) {
    if (tone === 'success') return { bg: 'var(--success-bg)', color: 'var(--success)' };
    if (tone === 'danger') return { bg: 'var(--danger-bg)', color: 'var(--danger)' };
    if (tone === 'warn') return { bg: 'var(--warn-bg)', color: 'var(--warn)' };
    if (tone === 'accent') return { bg: 'var(--accent-light)', color: 'var(--accent)' };
    return { bg: '#EFF6FF', color: '#1D4ED8' };
  }
%>

<main style="background:var(--canvas);min-height:80vh;padding:2rem 1rem;">
  <div class="container" style="max-width:900px;">
    <div class="d-flex align-items-center justify-content-between gap-3 mb-4">
      <div>
        <p class="section-label mb-1"><%= t('notifications.section') %></p>
        <h1 style="font-size:clamp(1.75rem,3vw,2.5rem);font-weight:800;color:var(--ink);margin:0;"><%= t('notifications.title') %></h1>
        <p style="color:var(--muted);margin:.35rem 0 0;"><%= t('notifications.subtitle') %></p>
      </div>
      <% if (notificationList.some(n => !n.is_read)) { %>
      <form action="/notifications/read-all" method="POST">
        <button class="btn btn-outline-secondary btn-sm btn-pill" type="submit">
          <i class="bi bi-check2-all me-1"></i><%= t('notifications.markAllRead') %>
        </button>
      </form>
      <% } %>
    </div>

    <% if (success) { %>
    <div id="notificationFlash" class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;transition:opacity .25s ease, transform .25s ease;">
      <i class="bi bi-check-circle me-2"></i><%= success %>
    </div>
    <% } %>

    <% if (typeof query !== 'undefined' && query && query.error) { %>
    <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
      <i class="bi bi-exclamation-circle me-2"></i><%= query.error %>
    </div>
    <% } %>

    <% if (error) { %>
    <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
      <i class="bi bi-exclamation-circle me-2"></i><%= error %>
    </div>
    <% } %>

    <% if (!notificationList.length) { %>
    <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:2rem;text-align:center;">
      <i class="bi bi-bell" style="font-size:2rem;color:var(--muted);"></i>
      <p style="font-weight:800;color:var(--ink);margin:.75rem 0 .25rem;"><%= t('notifications.emptyTitle') %></p>
      <p style="color:var(--muted);margin:0;"><%= t('notifications.emptyBody') %></p>
    </div>
    <% } else { %>
    <section class="d-flex flex-column gap-3">
      <% notificationList.forEach(notification => {
        const meta = metaFor(notification);
        const tone = toneStyle(meta.tone);
      %>
      <article class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);overflow:hidden;">
        <div class="d-flex flex-wrap align-items-start gap-3 p-3 p-md-4">
          <div style="width:44px;height:44px;border-radius:50%;background:<%= tone.bg %>;color:<%= tone.color %>;display:grid;place-items:center;font-size:1.2rem;flex:0 0 44px;">
            <i class="bi <%= meta.icon %>"></i>
          </div>
          <div style="min-width:0;flex:1 1 360px;">
            <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
              <% if (!notification.is_read) { %>
              <span style="width:.55rem;height:.55rem;border-radius:50%;background:var(--accent);display:inline-block;"></span>
              <% } %>
              <span class="badge rounded-pill" style="background:<%= tone.bg %>;color:<%= tone.color %>;"><%= meta.label %></span>
              <span style="font-size:.8125rem;color:var(--ghost);">
                <%= new Date(notification.created_at).toLocaleString(lang === 'zh' ? 'zh-CN' : (lang === 'ta' ? 'ta-IN' : 'en-SG'), { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) %>
              </span>
            </div>
            <h2 style="font-size:1rem;font-weight:800;color:var(--ink);margin:0 0 .35rem;"><%= titleFor(notification) %></h2>
            <p style="color:var(--muted);margin:0;"><%= notification.message %></p>
          </div>
          <div class="d-flex flex-wrap gap-2 justify-content-end" style="flex:0 0 auto;">
            <% if (notification.action_url && notification.action_label && notification.action_method === 'POST') { %>
            <form action="<%= notification.action_url %>" method="POST">
              <button class="btn btn-primary btn-sm btn-pill" type="submit">
                <i class="bi <%= notification.action_icon || 'bi-arrow-right' %> me-1"></i><%= actionLabelFor(notification) %>
              </button>
            </form>
            <% } else if (notification.action_url && notification.action_label) { %>
            <a href="<%= notification.action_url %>" class="btn btn-primary btn-sm btn-pill">
              <i class="bi <%= notification.action_icon || 'bi-arrow-right' %> me-1"></i><%= actionLabelFor(notification) %>
            </a>
            <% } %>
          </div>
        </div>
      </article>
      <% }) %>
    </section>
    <% } %>
  </div>
</main>

<script>
  (() => {
    const flash = document.getElementById('notificationFlash');
    if (!flash) return;

    const url = new URL(window.location.href);
    if (url.searchParams.has('success')) {
      url.searchParams.delete('success');
      window.history.replaceState({}, '', url.pathname + url.search + url.hash);
    }

    window.setTimeout(() => {
      flash.style.opacity = '0';
      flash.style.transform = 'translateY(-6px)';
      window.setTimeout(() => flash.remove(), 260);
    }, 2500);
  })();
</script>

<%- include('../partials/footer') %>
