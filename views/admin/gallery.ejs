<% locals.hideCatNav = true %><%- include('../partials/header') %>
<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;"><div class="container" style="max-width:1200px;">
  <div class="d-flex justify-content-between align-items-end gap-3 mb-4"><div><p class="section-label">Community Moderation</p><h2 style="font-weight:800;color:var(--ink);">Gallery Reports</h2><p style="color:var(--muted);margin:0;">Review posts reported by customers. Posts remain visible until an admin deletes them.</p></div><a href="/admin/dashboard" class="btn btn-outline-secondary btn-pill">Dashboard</a></div>
  <% if (success) { %><div class="rounded-xl p-3 mb-3" style="background:var(--success-bg);color:var(--success);"><%= success %></div><% } %><% if (error) { %><div class="rounded-xl p-3 mb-3" style="background:var(--danger-bg);color:var(--danger);"><%= error %></div><% } %>
  <% if (!posts.length) { %><div class="card border-0 text-center p-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);"><i class="bi bi-shield-check" style="font-size:2.5rem;color:var(--success);"></i><h5 class="mt-3" style="font-weight:800;">No active gallery reports</h5><p style="color:var(--muted);margin:0;">Reported showcase posts will appear here.</p></div><% } else { %>
  <div class="row g-4"><% posts.forEach(post => { %><div class="col-lg-6"><article class="card border-0 h-100 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);"><div class="row g-0 h-100"><div class="col-4"><img src="<%= post.image_path %>" alt="Reported gallery post" style="width:100%;height:100%;min-height:250px;object-fit:cover;"></div><div class="col-8 p-3"><div class="d-flex justify-content-between gap-2"><div><h5 style="font-weight:800;color:var(--ink);"><%= post.service_name %></h5><p style="color:var(--accent);font-weight:700;font-size:.78rem;"><%= post.merchant_name %></p></div><span class="badge rounded-pill" style="background:var(--danger-bg);color:var(--danger);height:max-content;"><%= post.report_count %> report(s)</span></div><p style="font-size:.8rem;color:var(--muted);">Posted by <strong><%= post.customer_name %></strong></p><p style="color:var(--ink);font-size:.85rem;"><%= post.caption || 'No caption.' %></p><div class="rounded-xl p-2 mb-3" style="background:var(--danger-bg);color:var(--danger);font-size:.75rem;"><strong>Reasons:</strong> <%= post.report_reasons %></div><div class="d-flex gap-2"><form action="/admin/gallery/posts/<%= post.post_id %>/ignore" method="POST" class="flex-grow-1"><button class="btn btn-outline-secondary btn-sm btn-pill w-100">Ignore Reports</button></form><form action="/admin/gallery/posts/<%= post.post_id %>/delete" method="POST" class="flex-grow-1" onsubmit="return confirm('Permanently delete this gallery post?');"><button class="btn btn-outline-danger btn-sm btn-pill w-100">Delete Post</button></form></div></div></div></article></div><% }) %></div><% } %>
</div></main>
<%- include('../partials/footer') %>
