<article class="card border-0 mb-4" style="border-radius:var(--r-xl);box-shadow:var(--shadow-sm);"><div class="card-body p-4">
  <div class="d-flex justify-content-between flex-wrap gap-3"><div><h5 style="font-weight:800;"><%= review.merchant_name %> · <%= review.service_name %></h5><p style="color:var(--muted);"><%= review.customer_name %> · Booking #<%= review.booking_id %> · <%= date(review.created_at) %><% if (review.updated_at) { %> · Edited <%= date(review.updated_at) %><% } %></p></div><div><span class="badge" style="background:<%= review.visibility === 'visible' ? 'var(--success-bg)' : 'var(--danger-bg)' %>;color:<%= review.visibility === 'visible' ? 'var(--success)' : 'var(--danger)' %>;"><%= review.visibility %></span> <span style="color:#f59e0b;font-weight:800;"><i class="bi bi-star-fill"></i> <%= review.rating %>/5</span></div></div>
  <p><%= review.review_text %></p>
  <% if (review.admin_image_path) { %><img src="<%= review.admin_image_path %>" alt="Review photo" style="width:240px;height:190px;object-fit:cover;border-radius:12px;margin-bottom:1rem;"><% } else { %><span class="badge mb-3" style="background:var(--canvas);color:var(--muted);">No picture</span><% } %>
  <% if (review.request_id) { %><div class="rounded-xl p-3 mb-3" style="background:var(--warn-bg);color:var(--warn);"><strong>Photo-removal request:</strong> <%= String(review.reason_type).replace('_',' ') %><% if (review.reason_text) { %> — <%= review.reason_text %><% } %></div><% } %>
  <div class="row g-3">
    <% if (showRequestActions && review.request_id) { %><div class="col-lg-7"><form method="POST" action="/admin/reviews/<%= review.review_id %>/moderate" class="rounded-xl p-3" style="border:1px solid var(--border);"><input type="hidden" name="request_id" value="<%= review.request_id %>"><label class="form-label fw-bold">Resolve request</label><input name="reason" list="requestReasons<%= review.review_id %>" class="form-control rounded-xl mb-2" required maxlength="500" placeholder="Choose or type a decision note"><datalist id="requestReasons<%= review.review_id %>"><option value="Your request was approved and the photo has been permanently removed."><option value="Your request was approved because the wrong photo was uploaded."><option value="Your request was approved to protect confidential or personal information."><option value="Your request could not be approved because the submitted reason could not be verified."><option value="Your request was rejected because the photo does not contain confidential or sensitive information."></datalist><small class="d-block mb-2" style="color:var(--muted);">Choose a suggested response or type your own.</small><button name="action" value="approve_request" class="btn btn-danger btn-sm btn-pill me-1">Approve and remove photo</button><button name="action" value="reject_request" class="btn btn-outline-secondary btn-sm btn-pill">Reject and restore photo</button></form></div><% } %>
    <% if (showModeration) { %><div class="col-lg-7"><form method="POST" action="/admin/reviews/<%= review.review_id %>/moderate" class="rounded-xl p-3" style="border:1px solid var(--border);"><label class="form-label fw-bold">Moderation</label><input name="reason" list="moderationReasons<%= review.review_id %>" class="form-control rounded-xl mb-2" required maxlength="500" placeholder="Choose or type a reason shown to the customer"><datalist id="moderationReasons<%= review.review_id %>"><option value="The photo was unrelated to the booked service."><option value="The photo contained inappropriate or unsafe content."><option value="The photo exposed confidential or personal information."><option value="The review contained abusive, discriminatory, or threatening content."><option value="The review was identified as spam or misleading content."><option value="The content was removed following the customer's request."><option value="The review was restored after a further moderation check."></datalist><small class="d-block mb-2" style="color:var(--muted);">Choose a suggested reason or type your own.</small><% if (review.has_photo) { %><button name="action" value="remove_photo" class="btn btn-outline-danger btn-sm btn-pill me-1">Remove photo</button><% } %><% if (review.visibility === 'visible') { %><button name="action" value="hide_review" class="btn btn-danger btn-sm btn-pill">Hide review</button><% } else { %><button name="action" value="restore_review" class="btn btn-success btn-sm btn-pill">Restore review</button><% } %></form></div><% } %>
  </div>
</div></article>
