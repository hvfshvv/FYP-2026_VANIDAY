<article class="card border-0 mb-4" style="border-radius:var(--r-xl);box-shadow:var(--shadow-sm);"><div class="card-body p-4">
  <div class="d-flex justify-content-between flex-wrap gap-3"><div><h5 style="font-weight:800;"><%= review.merchant_name %> · <%= review.service_name %></h5><p style="color:var(--muted);"><%= review.customer_name %> · <%= t('admin.reviews.bookingRef', { id: review.booking_id }) %> · <%= date(review.created_at) %><% if (review.updated_at) { %> · <%= t('admin.reviews.edited', { date: date(review.updated_at) }) %><% } %></p></div><div><span class="badge" style="background:<%= review.visibility === 'visible' ? 'var(--success-bg)' : 'var(--danger-bg)' %>;color:<%= review.visibility === 'visible' ? 'var(--success)' : 'var(--danger)' %>;"><%= t('admin.reviews.visibility.' + review.visibility, {}, review.visibility) %></span> <span style="color:#f59e0b;font-weight:800;"><i class="bi bi-star-fill"></i> <%= review.rating %>/5</span></div></div>
  <p><%= review.review_text %></p>
  <% if (review.admin_image_path) { %><img src="<%= review.admin_image_path %>" alt="<%= t('admin.reviews.photoAlt') %>" style="width:240px;height:190px;object-fit:cover;border-radius:12px;margin-bottom:1rem;"><% } else { %><span class="badge mb-3" style="background:var(--canvas);color:var(--muted);"><%= t('admin.reviews.noPicture') %></span><% } %>
  <% if (review.request_id) { %><div class="rounded-xl p-3 mb-3" style="background:var(--warn-bg);color:var(--warn);"><strong><%= t('admin.reviews.removalRequestLabel') %></strong> <%= t('admin.reviews.reasonType.' + review.reason_type, {}, String(review.reason_type).replace('_',' ')) %><% if (review.reason_text) { %> — <%= review.reason_text %><% } %></div><% } %>
  <div class="row g-3">
    <% if (showRequestActions && review.request_id) { %><div class="col-lg-7"><form method="POST" action="/admin/reviews/<%= review.review_id %>/moderate" class="rounded-xl p-3" style="border:1px solid var(--border);"><input type="hidden" name="request_id" value="<%= review.request_id %>"><label class="form-label fw-bold"><%= t('admin.reviews.resolveRequest') %></label><input name="reason" list="requestReasons<%= review.review_id %>" class="form-control rounded-xl mb-2" required maxlength="500" placeholder="<%= t('admin.reviews.decisionPlaceholder') %>"><datalist id="requestReasons<%= review.review_id %>"><option value="<%= t('admin.reviews.requestReason.approvedRemoved') %>"><option value="<%= t('admin.reviews.requestReason.approvedWrongPhoto') %>"><option value="<%= t('admin.reviews.requestReason.approvedConfidential') %>"><option value="<%= t('admin.reviews.requestReason.rejectedUnverified') %>"><option value="<%= t('admin.reviews.requestReason.rejectedNotSensitive') %>"></datalist><small class="d-block mb-2" style="color:var(--muted);"><%= t('admin.reviews.chooseOrType') %></small><button name="action" value="approve_request" class="btn btn-danger btn-sm btn-pill me-1"><%= t('admin.reviews.approveRemove') %></button><button name="action" value="reject_request" class="btn btn-outline-secondary btn-sm btn-pill"><%= t('admin.reviews.rejectRestore') %></button></form></div><% } %>
    <% if (showModeration) { %><div class="col-lg-7"><form method="POST" action="/admin/reviews/<%= review.review_id %>/moderate" class="rounded-xl p-3" style="border:1px solid var(--border);"><label class="form-label fw-bold"><%= t('admin.reviews.moderation') %></label><input name="reason" list="moderationReasons<%= review.review_id %>" class="form-control rounded-xl mb-2" required maxlength="500" placeholder="<%= t('admin.reviews.reasonPlaceholder') %>"><datalist id="moderationReasons<%= review.review_id %>"><option value="<%= t('admin.reviews.modReason.unrelated') %>"><option value="<%= t('admin.reviews.modReason.inappropriate') %>"><option value="<%= t('admin.reviews.modReason.confidential') %>"><option value="<%= t('admin.reviews.modReason.abusive') %>"><option value="<%= t('admin.reviews.modReason.spam') %>"><option value="<%= t('admin.reviews.modReason.customerRequest') %>"><option value="<%= t('admin.reviews.modReason.restored') %>"></datalist><small class="d-block mb-2" style="color:var(--muted);"><%= t('admin.reviews.chooseOrTypeReason') %></small><% if (review.has_photo) { %><button name="action" value="remove_photo" class="btn btn-outline-danger btn-sm btn-pill me-1"><%= t('admin.reviews.removePhoto') %></button><% } %><% if (review.visibility === 'visible') { %><button name="action" value="hide_review" class="btn btn-danger btn-sm btn-pill"><%= t('admin.reviews.hideReview') %></button><% } else { %><button name="action" value="restore_review" class="btn btn-success btn-sm btn-pill"><%= t('admin.reviews.restoreReview') %></button><% } %></form></div><% } %>
  </div>
</div></article>
