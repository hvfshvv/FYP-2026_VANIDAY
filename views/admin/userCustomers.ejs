<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  // Small formatting helpers used inside the customer table.
  const formatDate = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const maskMoney = value => {
    const amount = Number(value || 0);
    const whole = Math.floor(Math.abs(amount)).toString();
    const maskedWhole = whole.length > 1 ? whole[0] + 'x'.repeat(whole.length - 1) : whole;
    return `${amount < 0 ? '-' : ''}S$${maskedWhole}.xx`;
  };
  const maskEmail = email => {
    const parts = String(email || '').split('@');
    if (parts.length < 2) return email || '-';
    return `${parts[0].slice(0, 2)}***@${parts[1]}`;
  };
  const maskPhone = value => {
    const phone = String(value || '');
    if (!phone) return '-';
    let seen = 0;
    return phone.replace(/\d/g, digit => (++seen <= 4 ? digit : 'x'));
  };
%>

<!-- Admin customer accounts page: search customers and enable/disable accounts. -->
<main class="container py-5">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
      <p class="section-label"><%= t('admin.userOps.eyebrow') %></p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.userManagement.customerAccounts') %></h2>
      <p style="color:var(--muted);margin:0;"><%= t('admin.userOps.customerSubtitle') %></p>
    </div>
    <a href="/admin/user-management" class="btn btn-outline-secondary btn-pill">
      <i class="bi bi-arrow-left me-1"></i><%= t('admin.userManagement.title') %>
    </a>
  </div>

  <% if (query.updated) { %><div class="alert alert-success"><i class="bi bi-check-circle"></i><span><%= t('admin.userOps.customerUpdated') %></span></div><% } %>
  <% if (query.error || (typeof error !== 'undefined' && error)) { %>
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i><span><%= query.error || error %></span></div>
  <% } %>

  <!-- Search reloads the same page with ?search=... -->
  <form method="GET" action="/admin/user-management/customers" class="d-flex flex-wrap gap-2 mb-4">
    <input type="search" name="search" value="<%= search %>" class="form-control" placeholder="<%= t('admin.userOps.searchCustomers') %>" style="max-width:360px;">
    <button class="btn btn-primary btn-pill" type="submit"><i class="bi bi-search me-1"></i><%= t('admin.common.search') %></button>
    <% if (search) { %><a href="/admin/user-management/customers" class="btn btn-outline-secondary btn-pill"><%= t('admin.common.clear') %></a><% } %>
  </form>

  <!-- Customer table includes account status, spend, loyalty points and actions. -->
  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th><%= t('admin.dashboard.logs.colId') %></th>
            <th><%= t('admin.table.customer') %></th>
            <th><%= t('admin.table.email') %></th>
            <th><%= t('admin.table.status') %></th>
            <th><%= t('admin.table.tier') %></th>
            <th><%= t('admin.table.bookings') %></th>
            <th><%= t('admin.table.totalSpent') %></th>
            <th><%= t('admin.table.points') %></th>
            <th><%= t('admin.table.lastBooking') %></th>
            <th><%= t('admin.table.actions') %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!customers.length) { %>
            <tr><td colspan="10" class="text-center py-5 text-muted"><%= t('admin.userOps.noCustomers') %></td></tr>
          <% } %>
          <% customers.forEach(customer => { %>
          <tr>
            <td class="mono">#<%= customer.user_id %></td>
            <td>
              <strong><%= customer.full_name %></strong>
              <div class="small text-muted"><%= maskPhone(customer.phone) %></div>
            </td>
            <td><%= maskEmail(customer.email) %></td>
            <td>
              <span class="badge rounded-pill" style="<%= customer.status === 'active' ? 'background:var(--success-bg);color:var(--success);' : 'background:var(--warn-bg);color:var(--warn);' %>">
                <%= t('admin.accountStatus.' + customer.status, {}, customer.status) %>
              </span>
            </td>
            <td>
              <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);">
                <i class="bi bi-award me-1"></i><%= t('admin.tier.' + String(customer.tier || '').toLowerCase(), {}, customer.tier) %>
              </span>
            </td>
            <td><%= customer.bookings || 0 %></td>
            <td class="mono"><%= maskMoney(customer.total_spent) %></td>
            <td class="mono"><%= customer.points_balance || 0 %></td>
            <td><%= formatDate(customer.last_booking_at) %></td>
            <td>
              <div class="d-flex flex-wrap gap-2">
                <a href="/admin/user-management/customers/<%= customer.user_id %>/bookings" class="btn btn-outline-secondary btn-sm btn-pill">
                  <i class="bi bi-calendar-check me-1"></i><%= t('admin.userOps.viewBookings') %>
                </a>
                <!-- Toggle between active and suspended user status. -->
                <form method="POST" action="/admin/user-management/customers/<%= customer.user_id %>/status" class="d-flex flex-wrap gap-2">
                  <input type="hidden" name="status" value="<%= customer.status === 'active' ? 'suspended' : 'active' %>">
                  <% if (customer.status === 'active') { %>
                    <select name="disable_reason" class="form-select form-select-sm" style="width:220px;" required>
                      <option value=""><%= t('admin.userOps.selectDisableReason') %></option>
                      <% (disableReasons || []).forEach(reason => { %>
                        <option value="<%= reason %>"><%= t('admin.disableReason.' + reason, {}, reason) %></option>
                      <% }) %>
                    </select>
                  <% } %>
                  <button
                    class="btn <%= customer.status === 'active' ? 'btn-outline-danger' : 'btn-outline-success' %> btn-sm btn-pill"
                    type="submit"
                    onclick="return confirm('<%= customer.status === 'active' ? t('admin.userOps.disableCustomerConfirm') : t('admin.userOps.enableCustomerConfirm') %>')"
                  >
                    <%= customer.status === 'active' ? t('admin.common.disable') : t('admin.common.enable') %>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
