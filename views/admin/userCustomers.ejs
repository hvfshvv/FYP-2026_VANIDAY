<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  // Small formatting helpers used inside the customer table.
  const money = value => 'S$' + Number(value || 0).toFixed(2);
  const formatDate = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const maskEmail = email => {
    const parts = String(email || '').split('@');
    if (parts.length < 2) return email || '-';
    return `${parts[0].slice(0, 2)}***@${parts[1]}`;
  };
%>

<!-- Admin customer accounts page: search customers and enable/disable accounts. -->
<main class="container py-5">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
      <p class="section-label">User Operations</p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Customer Accounts</h2>
      <p style="color:var(--muted);margin:0;">Audit customers, booking activity, spending, and account status.</p>
    </div>
    <a href="/admin/user-management" class="btn btn-outline-secondary btn-pill">
      <i class="bi bi-arrow-left me-1"></i>User Management
    </a>
  </div>

  <% if (query.updated) { %><div class="alert alert-success"><i class="bi bi-check-circle"></i><span>Customer account updated.</span></div><% } %>
  <% if (query.error || (typeof error !== 'undefined' && error)) { %>
    <div class="alert alert-warning"><i class="bi bi-exclamation-triangle"></i><span><%= query.error || error %></span></div>
  <% } %>

  <!-- Search reloads the same page with ?search=... -->
  <form method="GET" action="/admin/user-management/customers" class="d-flex flex-wrap gap-2 mb-4">
    <input type="search" name="search" value="<%= search %>" class="form-control" placeholder="Search customers by name, email, or phone" style="max-width:360px;">
    <button class="btn btn-primary btn-pill" type="submit"><i class="bi bi-search me-1"></i>Search</button>
    <% if (search) { %><a href="/admin/user-management/customers" class="btn btn-outline-secondary btn-pill">Clear</a><% } %>
  </form>

  <!-- Customer table includes account status, spend, loyalty points and actions. -->
  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th>ID</th>
            <th>Customer</th>
            <th>Email</th>
            <th>Status</th>
            <th>Tier</th>
            <th>Bookings</th>
            <th>Total Spent</th>
            <th>Points</th>
            <th>Last Booking</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (!customers.length) { %>
            <tr><td colspan="10" class="text-center py-5 text-muted">No customer accounts found.</td></tr>
          <% } %>
          <% customers.forEach(customer => { %>
          <tr>
            <td class="mono">#<%= customer.user_id %></td>
            <td>
              <strong><%= customer.full_name %></strong>
              <div class="small text-muted"><%= customer.phone || '-' %></div>
            </td>
            <td><%= maskEmail(customer.email) %></td>
            <td>
              <span class="badge rounded-pill" style="<%= customer.status === 'active' ? 'background:var(--success-bg);color:var(--success);' : 'background:var(--warn-bg);color:var(--warn);' %>">
                <%= customer.status %>
              </span>
            </td>
            <td>
              <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);">
                <i class="bi bi-award me-1"></i><%= customer.tier %>
              </span>
            </td>
            <td><%= customer.bookings || 0 %></td>
            <td class="mono"><%= money(customer.total_spent) %></td>
            <td class="mono"><%= customer.points_balance || 0 %></td>
            <td><%= formatDate(customer.last_booking_at) %></td>
            <td>
              <div class="d-flex flex-wrap gap-2">
                <a href="/admin/user-management/customers/<%= customer.user_id %>/bookings" class="btn btn-outline-secondary btn-sm btn-pill">
                  <i class="bi bi-calendar-check me-1"></i>View Bookings
                </a>
                <!-- Toggle between active and suspended user status. -->
                <form method="POST" action="/admin/user-management/customers/<%= customer.user_id %>/status" class="d-flex flex-wrap gap-2">
                  <input type="hidden" name="status" value="<%= customer.status === 'active' ? 'suspended' : 'active' %>">
                  <% if (customer.status === 'active') { %>
                    <select name="disable_reason" class="form-select form-select-sm" style="width:220px;" required>
                      <option value="">Select disable reason</option>
                      <% (disableReasons || []).forEach(reason => { %>
                        <option value="<%= reason %>"><%= reason %></option>
                      <% }) %>
                    </select>
                  <% } %>
                  <button
                    class="btn <%= customer.status === 'active' ? 'btn-outline-danger' : 'btn-outline-success' %> btn-sm btn-pill"
                    type="submit"
                    onclick="<%= customer.status === 'active' ? 'return confirm(\'Disable this customer account using the selected policy reason?\')' : 'return confirm(\'Enable this customer account?\')' %>"
                  >
                    <%= customer.status === 'active' ? 'Disable' : 'Enable' %>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
