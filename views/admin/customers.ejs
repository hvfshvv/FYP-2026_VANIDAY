<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const a = analytics || {};
  const overview = a.overview || {};
  const loyalty = a.loyaltySummary || {};
  const security = a.security || {};
  const money = value => 'S$' + Number(value || 0).toFixed(2);
  const number = value => Number(value || 0).toLocaleString('en-SG');
  const percent = value => Number(value || 0).toFixed(1) + '%';
  const rating = value => Number(value || 0).toFixed(1) + '/5';
  const maskMoney = value => {
    const amount = Number(value || 0);
    const whole = Math.floor(Math.abs(amount)).toString();
    const maskedWhole = whole.length > 1 ? whole[0] + 'x'.repeat(whole.length - 1) : whole;
    return `${amount < 0 ? '-' : ''}S$${maskedWhole}.xx`;
  };
  const maskPhone = value => {
    const phone = String(value || '');
    if (!phone) return t('admin.customers.noPhone');
    let seen = 0;
    return phone.replace(/\d/g, digit => (++seen <= 4 ? digit : 'x'));
  };
  const dateLabel = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const maxOf = (items, key) => Math.max(1, ...items.map(item => Number(item[key] || 0)));
  const barWidth = (value, max) => Math.max(5, Math.round((Number(value || 0) / max) * 100));
  const avgPoints = Number(overview.avg_points_balance || 0);
  const tierProgress = Math.min(100, (avgPoints / 2000) * 100);
  const safeJson = value => JSON.stringify(value || {}).replace(/</g, '\\u003c');
%>

<style>
  .customer-admin {
    background:var(--canvas);
    min-height:80vh;
    padding:2.5rem 1rem;
  }
  .customer-admin[data-theme="dark"] {
    --canvas:#111827;
    --surface:#182235;
    --ink:#F8FAFC;
    --muted:#CBD5E1;
    --ghost:#94A3B8;
    --border:rgba(148,163,184,.24);
    --accent-light:rgba(225,29,72,.16);
    --neutral-bg:rgba(148,163,184,.16);
    --success-bg:rgba(16,185,129,.16);
    --danger-bg:rgba(239,68,68,.16);
    --warn-bg:rgba(217,119,6,.16);
  }
  .customer-card {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--r-lg);
    box-shadow:var(--shadow-sm);
    padding:1.25rem;
    height:100%;
  }
  .customer-title {
    color:var(--ink);
    font-weight:800;
    letter-spacing:-.02em;
    margin:0;
  }
  .customer-admin .form-control {
    background:var(--surface);
    color:var(--ink);
    border-color:var(--border);
  }
  .customer-admin .table {
    --bs-table-bg:var(--surface);
    --bs-table-color:var(--ink);
    --bs-table-border-color:var(--border);
    --bs-table-hover-bg:var(--accent-light);
    --bs-table-hover-color:var(--ink);
    color:var(--ink);
  }
  .customer-admin .table thead {
    color:var(--ink);
  }
  .customer-admin[data-theme="dark"] .btn-outline-secondary {
    color:var(--muted);
    border-color:var(--border);
  }
  .customer-admin[data-theme="dark"] .btn-outline-secondary:hover {
    color:var(--ink);
    background:var(--neutral-bg);
  }
  .admin-tabs {
    display:flex;
    gap:.5rem;
    overflow-x:auto;
    padding-bottom:.25rem;
  }
  .admin-tabs a {
    flex:0 0 auto;
    border:1px solid var(--border);
    background:var(--surface);
    color:var(--muted);
    border-radius:999px;
    padding:.5rem .8rem;
    font-size:.8125rem;
    font-weight:700;
  }
  .admin-tabs a:hover {
    color:var(--ink);
    border-color:rgba(225,29,72,.35);
  }
  .section-anchor { scroll-margin-top:7rem; }
  .mini-bar {
    height:10px;
    background:var(--neutral-bg);
    border-radius:999px;
    overflow:hidden;
  }
  .mini-bar span {
    display:block;
    height:100%;
    background:var(--accent);
    border-radius:999px;
  }
  .metric-list {
    display:flex;
    flex-direction:column;
    gap:.875rem;
  }
  .metric-row {
    display:grid;
    grid-template-columns:minmax(0, 1fr) auto;
    gap:.75rem;
    align-items:center;
  }
  .metric-row p {
    margin:0;
    color:var(--ink);
    font-weight:700;
    font-size:.875rem;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .metric-row small {
    color:var(--muted);
    font-family:var(--font-mono);
  }
  .calendar-card {
    display:grid;
    grid-template-columns:64px minmax(0, 1fr);
    gap:1rem;
    align-items:start;
    padding:1rem 0;
    border-top:1px solid var(--border);
  }
  .calendar-date {
    border:1px solid var(--border);
    border-radius:var(--r);
    background:var(--accent-light);
    text-align:center;
    overflow:hidden;
  }
  .calendar-date span {
    display:block;
    color:var(--accent);
    font-weight:800;
    line-height:1;
    padding:.4rem .25rem;
  }
  .calendar-date strong {
    display:block;
    background:var(--surface);
    color:var(--ink);
    font-size:1.35rem;
    line-height:1;
    padding:.5rem .25rem;
  }
  .chart-column-wrap {
    display:flex;
    align-items:end;
    gap:.45rem;
    min-height:170px;
    padding-top:.5rem;
  }
  .chart-column {
    flex:1;
    min-width:24px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-end;
    gap:.45rem;
  }
  .chart-column span {
    width:100%;
    min-height:8px;
    border-radius:.45rem .45rem 0 0;
    background:linear-gradient(180deg, var(--accent), #FB7185);
  }
  .chart-column small {
    color:var(--muted);
    font-size:.68rem;
    font-weight:700;
    writing-mode:vertical-rl;
    transform:rotate(180deg);
    max-height:48px;
  }
  .donut-grid {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));
    gap:.75rem;
  }
  .donut-stat {
    border:1px solid var(--border);
    border-radius:var(--r);
    background:var(--canvas);
    padding:1rem;
  }
  .donut-ring {
    width:72px;
    height:72px;
    border-radius:50%;
    display:grid;
    place-items:center;
    margin-bottom:.75rem;
    background:conic-gradient(var(--accent) var(--ring), var(--neutral-bg) 0);
  }
  .donut-ring span {
    width:48px;
    height:48px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:var(--surface);
    color:var(--ink);
    font-family:var(--font-mono);
    font-size:.78rem;
    font-weight:800;
  }
  .visual-strip {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));
    gap:.75rem;
  }
  .visual-tile {
    border:1px solid var(--border);
    border-radius:var(--r);
    background:var(--canvas);
    padding:.9rem;
  }
  .summary-panel {
    display:none;
    border:1px solid rgba(225,29,72,.22);
    border-radius:var(--r-lg);
    background:var(--surface);
    box-shadow:var(--shadow-sm);
    padding:1.25rem;
  }
  .summary-panel.is-visible {
    display:block;
  }
  .summary-panel__copy {
    color:var(--ink);
    line-height:1.7;
    margin:0;
    white-space:pre-line;
  }
  .summary-panel__meta {
    color:var(--muted);
    font-size:.8125rem;
    font-weight:700;
    margin-bottom:.75rem;
  }
</style>

<main class="customer-admin" id="customerAdmin">
  <div class="container" style="max-width:1400px;">
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
      <div>
        <p class="section-label mb-2"><%= t('admin.customers.eyebrow') %></p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.customers.title') %></h2>
        <p style="color:var(--muted);margin-bottom:0;"><%= t('admin.customers.subtitle') %></p>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <form method="GET" action="/admin/customers" class="d-flex flex-wrap gap-2 align-items-center">
          <input type="date" name="startDate" class="form-control rounded-xl" style="width:150px;" value="<%= range.startDate %>" />
          <input type="date" name="endDate" class="form-control rounded-xl" style="width:150px;" value="<%= range.endDate %>" />
          <button type="submit" class="btn btn-primary btn-pill">
            <i class="bi bi-funnel me-1"></i><%= t('admin.common.filter') %>
          </button>
        </form>
        <button type="button" class="btn btn-outline-secondary btn-pill" id="themeToggle">
          <i class="bi bi-moon-stars me-1"></i><%= t('admin.customers.theme') %>
        </button>
        <button type="button" class="btn btn-outline-secondary btn-pill" id="summaryButton">
          <i class="bi bi-file-earmark-text me-1"></i><%= t('admin.customers.summarize') %>
        </button>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <div class="admin-tabs mb-4">
      <a href="#overview"><%= t('admin.customers.tab.overview') %></a>
      <a href="#whatsapp"><%= t('admin.customers.tab.whatsapp') %></a>
      <a href="#loyalty"><%= t('admin.customers.tab.loyalty') %></a>
      <a href="#spending"><%= t('admin.customers.tab.spending') %></a>
      <a href="#recommendations"><%= t('admin.customers.tab.recommendations') %></a>
      <a href="#reviews"><%= t('admin.customers.tab.reviews') %></a>
      <a href="#security"><%= t('admin.customers.tab.security') %></a>
    </div>

    <section class="summary-panel mb-4" id="summaryPanel" aria-live="polite">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-2">
        <div>
          <p class="section-label mb-1"><%= t('admin.customers.summaryEyebrow') %></p>
          <h4 class="customer-title"><%= t('admin.customers.summaryTitle') %></h4>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm btn-pill" id="copySummaryButton">
          <i class="bi bi-clipboard me-1"></i><%= t('admin.customers.copy') %>
        </button>
      </div>
      <p class="summary-panel__meta" id="summaryMeta"></p>
      <p class="summary-panel__copy" id="summaryOutput"></p>
    </section>

    <section id="overview" class="section-anchor mb-5">
      <div class="row g-3">
        <% [
          { label:t('admin.customers.stat.accounts'), value:number(overview.total_customers), icon:'bi-person-badge', color:'var(--accent)' },
          { label:t('admin.customers.stat.paymentMethods'), value:number(overview.saved_payment_methods), icon:'bi-credit-card', color:'#1D4ED8' },
          { label:t('admin.customers.stat.totalSpent'), value:maskMoney(overview.total_amount_spent), icon:'bi-cash-stack', color:'var(--success)' },
          { label:t('admin.customers.stat.avgOrder'), value:money(overview.average_order_value), icon:'bi-bag-check', color:'var(--ink)' },
        ].forEach(stat => { %>
          <div class="col-6 col-lg-3">
            <div class="stat-card h-100">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.45rem;"><%= stat.label %></p>
                  <p class="stat-value" style="color:<%= stat.color %>;font-size:1.45rem;"><%= stat.value %></p>
                </div>
                <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
                  <i class="bi <%= stat.icon %>"></i>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-lg-8">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.profileTitle') %></h6>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
                <thead style="background:var(--accent-light);"><tr><th><%= t('admin.table.customer') %></th><th><%= t('admin.customers.contact') %></th><th><%= t('admin.customers.birthday') %></th><th><%= t('admin.table.points') %></th><th><%= t('admin.table.bookings') %></th><th><%= t('admin.customers.spent') %></th><th><%= t('admin.customers.favourites') %></th></tr></thead>
                <tbody>
                  <% (a.accountProfiles || []).forEach(customer => { %>
                    <tr>
                      <td>
                        <p style="font-weight:700;margin:0;"><%= customer.full_name || '-' %></p>
                        <p style="color:var(--muted);margin:0;font-size:.75rem;"><%= t('admin.accountStatus.' + (customer.status || 'active'), {}, customer.status || 'active') %></p>
                      </td>
                      <td>
                        <p style="margin:0;"><%= customer.email || '-' %></p>
                        <p style="color:var(--muted);margin:0;font-size:.75rem;"><%= maskPhone(customer.phone) %></p>
                      </td>
                      <td><%= customer.date_of_birth ? dateLabel(customer.date_of_birth) : '-' %></td>
                      <td><%= number(customer.points_balance) %></td>
                      <td><%= number(customer.bookings) %></td>
                      <td style="font-family:var(--font-mono);font-weight:700;"><%= maskMoney(customer.total_spent) %></td>
                      <td><%= number(customer.favourites) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (!(a.accountProfiles || []).length) { %><p style="color:var(--muted);margin:0;"><%= t('admin.customers.noProfiles') %></p><% } %>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.tierProgression') %></h6>
            <p style="color:var(--muted);margin-bottom:.35rem;"><%= t('admin.customers.avgPoints') %></p>
            <p class="stat-value" style="font-size:2rem;color:var(--accent);"><%= number(avgPoints) %></p>
            <div class="mini-bar mb-2"><span style="width:<%= barWidth(tierProgress, 100) %>%;"></span></div>
            <div class="d-flex justify-content-between" style="color:var(--muted);font-size:.75rem;font-weight:700;">
              <span><%= t('admin.tier.bronze') %></span><span><%= t('admin.tier.silver') %></span><span><%= t('admin.tier.gold') %></span>
            </div>
            <div class="metric-list mt-4">
              <div class="metric-row"><p><%= t('admin.customers.bronzeMembers') %></p><small><%= number(loyalty.bronze_members) %></small></div>
              <div class="metric-row"><p><%= t('admin.customers.silverMembers') %></p><small><%= number(loyalty.silver_members) %></small></div>
              <div class="metric-row"><p><%= t('admin.customers.goldMembers') %></p><small><%= number(loyalty.gold_members) %></small></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="whatsapp" class="section-anchor mb-5">
      <p class="section-label mb-1"><%= t('admin.customers.whatsappEyebrow') %></p>
      <h4 class="customer-title mb-3"><%= t('admin.customers.whatsappTitle') %></h4>
      <div class="row g-3">
        <% const whatsappSummary = a.whatsappBookingSummary || {}; %>
        <% [
          { label:t('admin.customers.wa.bookings'), value:number(whatsappSummary.total_bookings), icon:'bi-whatsapp', color:'var(--success)' },
          { label:t('admin.customers.wa.customers'), value:number(whatsappSummary.customers), icon:'bi-people', color:'var(--accent)' },
          { label:t('admin.customers.wa.paidRevenue'), value:maskMoney(whatsappSummary.paid_revenue), icon:'bi-cash-stack', color:'var(--success)' },
          { label:t('admin.customers.wa.avgPaid'), value:maskMoney(whatsappSummary.average_paid_booking), icon:'bi-bag-check', color:'var(--ink)' },
        ].forEach(stat => { %>
          <div class="col-6 col-lg-3">
            <div class="customer-card">
              <div class="icon-circle mb-3" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
                <i class="bi <%= stat.icon %>"></i>
              </div>
              <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;"><%= stat.label %></p>
              <p class="stat-value" style="color:<%= stat.color %>;font-size:1.45rem;"><%= stat.value %></p>
            </div>
          </div>
        <% }) %>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.wa.statusTitle') %></h6>
            <div class="metric-list">
              <% (a.whatsappBookingStatus || []).forEach(row => { %>
                <div class="metric-row"><p><%= t('admin.bookingStatus.' + row.status, {}, String(row.status || 'unknown').replace('_', ' ')) %></p><small><%= number(row.total) %></small></div>
              <% }) %>
              <% if (!(a.whatsappBookingStatus || []).length) { %><p style="color:var(--muted);margin:0;"><%= t('admin.customers.wa.noStatuses') %></p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-8">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.wa.recentTitle') %></h6>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
                <thead style="background:var(--accent-light);"><tr><th><%= t('admin.table.customer') %></th><th><%= t('common.merchant') %></th><th><%= t('common.service') %></th><th><%= t('admin.table.status') %></th><th><%= t('admin.payouts.status.paid') %></th><th><%= t('admin.logs.colCreated') %></th></tr></thead>
                <tbody>
                  <% (a.whatsappRecentBookings || []).forEach(booking => { %>
                    <tr>
                      <td>
                        <p style="font-weight:700;margin:0;"><%= booking.customer_name || '-' %></p>
                        <p style="color:var(--muted);margin:0;font-size:.75rem;"><%= maskPhone(booking.phone) %></p>
                      </td>
                      <td><%= booking.merchant_name || '-' %></td>
                      <td><%= booking.service_name || '-' %></td>
                      <td><%= t('admin.bookingStatus.' + booking.status, {}, String(booking.status || 'unknown').replace('_', ' ')) %></td>
                      <td style="font-family:var(--font-mono);font-weight:700;"><%= booking.payment_status === 'paid' ? maskMoney(booking.amount) : '-' %></td>
                      <td><%= dateLabel(booking.created_at) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (!(a.whatsappRecentBookings || []).length) { %><p style="color:var(--muted);margin:0;"><%= t('admin.customers.wa.noBookings') %></p><% } %>
          </div>
        </div>
      </div>
    </section>

    <section id="loyalty" class="section-anchor mb-5">
      <p class="section-label mb-1"><%= t('admin.customers.loyaltyEyebrow') %></p>
      <h4 class="customer-title mb-3"><%= t('admin.customers.loyaltyTitle') %></h4>
      <div class="row g-3">
        <div class="col-12">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.rewardVisual') %></h6>
            <div class="visual-strip">
              <div class="visual-tile">
                <p style="color:var(--muted);margin:0 0 .35rem;"><%= t('admin.customers.tierProgress') %></p>
                <p class="stat-value" style="font-size:1.45rem;"><%= percent(tierProgress) %></p>
                <div class="mini-bar"><span style="width:<%= barWidth(tierProgress, 100) %>%;"></span></div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-12">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.availableVouchers') %></h6>
            <div class="metric-list">
              <% (a.availableVouchers || []).forEach(voucher => { %>
                <div class="metric-row">
                  <p><%= voucher.campaign_name || voucher.voucher_code %></p>
                  <small><%= voucher.discount_type === 'percent' ? Number(voucher.discount_value || 0).toFixed(0) + '%' : money(voucher.discount_value) %></small>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="spending" class="section-anchor mb-5">
      <p class="section-label mb-1"><%= t('admin.customers.spendingEyebrow') %></p>
      <h4 class="customer-title mb-3"><%= t('admin.customers.spendingTitle') %></h4>
      <div class="row g-3">
        <div class="col-lg-6">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.spendCategories') %></h6>
            <% const categoryTotal = (a.spendingCategories || []).reduce((sum, row) => sum + Number(row.total || 0), 0) || 1; %>
            <div class="donut-grid mb-3">
              <% (a.spendingCategories || []).slice(0, 4).forEach(row => {
                const share = (Number(row.total || 0) / categoryTotal) * 100;
              %>
                <div class="donut-stat">
                  <div class="donut-ring" style="--ring:<%= share.toFixed(1) %>%;">
                    <span><%= share.toFixed(0) %>%</span>
                  </div>
                  <p style="color:var(--ink);font-weight:800;margin:0;"><%= row.category %></p>
                  <small style="color:var(--muted);font-family:var(--font-mono);"><%= maskMoney(row.total) %></small>
                </div>
              <% }) %>
              <% if (!(a.spendingCategories || []).length) { %><p style="color:var(--muted);margin:0;"><%= t('admin.customers.noCategorySpend') %></p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.bookingFrequency') %></h6>
            <% const frequencyMax = maxOf(a.bookingFrequency || [], 'bookings'); %>
            <div class="metric-list">
              <% (a.bookingFrequency || []).forEach(row => { %>
                <div>
                  <div class="metric-row mb-1"><p><%= row.day_label %></p><small><%= t('admin.payouts.bookingsCount', { count: number(row.bookings) }) %></small></div>
                  <div class="mini-bar"><span style="width:<%= barWidth(row.bookings, frequencyMax) %>%;"></span></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="recommendations" class="section-anchor mb-5">
      <p class="section-label mb-1"><%= t('admin.customers.recEyebrow') %></p>
      <h4 class="customer-title mb-3"><%= t('admin.customers.recTitle') %></h4>
      <div class="row g-3">
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.recMerchants') %></h6>
            <div class="metric-list">
              <% (a.recommendedMerchants || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.merchant_name %></p><small><%= rating(row.rating) %></small></div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.recServices') %></h6>
            <div class="metric-list">
              <% (a.suggestedServices || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.service_name %></p><small><%= row.category %></small></div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.recPromos') %></h6>
            <div class="metric-list">
              <% (a.behaviourPromotions || []).slice(0, 4).forEach(row => { %>
                <div class="metric-row"><p><%= row.campaign_name || row.voucher_code %></p></div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="reviews" class="section-anchor mb-5">
      <p class="section-label mb-1"><%= t('admin.customers.reviewsEyebrow') %></p>
      <h4 class="customer-title mb-3"><%= t('admin.customers.reviewsTitle') %></h4>
      <div class="row g-3">
        <div class="col-lg-4">
          <div class="customer-card">
            <p style="color:var(--muted);margin-bottom:.35rem;"><%= t('admin.feedback.averageRating') %></p>
            <p class="stat-value" style="font-size:2rem;color:var(--warn);"><%= rating(a.reviewSummary?.avg_rating) %></p>
            <p style="color:var(--muted);margin-bottom:.35rem;"><%= t('admin.customers.reviewsSubmitted') %></p>
            <p class="stat-value"><%= number(a.reviewSummary?.review_count) %></p>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.previousFeedback') %></h6>
            <div class="metric-list">
              <% (a.recentReviews || []).forEach(row => { %>
                <div>
                  <div class="metric-row"><p><%= row.customer_name %></p><small><%= row.rating %>/5</small></div>
                  <p style="color:var(--muted);margin:.15rem 0 0;font-size:.8rem;"><%= row.merchant_name %> · <%= row.service_name %></p>
                </div>
              <% }) %>
              <% if (!(a.recentReviews || []).length) { %><p style="color:var(--muted);margin:0;"><%= t('admin.customers.noReviews') %></p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.supportRequests') %></h6>
            <div class="metric-list">
              <% (a.platformFeedback || []).forEach(row => { %>
                <div class="metric-row"><p><%= t('admin.feedback.type.' + (row.feedback_type || 'general'), {}, String(row.feedback_type || 'general').replace('_', ' ')) %></p><small><%= number(row.total) %></small></div>
              <% }) %>
              <% if (!(a.platformFeedback || []).length) { %><p style="color:var(--muted);margin:0;"><%= t('admin.customers.noPlatformFeedback') %></p><% } %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="security" class="section-anchor mb-3">
      <p class="section-label mb-1"><%= t('admin.customers.securityEyebrow') %></p>
      <h4 class="customer-title mb-3"><%= t('admin.customers.securityTitle') %></h4>
      <div class="row g-3">
        <% [
          { label:t('admin.customers.activeAccounts'), value:number(security.active_accounts), icon:'bi-shield-check' },
          { label:t('admin.customers.suspendedAccounts'), value:number(security.suspended_accounts), icon:'bi-shield-exclamation' },
          { label:t('admin.customers.notificationPrefs'), value:t('admin.customers.notificationPrefsValue'), icon:'bi-bell' },
        ].forEach(item => { %>
          <div class="col-md-6 col-xl-4">
            <div class="customer-card">
              <div class="icon-circle mb-3" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
                <i class="bi <%= item.icon %>"></i>
              </div>
              <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;"><%= item.label %></p>
              <p style="color:var(--ink);font-weight:800;margin:0;"><%= item.value %></p>
            </div>
          </div>
        <% }) %>
        <div class="col-12">
          <div class="customer-card">
            <h6 class="customer-title mb-3"><%= t('admin.customers.paymentUsage') %></h6>
            <div class="metric-list">
              <% (a.paymentMethods || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.payment_method || t('admin.customers.unknown') %></p><small><%= t('admin.customers.paymentsCount', { count: number(row.total) }) %></small></div>
              <% }) %>
              <% if (!(a.paymentMethods || []).length) { %><p style="color:var(--muted);margin:0;"><%= t('admin.customers.noPaymentMethods') %></p><% } %>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>

<script>
  (function () {
    const dashboard = document.getElementById('customerAdmin');
    const toggle = document.getElementById('themeToggle');
    const summaryButton = document.getElementById('summaryButton');
    const summaryPanel = document.getElementById('summaryPanel');
    const summaryMeta = document.getElementById('summaryMeta');
    const summaryOutput = document.getElementById('summaryOutput');
    const copySummaryButton = document.getElementById('copySummaryButton');
    const analytics = <%- safeJson(a) %>;
    const range = <%- safeJson(range) %>;
    const storedTheme = localStorage.getItem('adminCustomerTheme') || 'light';
    dashboard.dataset.theme = storedTheme;

    toggle.addEventListener('click', function () {
      const nextTheme = dashboard.dataset.theme === 'dark' ? 'light' : 'dark';
      dashboard.dataset.theme = nextTheme;
      localStorage.setItem('adminCustomerTheme', nextTheme);
    });

    const number = value => Number(value || 0).toLocaleString('en-SG');
    const money = value => 'S$' + Number(value || 0).toFixed(2);
    const percent = value => Number(value || 0).toFixed(1) + '%';
    const dateLabel = value => value
      ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' })
      : '-';
    async function fetchAiSummary(endpoint, metaText) {
      const defaultButtonHtml = summaryButton.innerHTML;
      summaryButton.disabled = true;
      summaryButton.textContent = window.t('admin.customers.ai.generating');
      summaryMeta.textContent = metaText;
      summaryOutput.textContent = window.t('admin.customers.ai.generatingBody');
      summaryPanel.classList.add('is-visible');
      summaryPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            startDate: range.startDate,
            endDate: range.endDate,
          }),
        });
        const payload = await response.json().catch(() => ({}));
        if (!response.ok || !payload.success) {
          throw new Error(payload.message || window.t('admin.customers.ai.requestFailed'));
        }
        summaryMeta.textContent = window.t('admin.customers.ai.generatedMeta', { from: dateLabel(range.startDate), to: dateLabel(range.endDate) });
        summaryOutput.textContent = payload.summary?.text || window.t('admin.customers.ai.noSummary');
      } catch (error) {
        console.error('Failed to generate Gemini summary', error);
        summaryMeta.textContent = window.t('admin.customers.ai.unavailableMeta', { from: dateLabel(range.startDate), to: dateLabel(range.endDate) });
        summaryOutput.textContent = window.t('admin.customers.ai.errorBody') + ' ' + (error.message || window.t('admin.customers.ai.errorHint'));
      } finally {
        summaryButton.disabled = false;
        summaryButton.innerHTML = defaultButtonHtml;
      }
    }

    summaryButton.addEventListener('click', function () {
      fetchAiSummary(
        '/admin/customers/ai-summary',
        `Preparing Gemini AI summary from database data: ${dateLabel(range.startDate)} to ${dateLabel(range.endDate)}.`
      );
    });

    copySummaryButton.addEventListener('click', async function () {
      const value = summaryOutput.textContent || '';
      if (!value) return;
      await navigator.clipboard.writeText(value);
      copySummaryButton.innerHTML = '<i class="bi bi-check2 me-1"></i>' + window.t('admin.customers.copied');
      setTimeout(() => {
        copySummaryButton.innerHTML = '<i class="bi bi-clipboard me-1"></i>' + window.t('admin.customers.copy');
      }, 1600);
    });
  })();
</script>

<%- include('../partials/footer') %>
