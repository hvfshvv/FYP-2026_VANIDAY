<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const a = analytics || {};
  const overview = a.overview || {};
  const loyalty = a.loyaltySummary || {};
  const security = a.security || {};
  const money = value => 'S$' + Number(value || 0).toFixed(2);
  const number = value => Number(value || 0).toLocaleString('en-SG');
  const percent = value => Number(value || 0).toFixed(1) + '%';
  const rating = value => Number(value || 0).toFixed(1) + '/5';
  const dateLabel = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const timeLabel = value => value ? String(value).slice(0, 5) : '';
  const maxOf = (items, key) => Math.max(1, ...items.map(item => Number(item[key] || 0)));
  const barWidth = (value, max) => Math.max(5, Math.round((Number(value || 0) / max) * 100));
  const loyaltyMembers = Number(overview.loyalty_members || 0);
  const totalCustomers = Number(overview.total_customers || 0);
  const loyaltyRate = totalCustomers ? (loyaltyMembers / totalCustomers) * 100 : 0;
  const avgPoints = Number(overview.avg_points_balance || 0);
  const tierProgress = Math.min(100, (avgPoints / 2000) * 100);
  const qrTotal = (a.qrAccess || []).find(row => row.source === 'qr')?.total || 0;
  const reminderTotal = (a.reminders || []).reduce((sum, row) => sum + Number(row.total || 0), 0);
  const loyaltySummary = a.loyaltySummary || {};
  const safeJson = value => JSON.stringify(value || {}).replace(/</g, '\\u003c');
%>

<style>
  .customer-admin {
    background:var(--canvas);
    min-height:80vh;
    padding:2.5rem 1rem;
  }
  .customer-admin[data-theme="dark"] {
    --canvas:#111827;
    --surface:#182235;
    --ink:#F8FAFC;
    --muted:#CBD5E1;
    --ghost:#94A3B8;
    --border:rgba(148,163,184,.24);
    --accent-light:rgba(225,29,72,.16);
    --neutral-bg:rgba(148,163,184,.16);
    --success-bg:rgba(16,185,129,.16);
    --danger-bg:rgba(239,68,68,.16);
    --warn-bg:rgba(217,119,6,.16);
  }
  .customer-card {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--r-lg);
    box-shadow:var(--shadow-sm);
    padding:1.25rem;
    height:100%;
  }
  .customer-title {
    color:var(--ink);
    font-weight:800;
    letter-spacing:-.02em;
    margin:0;
  }
  .customer-admin .form-control {
    background:var(--surface);
    color:var(--ink);
    border-color:var(--border);
  }
  .customer-admin .table {
    --bs-table-bg:var(--surface);
    --bs-table-color:var(--ink);
    --bs-table-border-color:var(--border);
    --bs-table-hover-bg:var(--accent-light);
    --bs-table-hover-color:var(--ink);
    color:var(--ink);
  }
  .customer-admin .table thead {
    color:var(--ink);
  }
  .customer-admin[data-theme="dark"] .btn-outline-secondary {
    color:var(--muted);
    border-color:var(--border);
  }
  .customer-admin[data-theme="dark"] .btn-outline-secondary:hover {
    color:var(--ink);
    background:var(--neutral-bg);
  }
  .admin-tabs {
    display:flex;
    gap:.5rem;
    overflow-x:auto;
    padding-bottom:.25rem;
  }
  .admin-tabs a {
    flex:0 0 auto;
    border:1px solid var(--border);
    background:var(--surface);
    color:var(--muted);
    border-radius:999px;
    padding:.5rem .8rem;
    font-size:.8125rem;
    font-weight:700;
  }
  .admin-tabs a:hover {
    color:var(--ink);
    border-color:rgba(225,29,72,.35);
  }
  .section-anchor { scroll-margin-top:7rem; }
  .mini-bar {
    height:10px;
    background:var(--neutral-bg);
    border-radius:999px;
    overflow:hidden;
  }
  .mini-bar span {
    display:block;
    height:100%;
    background:var(--accent);
    border-radius:999px;
  }
  .metric-list {
    display:flex;
    flex-direction:column;
    gap:.875rem;
  }
  .metric-row {
    display:grid;
    grid-template-columns:minmax(0, 1fr) auto;
    gap:.75rem;
    align-items:center;
  }
  .metric-row p {
    margin:0;
    color:var(--ink);
    font-weight:700;
    font-size:.875rem;
    overflow:hidden;
    text-overflow:ellipsis;
    white-space:nowrap;
  }
  .metric-row small {
    color:var(--muted);
    font-family:var(--font-mono);
  }
  .calendar-card {
    display:grid;
    grid-template-columns:64px minmax(0, 1fr);
    gap:1rem;
    align-items:start;
    padding:1rem 0;
    border-top:1px solid var(--border);
  }
  .calendar-date {
    border:1px solid var(--border);
    border-radius:var(--r);
    background:var(--accent-light);
    text-align:center;
    overflow:hidden;
  }
  .calendar-date span {
    display:block;
    color:var(--accent);
    font-weight:800;
    line-height:1;
    padding:.4rem .25rem;
  }
  .calendar-date strong {
    display:block;
    background:var(--surface);
    color:var(--ink);
    font-size:1.35rem;
    line-height:1;
    padding:.5rem .25rem;
  }
  .chart-column-wrap {
    display:flex;
    align-items:end;
    gap:.45rem;
    min-height:170px;
    padding-top:.5rem;
  }
  .chart-column {
    flex:1;
    min-width:24px;
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:flex-end;
    gap:.45rem;
  }
  .chart-column span {
    width:100%;
    min-height:8px;
    border-radius:.45rem .45rem 0 0;
    background:linear-gradient(180deg, var(--accent), #FB7185);
  }
  .chart-column small {
    color:var(--muted);
    font-size:.68rem;
    font-weight:700;
    writing-mode:vertical-rl;
    transform:rotate(180deg);
    max-height:48px;
  }
  .donut-grid {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));
    gap:.75rem;
  }
  .donut-stat {
    border:1px solid var(--border);
    border-radius:var(--r);
    background:var(--canvas);
    padding:1rem;
  }
  .donut-ring {
    width:72px;
    height:72px;
    border-radius:50%;
    display:grid;
    place-items:center;
    margin-bottom:.75rem;
    background:conic-gradient(var(--accent) var(--ring), var(--neutral-bg) 0);
  }
  .donut-ring span {
    width:48px;
    height:48px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:var(--surface);
    color:var(--ink);
    font-family:var(--font-mono);
    font-size:.78rem;
    font-weight:800;
  }
  .visual-strip {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(160px, 1fr));
    gap:.75rem;
  }
  .visual-tile {
    border:1px solid var(--border);
    border-radius:var(--r);
    background:var(--canvas);
    padding:.9rem;
  }
  .summary-panel {
    display:none;
    border:1px solid rgba(225,29,72,.22);
    border-radius:var(--r-lg);
    background:var(--surface);
    box-shadow:var(--shadow-sm);
    padding:1.25rem;
  }
  .summary-panel.is-visible {
    display:block;
  }
  .summary-panel__copy {
    color:var(--ink);
    line-height:1.7;
    margin:0;
    white-space:pre-line;
  }
  .summary-panel__meta {
    color:var(--muted);
    font-size:.8125rem;
    font-weight:700;
    margin-bottom:.75rem;
  }
</style>

<main class="customer-admin" id="customerAdmin">
  <div class="container" style="max-width:1400px;">
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
      <div>
        <p class="section-label mb-2">Admin View</p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Customer Dashboard</h2>
        <p style="color:var(--muted);margin-bottom:0;">Account health, bookings, loyalty, spending, recommendations, reviews, and security settings.</p>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <form method="GET" action="/admin/customers" class="d-flex flex-wrap gap-2 align-items-center">
          <input type="date" name="startDate" class="form-control rounded-xl" style="width:150px;" value="<%= range.startDate %>" />
          <input type="date" name="endDate" class="form-control rounded-xl" style="width:150px;" value="<%= range.endDate %>" />
          <button type="submit" class="btn btn-primary btn-pill">
            <i class="bi bi-funnel me-1"></i>Filter
          </button>
        </form>
        <button type="button" class="btn btn-outline-secondary btn-pill" id="themeToggle">
          <i class="bi bi-moon-stars me-1"></i>Theme
        </button>
        <button type="button" class="btn btn-outline-secondary btn-pill" id="summaryButton">
          <i class="bi bi-file-earmark-text me-1"></i>Summarize Data
        </button>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <div class="admin-tabs mb-4">
      <a href="#overview">Account Overview</a>
      <a href="#bookings">Bookings</a>
      <a href="#loyalty">Loyalty</a>
      <a href="#spending">Spending</a>
      <a href="#recommendations">Recommendations</a>
      <a href="#reviews">Reviews</a>
      <a href="#security">Security</a>
    </div>

    <section class="summary-panel mb-4" id="summaryPanel" aria-live="polite">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-2">
        <div>
          <p class="section-label mb-1">Customer Data Summary</p>
          <h4 class="customer-title">Data Analysis</h4>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm btn-pill" id="copySummaryButton">
          <i class="bi bi-clipboard me-1"></i>Copy
        </button>
      </div>
      <p class="summary-panel__meta" id="summaryMeta"></p>
      <p class="summary-panel__copy" id="summaryOutput"></p>
    </section>

    <section id="overview" class="section-anchor mb-5">
      <div class="row g-3">
        <% [
          { label:'Customer accounts', value:number(overview.total_customers), icon:'bi-person-badge', color:'var(--accent)' },
          { label:'Loyalty members', value:number(overview.loyalty_members), icon:'bi-award', color:'var(--warn)' },
          { label:'Reward points balance', value:number(overview.reward_points_balance), icon:'bi-coin', color:'var(--success)' },
          { label:'Payment methods used', value:number(overview.saved_payment_methods), icon:'bi-credit-card', color:'#1D4ED8' },
          { label:'Preferred merchants', value:number(overview.preferred_merchants), icon:'bi-heart', color:'var(--danger)' },
          { label:'Total amount spent', value:money(overview.total_amount_spent), icon:'bi-cash-stack', color:'var(--success)' },
          { label:'Average order value', value:money(overview.average_order_value), icon:'bi-bag-check', color:'var(--ink)' },
          { label:'Loyalty adoption', value:percent(loyaltyRate), icon:'bi-graph-up', color:'var(--accent)' },
        ].forEach(stat => { %>
          <div class="col-6 col-lg-3">
            <div class="stat-card h-100">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.45rem;"><%= stat.label %></p>
                  <p class="stat-value" style="color:<%= stat.color %>;font-size:1.45rem;"><%= stat.value %></p>
                </div>
                <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
                  <i class="bi <%= stat.icon %>"></i>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>

      <div class="row g-3 mt-1">
        <div class="col-lg-8">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Profile Information &amp; Membership Status</h6>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
                <thead style="background:var(--accent-light);"><tr><th>Customer</th><th>Contact</th><th>Birthday</th><th>Points</th><th>Bookings</th><th>Spent</th><th>Favourites</th></tr></thead>
                <tbody>
                  <% (a.accountProfiles || []).forEach(customer => { %>
                    <tr>
                      <td>
                        <p style="font-weight:700;margin:0;"><%= customer.full_name || '-' %></p>
                        <p style="color:var(--muted);margin:0;font-size:.75rem;"><%= customer.status || 'active' %></p>
                      </td>
                      <td>
                        <p style="margin:0;"><%= customer.email || '-' %></p>
                        <p style="color:var(--muted);margin:0;font-size:.75rem;"><%= customer.phone || 'No phone' %></p>
                      </td>
                      <td><%= customer.date_of_birth ? dateLabel(customer.date_of_birth) : '-' %></td>
                      <td><%= number(customer.points_balance) %></td>
                      <td><%= number(customer.bookings) %></td>
                      <td style="font-family:var(--font-mono);font-weight:700;"><%= money(customer.total_spent) %></td>
                      <td><%= number(customer.favourites) %></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (!(a.accountProfiles || []).length) { %><p style="color:var(--muted);margin:0;">No customer profiles found.</p><% } %>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Loyalty Tier Progression</h6>
            <p style="color:var(--muted);margin-bottom:.35rem;">Average points balance</p>
            <p class="stat-value" style="font-size:2rem;color:var(--accent);"><%= number(avgPoints) %></p>
            <div class="mini-bar mb-2"><span style="width:<%= barWidth(tierProgress, 100) %>%;"></span></div>
            <div class="d-flex justify-content-between" style="color:var(--muted);font-size:.75rem;font-weight:700;">
              <span>Bronze</span><span>Silver</span><span>Gold</span>
            </div>
            <div class="metric-list mt-4">
              <div class="metric-row"><p>Bronze members</p><small><%= number(loyalty.bronze_members) %></small></div>
              <div class="metric-row"><p>Silver members</p><small><%= number(loyalty.silver_members) %></small></div>
              <div class="metric-row"><p>Gold members</p><small><%= number(loyalty.gold_members) %></small></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="bookings" class="section-anchor mb-5">
      <p class="section-label mb-1">Booking Management</p>
      <h4 class="customer-title mb-3">Upcoming, Past &amp; Status Tracking</h4>
      <div class="row g-3">
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Upcoming Appointments</h6>
            <% (a.upcomingBookings || []).forEach(booking => { const dt = new Date(booking.slot_date); %>
              <div class="calendar-card">
                <div class="calendar-date">
                  <span><%= dt.toLocaleDateString('en-SG', { month:'short' }) %></span>
                  <strong><%= dt.getDate() %></strong>
                </div>
                <div>
                  <p style="font-weight:800;color:var(--ink);margin:0;"><%= booking.service_name %></p>
                  <p style="color:var(--muted);margin:0;"><%= booking.customer_name %> · <%= booking.merchant_name %></p>
                  <p style="color:var(--accent);font-weight:700;margin:.25rem 0 0;"><%= timeLabel(booking.start_time) %> · <%= booking.status.replace('_', ' ') %></p>
                </div>
              </div>
            <% }) %>
            <% if (!(a.upcomingBookings || []).length) { %><p style="color:var(--muted);margin:0;">No upcoming bookings.</p><% } %>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Past Bookings</h6>
            <div class="metric-list">
              <% (a.pastBookings || []).forEach(booking => { %>
                <div class="metric-row">
                  <p><%= booking.service_name %></p>
                  <small><%= dateLabel(booking.slot_date) %></small>
                </div>
              <% }) %>
              <% if (!(a.pastBookings || []).length) { %><p style="color:var(--muted);margin:0;">No past bookings.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Status, QR Access &amp; Reminders</h6>
            <div class="metric-list">
              <% (a.bookingStatus || []).forEach(row => { %>
                <div class="metric-row"><p><%= String(row.status || 'unknown').replace('_', ' ') %></p><small><%= number(row.total) %></small></div>
              <% }) %>
              <div class="metric-row"><p>QR booking access</p><small><%= number(qrTotal) %> bookings</small></div>
              <div class="metric-row"><p>Booking reminders</p><small><%= number(reminderTotal) %> scheduled/sent</small></div>
              <div class="metric-row"><p>Cancel/reschedule tools</p><small>Available in customer booking history</small></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="loyalty" class="section-anchor mb-5">
      <p class="section-label mb-1">Loyalty &amp; Rewards</p>
      <h4 class="customer-title mb-3">Points, Vouchers &amp; Referral Signals</h4>
      <div class="row g-3">
        <div class="col-12">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Reward Balance Visual</h6>
            <div class="visual-strip">
              <div class="visual-tile">
                <p style="color:var(--muted);margin:0 0 .35rem;">Points balance</p>
                <p class="stat-value" style="font-size:1.45rem;color:var(--accent);"><%= number(loyalty.points_balance) %></p>
                <div class="mini-bar"><span style="width:<%= barWidth(loyalty.points_balance, Math.max(1, Number(loyalty.points_earned || 1))) %>%;"></span></div>
              </div>
              <div class="visual-tile">
                <p style="color:var(--muted);margin:0 0 .35rem;">Stored wallet balance</p>
                <p class="stat-value" style="font-size:1.45rem;color:var(--success);"><%= money(loyalty.money_balance) %></p>
                <div class="mini-bar"><span style="width:<%= barWidth(loyalty.money_balance, Math.max(1, Number(loyalty.money_balance || 1))) %>%;background:var(--success);"></span></div>
              </div>
              <div class="visual-tile">
                <p style="color:var(--muted);margin:0 0 .35rem;">Tier progress</p>
                <p class="stat-value" style="font-size:1.45rem;"><%= percent(tierProgress) %></p>
                <div class="mini-bar"><span style="width:<%= barWidth(tierProgress, 100) %>%;"></span></div>
              </div>
            </div>
          </div>
        </div>
        <div class="col-lg-3">
          <div class="customer-card">
            <p style="color:var(--muted);margin-bottom:.35rem;">Points earned</p>
            <p class="stat-value" style="font-size:1.8rem;color:var(--success);"><%= number(loyalty.points_earned) %></p>
            <p style="color:var(--muted);margin-bottom:.35rem;">Points spent</p>
            <p class="stat-value" style="font-size:1.8rem;color:var(--accent);"><%= number(loyalty.points_redeemed) %></p>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Reward History</h6>
            <div class="metric-list">
              <% (a.loyaltyTransactions || []).forEach(row => { %>
                <div class="metric-row"><p><%= String(row.transaction_type || '').replace('_', ' ') %></p><small><%= number(row.points) %> pts</small></div>
              <% }) %>
              <% if (!(a.loyaltyTransactions || []).length) { %><p style="color:var(--muted);margin:0;">No loyalty transactions yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Available Vouchers &amp; Promotions</h6>
            <div class="metric-list">
              <% (a.availableVouchers || []).forEach(voucher => { %>
                <div class="metric-row">
                  <p><%= voucher.campaign_name || voucher.voucher_code %></p>
                  <small><%= voucher.discount_type === 'percent' ? Number(voucher.discount_value || 0).toFixed(0) + '%' : money(voucher.discount_value) %></small>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="spending" class="section-anchor mb-5">
      <p class="section-label mb-1">Spending &amp; Activity Analytics</p>
      <h4 class="customer-title mb-3">Trends, Categories &amp; Usage</h4>
      <div class="row g-3">
        <div class="col-lg-6">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Monthly Spending Trend</h6>
            <% const spendMax = maxOf(a.spendingTrend || [], 'total'); %>
            <div class="chart-column-wrap mb-3">
              <% (a.spendingTrend || []).forEach(row => { %>
                <div class="chart-column" title="<%= row.month_label %>: <%= money(row.total) %>">
                  <span style="height:<%= barWidth(row.total, spendMax) %>%;"></span>
                  <small><%= row.month_label %></small>
                </div>
              <% }) %>
            </div>
            <div class="metric-list">
              <% (a.spendingTrend || []).forEach(row => { %>
                <div>
                  <div class="metric-row mb-1"><p><%= row.month_label %></p><small><%= money(row.total) %></small></div>
                  <div class="mini-bar"><span style="width:<%= barWidth(row.total, spendMax) %>%;"></span></div>
                </div>
              <% }) %>
              <% if (!(a.spendingTrend || []).length) { %><p style="color:var(--muted);margin:0;">No spending trend yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Spending Categories</h6>
            <% const categoryTotal = (a.spendingCategories || []).reduce((sum, row) => sum + Number(row.total || 0), 0) || 1; %>
            <div class="donut-grid mb-3">
              <% (a.spendingCategories || []).slice(0, 4).forEach(row => {
                const share = (Number(row.total || 0) / categoryTotal) * 100;
              %>
                <div class="donut-stat">
                  <div class="donut-ring" style="--ring:<%= share.toFixed(1) %>%;">
                    <span><%= share.toFixed(0) %>%</span>
                  </div>
                  <p style="color:var(--ink);font-weight:800;margin:0;"><%= row.category %></p>
                  <small style="color:var(--muted);font-family:var(--font-mono);"><%= money(row.total) %></small>
                </div>
              <% }) %>
              <% if (!(a.spendingCategories || []).length) { %><p style="color:var(--muted);margin:0;">No category spend yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Most Visited Merchants</h6>
            <div class="metric-list">
              <% (a.mostVisitedMerchants || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.merchant_name %></p><small><%= number(row.visits) %> visits</small></div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Favourite Services</h6>
            <div class="metric-list">
              <% (a.favouriteServices || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.service_name %></p><small><%= number(row.bookings) %></small></div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Booking Frequency</h6>
            <% const frequencyMax = maxOf(a.bookingFrequency || [], 'bookings'); %>
            <div class="metric-list">
              <% (a.bookingFrequency || []).forEach(row => { %>
                <div>
                  <div class="metric-row mb-1"><p><%= row.day_label %></p><small><%= number(row.bookings) %> bookings</small></div>
                  <div class="mini-bar"><span style="width:<%= barWidth(row.bookings, frequencyMax) %>%;"></span></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="recommendations" class="section-anchor mb-5">
      <p class="section-label mb-1">Personalized Recommendations</p>
      <h4 class="customer-title mb-3">Merchant, Service &amp; Promotion Suggestions</h4>
      <div class="row g-3">
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Recommended Merchants</h6>
            <div class="metric-list">
              <% (a.recommendedMerchants || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.merchant_name %></p><small><%= rating(row.rating) %></small></div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Suggested Services</h6>
            <div class="metric-list">
              <% (a.suggestedServices || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.service_name %></p><small><%= row.category %></small></div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Behaviour-Based Recommendations</h6>
            <div class="metric-list">
              <% (a.behaviourPromotions || []).slice(0, 4).forEach(row => { %>
                <div class="metric-row"><p><%= row.campaign_name || row.voucher_code %></p><small>Behaviour promo</small></div>
              <% }) %>
              <div class="metric-row"><p>Frequently booked combinations</p><small>Service bundle model pending</small></div>
              <div class="metric-row"><p>Promotion matching</p><small>Based on top categories</small></div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="reviews" class="section-anchor mb-5">
      <p class="section-label mb-1">Reviews &amp; Feedback</p>
      <h4 class="customer-title mb-3">Ratings, Previous Feedback &amp; Support Signals</h4>
      <div class="row g-3">
        <div class="col-lg-4">
          <div class="customer-card">
            <p style="color:var(--muted);margin-bottom:.35rem;">Average rating</p>
            <p class="stat-value" style="font-size:2rem;color:var(--warn);"><%= rating(a.reviewSummary?.avg_rating) %></p>
            <p style="color:var(--muted);margin-bottom:.35rem;">Reviews submitted</p>
            <p class="stat-value"><%= number(a.reviewSummary?.review_count) %></p>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Previous Feedback</h6>
            <div class="metric-list">
              <% (a.recentReviews || []).forEach(row => { %>
                <div>
                  <div class="metric-row"><p><%= row.customer_name %></p><small><%= row.rating %>/5</small></div>
                  <p style="color:var(--muted);margin:.15rem 0 0;font-size:.8rem;"><%= row.merchant_name %> · <%= row.service_name %></p>
                </div>
              <% }) %>
              <% if (!(a.recentReviews || []).length) { %><p style="color:var(--muted);margin:0;">No reviews yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Complaint / Support Requests</h6>
            <div class="metric-list">
              <% (a.platformFeedback || []).forEach(row => { %>
                <div class="metric-row"><p><%= String(row.feedback_type || 'general').replace('_', ' ') %></p><small><%= number(row.total) %></small></div>
              <% }) %>
              <% if (!(a.platformFeedback || []).length) { %><p style="color:var(--muted);margin:0;">No platform feedback or support records yet.</p><% } %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="security" class="section-anchor mb-3">
      <p class="section-label mb-1">Security &amp; Settings</p>
      <h4 class="customer-title mb-3">Account Controls</h4>
      <div class="row g-3">
        <% [
          { label:'Active accounts', value:number(security.active_accounts), icon:'bi-shield-check' },
          { label:'Suspended accounts', value:number(security.suspended_accounts), icon:'bi-shield-exclamation' },
          { label:'Notification preferences', value:'Email / WhatsApp records', icon:'bi-bell' },
          { label:'Linked accounts', value:'Not configured', icon:'bi-link-45deg' },
          { label:'Privacy settings', value:'Managed by account policy', icon:'bi-lock' },
          { label:'Password settings', value:'Available in auth module', icon:'bi-key' },
        ].forEach(item => { %>
          <div class="col-md-6 col-xl-4">
            <div class="customer-card">
              <div class="icon-circle mb-3" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
                <i class="bi <%= item.icon %>"></i>
              </div>
              <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;"><%= item.label %></p>
              <p style="color:var(--ink);font-weight:800;margin:0;"><%= item.value %></p>
            </div>
          </div>
        <% }) %>
        <div class="col-12">
          <div class="customer-card">
            <h6 class="customer-title mb-3">Payment Method Usage</h6>
            <div class="metric-list">
              <% (a.paymentMethods || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.payment_method || 'Unknown' %></p><small><%= number(row.total) %> payments</small></div>
              <% }) %>
              <% if (!(a.paymentMethods || []).length) { %><p style="color:var(--muted);margin:0;">No payment method records yet.</p><% } %>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</main>

<script>
  (function () {
    const dashboard = document.getElementById('customerAdmin');
    const toggle = document.getElementById('themeToggle');
    const summaryButton = document.getElementById('summaryButton');
    const summaryPanel = document.getElementById('summaryPanel');
    const summaryMeta = document.getElementById('summaryMeta');
    const summaryOutput = document.getElementById('summaryOutput');
    const copySummaryButton = document.getElementById('copySummaryButton');
    const analytics = <%- safeJson(a) %>;
    const range = <%- safeJson(range) %>;
    const storedTheme = localStorage.getItem('adminCustomerTheme') || 'light';
    dashboard.dataset.theme = storedTheme;

    toggle.addEventListener('click', function () {
      const nextTheme = dashboard.dataset.theme === 'dark' ? 'light' : 'dark';
      dashboard.dataset.theme = nextTheme;
      localStorage.setItem('adminCustomerTheme', nextTheme);
    });

    const number = value => Number(value || 0).toLocaleString('en-SG');
    const money = value => 'S$' + Number(value || 0).toFixed(2);
    const percent = value => Number(value || 0).toFixed(1) + '%';
    const dateLabel = value => value
      ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' })
      : '-';
    const text = value => String(value || '').replace(/_/g, ' ');
    const isFiniteNumber = value => Number.isFinite(Number(value || 0));
    const safeNumber = value => (isFiniteNumber(value) ? Number(value) : 0);
    const safePercent = (value, total) => total ? percent((safeNumber(value) / safeNumber(total)) * 100) : '0.0%';
    const safeMoney = value => money(safeNumber(value));
    const safeLabel = value => value ? String(value) : 'No data available';
    const listTop = (items, mapper, fallback) => {
      const values = (items || []).slice(0, 3).map(mapper).filter(Boolean);
      return values.length ? values.join(', ') : fallback;
    };
    const valuesFor = (items, key) => (items || [])
      .map(item => safeNumber(item[key]))
      .filter(value => Number.isFinite(value));
    const statsFor = values => {
      const nums = values.filter(value => Number.isFinite(value)).sort((a, b) => a - b);
      if (!nums.length) return null;
      const sum = nums.reduce((total, value) => total + value, 0);
      const mean = sum / nums.length;
      const median = nums.length % 2
        ? nums[(nums.length - 1) / 2]
        : (nums[(nums.length / 2) - 1] + nums[nums.length / 2]) / 2;
      const variance = nums.reduce((total, value) => total + Math.pow(value - mean, 2), 0) / nums.length;
      return {
        count: nums.length,
        mean,
        median,
        min: nums[0],
        max: nums[nums.length - 1],
        stdDev: Math.sqrt(variance),
      };
    };
    const frequencyText = (items, labelKey, valueKey, fallback) => {
      const total = (items || []).reduce((sum, row) => sum + safeNumber(row[valueKey]), 0);
      if (!total) return fallback;
      return (items || []).slice(0, 4).map(row => {
        const value = safeNumber(row[valueKey]);
        const share = (value / total) * 100;
        return `${text(row[labelKey] || 'Unknown')} ${number(value)} (${percent(share)})`;
      }).join(', ');
    };
    const buildMetricLine = (label, value) => `${label}: ${value}`;
    const buildStatusLine = (row, bookingTotal) => {
      if (!row) return 'No booking status data available for the selected period.';
      return `${text(row.status || 'unknown')} ${number(row.total || 0)} (${safePercent(row.total, bookingTotal)})`;
    };

    function buildCustomerSummary() {
      const overview = analytics.overview || {};
      const loyalty = analytics.loyaltySummary || {};
      const security = analytics.security || {};
      const totalCustomers = safeNumber(overview.total_customers);
      const loyaltyMembers = safeNumber(overview.loyalty_members);
      const loyaltyRate = totalCustomers ? (loyaltyMembers / totalCustomers) * 100 : 0;
      const totalBookings = (analytics.bookingStatus || []).reduce((sum, row) => sum + safeNumber(row.total), 0);
      const totalSpend = safeNumber(overview.total_amount_spent);
      const avgOrderValue = safeNumber(overview.average_order_value);
      const accountSpendStats = statsFor(valuesFor(analytics.accountProfiles, 'total_spent'));
      const monthlySpendStats = statsFor(valuesFor(analytics.spendingTrend, 'total'));
      const bookingFrequencyStats = statsFor(valuesFor(analytics.bookingFrequency, 'bookings'));
      const categoryTotal = (analytics.spendingCategories || []).reduce((sum, row) => sum + safeNumber(row.total), 0);
      const paymentTotal = (analytics.paymentMethods || []).reduce((sum, row) => sum + safeNumber(row.total), 0);
      const tierTotal = safeNumber(loyalty.bronze_members) + safeNumber(loyalty.silver_members) + safeNumber(loyalty.gold_members);
      const topCustomer = (analytics.accountProfiles || []).reduce((best, row) => {
        if (!best || safeNumber(row.total_spent) > safeNumber(best.total_spent)) return row;
        return best;
      }, null);
      const topCategory = (analytics.spendingCategories || []).reduce((best, row) => {
        if (!best || safeNumber(row.total) > safeNumber(best.total)) return row;
        return best;
      }, null);
      const topMerchant = (analytics.mostVisitedMerchants || []).reduce((best, row) => {
        if (!best || safeNumber(row.visits) > safeNumber(best.visits)) return row;
        return best;
      }, null);
      const topService = (analytics.favouriteServices || []).reduce((best, row) => {
        if (!best || safeNumber(row.bookings) > safeNumber(best.bookings)) return row;
        return best;
      }, null);
      const topPayment = (analytics.paymentMethods || []).reduce((best, row) => {
        if (!best || safeNumber(row.total) > safeNumber(best.total)) return row;
        return best;
      }, null);
      const topEmployee = (analytics.staffPerformance || []).reduce((best, row) => {
        if (!best || safeNumber(row.bookings) > safeNumber(best.bookings)) return row;
        return best;
      }, null);
      const topBookingDay = (analytics.bookingFrequency || []).reduce((best, row) => {
        if (!best || safeNumber(row.bookings) > safeNumber(best.bookings)) return row;
        return best;
      }, null);
      const topStatus = (analytics.bookingStatus || []).reduce((best, row) => {
        if (!best || safeNumber(row.total) > safeNumber(best.total)) return row;
        return best;
      }, null);
      const completed = (analytics.bookingStatus || []).find(row => String(row.status || '').toLowerCase() === 'completed');
      const cancelled = (analytics.bookingStatus || []).find(row => String(row.status || '').toLowerCase() === 'cancelled');
      const paymentFailed = (analytics.bookingStatus || []).find(row => String(row.status || '').toLowerCase().includes('payment_failed'));
      const firstMonth = (analytics.spendingTrend || [])[0];
      const lastMonth = (analytics.spendingTrend || []).slice(-1)[0];
      const reviewCount = safeNumber((analytics.reviewSummary || {}).review_count);
      const avgRating = Number((analytics.reviewSummary || {}).avg_rating || 0).toFixed(1);
      const activeAccounts = safeNumber(security.active_accounts);
      const suspendedAccounts = safeNumber(security.suspended_accounts);
      const topCustomerText = topCustomer
        ? `${safeLabel(topCustomer.full_name)} (${number(topCustomer.bookings || 0)} booking${safeNumber(topCustomer.bookings) === 1 ? '' : 's'}, ${safeMoney(topCustomer.total_spent)})`
        : 'No customer leader is available for the selected period.';
      const topCategoryText = topCategory
        ? `${safeLabel(topCategory.category)} (${safeMoney(topCategory.total)}, ${safePercent(topCategory.total, categoryTotal)} of category spending)`
        : 'No category spend data is available for the selected period.';
      const topMerchantText = topMerchant
        ? `${safeLabel(topMerchant.merchant_name)} (${number(topMerchant.visits || 0)} visit${safeNumber(topMerchant.visits) === 1 ? '' : 's'}, ${safeMoney(topMerchant.spent || 0)})`
        : 'No merchant visit leader is available for the selected period.';
      const topServiceText = topService
        ? `${safeLabel(topService.service_name)} (${number(topService.bookings || 0)} booking${safeNumber(topService.bookings) === 1 ? '' : 's'}, ${safeMoney(topService.spent || 0)})`
        : 'No favourite-service leader is available for the selected period.';
      const paymentInsight = topPayment
        ? `${safeLabel(topPayment.payment_method)} accounts for ${safePercent(topPayment.total, paymentTotal)} of recorded payments.`
        : 'No payment-method data is available for the selected period.';
      const loyaltyInsight = tierTotal
        ? `Loyalty tiers are ${safePercent(loyalty.bronze_members, tierTotal)} Bronze, ${safePercent(loyalty.silver_members, tierTotal)} Silver, and ${safePercent(loyalty.gold_members, tierTotal)} Gold.`
        : 'No loyalty tier data is available for the selected period.';
      const spendDistributionText = accountSpendStats
        ? `Customer spend distribution shows a mean of ${safeMoney(accountSpendStats.mean)}, a median of ${safeMoney(accountSpendStats.median)}, and a standard deviation of ${safeMoney(accountSpendStats.stdDev)}.`
        : 'No customer spend distribution is available for the selected period.';
      const monthlyTrendText = firstMonth && lastMonth
        ? `Monthly spend moved from ${safeMoney(firstMonth.total)} in ${safeLabel(firstMonth.month_label)} to ${safeMoney(lastMonth.total)} in ${safeLabel(lastMonth.month_label)}.`
        : 'No monthly spend trend is available for the selected period.';
      const bookingFrequencyText = bookingFrequencyStats
        ? `Booking frequency reports a mean of ${number(bookingFrequencyStats.mean.toFixed(1))} bookings per active day, a median of ${number(bookingFrequencyStats.median.toFixed(1))}, and a standard deviation of ${number(bookingFrequencyStats.stdDev.toFixed(1))}.`
        : 'No booking frequency distribution is available for the selected period.';
      const statusText = topStatus
        ? `${text(topStatus.status)} is the most common status at ${buildStatusLine(topStatus, totalBookings)}`
        : 'No booking status data is available for the selected period.';
      const reviewText = reviewCount > 0
        ? `Customers submitted ${number(reviewCount)} review${reviewCount === 1 ? '' : 's'} with an average rating of ${avgRating}/5.`
        : 'No review data is available for the selected period.';
      const securityText = activeAccounts + suspendedAccounts > 0
        ? `Customer accounts are ${number(activeAccounts)} active and ${number(suspendedAccounts)} suspended.`
        : 'No account-status data is available for the selected period.';
      const employeeFocusText = topEmployee
        ? `${safeLabel(topEmployee.staff_name)} handled the most employee-linked bookings (${number(topEmployee.bookings)}), so use their workload as the clearest staffing signal for this filter.`
        : 'No employee-linked booking data is available for this filter, so use the customer, service, timing, and booking-status signals below for daily actions.';
      const employeeDailyActions = [
        topService
          ? `Prepare for ${safeLabel(topService.service_name)} requests first: review tools, products, add-ons, and aftercare notes before appointments because this is the strongest service demand signal.`
          : 'Check the appointment list before each shift because the selected data does not show a clear leading service yet.',
        topCategory
          ? `When customers ask for recommendations, lead with ${safeLabel(topCategory.category)} options, then suggest suitable follow-up services instead of giving generic recommendations.`
          : 'Ask one extra preference question during consultation so recommendations can be personalized while category demand is still unclear.',
        topBookingDay
          ? `On ${safeLabel(topBookingDay.day_label)}, expect heavier demand and keep handovers short, supplies ready, and customer follow-ups scheduled before the rush.`
          : 'Spread prep work evenly across the week because the filtered data does not show a clear busiest day.',
        cancelled || paymentFailed
          ? `Reduce lost bookings by confirming appointment details, payment readiness, and cancellation terms early, especially when customers seem unsure.`
          : 'Protect the current booking flow by continuing clear confirmations, punctual service starts, and simple payment guidance.',
        reviewCount > 0
          ? `Customer experience is visible in reviews (${avgRating}/5 average), so each employee should close the appointment with aftercare advice and a polite review reminder.`
          : 'Start collecting feedback after completed appointments so employees can see what customers value and what needs fixing.',
        loyaltyMembers
          ? `Mention loyalty points and vouchers during checkout because ${number(loyaltyMembers)} customers in this view are loyalty members or loyalty-linked.`
          : 'Introduce the loyalty programme during checkout so repeat customers have a reason to book again.',
      ].join('\n- ');

      return `Summary

Period: ${dateLabel(range.startDate)} to ${dateLabel(range.endDate)}.
${buildMetricLine('Bookings', totalBookings ? number(totalBookings) : 'No data available')}; ${buildMetricLine('Spend', safeMoney(totalSpend))}; ${buildMetricLine('Customers', totalCustomers ? number(totalCustomers) : 'No data available')}; ${buildMetricLine('Loyalty members', loyaltyMembers ? number(loyaltyMembers) : 'No data available')}; ${buildMetricLine('Avg order value', safeMoney(avgOrderValue))}; ${buildMetricLine('Top customer', topCustomerText)}

Stats

${spendDistributionText}
${monthlyTrendText}
${bookingFrequencyText}

Insights

- ${topCategoryText}
- ${topMerchantText}
- ${topServiceText}
- ${paymentInsight}
- ${loyaltyInsight}
- ${statusText}
- ${reviewText}
- ${securityText}

Takeaway

${totalBookings ? `${number(totalBookings)} bookings` : 'No bookings'} and ${totalSpend ? `${safeMoney(totalSpend)} spend` : 'no spend'} for the selected period. The main customer, category, merchant, service, payment, loyalty, and status insights come from the same filtered records.

What This Means For Employees

Employee-focused view based on the current filtered dashboard data.

${employeeFocusText}

Daily actions:
- ${employeeDailyActions}`;
    }

    summaryButton.addEventListener('click', function () {
      try {
        const content = buildCustomerSummary();
        summaryMeta.textContent = `Generated from the currently filtered dashboard data: ${dateLabel(range.startDate)} to ${dateLabel(range.endDate)}.`;
        summaryOutput.textContent = content || 'No summary was generated for the selected period.';
        summaryPanel.classList.add('is-visible');
        summaryPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      } catch (error) {
        console.error('Failed to build customer summary', error);
        summaryMeta.textContent = `Generated from the currently filtered dashboard data: ${dateLabel(range.startDate)} to ${dateLabel(range.endDate)}.`;
        summaryOutput.textContent = 'The summary could not be generated for the selected period. Please try a different date range or refresh the page.';
        summaryPanel.classList.add('is-visible');
        summaryPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    copySummaryButton.addEventListener('click', async function () {
      const value = summaryOutput.textContent || '';
      if (!value) return;
      await navigator.clipboard.writeText(value);
      copySummaryButton.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied';
      setTimeout(() => {
        copySummaryButton.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy';
      }, 1600);
    });
  })();
</script>

<%- include('../partials/footer') %>
