<% locals.hideCatNav = true %>
<%- include('../partials/header') %>
<%
  const money = value => 'S$' + Number(value || 0).toFixed(2);
  const settlementBand = value => {
    const amount = Number(value || 0);
    if (amount <= 0) return 'S$0';
    if (amount < 10) return 'S$X';
    if (amount < 100) return 'S$' + Math.floor(amount / 10) + 'X';
    return 'S$' + Math.floor(amount / 100) + 'XX';
  };
  const dateTime = value => value ? new Date(value).toLocaleString('en-SG', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '-';
  const dateSlot = (date, time) => `${date ? new Date(date).toLocaleDateString('en-SG', { day:'numeric', month:'short', year:'numeric' }) : '-'} ${time ? String(time).slice(0,5) : ''}`;
%>

<main class="container py-5">
  <a href="/admin/payouts" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
    <i class="bi bi-arrow-left me-1"></i>Payouts
  </a>

  <% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
  <% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

  <div class="card border-0 mb-4" style="border-radius:var(--r-xl);box-shadow:var(--shadow);">
    <div class="card-body p-4">
      <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
        <div>
          <p class="section-label mb-2">Merchant Settlement</p>
          <h2 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">Payout #<%= payout.payout_id %></h2>
          <p style="color:var(--muted);margin:0;"><%= payout.merchant_name %> · <%= payout.booking_count %> eligible completed paid bookings</p>
        </div>
        <span class="badge" style="background:<%= payout.status === 'paid' ? 'var(--success-bg)' : 'var(--warn-bg)' %>;color:<%= payout.status === 'paid' ? 'var(--success)' : 'var(--warn)' %>;font-weight:800;text-transform:capitalize;"><%= payout.status %></span>
      </div>

      <div class="row g-3 mt-3">
        <div class="col-md-3"><div class="rounded-xl p-3" style="background:var(--canvas);"><span style="color:var(--muted);font-size:.82rem;">Gross</span><strong class="d-block mono"><%= settlementBand(payout.gross_amount) %></strong></div></div>
        <div class="col-md-3"><div class="rounded-xl p-3" style="background:var(--canvas);"><span style="color:var(--muted);font-size:.82rem;">Uniday commission</span><strong class="d-block mono" style="color:var(--accent);"><%= money(payout.platform_commission) %></strong></div></div>
        <div class="col-md-3"><div class="rounded-xl p-3" style="background:var(--canvas);"><span style="color:var(--muted);font-size:.82rem;">Gateway fees</span><strong class="d-block mono"><%= money(Number(payout.processor_fee_amount || 0) + Number(payout.dispute_fee_amount || 0)) %></strong></div></div>
        <div class="col-md-3"><div class="rounded-xl p-3" style="background:var(--canvas);"><span style="color:var(--muted);font-size:.82rem;">Settlement</span><strong class="d-block mono" style="color:var(--success);"><%= money(payout.payout_amount) %></strong></div></div>
      </div>
    </div>
  </div>

  <div class="card border-0 mb-4" style="border-radius:var(--r-xl);box-shadow:var(--shadow-sm);">
    <div class="card-body p-4">
      <h5 style="font-weight:800;color:var(--ink);">Automated settlement</h5>
      <p style="color:var(--muted);font-size:.9rem;margin-bottom:0;">Payout batches are created and credited by the automated weekly payout run. Merchants are notified when the batch is credited.</p>
      <% if (payout.stripe_transfer_id || payout.payout_reference) { %>
      <p class="mono mt-3 mb-0" style="color:var(--muted);font-size:.82rem;">Reference: <%= payout.stripe_transfer_id || payout.payout_reference %></p>
      <% } %>
      <% if (payout.stripe_transfer_error) { %>
      <p class="mt-3 mb-0" style="color:var(--danger);font-size:.85rem;">Stripe transfer error: <%= payout.stripe_transfer_error %></p>
      <% } %>
    </div>
  </div>

  <div class="card border-0" style="border-radius:var(--r-xl);box-shadow:var(--shadow);">
    <div class="card-body p-4">
      <h5 style="font-weight:800;color:var(--ink);margin-bottom:1rem;">Included bookings</h5>
      <div class="table-responsive">
        <table class="table align-middle mb-0">
          <thead style="background:var(--accent-light);">
            <tr>
              <th>Booking</th>
              <th>Customer</th>
              <th>Service</th>
              <th>Slot</th>
              <th>Gross</th>
              <th>Uniday</th>
              <th>Gateway Fees</th>
              <th>Settlement</th>
            </tr>
          </thead>
          <tbody>
            <% items.forEach(item => { %>
            <tr>
              <td class="mono">#<%= item.booking_id %></td>
              <td><%= item.customer_name %></td>
              <td><%= item.service_name %></td>
              <td><%= dateSlot(item.slot_date, item.start_time) %></td>
              <td class="mono"><%= settlementBand(item.gross_amount) %></td>
              <td class="mono"><%= money(item.platform_commission) %></td>
              <td class="mono"><%= money(Number(item.processor_fee_amount || 0) + Number(item.dispute_fee_amount || 0)) %></td>
              <td class="mono" style="font-weight:800;color:var(--success);"><%= money(item.payout_amount) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
