<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const rows = Array.isArray(logs) ? logs : [];
  const pager = pagination || {
    currentPage: 1,
    totalPages: 1,
    totalLogs: 0,
    startItem: 0,
    endItem: 0,
    hasPrevious: false,
    hasNext: false
  };
  const mysqlUtcToDate = value => {
    if (!value) return null;

    if (value instanceof Date) {
      return new Date(Date.UTC(
        value.getFullYear(),
        value.getMonth(),
        value.getDate(),
        value.getHours(),
        value.getMinutes(),
        value.getSeconds(),
        value.getMilliseconds()
      ));
    }

    const raw = String(value).trim();
    const normalized = raw.includes('T') ? raw : raw.replace(' ', 'T');
    return new Date(/[zZ]|[+-]\d{2}:?\d{2}$/.test(normalized) ? normalized : `${normalized}Z`);
  };

  const fmtDateTime = value => {
    const date = mysqlUtcToDate(value);

    return date && !Number.isNaN(date.getTime()) ? date.toLocaleString('en-SG', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Asia/Singapore'
    }) : '-';
  };
  const label = value => String(value || '-').replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  const messageLines = value => String(value || '').split('\n').filter(Boolean);
  const supportTemplates = [
    { key:'acknowledgement', label:'Acknowledgement' },
    { key:'booking_issue', label:'Booking Issue' },
    { key:'payment_issue', label:'Payment Issue' },
    { key:'refund_issue', label:'Refund Issue' },
    { key:'voucher_promotion_issue', label:'Voucher / Promotion Issue' },
    { key:'whatsapp_issue', label:'WhatsApp Issue' },
    { key:'account_issue', label:'Account Issue' },
    { key:'merchant_issue', label:'Merchant Issue' },
    { key:'technical_issue', label:'Technical Issue' },
    { key:'more_information', label:'Request More Information' },
    { key:'issue_resolved', label:'Issue Resolved' },
  ];
  const templateLabels = supportTemplates.reduce((labels, template) => {
    labels[template.key] = template.label;
    return labels;
  }, {});
  const categoryTemplateMap = {
    booking: 'booking_issue',
    payment: 'payment_issue',
    refund: 'refund_issue',
    voucher_promotion: 'voucher_promotion_issue',
    whatsapp: 'whatsapp_issue',
    account: 'account_issue',
    merchant: 'merchant_issue',
    technical: 'technical_issue',
    other: 'acknowledgement',
    waiting_for_agent: 'acknowledgement',
    after_hours: 'acknowledgement'
  };
  const recommendedSupportTemplate = row => {
    const errorType = String(row && row.error_type || '').toLowerCase();
    return categoryTemplateMap[errorType] || 'acknowledgement';
  };
  const getMessageField = (value, fieldName) => {
    const prefix = `${fieldName}:`;
    const line = messageLines(value).find(item => item.toLowerCase().startsWith(prefix.toLowerCase()));
    return line ? line.slice(prefix.length).trim() : '';
  };
  const supportDisplayName = row => {
    if (row.customer_name) return row.customer_name;
    if (row.module === 'web_support') {
      const submittedName = getMessageField(row.error_message, 'Name');
      return submittedName && submittedName !== '-' ? `${submittedName} (Guest Web User)` : 'Guest Web User';
    }
    if (row.module === 'whatsapp_support') return 'Unlinked WhatsApp user';
    return 'Unlinked user';
  };
  const pageHref = page => {
    const params = new URLSearchParams();
    if (String(filters.search || '').trim()) params.set('search', String(filters.search).trim());
    if (filters.module) params.set('module', filters.module);
    if (filters.status) params.set('status', filters.status);
    params.set('page', String(page));
    return `/admin/validation?${params.toString()}`;
  };
  const firstPageNumber = Math.max(1, pager.currentPage - 2);
  const lastPageNumber = Math.min(pager.totalPages, firstPageNumber + 4);
  const pageNumbers = [];
  for (let pageNumber = Math.max(1, lastPageNumber - 4); pageNumber <= lastPageNumber; pageNumber += 1) {
    pageNumbers.push(pageNumber);
  }
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:1180px;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
      <div>
        <p class="section-label">Admin Support</p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Validation & Support Logs</h2>
        <p style="color:var(--muted);margin-bottom:0;">Monitor WhatsApp support handoffs, validation issues, and backend logs.</p>
      </div>
      <a href="/admin/dashboard" class="btn btn-outline-secondary btn-pill btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
      </a>
    </div>

    <% if (query && query.resolved) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-check-circle"></i>
      <span>Log marked as resolved.</span>
    </div>
    <% } %>

    <% if (query && query.replySent) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-whatsapp"></i>
      <span>WhatsApp reply sent and request marked as resolved.</span>
    </div>
    <% } %>

    <% if (query && query.replyKeptOpen) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-whatsapp"></i>
      <span>WhatsApp reply sent and request kept open.</span>
    </div>
    <% } %>

    <% if (query && query.webReplySent) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-envelope-check"></i>
      <span>Email reply sent and web support request marked as resolved.</span>
    </div>
    <% } %>

    <% if (query && query.webReplyKeptOpen) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-envelope-check"></i>
      <span>Email reply sent and web support request kept open.</span>
    </div>
    <% } %>

    <% if (query && query.error) { %>
    <div class="alert alert-warning mb-4">
      <i class="bi bi-exclamation-triangle"></i>
      <span>
        <% if (query.error === 'webReplyValidation') { %>
          Please enter an email reply between 2 and 2,000 characters.
        <% } else if (query.error === 'webReplyEmail') { %>
          No valid customer email could be found for that web support request.
        <% } else if (query.error === 'webReplySend') { %>
          The email reply could not be delivered. The request is still open.
        <% } else if (query.error === 'webReplyResolved') { %>
          That web support request is already resolved.
        <% } else if (query.error === 'webReplyNotFound') { %>
          Web support request not found.
        <% } else if (query.error === 'webReplyAuth') { %>
          Admin access is required.
        <% } else if (query.error === 'webReplyAction') { %>
          Please choose whether to keep the web support request open or resolve it.
        <% } else if (query.error === 'replyAction') { %>
          Please choose whether to keep the WhatsApp support request open or resolve it.
        <% } else if (query.error === 'replyResolved') { %>
          That WhatsApp support request is already resolved.
        <% } else { %>
          Unable to complete that action.
        <% } %>
      </span>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-warning mb-4">
      <i class="bi bi-exclamation-triangle"></i>
      <span><%= error %></span>
    </div>
    <% } %>

    <div class="row g-3 mb-4">
      <% [
        { label:'Total Logs', value:summary.total_logs || 0, icon:'bi-list-check', color:'var(--ink)' },
        { label:'Open Logs', value:summary.open_logs || 0, icon:'bi-exclamation-circle', color:'var(--danger)' },
        { label:'Resolved', value:summary.resolved_logs || 0, icon:'bi-check-circle', color:'var(--success)' },
        { label:'Open WhatsApp Support', value:summary.open_whatsapp_support || 0, icon:'bi-whatsapp', color:'#16a34a' },
      ].forEach(stat => { %>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;"><%= stat.label %></p>
          <div class="d-flex justify-content-between align-items-center gap-3">
            <p class="stat-value" style="color:<%= stat.color %>;"><%= stat.value %></p>
            <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
              <i class="bi <%= stat.icon %>"></i>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <form method="GET" action="/admin/validation" class="card border-0 mb-4" style="box-shadow:var(--shadow-sm);border-radius:var(--r-lg);">
      <div class="card-body p-3">
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label" style="font-size:.8rem;font-weight:700;">Search</label>
            <input type="search" name="search" value="<%= filters.search || '' %>" class="form-control rounded-xl" placeholder="Phone, customer, issue, module">
          </div>
          <div class="col-md-3">
            <label class="form-label" style="font-size:.8rem;font-weight:700;">Module</label>
            <select name="module" class="form-select rounded-xl">
              <% [
                ['all', 'All modules'],
                ['whatsapp_support', 'WhatsApp support'],
                ['web_support', 'Web Support'],
                ['booking', 'Booking Errors'],
                ['payment', 'Payment Errors'],
                ['whatsapp', 'WhatsApp Errors']
              ].forEach(option => { %>
              <option value="<%= option[0] %>" <%= filters.module === option[0] ? 'selected' : '' %>><%= option[1] %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label" style="font-size:.8rem;font-weight:700;">Status</label>
            <select name="status" class="form-select rounded-xl">
              <% [
                ['all', 'All'],
                ['open', 'Open'],
                ['resolved', 'Resolved']
              ].forEach(option => { %>
              <option value="<%= option[0] %>" <%= filters.status === option[0] ? 'selected' : '' %>><%= option[1] %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary btn-pill flex-fill" style="font-weight:800;">
              <i class="bi bi-funnel me-1"></i>Filter
            </button>
            <a href="/admin/validation" class="btn btn-outline-secondary btn-pill">Clear</a>
          </div>
        </div>
      </div>
    </form>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <p style="color:var(--muted);font-size:.875rem;margin:0;">
        Showing <%= pager.startItem %>&ndash;<%= pager.endItem %> of <%= pager.totalLogs %> logs
      </p>
      <p style="color:var(--muted);font-size:.8125rem;margin:0;">
        Page <%= pager.currentPage %> of <%= pager.totalPages %>
      </p>
    </div>

    <% if (!rows.length) { %>
    <div class="card border-0 text-center p-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="icon-circle-lg mx-auto mb-3">
        <i class="bi bi-shield-check" style="font-size:2rem;color:var(--success);"></i>
      </div>
      <h6 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">No logs found</h6>
      <p style="color:var(--muted);margin:0;">WhatsApp support requests and validation logs will appear here.</p>
    </div>
    <% } else { %>
    <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
          <thead style="background:var(--accent-light);">
            <tr>
              <th>Log</th>
              <th>Customer</th>
              <th>Message</th>
              <th>Status</th>
              <th>Created</th>
              <th style="min-width:320px;">Action</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(row => { %>
            <tr>
              <td style="min-width:190px;">
                <p style="font-weight:800;color:var(--ink);margin-bottom:.15rem;">#<%= row.log_id %></p>
                <span class="badge" style="background:<%= row.module === 'whatsapp_support' ? '#dcfce7' : 'var(--accent-light)' %>;color:<%= row.module === 'whatsapp_support' ? '#15803d' : 'var(--accent)' %>;">
                  <%= label(row.module) %>
                </span>
                <p style="color:var(--muted);margin:.35rem 0 0;"><%= label(row.error_type) %></p>
              </td>
              <td style="min-width:190px;">
                <p style="font-weight:800;color:var(--ink);margin-bottom:.15rem;"><%= supportDisplayName(row) %></p>
                <p style="color:var(--muted);margin:0;"><%= row.customer_email || '-' %></p>
                <p style="color:var(--muted);margin:.15rem 0 0;"><%= row.customer_phone || '-' %></p>
              </td>
              <td style="min-width:360px;">
                <% messageLines(row.error_message).forEach(line => { %>
                <p style="color:<%= line.startsWith('Message:') ? 'var(--ink)' : 'var(--muted)' %>;margin:0 0 .2rem;<%= line.startsWith('Message:') ? 'font-weight:800;' : '' %>"><%= line %></p>
                <% }) %>
              </td>
              <td>
                <span class="badge" style="<%= row.is_resolved ? 'background:var(--success-bg);color:var(--success);' : 'background:var(--warn-bg);color:var(--warn);' %>">
                  <%= row.is_resolved ? 'Resolved' : 'Open' %>
                </span>
              </td>
              <td><%= fmtDateTime(row.created_at) %></td>
              <td>
                <% if (!row.is_resolved && row.module === 'whatsapp_support') { %>
                <% const recommendedTemplate = recommendedSupportTemplate(row); %>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/reply" class="d-grid gap-2">
                  <div>
                    <p style="color:var(--muted);font-size:.72rem;font-weight:700;margin:0 0 .45rem;">Choose a template to draft a reply. Review and edit it before sending.</p>
                    <div class="d-grid gap-2">
                      <button type="button" class="btn btn-outline-primary btn-sm btn-pill" data-support-template-key="<%= recommendedTemplate %>" style="font-size:.72rem;font-weight:800;">
                        <i class="bi bi-lightning-charge me-1"></i>Suggested: <%= templateLabels[recommendedTemplate] %>
                      </button>
                      <select class="form-select form-select-sm rounded-xl" data-support-template-select aria-label="Other WhatsApp support reply templates">
                        <option value="">Other templates</option>
                        <% supportTemplates.forEach(template => { %>
                        <option value="<%= template.key %>"><%= template.label %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                  <textarea
                    name="reply"
                    class="form-control rounded-xl"
                    rows="3"
                    maxlength="1000"
                    placeholder="Type Uniday support reply..."
                    required
                  ></textarea>
                  <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <button class="btn btn-outline-primary btn-sm btn-pill" name="action" value="keep_open" style="font-weight:800;">
                      <i class="bi bi-send me-1"></i>Send Reply &amp; Keep Open
                    </button>
                    <button class="btn btn-primary btn-sm btn-pill" name="action" value="resolve" style="font-weight:800;">
                      <i class="bi bi-whatsapp me-1"></i>Send Reply &amp; Resolve
                    </button>
                  </div>
                </form>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/resolve" class="mt-2 text-end">
                  <button class="btn btn-outline-secondary btn-sm btn-pill" style="font-weight:800;">
                    <i class="bi bi-check2 me-1"></i>Resolve Without Reply
                  </button>
                </form>
                <% } else if (!row.is_resolved && row.module === 'web_support') { %>
                <% const recommendedTemplate = recommendedSupportTemplate(row); %>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/web-reply" class="d-grid gap-2">
                  <div>
                    <p style="color:var(--muted);font-size:.72rem;font-weight:700;margin:0 0 .45rem;">Choose a template to draft a reply. Review and edit it before sending.</p>
                    <div class="d-grid gap-2">
                      <button type="button" class="btn btn-outline-primary btn-sm btn-pill" data-support-template-key="<%= recommendedTemplate %>" style="font-size:.72rem;font-weight:800;">
                        <i class="bi bi-lightning-charge me-1"></i>Suggested: <%= templateLabels[recommendedTemplate] %>
                      </button>
                      <select class="form-select form-select-sm rounded-xl" data-support-template-select aria-label="Other web support reply templates">
                        <option value="">Other templates</option>
                        <% supportTemplates.forEach(template => { %>
                        <option value="<%= template.key %>"><%= template.label %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                  <textarea
                    name="reply"
                    class="form-control rounded-xl"
                    rows="3"
                    maxlength="2000"
                    placeholder="Type email reply..."
                    required
                  ></textarea>
                  <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <button class="btn btn-outline-primary btn-sm btn-pill" name="action" value="keep_open" style="font-weight:800;">
                      <i class="bi bi-send me-1"></i>Send Reply &amp; Keep Open
                    </button>
                    <button class="btn btn-primary btn-sm btn-pill" name="action" value="resolve" style="font-weight:800;">
                      <i class="bi bi-envelope me-1"></i>Send Reply &amp; Resolve
                    </button>
                  </div>
                </form>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/resolve" class="mt-2 text-end">
                  <button class="btn btn-outline-secondary btn-sm btn-pill" style="font-weight:800;">
                    <i class="bi bi-check2 me-1"></i>Resolve Without Reply
                  </button>
                </form>
                <% } else if (!row.is_resolved) { %>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/resolve" class="text-end">
                  <button class="btn btn-outline-success btn-sm btn-pill" style="font-weight:800;">
                    <i class="bi bi-check2 me-1"></i>Resolve
                  </button>
                </form>
                <% } else { %>
                <span style="color:var(--muted);">-</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <nav class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3" aria-label="Validation log pages">
      <% if (pager.hasPrevious) { %>
      <a class="btn btn-outline-secondary btn-sm btn-pill" href="<%= pageHref(pager.currentPage - 1) %>">
        <i class="bi bi-chevron-left me-1"></i>Previous
      </a>
      <% } else { %>
      <span class="btn btn-outline-secondary btn-sm btn-pill disabled" aria-disabled="true">
        <i class="bi bi-chevron-left me-1"></i>Previous
      </span>
      <% } %>

      <div class="d-flex flex-wrap gap-1 justify-content-center" aria-label="Page numbers">
        <% pageNumbers.forEach(pageNumber => { %>
        <% if (pageNumber === pager.currentPage) { %>
        <span class="btn btn-primary btn-sm btn-pill" aria-current="page"><%= pageNumber %></span>
        <% } else { %>
        <a class="btn btn-outline-secondary btn-sm btn-pill" href="<%= pageHref(pageNumber) %>"><%= pageNumber %></a>
        <% } %>
        <% }) %>
      </div>

      <% if (pager.hasNext) { %>
      <a class="btn btn-outline-secondary btn-sm btn-pill" href="<%= pageHref(pager.currentPage + 1) %>">
        Next<i class="bi bi-chevron-right ms-1"></i>
      </a>
      <% } else { %>
      <span class="btn btn-outline-secondary btn-sm btn-pill disabled" aria-disabled="true">
        Next<i class="bi bi-chevron-right ms-1"></i>
      </span>
      <% } %>
    </nav>
    <% } %>
  </div>
</main>

<script>
  (() => {
    const templates = Object.freeze({
      acknowledgement: 'Hi, thanks for contacting Uniday Support. We have received your request and are checking it now. We will update you as soon as possible.',
      booking_issue: 'Hi, thanks for letting us know. We are checking your booking details and will help you resolve the issue as soon as possible. Please include your booking ID if you have not shared it yet.',
      payment_issue: 'Hi, thanks for reaching out. We are reviewing your payment issue. Please do not share card details, passwords, or one-time codes. We will update you once we have checked the payment status.',
      refund_issue: 'Hi, thanks for contacting Uniday Support. We are checking the refund details for your request. Please include the booking ID if you have not shared it yet, and we will update you after reviewing the record.',
      voucher_promotion_issue: 'Hi, thanks for letting us know. We are reviewing the voucher or promotion issue and checking the eligibility details. We will update you once we have confirmed what happened.',
      whatsapp_issue: 'Hi, thanks for contacting us. We are checking the WhatsApp notification issue and will follow up once we have reviewed the message status.',
      account_issue: 'Hi, thanks for contacting Uniday Support. We are checking your account issue now. Please do not share passwords, OTPs, or private security details.',
      merchant_issue: 'Hi, thanks for letting us know. We are reviewing the merchant-related issue and will follow up once we have checked the details.',
      technical_issue: 'Hi, thanks for reporting this. We are reviewing the technical issue and checking the affected steps. Please share what you were trying to do if you have not already included it.',
      more_information: 'Hi, thanks for contacting Uniday Support. Could you please share more details about what happened, including the booking ID if available and the step where the issue occurred?',
      issue_resolved: 'Hi, thanks for your patience. This issue has been resolved. Please try again and let us know if you still face any problems.'
    });

    function fillTemplate(control, key) {
      const template = templates[key];
      const form = control.closest('form');
      const textarea = form ? form.querySelector('textarea[name="reply"]') : null;

      if (!template || !textarea) return;

      textarea.value = template;
      textarea.focus();
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }

    document.querySelectorAll('[data-support-template-key]').forEach(button => {
      button.addEventListener('click', () => {
        fillTemplate(button, button.dataset.supportTemplateKey);
      });
    });

    document.querySelectorAll('[data-support-template-select]').forEach(select => {
      select.addEventListener('change', () => {
        fillTemplate(select, select.value);
        select.value = '';
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
