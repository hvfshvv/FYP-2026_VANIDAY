<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const rows = Array.isArray(logs) ? logs : [];
  const pager = pagination || {
    currentPage: 1,
    totalPages: 1,
    totalLogs: 0,
    startItem: 0,
    endItem: 0,
    hasPrevious: false,
    hasNext: false
  };
  const mysqlUtcToDate = value => {
    if (!value) return null;

    if (value instanceof Date) {
      return new Date(Date.UTC(
        value.getFullYear(),
        value.getMonth(),
        value.getDate(),
        value.getHours(),
        value.getMinutes(),
        value.getSeconds(),
        value.getMilliseconds()
      ));
    }

    const raw = String(value).trim();
    const normalized = raw.includes('T') ? raw : raw.replace(' ', 'T');
    return new Date(/[zZ]|[+-]\d{2}:?\d{2}$/.test(normalized) ? normalized : `${normalized}Z`);
  };

  const fmtDateTime = value => {
    const date = mysqlUtcToDate(value);

    return date && !Number.isNaN(date.getTime()) ? date.toLocaleString('en-SG', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      timeZone: 'Asia/Singapore'
    }) : '-';
  };
  const label = value => {
    const key = String(value || '-');
    return t(`admin.logs.label.${key}`, {}, key.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()));
  };
  const messageLines = value => String(value || '').split('\n').filter(Boolean);
  const supportTemplates = [
    'acknowledgement', 'booking_issue', 'payment_issue', 'refund_issue',
    'voucher_promotion_issue', 'whatsapp_issue', 'account_issue',
    'merchant_issue', 'technical_issue', 'more_information', 'issue_resolved',
  ].map(key => ({ key, label: t(`admin.logs.template.${key}`) }));
  const templateLabels = supportTemplates.reduce((labels, template) => {
    labels[template.key] = template.label;
    return labels;
  }, {});
  const categoryTemplateMap = {
    booking: 'booking_issue',
    payment: 'payment_issue',
    refund: 'refund_issue',
    voucher_promotion: 'voucher_promotion_issue',
    whatsapp: 'whatsapp_issue',
    account: 'account_issue',
    merchant: 'merchant_issue',
    technical: 'technical_issue',
    other: 'acknowledgement',
    waiting_for_agent: 'acknowledgement',
    after_hours: 'acknowledgement'
  };
  const recommendedSupportTemplate = row => {
    const errorType = String(row && row.error_type || '').toLowerCase();
    return categoryTemplateMap[errorType] || 'acknowledgement';
  };
  const getMessageField = (value, fieldName) => {
    const prefix = `${fieldName}:`;
    const line = messageLines(value).find(item => item.toLowerCase().startsWith(prefix.toLowerCase()));
    return line ? line.slice(prefix.length).trim() : '';
  };
  const supportDisplayName = row => {
    if (row.customer_name) return row.customer_name;
    if (row.module === 'web_support') {
      const submittedName = getMessageField(row.error_message, 'Name');
      return submittedName && submittedName !== '-'
        ? t('admin.logs.guestWebUserNamed', { name: submittedName })
        : t('admin.logs.guestWebUser');
    }
    if (row.module === 'whatsapp_support') return t('admin.logs.unlinkedWhatsapp');
    return t('admin.logs.unlinkedUser');
  };
  const pageHref = page => {
    const params = new URLSearchParams();
    if (String(filters.search || '').trim()) params.set('search', String(filters.search).trim());
    if (filters.module) params.set('module', filters.module);
    if (filters.status) params.set('status', filters.status);
    params.set('page', String(page));
    return `/admin/validation?${params.toString()}`;
  };
  const firstPageNumber = Math.max(1, pager.currentPage - 2);
  const lastPageNumber = Math.min(pager.totalPages, firstPageNumber + 4);
  const pageNumbers = [];
  for (let pageNumber = Math.max(1, lastPageNumber - 4); pageNumber <= lastPageNumber; pageNumber += 1) {
    pageNumbers.push(pageNumber);
  }
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:1180px;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
      <div>
        <p class="section-label"><%= t('admin.logs.eyebrow') %></p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.logs.pageTitle') %></h2>
        <p style="color:var(--muted);margin-bottom:0;"><%= t('admin.logs.subtitle') %></p>
      </div>
      <a href="/admin/dashboard" class="btn btn-outline-secondary btn-pill btn-sm">
        <i class="bi bi-arrow-left me-1"></i><%= t('nav.dashboard') %>
      </a>
    </div>

    <% if (query && query.resolved) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-check-circle"></i>
      <span><%= t('admin.logs.msg.resolved') %></span>
    </div>
    <% } %>

    <% if (query && query.replySent) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-whatsapp"></i>
      <span><%= t('admin.logs.msg.replySent') %></span>
    </div>
    <% } %>

    <% if (query && query.replyKeptOpen) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-whatsapp"></i>
      <span><%= t('admin.logs.msg.replyKeptOpen') %></span>
    </div>
    <% } %>

    <% if (query && query.webReplySent) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-envelope-check"></i>
      <span><%= t('admin.logs.msg.webReplySent') %></span>
    </div>
    <% } %>

    <% if (query && query.webReplyKeptOpen) { %>
    <div class="alert alert-success mb-4">
      <i class="bi bi-envelope-check"></i>
      <span><%= t('admin.logs.msg.webReplyKeptOpen') %></span>
    </div>
    <% } %>

    <% if (query && query.error) { %>
    <div class="alert alert-warning mb-4">
      <i class="bi bi-exclamation-triangle"></i>
      <span>
        <%= t('admin.logs.err.' + query.error, {}, t('admin.logs.err.generic')) %>
      </span>
    </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-warning mb-4">
      <i class="bi bi-exclamation-triangle"></i>
      <span><%= error %></span>
    </div>
    <% } %>

    <div class="row g-3 mb-4">
      <% [
        { label:t('admin.logs.totalLogs'), value:summary.total_logs || 0, icon:'bi-list-check', color:'var(--ink)' },
        { label:t('admin.logs.openLogs'), value:summary.open_logs || 0, icon:'bi-exclamation-circle', color:'var(--danger)' },
        { label:t('admin.common.resolved'), value:summary.resolved_logs || 0, icon:'bi-check-circle', color:'var(--success)' },
        { label:t('admin.logs.openWhatsapp'), value:summary.open_whatsapp_support || 0, icon:'bi-whatsapp', color:'#16a34a' },
      ].forEach(stat => { %>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;"><%= stat.label %></p>
          <div class="d-flex justify-content-between align-items-center gap-3">
            <p class="stat-value" style="color:<%= stat.color %>;"><%= stat.value %></p>
            <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
              <i class="bi <%= stat.icon %>"></i>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <form method="GET" action="/admin/validation" class="card border-0 mb-4" style="box-shadow:var(--shadow-sm);border-radius:var(--r-lg);">
      <div class="card-body p-3">
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label" style="font-size:.8rem;font-weight:700;"><%= t('admin.common.search') %></label>
            <input type="search" name="search" value="<%= filters.search || '' %>" class="form-control rounded-xl" placeholder="<%= t('admin.logs.searchPlaceholder') %>">
          </div>
          <div class="col-md-3">
            <label class="form-label" style="font-size:.8rem;font-weight:700;"><%= t('admin.dashboard.logs.colModule') %></label>
            <select name="module" class="form-select rounded-xl">
              <% [
                ['all', t('admin.logs.moduleFilter.all')],
                ['whatsapp_support', t('admin.logs.moduleFilter.whatsapp_support')],
                ['web_support', t('admin.logs.moduleFilter.web_support')],
                ['booking', t('admin.logs.moduleFilter.booking')],
                ['payment', t('admin.logs.moduleFilter.payment')],
                ['whatsapp', t('admin.logs.moduleFilter.whatsapp')]
              ].forEach(option => { %>
              <option value="<%= option[0] %>" <%= filters.module === option[0] ? 'selected' : '' %>><%= option[1] %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label" style="font-size:.8rem;font-weight:700;"><%= t('admin.table.status') %></label>
            <select name="status" class="form-select rounded-xl">
              <% [
                ['all', t('admin.feedback.allRatings')],
                ['open', t('admin.common.open')],
                ['resolved', t('admin.common.resolved')]
              ].forEach(option => { %>
              <option value="<%= option[0] %>" <%= filters.status === option[0] ? 'selected' : '' %>><%= option[1] %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary btn-pill flex-fill" style="font-weight:800;">
              <i class="bi bi-funnel me-1"></i><%= t('admin.common.filter') %>
            </button>
            <a href="/admin/validation" class="btn btn-outline-secondary btn-pill"><%= t('admin.common.clear') %></a>
          </div>
        </div>
      </div>
    </form>

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <p style="color:var(--muted);font-size:.875rem;margin:0;">
        <%- t('admin.logs.showingRange', { start: pager.startItem, end: pager.endItem, total: pager.totalLogs }) %>
      </p>
      <p style="color:var(--muted);font-size:.8125rem;margin:0;">
        <%= t('admin.logs.pageOf', { current: pager.currentPage, total: pager.totalPages }) %>
      </p>
    </div>

    <% if (!rows.length) { %>
    <div class="card border-0 text-center p-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="icon-circle-lg mx-auto mb-3">
        <i class="bi bi-shield-check" style="font-size:2rem;color:var(--success);"></i>
      </div>
      <h6 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.logs.noLogsTitle') %></h6>
      <p style="color:var(--muted);margin:0;"><%= t('admin.logs.noLogsBody') %></p>
    </div>
    <% } else { %>
    <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
          <thead style="background:var(--accent-light);">
            <tr>
              <th><%= t('admin.logs.colLog') %></th>
              <th><%= t('admin.table.customer') %></th>
              <th><%= t('admin.logs.colMessage') %></th>
              <th><%= t('admin.table.status') %></th>
              <th><%= t('admin.logs.colCreated') %></th>
              <th style="min-width:320px;"><%= t('admin.logs.colAction') %></th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(row => { %>
            <tr>
              <td style="min-width:190px;">
                <p style="font-weight:800;color:var(--ink);margin-bottom:.15rem;">#<%= row.log_id %></p>
                <span class="badge" style="background:<%= row.module === 'whatsapp_support' ? '#dcfce7' : 'var(--accent-light)' %>;color:<%= row.module === 'whatsapp_support' ? '#15803d' : 'var(--accent)' %>;">
                  <%= label(row.module) %>
                </span>
                <p style="color:var(--muted);margin:.35rem 0 0;"><%= label(row.error_type) %></p>
              </td>
              <td style="min-width:190px;">
                <p style="font-weight:800;color:var(--ink);margin-bottom:.15rem;"><%= supportDisplayName(row) %></p>
                <p style="color:var(--muted);margin:0;"><%= row.customer_email || '-' %></p>
                <p style="color:var(--muted);margin:.15rem 0 0;"><%= row.customer_phone || '-' %></p>
              </td>
              <td style="min-width:360px;">
                <% messageLines(row.error_message).forEach(line => { %>
                <p style="color:<%= line.startsWith('Message:') ? 'var(--ink)' : 'var(--muted)' %>;margin:0 0 .2rem;<%= line.startsWith('Message:') ? 'font-weight:800;' : '' %>"><%= line %></p>
                <% }) %>
              </td>
              <td>
                <span class="badge" style="<%= row.is_resolved ? 'background:var(--success-bg);color:var(--success);' : 'background:var(--warn-bg);color:var(--warn);' %>">
                  <%= row.is_resolved ? t('admin.common.resolved') : t('admin.common.open') %>
                </span>
              </td>
              <td><%= fmtDateTime(row.created_at) %></td>
              <td>
                <% if (!row.is_resolved && row.module === 'whatsapp_support') { %>
                <% const recommendedTemplate = recommendedSupportTemplate(row); %>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/reply" class="d-grid gap-2">
                  <div>
                    <p style="color:var(--muted);font-size:.72rem;font-weight:700;margin:0 0 .45rem;"><%= t('admin.logs.templateHint') %></p>
                    <div class="d-grid gap-2">
                      <button type="button" class="btn btn-outline-primary btn-sm btn-pill" data-support-template-key="<%= recommendedTemplate %>" style="font-size:.72rem;font-weight:800;">
                        <i class="bi bi-lightning-charge me-1"></i><%= t('admin.logs.suggested', { label: templateLabels[recommendedTemplate] }) %>
                      </button>
                      <select class="form-select form-select-sm rounded-xl" data-support-template-select aria-label="<%= t('admin.logs.otherTemplatesAria') %>">
                        <option value=""><%= t('admin.logs.otherTemplates') %></option>
                        <% supportTemplates.forEach(template => { %>
                        <option value="<%= template.key %>"><%= template.label %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                  <textarea
                    name="reply"
                    class="form-control rounded-xl"
                    rows="3"
                    maxlength="1000"
                    placeholder="<%= t('admin.logs.replyPlaceholder') %>"
                    required
                  ></textarea>
                  <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <button class="btn btn-outline-primary btn-sm btn-pill" name="action" value="keep_open" style="font-weight:800;">
                      <i class="bi bi-send me-1"></i><%= t('admin.logs.sendKeepOpen') %>
                    </button>
                    <button class="btn btn-primary btn-sm btn-pill" name="action" value="resolve" style="font-weight:800;">
                      <i class="bi bi-whatsapp me-1"></i><%= t('admin.logs.sendResolve') %>
                    </button>
                  </div>
                </form>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/resolve" class="mt-2 text-end">
                  <button class="btn btn-outline-secondary btn-sm btn-pill" style="font-weight:800;">
                    <i class="bi bi-check2 me-1"></i><%= t('admin.logs.resolveNoReply') %>
                  </button>
                </form>
                <% } else if (!row.is_resolved && row.module === 'web_support') { %>
                <% const recommendedTemplate = recommendedSupportTemplate(row); %>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/web-reply" class="d-grid gap-2">
                  <div>
                    <p style="color:var(--muted);font-size:.72rem;font-weight:700;margin:0 0 .45rem;"><%= t('admin.logs.templateHint') %></p>
                    <div class="d-grid gap-2">
                      <button type="button" class="btn btn-outline-primary btn-sm btn-pill" data-support-template-key="<%= recommendedTemplate %>" style="font-size:.72rem;font-weight:800;">
                        <i class="bi bi-lightning-charge me-1"></i><%= t('admin.logs.suggested', { label: templateLabels[recommendedTemplate] }) %>
                      </button>
                      <select class="form-select form-select-sm rounded-xl" data-support-template-select aria-label="<%= t('admin.logs.otherWebTemplatesAria') %>">
                        <option value=""><%= t('admin.logs.otherTemplates') %></option>
                        <% supportTemplates.forEach(template => { %>
                        <option value="<%= template.key %>"><%= template.label %></option>
                        <% }) %>
                      </select>
                    </div>
                  </div>
                  <textarea
                    name="reply"
                    class="form-control rounded-xl"
                    rows="3"
                    maxlength="2000"
                    placeholder="<%= t('admin.logs.emailReplyPlaceholder') %>"
                    required
                  ></textarea>
                  <div class="d-flex flex-wrap gap-2 justify-content-end">
                    <button class="btn btn-outline-primary btn-sm btn-pill" name="action" value="keep_open" style="font-weight:800;">
                      <i class="bi bi-send me-1"></i><%= t('admin.logs.sendKeepOpen') %>
                    </button>
                    <button class="btn btn-primary btn-sm btn-pill" name="action" value="resolve" style="font-weight:800;">
                      <i class="bi bi-envelope me-1"></i><%= t('admin.logs.sendResolve') %>
                    </button>
                  </div>
                </form>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/resolve" class="mt-2 text-end">
                  <button class="btn btn-outline-secondary btn-sm btn-pill" style="font-weight:800;">
                    <i class="bi bi-check2 me-1"></i><%= t('admin.logs.resolveNoReply') %>
                  </button>
                </form>
                <% } else if (!row.is_resolved) { %>
                <form method="POST" action="/admin/validation/<%= row.log_id %>/resolve" class="text-end">
                  <button class="btn btn-outline-success btn-sm btn-pill" style="font-weight:800;">
                    <i class="bi bi-check2 me-1"></i><%= t('admin.logs.resolveAction') %>
                  </button>
                </form>
                <% } else { %>
                <span style="color:var(--muted);">-</span>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <nav class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3" aria-label="<%= t('admin.logs.pagesAria') %>">
      <% if (pager.hasPrevious) { %>
      <a class="btn btn-outline-secondary btn-sm btn-pill" href="<%= pageHref(pager.currentPage - 1) %>">
        <i class="bi bi-chevron-left me-1"></i><%= t('admin.logs.previous') %>
      </a>
      <% } else { %>
      <span class="btn btn-outline-secondary btn-sm btn-pill disabled" aria-disabled="true">
        <i class="bi bi-chevron-left me-1"></i><%= t('admin.logs.previous') %>
      </span>
      <% } %>

      <div class="d-flex flex-wrap gap-1 justify-content-center" aria-label="<%= t('admin.logs.pageNumbersAria') %>">
        <% pageNumbers.forEach(pageNumber => { %>
        <% if (pageNumber === pager.currentPage) { %>
        <span class="btn btn-primary btn-sm btn-pill" aria-current="page"><%= pageNumber %></span>
        <% } else { %>
        <a class="btn btn-outline-secondary btn-sm btn-pill" href="<%= pageHref(pageNumber) %>"><%= pageNumber %></a>
        <% } %>
        <% }) %>
      </div>

      <% if (pager.hasNext) { %>
      <a class="btn btn-outline-secondary btn-sm btn-pill" href="<%= pageHref(pager.currentPage + 1) %>">
        <%= t('admin.logs.next') %><i class="bi bi-chevron-right ms-1"></i>
      </a>
      <% } else { %>
      <span class="btn btn-outline-secondary btn-sm btn-pill disabled" aria-disabled="true">
        <%= t('admin.logs.next') %><i class="bi bi-chevron-right ms-1"></i>
      </span>
      <% } %>
    </nav>
    <% } %>
  </div>
</main>

<script>
  (() => {
    const templates = Object.freeze(<%- JSON.stringify(
      supportTemplates.reduce((acc, tpl) => {
        acc[tpl.key] = t(`admin.logs.reply.${tpl.key}`);
        return acc;
      }, {})
    ).replace(/</g, '\\u003c') %>);

    function fillTemplate(control, key) {
      const template = templates[key];
      const form = control.closest('form');
      const textarea = form ? form.querySelector('textarea[name="reply"]') : null;

      if (!template || !textarea) return;

      textarea.value = template;
      textarea.focus();
      textarea.dispatchEvent(new Event('input', { bubbles: true }));
    }

    document.querySelectorAll('[data-support-template-key]').forEach(button => {
      button.addEventListener('click', () => {
        fillTemplate(button, button.dataset.supportTemplateKey);
      });
    });

    document.querySelectorAll('[data-support-template-select]').forEach(select => {
      select.addEventListener('change', () => {
        fillTemplate(select, select.value);
        select.value = '';
      });
    });
  })();
</script>

<%- include('../partials/footer') %>
