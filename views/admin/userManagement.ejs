<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<!-- Admin user management home: choose whether to manage customers or merchants. -->
<main class="container py-5">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-5">
    <div>
      <p class="section-label">Control Room</p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">User Management</h2>
      <p style="color:var(--muted);margin:0;">Choose which account type you want to manage.</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-pill">
      <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-warning mb-4"><i class="bi bi-exclamation-triangle"></i><span><%= error %></span></div>
  <% } %>

  <!-- These cards link to the detailed customer and merchant account tables. -->
  <div class="row g-4">
    <div class="col-md-6">
      <a href="/admin/user-management/customers" class="action-card h-100" style="min-height:260px;">
        <div class="action-icon"><i class="bi bi-people"></i></div>
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;">Customer Accounts</h5>
        <p style="color:var(--muted);margin-bottom:1.5rem;">View customers, status, spending, loyalty points, and booking history.</p>
        <div class="d-flex flex-wrap gap-2 mt-auto">
          <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);"><%= summary.customers || 0 %> total</span>
          <span class="badge rounded-pill" style="background:var(--success-bg);color:var(--success);"><%= summary.active_customers || 0 %> active</span>
          <span class="badge rounded-pill" style="background:var(--warn-bg);color:var(--warn);"><%= summary.suspended_customers || 0 %> disabled</span>
        </div>
      </a>
    </div>
    <div class="col-md-6">
      <a href="/admin/user-management/merchants" class="action-card h-100" style="min-height:260px;">
        <div class="action-icon"><i class="bi bi-shop-window"></i></div>
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;">Merchant Accounts</h5>
        <p style="color:var(--muted);margin-bottom:1.5rem;">View merchants, owner accounts, verification, revenue, and marketplace access.</p>
        <div class="d-flex flex-wrap gap-2 mt-auto">
          <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);"><%= summary.merchants || 0 %> total</span>
          <span class="badge rounded-pill" style="background:var(--success-bg);color:var(--success);"><%= summary.active_merchants || 0 %> active</span>
          <span class="badge rounded-pill" style="background:var(--warn-bg);color:var(--warn);"><%= summary.disabled_merchants || 0 %> disabled</span>
        </div>
      </a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
