<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<!-- Admin user management home: choose whether to manage customers or merchants. -->
<main class="container py-5">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-5">
    <div>
      <p class="section-label"><%= t('admin.userManagement.eyebrow') %></p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.userManagement.title') %></h2>
      <p style="color:var(--muted);margin:0;"><%= t('admin.userManagement.subtitle') %></p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-pill">
      <i class="bi bi-arrow-left me-1"></i><%= t('admin.common.backToDashboard') %>
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-warning mb-4"><i class="bi bi-exclamation-triangle"></i><span><%= error %></span></div>
  <% } %>

  <!-- These cards link to the detailed customer and merchant account tables. -->
  <div class="row g-4">
    <div class="col-md-6">
      <a href="/admin/user-management/customers" class="action-card h-100" style="min-height:260px;">
        <div class="action-icon"><i class="bi bi-people"></i></div>
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;"><%= t('admin.userManagement.customerAccounts') %></h5>
        <p style="color:var(--muted);margin-bottom:1.5rem;"><%= t('admin.userManagement.customerAccountsDesc') %></p>
        <div class="d-flex flex-wrap gap-2 mt-auto">
          <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);"><%= t('admin.common.countTotal', { count: summary.customers || 0 }) %></span>
          <span class="badge rounded-pill" style="background:var(--success-bg);color:var(--success);"><%= t('admin.common.countActive', { count: summary.active_customers || 0 }) %></span>
          <span class="badge rounded-pill" style="background:var(--warn-bg);color:var(--warn);"><%= t('admin.common.countDisabled', { count: summary.suspended_customers || 0 }) %></span>
        </div>
      </a>
    </div>
    <div class="col-md-6">
      <a href="/admin/user-management/merchants" class="action-card h-100" style="min-height:260px;">
        <div class="action-icon"><i class="bi bi-shop-window"></i></div>
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;"><%= t('admin.userManagement.merchantAccounts') %></h5>
        <p style="color:var(--muted);margin-bottom:1.5rem;"><%= t('admin.userManagement.merchantAccountsDesc') %></p>
        <div class="d-flex flex-wrap gap-2 mt-auto">
          <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);"><%= t('admin.common.countTotal', { count: summary.merchants || 0 }) %></span>
          <span class="badge rounded-pill" style="background:var(--success-bg);color:var(--success);"><%= t('admin.common.countActive', { count: summary.active_merchants || 0 }) %></span>
          <span class="badge rounded-pill" style="background:var(--warn-bg);color:var(--warn);"><%= t('admin.common.countDisabled', { count: summary.disabled_merchants || 0 }) %></span>
        </div>
      </a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
