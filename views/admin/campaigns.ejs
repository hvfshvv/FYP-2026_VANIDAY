<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const money = value => 'S$' + Number(value || 0).toFixed(2);
  const formatDate = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const discountText = voucher => voucher.discount_type === 'percent'
    ? Number(voucher.discount_value || 0).toFixed(0) + '%'
    : money(voucher.discount_value);
  const campaignStatus = voucher => {
    const today = new Date();
    const start = new Date(voucher.start_date);
    const end = new Date(voucher.end_date);

    today.setHours(0, 0, 0, 0);
    start.setHours(0, 0, 0, 0);
    end.setHours(0, 0, 0, 0);

    if (!voucher.is_active) return { label: 'Paused', className: 'status-paused' };
    if (today < start) return { label: 'Upcoming', className: 'status-upcoming' };
    if (today > end) return { label: 'Expired', className: 'status-expired' };
    return { label: 'Active', className: 'status-active' };
  };
  const summary = { active_count: 0, upcoming_count: 0, paused_count: 0, expired_count: 0 };

  vouchers.forEach(voucher => {
    const status = campaignStatus(voucher).label;

    if (status === 'Active') summary.active_count += 1;
    if (status === 'Upcoming') summary.upcoming_count += 1;
    if (status === 'Paused') summary.paused_count += 1;
    if (status === 'Expired') summary.expired_count += 1;
  });
%>

<style>
  .campaign-status-badge.status-active {
    background: var(--success-bg);
    color: var(--success);
  }

  .campaign-status-badge.status-upcoming {
    background: #EFF6FF;
    color: #1D4ED8;
  }

  .campaign-status-badge.status-paused {
    background: var(--neutral-bg);
    color: var(--muted);
  }

  .campaign-status-badge.status-expired {
    background: var(--danger-bg);
    color: var(--danger);
  }
</style>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
      <p class="section-label">Admin Campaigns</p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Voucher &amp; Campaign Management</h2>
      <p style="color:var(--muted);margin-bottom:0;">Create platform-wide vouchers and monitor voucher usage.</p>
    </div>
    <a href="/admin/campaigns" class="btn btn-outline-secondary btn-pill btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Voucher Home
    </a>
  </div>

  <% if (error) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i><%= error %>
  </div>
  <% } %>

  <% if (query && query.created) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
    <i class="bi bi-check-circle me-2"></i>Voucher campaign created.
  </div>
  <% } %>

  <% if (query && query.updated) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
    <i class="bi bi-check-circle me-2"></i>Voucher status updated.
  </div>
  <% } %>

  <% if (query && query.error) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i>Unable to update voucher campaign.
  </div>
  <% } %>

  <div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.5rem;">Active</p>
            <p class="stat-value" style="color:var(--success);"><%= summary.active_count || 0 %></p>
          </div>
          <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
            <i class="bi bi-play-circle"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.5rem;">Upcoming</p>
            <p class="stat-value" style="color:#1D4ED8;"><%= summary.upcoming_count || 0 %></p>
          </div>
          <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
            <i class="bi bi-calendar-plus"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.5rem;">Paused</p>
            <p class="stat-value" style="color:var(--muted);"><%= summary.paused_count || 0 %></p>
          </div>
          <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
            <i class="bi bi-pause-circle"></i>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-lg-3">
      <div class="stat-card">
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.5rem;">Expired</p>
            <p class="stat-value" style="color:var(--danger);"><%= summary.expired_count || 0 %></p>
          </div>
          <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
            <i class="bi bi-calendar-x"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="row g-4 mb-4">
    <div class="col-12">
      <div class="card border-0 h-100" style="box-shadow:var(--shadow);border-radius:var(--r-xl);padding:1.5rem;">
        <p class="section-label mb-2">Create Voucher</p>
        <form action="/admin/campaigns/vouchers/create" method="POST">
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Campaign Name</label>
              <input type="text" name="campaign_name" class="form-control rounded-xl" value="<%= form.campaign_name || '' %>" placeholder="e.g. May Beauty Deals" required />
            </div>
            <div class="col-md-6">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Voucher Code</label>
              <input type="text" name="voucher_code" class="form-control rounded-xl text-uppercase" value="<%= form.voucher_code || '' %>" placeholder="e.g. BEAUTY20" maxlength="50" required />
            </div>
            <div class="col-md-6">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Discount Type</label>
              <select name="discount_type" class="form-select rounded-xl">
                <% if (form.discount_type === 'fixed_amount') { %>
                <option value="percent">Percent</option>
                <option value="fixed_amount" selected>Fixed amount</option>
                <% } else { %>
                <option value="percent" selected>Percent</option>
                <option value="fixed_amount">Fixed amount</option>
                <% } %>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Discount Value</label>
              <input type="number" name="discount_value" class="form-control rounded-xl" value="<%= form.discount_value || '' %>" min="0.01" step="0.01" placeholder="20" required />
            </div>
            <div class="col-md-4">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Min Spend</label>
              <input type="number" name="min_spend" class="form-control rounded-xl" value="<%= form.min_spend || '' %>" min="0" step="0.01" placeholder="50" />
            </div>
            <div class="col-md-4">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Usage Limit</label>
              <input type="number" name="usage_limit" class="form-control rounded-xl" value="<%= form.usage_limit || '' %>" min="1" step="1" placeholder="100" />
            </div>
            <div class="col-md-4">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Per Customer</label>
              <input type="number" name="usage_per_customer" class="form-control rounded-xl" value="<%= form.usage_per_customer || '1' %>" min="1" step="1" />
            </div>
            <div class="col-md-6">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">Start Date</label>
              <input type="date" name="start_date" class="form-control rounded-xl" value="<%= form.start_date || '' %>" required />
            </div>
            <div class="col-md-6">
              <label class="form-label" style="font-weight:600;font-size:.875rem;">End Date</label>
              <input type="date" name="end_date" class="form-control rounded-xl" value="<%= form.end_date || '' %>" required />
            </div>
          </div>
          <button type="submit" class="btn btn-primary btn-pill mt-3">
            <i class="bi bi-ticket-perforated me-1"></i>Create Campaign
          </button>
        </form>
      </div>
    </div>
  </div>

  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="p-4 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-bottom:1px solid var(--border);">
      <div>
        <p class="section-label mb-1">Voucher Campaigns</p>
        <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;">All Vouchers</h5>
      </div>
      <span class="badge" style="background:var(--accent-light);color:var(--accent);"><%= vouchers.length %> total</span>
    </div>

    <% if (vouchers.length === 0) { %>
    <div class="text-center py-5 px-4">
      <div class="icon-circle-lg mx-auto mb-3" style="width:64px;height:64px;">
        <i class="bi bi-ticket-perforated" style="font-size:2rem;color:var(--accent);"></i>
      </div>
      <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;">No voucher campaigns yet</h6>
      <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;">Created voucher campaigns will appear here.</p>
    </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th>Campaign</th>
            <th>Scope</th>
            <th>Discount</th>
            <th>Dates</th>
            <th>Usage</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% vouchers.forEach(voucher => { const status = campaignStatus(voucher); %>
          <tr>
            <td>
              <p style="font-weight:700;color:var(--ink);margin-bottom:.15rem;"><%= voucher.campaign_name || 'Untitled Campaign' %></p>
              <p style="color:var(--muted);font-family:var(--font-mono);margin-bottom:0;"><%= voucher.voucher_code %></p>
            </td>
            <td>
              <span class="badge" style="background:var(--accent-light);color:var(--accent);"><%= voucher.voucher_type %></span>
              <p style="color:var(--muted);margin:.25rem 0 0;"><%= voucher.merchant_name || 'All merchants' %></p>
            </td>
            <td>
              <p style="font-weight:700;margin-bottom:.15rem;"><%= discountText(voucher) %></p>
              <p style="color:var(--muted);margin-bottom:0;">Min <%= money(voucher.min_spend) %></p>
            </td>
            <td>
              <%= formatDate(voucher.start_date) %>
              <span style="color:var(--muted);">to</span>
              <%= formatDate(voucher.end_date) %>
            </td>
            <td>
              <p style="font-weight:700;margin-bottom:.15rem;"><%= voucher.claim_count || 0 %> claimed</p>
              <p style="color:var(--muted);margin-bottom:.1rem;"><%= voucher.use_count || 0 %> used</p>
              <p style="color:var(--muted);margin-bottom:0;font-size:.75rem;">Limit <%= voucher.usage_limit || 'Unlimited' %></p>
            </td>
            <td><span class="badge campaign-status-badge <%= status.className %>"><%= status.label %></span></td>
            <td>
              <% if (status.label === 'Expired') { %>
              <button type="button" class="btn btn-sm btn-pill btn-outline-secondary" disabled>
                <i class="bi bi-calendar-x me-1"></i>Expired
              </button>
              <% } else { %>
              <form action="/admin/campaigns/vouchers/<%= voucher.voucher_id %>/toggle" method="POST" class="m-0">
                <% if (voucher.is_active) { %>
                <button type="submit" class="btn btn-sm btn-pill btn-outline-secondary">
                  <i class="bi bi-pause-circle me-1"></i>Pause
                </button>
                <% } else { %>
                <button type="submit" class="btn btn-sm btn-pill btn-outline-success">
                  <i class="bi bi-play-circle me-1"></i>Activate
                </button>
                <% } %>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
