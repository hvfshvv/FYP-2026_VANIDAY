  const aiOccasion = document.getElementById('aiOccasion');
  const aiEventDate = document.getElementById('aiEventDate');
  const aiCampaignGoal = document.getElementById('aiCampaignGoal');
  const aiRecommendationEmpty = document.getElementById('aiRecommendationEmpty');
  const aiRecommendationCard = document.getElementById('aiRecommendationCard');
  const generateAiCampaignBtn = document.getElementById('generateAiCampaignBtn');
  const useAiRecommendationBtn = document.getElementById('useAiRecommendationBtn');
  let activeAiRecommendation = null;

  function fillAiEventDateFromOccasion() {
    const mappedDate = aiOccasionDates[aiOccasion.value];
    if (mappedDate) {
      aiEventDate.value = mappedDate;
    }
  }

  function addDaysToInputDate(inputDate, days) {
    const parts = inputDate.split('-').map(Number);
    const date = new Date(parts[0], parts[1] - 1, parts[2]);
    date.setDate(date.getDate() + days);
    const yyyy = date.getFullYear();
    const mm = String(date.getMonth() + 1).padStart(2, '0');
    const dd = String(date.getDate()).padStart(2, '0');
    return `${yyyy}-${mm}-${dd}`;
  }

  function formatCampaignDate(inputDate) {
    return new Date(`${inputDate}T00:00:00`).toLocaleDateString('en-SG', {
      day: 'numeric',
      month: 'short',
      year: 'numeric'
    });
  }

  function buildAiRecommendation(occasion, eventDate, goal) {
    const template = aiCampaignTemplates[occasion];
    const anchorDate = eventDate || aiOccasionDates[occasion] || template.defaultEventDate;
    const isSale = occasion.includes('Sale');
    const startDate = isSale ? anchorDate : addDaysToInputDate(anchorDate, -8);
    const endDate = isSale ? addDaysToInputDate(anchorDate, 2) : addDaysToInputDate(anchorDate, 1);

    return {
      ...template,
      occasion,
      goal,
      startDate,
      endDate
    };
  }

  function setVoucherField(name, value) {
    const field = document.querySelector(`[name="${name}"]`);
    if (!field) return;
    field.value = value;
    field.dispatchEvent(new Event('change', { bubbles: true }));
  }

  if (aiOccasion && aiEventDate) {
    aiOccasion.addEventListener('change', fillAiEventDateFromOccasion);
    fillAiEventDateFromOccasion();
  }

  if (generateAiCampaignBtn) {
    generateAiCampaignBtn.addEventListener('click', () => {
      const occasion = aiOccasion.value;
      if (!occasion) {
        aiOccasion.focus();
        return;
      }

      activeAiRecommendation = buildAiRecommendation(
        occasion,
        aiEventDate.value,
        aiCampaignGoal.value
      );

      document.getElementById('aiRecOccasion').textContent = `Based on: ${activeAiRecommendation.occasion}`;
      document.getElementById('aiRecName').textContent = activeAiRecommendation.campaignName;
      document.getElementById('aiRecSummary').textContent = activeAiRecommendation.summary;
      document.getElementById('aiRecDiscount').textContent = activeAiRecommendation.discountType === 'percent'
        ? `${activeAiRecommendation.discountValue}% OFF`
        : `S$${Number(activeAiRecommendation.discountValue).toFixed(2)} OFF`;
      document.getElementById('aiRecMinSpend').textContent = `S$${Number(activeAiRecommendation.minSpend).toFixed(2)}`;
      document.getElementById('aiRecValidity').textContent = `${formatCampaignDate(activeAiRecommendation.startDate)} - ${formatCampaignDate(activeAiRecommendation.endDate)}`;
      document.getElementById('aiRecReason').textContent = `${activeAiRecommendation.reason} Goal: ${activeAiRecommendation.goal}.`;

      aiRecommendationEmpty.style.display = 'none';
      aiRecommendationCard.classList.add('is-visible');
    });
  }

  if (useAiRecommendationBtn) {
    useAiRecommendationBtn.addEventListener('click', () => {
      if (!activeAiRecommendation) return;

      setVoucherField('campaign_name', activeAiRecommendation.campaignName);
      setVoucherField('voucher_code', activeAiRecommendation.voucherCode);
      setVoucherField('discount_type', activeAiRecommendation.discountType);
      setVoucherField('discount_value', activeAiRecommendation.discountValue);
      setVoucherField('min_spend', activeAiRecommendation.minSpend);
      setVoucherField('usage_limit', activeAiRecommendation.usageLimit);
      setVoucherField('usage_per_customer', activeAiRecommendation.usagePerCustomer);
      setVoucherField('start_date', activeAiRecommendation.startDate);
      setVoucherField('end_date', activeAiRecommendation.endDate);
    });
  }
</script>

