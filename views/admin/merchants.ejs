<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const a = analytics || {};
  const overview = a.overview || {};
  const money = value => 'S$' + Number(value || 0).toFixed(2);
  const number = value => Number(value || 0).toLocaleString('en-SG');
  const percent = value => Number(value || 0).toFixed(1) + '%';
  const rating = value => Number(value || 0).toFixed(1) + '/5';
  const dateLabel = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short' }) : '-';
  const maxOf = (items, key) => Math.max(1, ...items.map(item => Number(item[key] || 0)));
  const barWidth = (value, max) => Math.max(6, Math.round((Number(value || 0) / max) * 100));
  const avgLeadDays = Number(a.leadTime?.avg_lead_hours || 0) / 24;
  const returning = Number(a.customerSegments?.returning_customers || 0);
  const totalCustomers = Number(a.customerSegments?.total_customers || 0);
  const retentionRate = totalCustomers ? (returning / totalCustomers) * 100 : 0;
  const grossRevenue = Number(a.financial?.gross_revenue || 0);
  const refundedAmount = Number(a.financial?.refunded_amount || 0);
  const profitMargin = grossRevenue ? ((grossRevenue - refundedAmount) / grossRevenue) * 100 : 0;
  const chartColors = ['#E11D48', '#FB7185', '#F59E0B', '#10B981', '#0EA5E9', '#8B5CF6', '#EC4899', '#14B8A6', '#F97316', '#64748B'];
  const safeJson = value => JSON.stringify(value || {}).replace(/</g, '\\u003c');
%>

<style>
  .merchant-analytics[data-theme="dark"] {
    --canvas:#111827;
    --surface:#182235;
    --ink:#F8FAFC;
    --muted:#CBD5E1;
    --ghost:#94A3B8;
    --border:rgba(148,163,184,.24);
    --accent-light:rgba(225,29,72,.16);
    --neutral-bg:rgba(148,163,184,.16);
    --success-bg:rgba(16,185,129,.16);
    --danger-bg:rgba(239,68,68,.16);
    --warn-bg:rgba(217,119,6,.16);
    background:var(--canvas);
  }
  .analytics-card {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--r-lg);
    box-shadow:var(--shadow-sm);
    padding:1.25rem;
    height:100%;
  }
  .analytics-title {
    color:var(--ink);
    font-weight:800;
    letter-spacing:-.02em;
    margin:0;
  }
  .mini-bar {
    height:10px;
    background:var(--neutral-bg);
    border-radius:999px;
    overflow:hidden;
  }
  .mini-bar span {
    display:block;
    height:100%;
    background:var(--accent);
    border-radius:999px;
  }
  .metric-list {
    display:flex;
    flex-direction:column;
    gap:.875rem;
  }
  .metric-row {
    display:grid;
    grid-template-columns:minmax(0, 1fr) auto;
    gap:.75rem;
    align-items:center;
  }
  .metric-row p {
    margin:0;
    color:var(--ink);
    font-weight:700;
    font-size:.875rem;
    white-space:nowrap;
    overflow:hidden;
    text-overflow:ellipsis;
  }
  .metric-row small {
    color:var(--muted);
    font-family:var(--font-mono);
  }
  .section-anchor {
    scroll-margin-top:7rem;
  }
  .dashboard-tabs {
    display:flex;
    gap:.5rem;
    overflow-x:auto;
    padding-bottom:.25rem;
  }
  .dashboard-tabs a {
    flex:0 0 auto;
    border:1px solid var(--border);
    background:var(--surface);
    color:var(--muted);
    border-radius:999px;
    padding:.5rem .8rem;
    font-size:.8125rem;
    font-weight:700;
  }
  .dashboard-tabs a:hover {
    color:var(--ink);
    border-color:rgba(225,29,72,.35);
  }
  .round-chart-wrap {
    display:flex;
    flex-direction:column;
    align-items:center;
    gap:1.25rem;
    padding:.75rem 0 .25rem;
  }
  .round-chart {
    width:min(280px, 72vw);
    aspect-ratio:1;
    border-radius:50%;
    display:grid;
    place-items:center;
    box-shadow:inset 0 0 0 1px var(--border);
  }
  .round-chart-center {
    width:48%;
    aspect-ratio:1;
    border-radius:50%;
    display:grid;
    place-items:center;
    text-align:center;
    background:var(--surface);
    border:1px solid var(--border);
    box-shadow:var(--shadow);
    padding:.75rem;
  }
  .round-chart-center strong {
    display:block;
    color:var(--ink);
    font-family:var(--font-mono);
    font-size:1rem;
    line-height:1.15;
  }
  .round-chart-center small {
    display:block;
    margin-top:.25rem;
    color:var(--muted);
    font-size:.72rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.04em;
  }
  .round-chart-legend {
    width:100%;
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(130px, 1fr));
    gap:.55rem .85rem;
  }
  .round-chart-legend span {
    display:inline-flex;
    align-items:center;
    justify-content:space-between;
    gap:.5rem;
    color:var(--muted);
    font-size:.78rem;
    font-weight:700;
  }
  .round-chart-legend i {
    width:.7rem;
    height:.7rem;
    border-radius:50%;
    flex:0 0 auto;
  }
  .round-chart-legend b {
    color:var(--ink);
    font-family:var(--font-mono);
    font-weight:700;
    margin-left:auto;
  }
  .status-pill {
    display:inline-flex;
    align-items:center;
    gap:.35rem;
    border-radius:999px;
    padding:.35rem .6rem;
    background:var(--accent-light);
    color:var(--accent);
    font-size:.75rem;
    font-weight:800;
  }
  .donut-grid {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(120px, 1fr));
    gap:.75rem;
  }
  .donut-stat {
    border:1px solid var(--border);
    border-radius:var(--r);
    padding:1rem;
    background:var(--canvas);
  }
  .donut-ring {
    width:70px;
    height:70px;
    border-radius:50%;
    display:grid;
    place-items:center;
    margin-bottom:.75rem;
    background:conic-gradient(var(--accent) var(--ring), var(--neutral-bg) 0);
  }
  .donut-ring span {
    width:46px;
    height:46px;
    border-radius:50%;
    display:grid;
    place-items:center;
    background:var(--surface);
    color:var(--ink);
    font-family:var(--font-mono);
    font-size:.78rem;
    font-weight:800;
  }
  .mini-kpi-strip {
    display:grid;
    grid-template-columns:repeat(auto-fit, minmax(150px, 1fr));
    gap:.75rem;
  }
  .mini-kpi {
    border:1px solid var(--border);
    border-radius:var(--r);
    padding:.9rem;
    background:var(--canvas);
  }
  .leaderboard-actions {
    display:flex;
    align-items:center;
    gap:.55rem;
    flex-wrap:wrap;
  }
  .leaderboard-action-btn {
    border-radius:999px;
    padding:.5rem 1.05rem;
    font-weight:800;
    font-size:.82rem;
    display:inline-flex;
    align-items:center;
    gap:.45rem;
    border:1px solid var(--border);
    background:var(--surface);
    color:var(--muted);
    white-space:nowrap;
  }
  .leaderboard-action-btn.danger {
    border-color:var(--danger);
    color:var(--danger);
    background:var(--surface);
  }
  .summary-panel {
    display:none;
    border:1px solid rgba(225,29,72,.22);
    border-radius:var(--r-lg);
    background:var(--surface);
    box-shadow:var(--shadow-sm);
    padding:1.25rem;
  }
  .summary-panel.is-visible {
    display:block;
  }
  .summary-panel__copy {
    color:var(--ink);
    line-height:1.7;
    margin:0;
    white-space:pre-line;
  }
  .summary-panel__meta {
    color:var(--muted);
    font-size:.8125rem;
    font-weight:700;
    margin-bottom:.75rem;
  }
</style>

<main class="merchant-analytics" id="merchantAnalytics" style="background:var(--canvas);min-height:80vh;padding:2.5rem 1rem;">
  <div class="container" style="max-width:1400px;">
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
      <div>
        <p class="section-label mb-2">Admin View</p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Merchant Dashboard</h2>
        <p style="color:var(--muted);margin-bottom:0;">Performance, booking, customer, marketing, operational, and financial analytics.</p>
      </div>
      <div class="d-flex flex-wrap gap-2 align-items-center">
        <form method="GET" action="/admin/merchants" class="d-flex flex-wrap gap-2 align-items-center">
          <input type="date" name="startDate" class="form-control rounded-xl" style="width:150px;" value="<%= range.startDate %>" />
          <input type="date" name="endDate" class="form-control rounded-xl" style="width:150px;" value="<%= range.endDate %>" />
          <button type="submit" class="btn btn-primary btn-pill">
            <i class="bi bi-funnel me-1"></i>Filter
          </button>
        </form>
        <button type="button" class="btn btn-outline-secondary btn-pill" id="themeToggle">
          <i class="bi bi-moon-stars me-1"></i>Theme
        </button>
        <button type="button" class="btn btn-outline-secondary btn-pill" id="summaryButton">
          <i class="bi bi-file-earmark-text me-1"></i>Summarize Data
        </button>
      </div>
    </div>

    <% if (error) { %>
      <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle"></i>
        <span><%= error %></span>
      </div>
    <% } %>
    <% if (query && query.featured) { %>
      <div class="alert alert-success mb-4">
        <i class="bi bi-check-circle"></i>
        <span>Merchant added to featured merchants.</span>
      </div>
    <% } %>
    <% if (query && query.error === 'feature') { %>
      <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle"></i>
        <span>Could not add merchant to featured merchants.</span>
      </div>
    <% } %>

    <div class="dashboard-tabs mb-4">
      <a href="#overview">Overview</a>
      <a href="#sales">Sales</a>
      <a href="#bookings">Bookings</a>
      <a href="#customers">Customers</a>
      <a href="#marketing">Marketing</a>
      <a href="#finance">Finance</a>
      <a href="#insights">AI Insights</a>
    </div>

    <section class="summary-panel mb-4" id="summaryPanel" aria-live="polite">
      <div class="d-flex justify-content-between align-items-start gap-3 flex-wrap mb-2">
        <div>
          <p class="section-label mb-1">Merchant Data Summary</p>
          <h4 class="analytics-title">Data Analysis</h4>
        </div>
        <button type="button" class="btn btn-outline-secondary btn-sm btn-pill" id="copySummaryButton">
          <i class="bi bi-clipboard me-1"></i>Copy
        </button>
      </div>
      <p class="summary-panel__meta" id="summaryMeta"></p>
      <p class="summary-panel__copy" id="summaryOutput"></p>
    </section>

    <section id="overview" class="section-anchor mb-5">
      <div class="row g-3">
        <% [
          { label:'Total bookings', value:number(overview.total_bookings), icon:'bi-calendar-check', color:'#1D4ED8' },
          { label:'Revenue generated', value:money(overview.revenue_generated), icon:'bi-cash-stack', color:'var(--success)' },
          { label:'Customers', value:number(overview.number_of_customers), icon:'bi-people', color:'var(--accent)' },
          { label:'Average order value', value:money(overview.average_order_value), icon:'bi-bag-check', color:'var(--ink)' },
          { label:'Booking conversion', value:percent(overview.booking_conversion_rate), icon:'bi-graph-up-arrow', color:'var(--success)' },
          { label:'Cancel/no-show rate', value:percent(overview.cancellation_no_show_rate), icon:'bi-calendar-x', color:'var(--danger)' },
          { label:'Satisfaction rating', value:rating(overview.customer_satisfaction_rating), icon:'bi-star', color:'var(--warn)' },
          { label:'Retention rate', value:percent(retentionRate), icon:'bi-arrow-repeat', color:'var(--accent)' },
        ].forEach(stat => { %>
          <div class="col-6 col-lg-3">
            <div class="stat-card h-100">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.45rem;"><%= stat.label %></p>
                  <p class="stat-value" style="color:<%= stat.color %>;font-size:1.55rem;"><%= stat.value %></p>
                </div>
                <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
                  <i class="bi <%= stat.icon %>"></i>
                </div>
              </div>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <section id="sales" class="section-anchor mb-5">
      <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
        <div>
          <p class="section-label mb-1">Sales &amp; Revenue</p>
          <h4 class="analytics-title">Revenue Analytics</h4>
        </div>
      </div>
      <div class="row g-3">
        <div class="col-lg-7">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Daily Revenue Trend</h6>
            <%
              const revenueRows = (a.revenueTrend || []).filter(row => Number(row.total || 0) > 0);
              const revenueTotal = revenueRows.reduce((sum, row) => sum + Number(row.total || 0), 0);
              let revenueCursor = 0;
              const revenueGradient = revenueRows.map((row, index) => {
                const start = revenueCursor;
                revenueCursor += (Number(row.total || 0) / revenueTotal) * 100;
                const color = chartColors[index % chartColors.length];
                return `${color} ${start.toFixed(2)}% ${revenueCursor.toFixed(2)}%`;
              }).join(', ');
            %>
            <% if (revenueRows.length) { %>
              <div class="round-chart-wrap">
                <div class="round-chart" style="background:conic-gradient(<%- revenueGradient %>);">
                  <div class="round-chart-center">
                    <div>
                      <strong><%= money(revenueTotal) %></strong>
                      <small>Total</small>
                    </div>
                  </div>
                </div>
                <div class="round-chart-legend">
                  <% revenueRows.forEach((row, index) => { %>
                    <span>
                      <i style="background:<%= chartColors[index % chartColors.length] %>;"></i>
                      <%= dateLabel(row.period_label) %>
                      <b><%= money(row.total) %></b>
                    </span>
                  <% }) %>
                </div>
              </div>
            <% } else { %>
              <p style="color:var(--muted);margin:0;">No paid revenue in this range.</p>
            <% } %>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Revenue by Category</h6>
            <% const categoryMax = maxOf(a.revenueByCategory || [], 'revenue'); %>
            <div class="d-flex flex-wrap gap-2 mb-3">
              <% (a.revenueByCategory || []).slice(0, 4).forEach(row => { %>
                <span class="status-pill"><%= row.category %> · <%= money(row.revenue) %></span>
              <% }) %>
            </div>
            <div class="metric-list">
              <% (a.revenueByCategory || []).forEach(row => { %>
                <div>
                  <div class="metric-row mb-1"><p><%= row.category %></p><small><%= money(row.revenue) %></small></div>
                  <div class="mini-bar"><span style="width:<%= barWidth(row.revenue, categoryMax) %>%;"></span></div>
                </div>
              <% }) %>
              <% if (!(a.revenueByCategory || []).length) { %><p style="color:var(--muted);margin:0;">No category revenue yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Top-Selling Services</h6>
            <% const serviceMax = maxOf(a.topServices || [], 'bookings'); %>
            <div class="metric-list">
              <% (a.topServices || []).forEach(row => { %>
                <div>
                  <div class="metric-row mb-1"><p><%= row.service_name %></p><small><%= row.bookings %></small></div>
                  <div class="mini-bar"><span style="width:<%= barWidth(row.bookings, serviceMax) %>%;"></span></div>
                </div>
              <% }) %>
              <% if (!(a.topServices || []).length) { %><p style="color:var(--muted);margin:0;">No service sales yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Payment Methods</h6>
            <% const paymentMax = maxOf(a.paymentBreakdown || [], 'revenue'); %>
            <div class="metric-list">
              <% (a.paymentBreakdown || []).forEach(row => { %>
                <div>
                  <div class="metric-row mb-1"><p><%= row.payment_method || 'Unknown' %></p><small><%= money(row.revenue) %></small></div>
                  <div class="mini-bar"><span style="width:<%= barWidth(row.revenue, paymentMax) %>%;"></span></div>
                </div>
              <% }) %>
              <% if (!(a.paymentBreakdown || []).length) { %><p style="color:var(--muted);margin:0;">No payment method data yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Promotion Performance</h6>
            <div class="metric-list">
              <% (a.promotionPerformance || []).forEach(row => { %>
                <div class="metric-row">
                  <p><%= row.campaign_name || row.voucher_code || 'Voucher' %></p>
                  <small><%= number(row.redemptions) %> redemptions</small>
                </div>
              <% }) %>
              <% if (!(a.promotionPerformance || []).length) { %><p style="color:var(--muted);margin:0;">No promo redemptions yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Peak Sales Periods</h6>
            <div class="metric-list">
              <% (a.peakSalesPeriods || []).forEach(row => { %>
                <div class="metric-row">
                  <p><%= String(row.hour_label).padStart(2, '0') %>:00</p>
                  <small><%= money(row.revenue) %></small>
                </div>
              <% }) %>
              <% if (!(a.peakSalesPeriods || []).length) { %><p style="color:var(--muted);margin:0;">No peak sales data yet.</p><% } %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="bookings" class="section-anchor mb-5">
      <p class="section-label mb-1">Booking Analytics</p>
      <h4 class="analytics-title mb-3">Demand &amp; Utilization</h4>
      <div class="row g-3">
        <div class="col-12">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Booking Status Mix</h6>
            <% const statusTotal = (a.bookingStatus || []).reduce((sum, row) => sum + Number(row.total || 0), 0) || 1; %>
            <div class="donut-grid">
              <% (a.bookingStatus || []).forEach(row => {
                const share = (Number(row.total || 0) / statusTotal) * 100;
              %>
                <div class="donut-stat">
                  <div class="donut-ring" style="--ring:<%= share.toFixed(1) %>%;">
                    <span><%= share.toFixed(0) %>%</span>
                  </div>
                  <p style="color:var(--ink);font-weight:800;margin:0;"><%= String(row.status || 'unknown').replace('_', ' ') %></p>
                  <small style="color:var(--muted);font-family:var(--font-mono);"><%= number(row.total) %> bookings</small>
                </div>
              <% }) %>
              <% if (!(a.bookingStatus || []).length) { %><p style="color:var(--muted);margin:0;">No booking status data yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Confirmed vs Cancelled</h6>
            <% const statusMax = maxOf(a.bookingStatus || [], 'total'); %>
            <div class="metric-list">
              <% (a.bookingStatus || []).forEach(row => { %>
                <div>
                  <div class="metric-row mb-1"><p><%= String(row.status || 'unknown').replace('_', ' ') %></p><small><%= number(row.total) %></small></div>
                  <div class="mini-bar"><span style="width:<%= barWidth(row.total, statusMax) %>%;"></span></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Peak Booking Hours &amp; Days</h6>
            <% const peakBookingMax = maxOf(a.peakBookingTimes || [], 'bookings'); %>
            <div class="metric-list">
              <% (a.peakBookingTimes || []).forEach(row => { %>
                <div>
                  <div class="metric-row mb-1"><p><%= row.day_label %>, <%= String(row.hour_label).padStart(2, '0') %>:00</p><small><%= number(row.bookings) %></small></div>
                  <div class="mini-bar"><span style="width:<%= barWidth(row.bookings, peakBookingMax) %>%;"></span></div>
                </div>
              <% }) %>
              <% if (!(a.peakBookingTimes || []).length) { %><p style="color:var(--muted);margin:0;">No booking heatmap data yet.</p><% } %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Booking Lead Time</h6>
            <p class="stat-value" style="font-size:2rem;color:var(--accent);"><%= avgLeadDays.toFixed(1) %> days</p>
            <p style="color:var(--muted);margin:0;">Average time between booking creation and appointment slot.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="customers" class="section-anchor mb-5">
      <p class="section-label mb-1">Customer Insights</p>
      <h4 class="analytics-title mb-3">Retention &amp; Loyalty</h4>
      <div class="row g-3">
        <div class="col-lg-3">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">New vs Returning</h6>
            <p style="color:var(--muted);margin-bottom:.35rem;">New customers</p>
            <p class="stat-value mb-3"><%= number(a.customerSegments?.new_customers) %></p>
            <p style="color:var(--muted);margin-bottom:.35rem;">Returning customers</p>
            <p class="stat-value" style="color:var(--accent);"><%= number(a.customerSegments?.returning_customers) %></p>
          </div>
        </div>
        <div class="col-lg-9">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Most Loyal Customers</h6>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
                <thead style="background:var(--accent-light);"><tr><th>Customer</th><th>Bookings</th><th>Reviews</th><th>CLV</th></tr></thead>
                <tbody>
                  <% (a.topCustomers || []).forEach(customer => { %>
                    <tr><td><%= customer.full_name %></td><td><%= number(customer.bookings) %></td><td><%= number(customer.reviews) %></td><td><%= money(customer.lifetime_value) %></td></tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <% if (!(a.topCustomers || []).length) { %><p style="color:var(--muted);margin:0;">No repeat customer data yet.</p><% } %>
          </div>
        </div>
      </div>
    </section>

    <section id="marketing" class="section-anchor mb-5">
      <p class="section-label mb-1">Marketing Performance</p>
      <h4 class="analytics-title mb-3">Campaigns, WhatsApp Booking, Walk-in QR &amp; Marketplace</h4>
      <div class="row g-3">
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Campaign Performance</h6>
            <div class="metric-list">
              <% (a.campaignPerformance || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.campaign_name || row.voucher_code %></p><small><%= row.is_active ? 'Active' : 'Inactive' %></small></div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Booking Source</h6>
            <% const channelMax = maxOf(a.bookingChannelAnalytics || [], 'total'); %>
            <div class="metric-list">
              <%
                const bookingSources = [...(a.bookingChannelAnalytics || [])];
                if (!bookingSources.some(row => row.channel_label === 'WhatsApp booking')) {
                  bookingSources.push({ channel_label: 'WhatsApp booking', total: 0, revenue: 0 });
                }
              %>
              <% bookingSources.forEach(row => { %>
                <div>
                  <div class="metric-row mb-1"><p><%= row.channel_label || 'Booking channel' %></p><small><%= number(row.total) %> bookings</small></div>
                  <div class="mini-bar"><span style="width:<%= barWidth(row.total, channelMax) %>%;"></span></div>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="analytics-card">
            <h6 class="analytics-title mb-3">Marketplace Listing Performance</h6>
            <div class="metric-list">
              <% (a.listingPerformance || []).forEach(row => { %>
                <div class="metric-row"><p><%= row.merchant_name %></p><small><%= number(row.visible_listings) %> visible</small></div>
              <% }) %>
              <% if (!(a.listingPerformance || []).length) { %><p style="color:var(--muted);margin:0;">No featured listings yet.</p><% } %>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section-anchor mb-5">
      <p class="section-label mb-1">Visual Summary</p>
      <h4 class="analytics-title mb-3">At-a-Glance Performance</h4>
      <div class="mini-kpi-strip">
        <div class="mini-kpi">
          <p style="color:var(--muted);margin:0 0 .35rem;">Paid revenue</p>
          <p class="stat-value" style="font-size:1.45rem;color:var(--success);"><%= money(overview.revenue_generated) %></p>
        </div>
        <div class="mini-kpi">
          <p style="color:var(--muted);margin:0 0 .35rem;">Conversion health</p>
          <div class="mini-bar mb-2"><span style="width:<%= barWidth(overview.booking_conversion_rate, 100) %>%;"></span></div>
          <p style="color:var(--ink);font-weight:800;margin:0;"><%= percent(overview.booking_conversion_rate) %></p>
        </div>
        <div class="mini-kpi">
          <p style="color:var(--muted);margin:0 0 .35rem;">Risk rate</p>
          <div class="mini-bar mb-2"><span style="width:<%= barWidth(overview.cancellation_no_show_rate, 100) %>%;background:var(--danger);"></span></div>
          <p style="color:var(--ink);font-weight:800;margin:0;"><%= percent(overview.cancellation_no_show_rate) %></p>
        </div>
        <div class="mini-kpi">
          <p style="color:var(--muted);margin:0 0 .35rem;">Customer retention</p>
          <div class="mini-bar mb-2"><span style="width:<%= barWidth(retentionRate, 100) %>%;background:var(--success);"></span></div>
          <p style="color:var(--ink);font-weight:800;margin:0;"><%= percent(retentionRate) %></p>
        </div>
      </div>
    </section>

    <section id="finance" class="section-anchor mb-5">
      <p class="section-label mb-1">Financial Reports</p>
      <h4 class="analytics-title mb-3">Margins, Refunds &amp; Reports</h4>
      <div class="row g-3">
        <% [
          { label:'Profit margin', value:percent(profitMargin), icon:'bi-percent' },
          { label:'Refund amount', value:money(a.financial?.refunded_amount), icon:'bi-arrow-counterclockwise' },
          { label:'Refund count', value:number(a.financial?.refund_count), icon:'bi-receipt-cutoff' },
          { label:'Estimated tax', value:money(a.financial?.estimated_tax), icon:'bi-file-earmark-text' },
        ].forEach(item => { %>
          <div class="col-6 col-lg-3">
            <div class="analytics-card">
              <div class="icon-circle mb-3" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
                <i class="bi <%= item.icon %>"></i>
              </div>
              <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;"><%= item.label %></p>
              <p class="stat-value" style="font-size:1.45rem;"><%= item.value %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <section id="insights" class="section-anchor mb-5">
      <p class="section-label mb-1">Predictive / AI Insights</p>
      <h4 class="analytics-title mb-3">Planning Signals</h4>
      <div class="row g-3">
        <% const bestHour = (a.peakBookingTimes || [])[0]; const bestCategory = (a.revenueByCategory || [])[0]; const topService = (a.topServices || [])[0]; %>
        <% [
          { title:'Sales forecasting', body: grossRevenue > 0 ? `Current filtered gross revenue is ${money(grossRevenue)}.` : 'More paid payment history is needed for forecasting.' },
          { title:'Demand prediction', body: bestHour ? `Demand is strongest on ${bestHour.day_label} around ${String(bestHour.hour_label).padStart(2, '0')}:00.` : 'More bookings are needed to detect demand patterns.' },
          { title:'Recommended promotions', body: bestCategory ? `Prioritise ${bestCategory.category} campaigns; it leads category revenue.` : 'Category revenue is not available yet.' },
          { title:'Customer churn prediction', body: retentionRate ? `Retention is ${percent(retentionRate)}; low-repeat segments should receive win-back offers.` : 'Repeat booking data is not available yet.' },
          { title:'Suggested peak coverage hours', body: bestHour ? `Prepare extra capacity for ${bestHour.day_label} ${String(bestHour.hour_label).padStart(2, '0')}:00.` : 'Coverage recommendation needs booking heatmap data.' },
          { title:'Trend anomaly detection', body: topService ? `${topService.service_name} is the current service benchmark.` : 'No abnormal trend detected from available data.' },
        ].forEach(card => { %>
          <div class="col-md-6 col-xl-4">
            <div class="analytics-card">
              <h6 class="analytics-title mb-2"><%= card.title %></h6>
              <p style="color:var(--muted);margin:0;"><%= card.body %></p>
            </div>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="mb-3 section-anchor" id="leaderboard">
      <p class="section-label mb-1">Merchant Leaderboard</p>
      <h4 class="analytics-title mb-3">Top Merchants</h4>
      <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
            <thead style="background:var(--accent-light);">
              <tr>
                <th>Merchant</th>
                <th>Category</th>
                <th>Bookings</th>
                <th>Customers</th>
                <th>Revenue</th>
                <th>Rating</th>
                <th>Featured</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              <% (a.topMerchants || []).forEach(merchant => { %>
                <tr>
                  <td style="font-weight:700;"><%= merchant.merchant_name %></td>
                  <td><%= merchant.category %></td>
                  <td><%= number(merchant.bookings) %></td>
                  <td><%= number(merchant.customers) %></td>
                  <td style="font-family:var(--font-mono);font-weight:700;"><%= money(merchant.revenue) %></td>
                  <td><%= rating(merchant.rating) %></td>
                  <td>
                    <% if (Number(merchant.is_featured || 0)) { %>
                      <a href="/admin/featured" class="badge text-decoration-none" style="background:var(--success-bg);color:var(--success);">Featured</a>
                    <% } else if (Number(merchant.has_featured_listing || 0)) { %>
                      <span class="badge" style="background:var(--neutral-bg);color:var(--muted);">Hidden</span>
                    <% } else { %>
                      <form action="/admin/merchants/<%= merchant.merchant_id %>/feature" method="POST" class="m-0">
                        <button type="submit" class="btn btn-primary btn-sm btn-pill">
                          <i class="bi bi-star me-1"></i>Add Featured
                        </button>
                      </form>
                    <% } %>
                  </td>
                  <td>
                    <% if (merchant.featured_listing_id) { %>
                      <div class="leaderboard-actions">
                        <form action="/admin/merchants/featured/<%= merchant.featured_listing_id %>/toggle" method="POST" class="m-0">
                          <button type="submit" class="leaderboard-action-btn">
                            <i class="bi bi-<%= Number(merchant.is_featured || 0) ? 'eye-slash' : 'eye' %>"></i>
                            <%= Number(merchant.is_featured || 0) ? 'Hide' : 'Show' %>
                          </button>
                        </form>
                        <form action="/admin/merchants/featured/<%= merchant.featured_listing_id %>/remove" method="POST" class="m-0" onsubmit="return confirm('Remove this merchant from featured listings?');">
                          <button type="submit" class="leaderboard-action-btn danger">
                            <i class="bi bi-trash"></i>Remove
                          </button>
                        </form>
                      </div>
                    <% } else { %>
                      <span style="color:var(--muted);">-</span>
                    <% } %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</main>

<script>
  (function () {
    const dashboard = document.getElementById('merchantAnalytics');
    const toggle = document.getElementById('themeToggle');
    const summaryButton = document.getElementById('summaryButton');
    const summaryPanel = document.getElementById('summaryPanel');
    const summaryMeta = document.getElementById('summaryMeta');
    const summaryOutput = document.getElementById('summaryOutput');
    const copySummaryButton = document.getElementById('copySummaryButton');
    const analytics = <%- safeJson(a) %>;
    const range = <%- safeJson(range) %>;
    const storedTheme = localStorage.getItem('adminMerchantTheme') || 'light';
    dashboard.dataset.theme = storedTheme;

    toggle.addEventListener('click', function () {
      const nextTheme = dashboard.dataset.theme === 'dark' ? 'light' : 'dark';
      dashboard.dataset.theme = nextTheme;
      localStorage.setItem('adminMerchantTheme', nextTheme);
    });

    const number = value => Number(value || 0).toLocaleString('en-SG');
    const money = value => 'S$' + Number(value || 0).toFixed(2);
    const percent = value => Number(value || 0).toFixed(1) + '%';
    const dateLabel = value => value
      ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' })
      : '-';
    const text = value => String(value || '').replace(/_/g, ' ');
    const listTop = (items, mapper, fallback) => {
      const values = (items || []).slice(0, 3).map(mapper).filter(Boolean);
      return values.length ? values.join(', ') : fallback;
    };
    const valuesFor = (items, key) => (items || [])
      .map(item => Number(item[key] || 0))
      .filter(value => Number.isFinite(value));
    const statsFor = values => {
      const nums = values.filter(value => Number.isFinite(value)).sort((a, b) => a - b);
      if (!nums.length) return null;
      const sum = nums.reduce((total, value) => total + value, 0);
      const mean = sum / nums.length;
      const median = nums.length % 2
        ? nums[(nums.length - 1) / 2]
        : (nums[(nums.length / 2) - 1] + nums[nums.length / 2]) / 2;
      const counts = nums.reduce((acc, value) => {
        const key = value.toFixed(2);
        acc[key] = (acc[key] || 0) + 1;
        return acc;
      }, {});
      const maxCount = Math.max(...Object.values(counts));
      const mode = Object.entries(counts)
        .filter(([, count]) => count === maxCount)
        .map(([value]) => Number(value));
      const variance = nums.reduce((total, value) => total + Math.pow(value - mean, 2), 0) / nums.length;
      return {
        count: nums.length,
        mean,
        median,
        mode,
        min: nums[0],
        max: nums[nums.length - 1],
        stdDev: Math.sqrt(variance),
      };
    };
    const formatStat = (stats, formatter) => {
      if (!stats) return 'not available from the current dashboard data';
      const modeText = stats.mode.length > 3 ? 'multiple values' : stats.mode.map(formatter).join(', ');
      return `mean ${formatter(stats.mean)}, median ${formatter(stats.median)}, mode ${modeText}, minimum ${formatter(stats.min)}, maximum ${formatter(stats.max)}, and standard deviation ${formatter(stats.stdDev)} across ${number(stats.count)} displayed aggregate value${stats.count === 1 ? '' : 's'}`;
    };
    const frequencyText = (items, labelKey, valueKey, fallback) => {
      const total = (items || []).reduce((sum, row) => sum + Number(row[valueKey] || 0), 0);
      if (!total) return fallback;
      return (items || []).slice(0, 4).map(row => {
        const value = Number(row[valueKey] || 0);
        const share = (value / total) * 100;
        return `${text(row[labelKey] || 'Unknown')} ${number(value)} (${percent(share)})`;
      }).join(', ');
    };

    function buildMerchantSummary() {
      const overview = analytics.overview || {};
      const financial = analytics.financial || {};
      const segments = analytics.customerSegments || {};
      const grossRevenue = Number(financial.gross_revenue || 0);
      const refundedAmount = Number(financial.refunded_amount || 0);
      const profitMargin = grossRevenue ? ((grossRevenue - refundedAmount) / grossRevenue) * 100 : 0;
      const totalCustomers = Number(segments.total_customers || 0);
      const returningCustomers = Number(segments.returning_customers || 0);
      const retentionRate = totalCustomers ? (returningCustomers / totalCustomers) * 100 : 0;
      const revenueStats = statsFor(valuesFor(analytics.revenueTrend, 'total'));
      const categoryStats = statsFor(valuesFor(analytics.revenueByCategory, 'revenue'));
      const serviceBookingStats = statsFor(valuesFor(analytics.topServices, 'bookings'));
      const merchantRevenueStats = statsFor(valuesFor(analytics.topMerchants, 'revenue'));
      const statusFrequency = frequencyText(analytics.bookingStatus, 'status', 'total', 'no booking status frequency counts are available');
      const categoryFrequency = frequencyText(analytics.revenueByCategory, 'category', 'revenue', 'no category revenue percentages are available');
      const paymentFrequency = frequencyText(analytics.paymentBreakdown, 'payment_method', 'total', 'no payment method percentages are available');
      const channelFrequency = frequencyText(analytics.bookingChannelAnalytics, 'channel_label', 'total', 'no booking channel percentages are available');
      const topServices = listTop(
        analytics.topServices,
        row => `${row.service_name || 'Service'} with ${number(row.bookings)} booking${Number(row.bookings || 0) === 1 ? '' : 's'} and ${money(row.revenue)} revenue`,
        'no top-selling service rows'
      );
      const topMerchants = listTop(
        analytics.topMerchants,
        row => `${row.merchant_name || 'Merchant'} (${number(row.bookings)} booking${Number(row.bookings || 0) === 1 ? '' : 's'}, ${money(row.revenue)})`,
        'no merchant leaderboard rows'
      );
      const peakSales = listTop(
        analytics.peakSalesPeriods,
        row => `${String(row.hour_label).padStart(2, '0')}:00 with ${money(row.revenue)}`,
        'no peak sales period data'
      );
      const peakBookings = listTop(
        analytics.peakBookingTimes,
        row => `${row.day_label} ${String(row.hour_label).padStart(2, '0')}:00 with ${number(row.bookings)} booking${Number(row.bookings || 0) === 1 ? '' : 's'}`,
        'no booking heatmap data'
      );
      const campaigns = listTop(
        analytics.promotionPerformance,
        row => `${row.campaign_name || row.voucher_code || 'Voucher'} with ${number(row.redemptions)} redemption${Number(row.redemptions || 0) === 1 ? '' : 's'}`,
        'no promotion redemptions'
      );
      const loyalCustomers = listTop(
        analytics.topCustomers,
        row => `${row.full_name || 'Customer'} with ${number(row.bookings)} booking${Number(row.bookings || 0) === 1 ? '' : 's'} and ${money(row.lifetime_value)} CLV`,
        'no repeat customer rows'
      );
      const trendText = (analytics.revenueTrend || []).length > 1
        ? `Daily revenue moves from ${money((analytics.revenueTrend || [])[0].total)} on ${dateLabel((analytics.revenueTrend || [])[0].period_label)} to ${money((analytics.revenueTrend || []).slice(-1)[0].total)} on ${dateLabel((analytics.revenueTrend || []).slice(-1)[0].period_label)}.`
        : 'Daily revenue trend evidence is limited because fewer than two daily points are available.';

      return `Data Summary

The merchant analytics dataset covers the filtered period from ${dateLabel(range.startDate)} to ${dateLabel(range.endDate)}. It summarizes booking activity, paid revenue, service performance, category revenue, customer retention, marketing channels, campaign performance, finance indicators, predictive planning signals, and merchant leaderboard rows. The dashboard contains ${number(overview.total_bookings)} booking${Number(overview.total_bookings || 0) === 1 ? '' : 's'}, ${money(overview.revenue_generated)} in generated revenue, ${number(overview.number_of_customers)} customer${Number(overview.number_of_customers || 0) === 1 ? '' : 's'}, and an average order value of ${money(overview.average_order_value)}. The visible leaderboard is led by ${topMerchants}.

Descriptive Statistics

For daily revenue, the distribution has ${formatStat(revenueStats, money)}. Revenue by category has ${formatStat(categoryStats, money)}. Top-service booking counts have ${formatStat(serviceBookingStats, value => number(value) + ' booking' + (Math.round(value) === 1 ? '' : 's'))}. Merchant leaderboard revenue has ${formatStat(merchantRevenueStats, money)}. Key KPI values show a booking conversion rate of ${percent(overview.booking_conversion_rate)}, cancellation/no-show rate of ${percent(overview.cancellation_no_show_rate)}, satisfaction rating of ${Number(overview.customer_satisfaction_rating || 0).toFixed(1)}/5, average lead time of ${(Number((analytics.leadTime || {}).avg_lead_hours || 0) / 24).toFixed(1)} days, retention rate of ${percent(retentionRate)}, profit margin of ${percent(profitMargin)}, refund amount of ${money(financial.refunded_amount)}, refund count of ${number(financial.refund_count)}, and estimated tax of ${money(financial.estimated_tax)}.

Frequency counts and percentages show booking status distribution as ${statusFrequency}. Category revenue distribution is ${categoryFrequency}. Payment method distribution is ${paymentFrequency}. Booking channel distribution is ${channelFrequency}. Top-selling service concentration is led by ${topServices}, while promotion performance includes ${campaigns}.

Key Observations

The main revenue trend is that ${trendText} Peak sales periods are ${peakSales}, and booking demand patterns are strongest at ${peakBookings}. Customer relationships worth investigating include ${number(segments.new_customers)} new customer${Number(segments.new_customers || 0) === 1 ? '' : 's'}, ${number(segments.returning_customers)} returning customer${Number(segments.returning_customers || 0) === 1 ? '' : 's'}, and loyal customer rows led by ${loyalCustomers}. Patterns worth investigating include whether high-revenue categories also have high booking conversion, whether peak booking hours align with peak revenue hours, and whether campaigns with redemptions are tied to repeat-customer behaviour. Unusual findings to review include categories or merchants where maximum revenue sits far above the median, booking statuses with unexpectedly high cancellation/no-show percentages, and payment or channel categories with low frequency but high revenue. Overall, the dataset is sufficiently complete for further merchant performance analysis, revenue trend analysis, operational capacity planning, campaign evaluation, and predictive modelling.`;
    }

    summaryButton.addEventListener('click', function () {
      summaryMeta.textContent = `Generated from the currently filtered merchant dashboard data: ${dateLabel(range.startDate)} to ${dateLabel(range.endDate)}.`;
      summaryOutput.textContent = buildMerchantSummary();
      summaryPanel.classList.add('is-visible');
      summaryPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    copySummaryButton.addEventListener('click', async function () {
      const value = summaryOutput.textContent || '';
      if (!value) return;
      await navigator.clipboard.writeText(value);
      copySummaryButton.innerHTML = '<i class="bi bi-check2 me-1"></i>Copied';
      setTimeout(() => {
        copySummaryButton.innerHTML = '<i class="bi bi-clipboard me-1"></i>Copy';
      }, 1600);
    });
  })();
</script>

<%- include('../partials/footer') %>
