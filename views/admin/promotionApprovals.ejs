<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const formatDate = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const discountText = promo => promo.offer_text || `${Number(promo.discount_pct || 0).toFixed(0)}% off`;
  const dayNames = { mon: 'Mon', tue: 'Tue', wed: 'Wed', thu: 'Thu', fri: 'Fri', sat: 'Sat', sun: 'Sun' };
  const dayLabel = value => {
    const values = String(value || '').split(',').filter(Boolean);
    if (!values.length || values.length === 7) return 'Every day';
    if (values.join(',') === 'sat,sun') return 'Weekends only';
    if (values.join(',') === 'mon,tue,wed,thu,fri') return 'Weekdays only';
    return values.map(day => dayNames[day] || day).join(', ');
  };
%>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
      <p class="section-label">Admin Review</p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Promotion Approvals</h2>
      <p style="color:var(--muted);margin-bottom:0;">Review merchant-submitted promotions before they appear in the marketplace.</p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-pill btn-sm">
      <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>
  </div>

  <% if (error) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i><%= error %>
  </div>
  <% } %>

  <% if (query && query.approved) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
    <i class="bi bi-check-circle me-2"></i>Promotion approved and published.
  </div>
  <% } %>

  <% if (query && query.rejected) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
    <i class="bi bi-check-circle me-2"></i>Promotion rejected.
  </div>
  <% } %>

  <% if (query && query.error) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i>Unable to update promotion request.
  </div>
  <% } %>

  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="p-4 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-bottom:1px solid var(--border);">
      <div>
        <p class="section-label mb-1">Approval Queue</p>
        <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;">Pending Promotion Requests</h5>
      </div>
      <span class="badge" style="background:#EFF6FF;color:#1D4ED8;"><%= pendingPromotions.length %> pending</span>
    </div>

    <% if (!pendingPromotions.length) { %>
    <div class="text-center py-5 px-4">
      <div class="icon-circle-lg mx-auto mb-3" style="width:64px;height:64px;">
        <i class="bi bi-check-circle" style="font-size:2rem;color:var(--success);"></i>
      </div>
      <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;">No pending promotions</h6>
      <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;">New merchant promotion requests will appear here.</p>
    </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th>Promotion</th>
            <th>Merchant</th>
            <th>Offer</th>
            <th>Dates</th>
            <th>Review</th>
          </tr>
        </thead>
        <tbody>
          <% pendingPromotions.forEach(promo => { %>
          <tr>
            <td style="min-width:260px;">
              <div class="d-flex gap-3 align-items-start">
                <% if (promo.image_path) { %>
                <img src="<%= promo.image_path %>" alt="" style="width:72px;height:54px;object-fit:cover;border-radius:var(--r);border:1px solid var(--border);" />
                <% } %>
                <div>
                  <p style="font-weight:700;color:var(--ink);margin-bottom:.15rem;"><%= promo.title %></p>
                  <p style="color:var(--muted);margin-bottom:.25rem;"><%= promo.description || '' %></p>
                  <% if (promo.service_name) { %>
                  <span class="badge" style="background:var(--accent-light);color:var(--accent);"><%= promo.service_name %></span>
                  <% } %>
                </div>
              </div>
            </td>
            <td>
              <p style="font-weight:700;margin-bottom:.15rem;"><%= promo.merchant_name %></p>
              <p style="color:var(--muted);margin-bottom:0;"><%= promo.merchant_email || '' %></p>
            </td>
            <td>
              <p style="font-weight:700;margin-bottom:.15rem;"><%= discountText(promo) %></p>
              <p style="color:var(--muted);margin-bottom:0;"><%= Number(promo.discount_pct || 0).toFixed(0) %>% discount</p>
            </td>
            <td>
              <%= formatDate(promo.start_date) %>
              <span style="color:var(--muted);">to</span>
              <%= formatDate(promo.end_date) %>
              <p style="color:var(--muted);margin:.25rem 0 0;"><i class="bi bi-calendar-week me-1"></i><%= dayLabel(promo.applicable_days) %></p>
            </td>
            <td style="min-width:260px;">
              <form action="/admin/promotions/<%= promo.promo_id %>/approve" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-success btn-pill mb-2">
                  <i class="bi bi-check-circle me-1"></i>Approve
                </button>
              </form>
              <form action="/admin/promotions/<%= promo.promo_id %>/reject" method="POST">
                <div class="input-group input-group-sm">
                  <input type="text" name="rejection_reason" class="form-control" placeholder="Optional rejection reason" />
                  <button type="submit" class="btn btn-outline-danger">Reject</button>
                </div>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
