<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const formatDate = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const discountText = promo => promo.offer_text || t('admin.promotions.percentOff', { pct: Number(promo.discount_pct || 0).toFixed(0) });
  const dayNames = { mon: 'Mon', tue: 'Tue', wed: 'Wed', thu: 'Thu', fri: 'Fri', sat: 'Sat', sun: 'Sun' };
  const dayLabel = value => {
    const values = String(value || '').split(',').filter(Boolean);
    if (!values.length || values.length === 7) return t('home.everyDay');
    if (values.join(',') === 'sat,sun') return t('home.weekendsOnly');
    if (values.join(',') === 'mon,tue,wed,thu,fri') return t('home.weekdaysOnly');
    return values.map(day => dayNames[day] || day).join(', ');
  };
  const lifecycleStyle = status => ({
    active:   { label: t('admin.promotions.lifecycle.active'),   icon: 'bi-broadcast',  bg: 'var(--success-bg)', color: 'var(--success)' },
    upcoming: { label: t('admin.promotions.lifecycle.upcoming'), icon: 'bi-clock',      bg: '#EFF6FF',           color: '#1D4ED8' },
    paused:   { label: t('admin.promotions.lifecycle.paused'),   icon: 'bi-pause',      bg: 'var(--warn-bg)',    color: 'var(--warn)' },
    expired:  { label: t('admin.promotions.lifecycle.expired'),  icon: 'bi-calendar-x', bg: 'var(--danger-bg)',  color: 'var(--danger)' },
  }[status] || { label: t('admin.promotions.lifecycle.approved'), icon: 'bi-check-circle', bg: 'var(--success-bg)', color: 'var(--success)' });
  const pastApprovedList = Array.isArray(pastApprovedPromotions) ? pastApprovedPromotions : [];
%>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
      <p class="section-label"><%= t('admin.promotions.eyebrow') %></p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.promotions.title') %></h2>
      <p style="color:var(--muted);margin-bottom:0;"><%= t('admin.promotions.subtitle') %></p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-pill btn-sm">
      <i class="bi bi-arrow-left me-1"></i><%= t('nav.dashboard') %>
    </a>
  </div>

  <% if (error) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i><%= error %>
  </div>
  <% } %>

  <% if (query && query.approved) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
    <i class="bi bi-check-circle me-2"></i><%= t('admin.promotions.approvedMsg') %>
  </div>
  <% } %>

  <% if (query && query.rejected) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
    <i class="bi bi-check-circle me-2"></i><%= t('admin.promotions.rejectedMsg') %>
  </div>
  <% } %>

  <% if (query && query.error) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i><%= t('admin.promotions.errorMsg') %>
  </div>
  <% } %>

  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="p-4 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-bottom:1px solid var(--border);">
      <div>
        <p class="section-label mb-1"><%= t('admin.promotions.queueEyebrow') %></p>
        <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;"><%= t('admin.promotions.queueTitle') %></h5>
      </div>
      <span class="badge" style="background:#EFF6FF;color:#1D4ED8;"><%= t('admin.common.countPending', { count: pendingPromotions.length }) %></span>
    </div>

    <% if (!pendingPromotions.length) { %>
    <div class="text-center py-5 px-4">
      <div class="icon-circle-lg mx-auto mb-3" style="width:64px;height:64px;">
        <i class="bi bi-check-circle" style="font-size:2rem;color:var(--success);"></i>
      </div>
      <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.promotions.emptyTitle') %></h6>
      <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;"><%= t('admin.promotions.emptyBody') %></p>
    </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th><%= t('admin.promotions.colPromotion') %></th>
            <th><%= t('common.merchant') %></th>
            <th><%= t('admin.promotions.colOffer') %></th>
            <th><%= t('admin.promotions.colDates') %></th>
            <th><%= t('admin.promotions.colReview') %></th>
          </tr>
        </thead>
        <tbody>
          <% pendingPromotions.forEach(promo => { %>
          <tr>
            <td style="min-width:260px;">
              <div class="d-flex gap-3 align-items-start">
                <% if (promo.image_path) { %>
                <img src="<%= promo.image_path %>" alt="" style="width:72px;height:54px;object-fit:cover;border-radius:var(--r);border:1px solid var(--border);" />
                <% } %>
                <div>
                  <p style="font-weight:700;color:var(--ink);margin-bottom:.15rem;"><%= promo.title %></p>
                  <p style="color:var(--muted);margin-bottom:.25rem;"><%= promo.description || '' %></p>
                  <% if (promo.service_name) { %>
                  <span class="badge" style="background:var(--accent-light);color:var(--accent);"><%= promo.service_name %></span>
                  <% } %>
                </div>
              </div>
            </td>
            <td>
              <p style="font-weight:700;margin-bottom:.15rem;"><%= promo.merchant_name %></p>
              <p style="color:var(--muted);margin-bottom:0;"><%= promo.merchant_email || '' %></p>
            </td>
            <td>
              <p style="font-weight:700;margin-bottom:.15rem;"><%= discountText(promo) %></p>
              <p style="color:var(--muted);margin-bottom:0;"><%= t('admin.promotions.percentDiscount', { pct: Number(promo.discount_pct || 0).toFixed(0) }) %></p>
            </td>
            <td>
              <%= formatDate(promo.start_date) %>
              <span style="color:var(--muted);"><%= t('admin.promotions.dateRangeTo') %></span>
              <%= formatDate(promo.end_date) %>
              <p style="color:var(--muted);margin:.25rem 0 0;"><i class="bi bi-calendar-week me-1"></i><%= dayLabel(promo.applicable_days) %></p>
            </td>
            <td style="min-width:260px;">
              <form action="/admin/promotions/<%= promo.promo_id %>/approve" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-success btn-pill mb-2">
                  <i class="bi bi-check-circle me-1"></i><%= t('admin.common.approve') %>
                </button>
              </form>
              <form action="/admin/promotions/<%= promo.promo_id %>/reject" method="POST">
                <div class="input-group input-group-sm">
                  <input type="text" name="rejection_reason" class="form-control" placeholder="<%= t('admin.promotions.rejectionReason') %>" />
                  <button type="submit" class="btn btn-outline-danger"><%= t('admin.common.reject') %></button>
                </div>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <div class="card border-0 overflow-hidden mt-4" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="p-4 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-bottom:1px solid var(--border);">
      <div>
        <p class="section-label mb-1"><%= t('admin.promotions.historyEyebrow') %></p>
        <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;"><%= t('admin.promotions.historyTitle') %></h5>
      </div>
      <span class="badge" style="background:var(--success-bg);color:var(--success);"><%= t('admin.promotions.countApproved', { count: pastApprovedList.length }) %></span>
    </div>

    <% if (!pastApprovedList.length) { %>
    <div class="text-center py-5 px-4">
      <div class="icon-circle-lg mx-auto mb-3" style="width:64px;height:64px;">
        <i class="bi bi-calendar-check" style="font-size:2rem;color:var(--muted);"></i>
      </div>
      <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.promotions.historyEmptyTitle') %></h6>
      <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;"><%= t('admin.promotions.historyEmptyBody') %></p>
    </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
        <thead style="background:var(--canvas);">
          <tr>
            <th><%= t('admin.promotions.colPromotion') %></th>
            <th><%= t('common.merchant') %></th>
            <th><%= t('admin.promotions.colOffer') %></th>
            <th><%= t('admin.promotions.colPeriod') %></th>
            <th><%= t('admin.table.status') %></th>
          </tr>
        </thead>
        <tbody>
          <% pastApprovedList.forEach(promo => { %>
          <% const lifecycle = lifecycleStyle(promo.lifecycle_status); %>
          <tr>
            <td style="min-width:260px;">
              <div class="d-flex gap-3 align-items-start">
                <% if (promo.image_path) { %>
                <img src="<%= promo.image_path %>" alt="" style="width:72px;height:54px;object-fit:cover;border-radius:var(--r);border:1px solid var(--border);" />
                <% } %>
                <div>
                  <p style="font-weight:700;color:var(--ink);margin-bottom:.15rem;"><%= promo.title %></p>
                  <p style="color:var(--muted);margin-bottom:.25rem;"><%= promo.description || '' %></p>
                  <% if (promo.service_name) { %>
                  <span class="badge" style="background:var(--accent-light);color:var(--accent);"><%= promo.service_name %></span>
                  <% } %>
                </div>
              </div>
            </td>
            <td>
              <p style="font-weight:700;margin-bottom:.15rem;"><%= promo.merchant_name %></p>
              <p style="color:var(--muted);margin-bottom:0;"><%= promo.merchant_email || '' %></p>
            </td>
            <td>
              <p style="font-weight:700;margin-bottom:.15rem;"><%= discountText(promo) %></p>
              <p style="color:var(--muted);margin-bottom:0;"><%= t('admin.promotions.percentDiscount', { pct: Number(promo.discount_pct || 0).toFixed(0) }) %></p>
            </td>
            <td>
              <%= formatDate(promo.start_date) %>
              <span style="color:var(--muted);"><%= t('admin.promotions.dateRangeTo') %></span>
              <%= formatDate(promo.end_date) %>
              <p style="color:var(--muted);margin:.25rem 0 0;"><i class="bi bi-calendar-week me-1"></i><%= dayLabel(promo.applicable_days) %></p>
            </td>
            <td>
              <span class="badge rounded-pill" style="background:<%= lifecycle.bg %>;color:<%= lifecycle.color %>;">
                <i class="bi <%= lifecycle.icon %> me-1"></i><%= lifecycle.label %>
              </span>
              <p style="color:var(--muted);margin:.35rem 0 0;"><%= t('admin.promotions.approvedOn', { date: formatDate(promo.approved_at) }) %></p>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
