<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const r = report || {};
  const overview = r.overview || {};
  const money = value => 'S$' + Number(value || 0).toFixed(2);
  const moneyWhole = value => 'S$' + Math.round(Number(value || 0)).toLocaleString('en-SG');
  const number = value => Number(value || 0).toLocaleString('en-SG');
  const pct = value => Number(value || 0).toFixed(1) + '%';
  const percentOf = (value, total) => {
    const base = Number(total || 0);
    return base ? ((Number(value || 0) / base) * 100) : 0;
  };
  const dateTime = value => value ? new Date(value).toLocaleString('en-SG', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '-';
  const displaySource = value => {
    const source = String(value || 'marketplace').toLowerCase();
    if (source === 'web' || source === 'marketplace') return 'Marketplace';
    if (source === 'qr') return 'QR';
    if (source === 'whatsapp') return 'WhatsApp';
    return source.charAt(0).toUpperCase() + source.slice(1);
  };
  const paymentMethod = value => {
    const method = String(value || 'stripe').toLowerCase();
    if (method === 'paynow') return 'PayNow';
    if (method === 'wallet') return 'Wallet';
    if (method === 'card' || method === 'stripe' || method === 'checkout') return 'Stripe Card';
    return method.charAt(0).toUpperCase() + method.slice(1);
  };
  const statusClass = status => {
    const s = String(status || '').toLowerCase();
    if (s === 'paid') return 'success';
    if (s === 'pending' || s === 'processing') return 'warn';
    if (s === 'failed' || s === 'payment_failed' || s === 'refunded' || s === 'partially_refunded') return 'danger';
    return 'muted';
  };
  const sourceTotal = (r.bookingSource || []).reduce((sum, row) => sum + Number(row.gross_revenue || 0), 0);
  const sourceStops = [];
  let running = 0;
  const sourceColors = ['#E11D48', '#2563EB', '#10B981', '#F59E0B', '#64748B'];
  (r.bookingSource || []).forEach((row, index) => {
    const start = running;
    running += percentOf(row.gross_revenue, sourceTotal);
    sourceStops.push(`${sourceColors[index % sourceColors.length]} ${start}% ${running}%`);
  });
  const donutBackground = sourceStops.length ? `conic-gradient(${sourceStops.join(', ')})` : 'conic-gradient(var(--neutral-bg) 0% 100%)';
  const trend = (r.dailyTrend || []).map(row => ({
    date: row.revenue_date,
    gross: Number(row.gross_revenue || 0),
    commission: Number(row.platform_commission || 0),
    bookings: Number(row.paid_bookings || 0),
  }));
%>

<style>
  .finance-page {
    display:flex;
    flex-direction:column;
    gap:2.25rem;
  }
  .finance-panel {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--r-xl);
    box-shadow:var(--shadow-sm);
    padding:1.5rem;
  }
  .finance-card {
    background:var(--surface);
    border:1px solid var(--border);
    border-radius:var(--r-lg);
    box-shadow:var(--shadow-sm);
    padding:1.35rem;
    height:100%;
  }
  .finance-card-label {
    color:var(--muted);
    font-size:.78rem;
    font-weight:700;
    margin-bottom:.45rem;
  }
  .finance-card-value {
    font-family:var(--font-mono);
    font-size:1.9rem;
    font-weight:800;
    letter-spacing:-.03em;
    line-height:1;
    margin-bottom:.65rem;
    color:var(--ink);
  }
  .finance-card-sub {
    color:var(--ghost);
    font-size:.75rem;
    margin:0;
  }
  .filter-chip {
    border:1px solid var(--border);
    border-radius:999px;
    padding:.55rem .9rem;
    color:var(--muted);
    text-decoration:none;
    font-size:.82rem;
    font-weight:800;
    background:var(--surface);
  }
  .filter-chip:hover,
  .filter-chip.active {
    background:var(--accent);
    border-color:var(--accent);
    color:#fff;
  }
  .stacked-bar {
    display:flex;
    height:18px;
    border-radius:999px;
    overflow:hidden;
    background:var(--neutral-bg);
  }
  .stacked-bar span:first-child { background:var(--success); }
  .stacked-bar span:last-child { background:var(--accent); }
  .split-box {
    border:1px solid var(--border);
    border-radius:var(--r);
    padding:1rem;
    background:var(--canvas);
  }
  .donut-wrap {
    display:grid;
    grid-template-columns:180px minmax(0, 1fr);
    gap:1.25rem;
    align-items:center;
  }
  .donut {
    width:180px;
    height:180px;
    border-radius:50%;
    background:<%= donutBackground %>;
    position:relative;
    box-shadow:inset 0 0 0 1px var(--border);
  }
  .donut::after {
    content:'';
    position:absolute;
    inset:42px;
    border-radius:50%;
    background:var(--surface);
    box-shadow:inset 0 0 0 1px var(--border);
  }
  .source-line {
    display:grid;
    grid-template-columns:minmax(0, 1fr) auto;
    gap:1rem;
    align-items:center;
    padding:.55rem 0;
    border-bottom:1px solid var(--border);
  }
  .source-line:last-child { border-bottom:none; }
  .source-dot {
    width:9px;
    height:9px;
    border-radius:50%;
    display:inline-block;
    margin-right:.45rem;
  }
  .chart-wrap {
    position:relative;
    min-height:220px;
  }
  .trend-chart {
    width:100%;
    height:220px;
    display:block;
    overflow:visible;
  }
  .trend-tip {
    position:absolute;
    transform:translate(-50%,-128%);
    background:var(--ink);
    color:#fff;
    border-radius:.65rem;
    padding:.4rem .65rem;
    font-size:.72rem;
    font-weight:800;
    pointer-events:none;
    white-space:nowrap;
    box-shadow:0 8px 20px rgba(0,0,0,.18);
  }
  .finance-table th {
    color:var(--muted);
    font-size:.72rem;
    font-weight:800;
    text-transform:uppercase;
    letter-spacing:.06em;
    background:var(--accent-light);
    border-bottom:none;
  }
  .finance-table td {
    vertical-align:middle;
  }
  .finance-table .currency,
  .finance-table th.currency {
    text-align:right;
    font-family:var(--font-mono);
  }
  .status-pill {
    display:inline-flex;
    align-items:center;
    border-radius:999px;
    padding:.3rem .65rem;
    font-size:.75rem;
    font-weight:800;
    text-transform:capitalize;
  }
  .status-pill.success { background:var(--success-bg); color:var(--success); }
  .status-pill.warn { background:var(--warn-bg); color:var(--warn); }
  .status-pill.danger { background:var(--danger-bg); color:var(--danger); }
  .status-pill.muted { background:var(--neutral-bg); color:var(--muted); }
  @media (max-width: 768px) {
    .donut-wrap { grid-template-columns:1fr; }
    .donut { width:150px; height:150px; margin:auto; }
  }
</style>

<div class="container py-5 finance-page">
  <div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
      <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
      <div class="d-flex align-items-center gap-3">
        <div class="icon-circle flex-shrink-0" style="background:#fff;color:var(--accent);width:42px;height:42px;">
          <i class="bi bi-graph-up-arrow"></i>
        </div>
        <div>
          <p class="section-label mb-1">Admin Finance</p>
          <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.15rem;">Revenue Summary</h2>
          <p style="color:var(--muted);margin-bottom:0;">Summary, trend, breakdowns, and payment records from actual platform payment data.</p>
        </div>
      </div>

      <form method="GET" action="/admin/revenue" class="d-flex flex-wrap gap-2 align-items-center">
        <a href="/admin/payouts" class="btn btn-outline-secondary btn-pill">
          <i class="bi bi-bank me-1"></i>Payouts
        </a>
        <input type="date" name="startDate" class="form-control rounded-xl" style="width:150px;" value="<%= range.startDate %>" />
        <input type="date" name="endDate" class="form-control rounded-xl" style="width:150px;" value="<%= range.endDate %>" />
        <button type="submit" class="btn btn-primary btn-pill">
          <i class="bi bi-funnel me-1"></i>Filter
        </button>
      </form>
    </div>
  </div>

  <% if (error) { %>
    <div class="alert alert-warning">
      <i class="bi bi-exclamation-triangle"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <section>
    <div class="row g-3">
      <div class="col-6 col-lg-3">
        <div class="finance-card">
          <p class="finance-card-label">Gross Revenue</p>
          <p class="finance-card-value" style="color:var(--accent);"><%= moneyWhole(overview.gross_revenue) %></p>
          <p class="finance-card-sub">Successful customer payments</p>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="finance-card">
          <p class="finance-card-label">Platform Revenue</p>
          <p class="finance-card-value" style="color:var(--success);"><%= money(overview.platform_commission) %></p>
          <p class="finance-card-sub">10% Uniday commission</p>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="finance-card">
          <p class="finance-card-label">Completed Orders</p>
          <p class="finance-card-value"><%= number(overview.paid_bookings) %></p>
          <p class="finance-card-sub">Paid bookings in this range</p>
        </div>
      </div>
      <div class="col-6 col-lg-3">
        <div class="finance-card">
          <p class="finance-card-label">Refund Rate</p>
          <p class="finance-card-value" style="color:<%= Number(overview.refund_rate || 0) > 0 ? 'var(--danger)' : 'var(--success)' %>;"><%= pct(overview.refund_rate) %></p>
          <p class="finance-card-sub"><%= number(overview.refund_count) %> refund records - <%= money(overview.refund_amount) %></p>
        </div>
      </div>
    </div>
  </section>

  <section class="finance-panel">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
      <div>
        <p class="section-label mb-1">Revenue Trend</p>
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">Revenue for selected period</h5>
        <p style="color:var(--muted);margin-bottom:0;">Daily gross paid revenue based on payment completion date.</p>
      </div>
      <div class="d-flex flex-wrap gap-2">
        <a class="filter-chip" href="/admin/revenue?startDate=<%= range.endDate %>&endDate=<%= range.endDate %>">Today</a>
        <a class="filter-chip" href="/admin/revenue?startDate=<%= new Date(new Date(range.endDate).setDate(new Date(range.endDate).getDate() - 6)).toISOString().slice(0,10) %>&endDate=<%= range.endDate %>">7 Days</a>
        <a class="filter-chip" href="/admin/revenue?startDate=<%= new Date(new Date(range.endDate).setDate(new Date(range.endDate).getDate() - 29)).toISOString().slice(0,10) %>&endDate=<%= range.endDate %>">30 Days</a>
        <a class="filter-chip" href="/admin/revenue?startDate=<%= range.endDate.slice(0,8) %>01&endDate=<%= range.endDate %>">This Month</a>
      </div>
    </div>
    <div class="chart-wrap" data-trend='<%- JSON.stringify(trend).replace(/</g, "\\u003c") %>'>
      <svg class="trend-chart" viewBox="0 0 900 220" preserveAspectRatio="none"></svg>
      <div class="trend-tip" hidden></div>
    </div>
  </section>

  <section class="row g-4">
    <div class="col-lg-6">
      <div class="finance-panel h-100">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-3">
          <div>
            <p class="section-label mb-1">Revenue Split</p>
            <h5 style="font-weight:800;color:var(--ink);margin-bottom:0;">Gross revenue allocation</h5>
          </div>
          <span class="badge" style="background:var(--accent-light);color:var(--accent);font-weight:800;">10% platform / 90% merchant</span>
        </div>
        <div class="row g-3 mb-3">
          <div class="col-4">
            <p style="color:var(--muted);font-size:.78rem;margin-bottom:.3rem;">Gross</p>
            <strong class="mono"><%= money(overview.gross_revenue) %></strong>
          </div>
          <div class="col-4">
            <p style="color:var(--muted);font-size:.78rem;margin-bottom:.3rem;">Merchant receives</p>
            <strong class="mono" style="color:var(--success);"><%= money(overview.merchant_settlement_total) %></strong>
          </div>
          <div class="col-4">
            <p style="color:var(--muted);font-size:.78rem;margin-bottom:.3rem;">Platform earns</p>
            <strong class="mono" style="color:var(--accent);"><%= money(overview.platform_commission) %></strong>
          </div>
        </div>
        <div class="stacked-bar mb-2">
          <span style="width:90%;"></span>
          <span style="width:10%;"></span>
        </div>
        <div class="d-flex justify-content-between" style="font-size:.78rem;color:var(--muted);">
          <span>Merchant 90% before gateway fees</span>
          <span>Platform 10%</span>
        </div>
        <div class="split-box mt-3">
          <p style="font-weight:800;margin-bottom:.35rem;">Gateway fees</p>
          <p style="color:var(--muted);margin-bottom:0;">Stripe processing and dispute fees are tracked separately: <strong class="mono"><%= money(overview.gateway_fees) %></strong>.</p>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="finance-panel h-100">
        <p class="section-label mb-1">Revenue Sources</p>
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:1rem;">Channel share</h5>
        <div class="donut-wrap">
          <div class="donut" aria-hidden="true"></div>
          <div>
            <% (r.bookingSource || []).forEach((row, index) => { %>
              <div class="source-line">
                <span style="color:var(--muted);">
                  <span class="source-dot" style="background:<%= sourceColors[index % sourceColors.length] %>;"></span>
                  <%= displaySource(row.source) %> - <%= pct(percentOf(row.gross_revenue, sourceTotal)) %>
                </span>
                <strong class="mono"><%= money(row.gross_revenue) %></strong>
              </div>
            <% }) %>
            <% if (!(r.bookingSource || []).length) { %><p style="color:var(--muted);margin:0;">No paid sources in this range.</p><% } %>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="row g-4">
    <div class="col-lg-6">
      <div class="finance-panel h-100">
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:1rem;">Top Merchants</h5>
        <div class="table-responsive">
          <table class="table align-middle finance-table mb-0">
            <thead>
              <tr>
                <th>Rank</th>
                <th>Merchant</th>
                <th class="currency">Revenue Band</th>
                <th class="currency">Bookings</th>
              </tr>
            </thead>
            <tbody>
              <% (r.topMerchants || []).forEach((row, index) => { %>
                <tr>
                  <td style="font-weight:800;">#<%= index + 1 %></td>
                  <td><strong><%= row.merchant_name %></strong><div style="color:var(--muted);font-size:.78rem;"><%= row.category %></div></td>
                  <td class="currency"><%= row.gross_revenue_band || 'S$0' %></td>
                  <td class="currency"><%= number(row.paid_bookings) %></td>
                </tr>
              <% }) %>
              <% if (!(r.topMerchants || []).length) { %><tr><td colspan="4" style="color:var(--muted);">No paid merchant revenue in this range.</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="col-lg-6">
      <div class="finance-panel h-100">
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:1rem;">Revenue by Category</h5>
        <div class="table-responsive">
          <table class="table align-middle finance-table mb-0">
            <thead>
              <tr>
                <th>Category</th>
                <th class="currency">Revenue</th>
                <th class="currency">Bookings</th>
                <th class="currency">Avg Ticket</th>
              </tr>
            </thead>
            <tbody>
              <% (r.categoryBreakdown || []).forEach(row => { %>
                <tr>
                  <td><strong><%= row.category %></strong></td>
                  <td class="currency"><%= money(row.gross_revenue) %></td>
                  <td class="currency"><%= number(row.paid_bookings) %></td>
                  <td class="currency"><%= money(Number(row.gross_revenue || 0) / Math.max(1, Number(row.paid_bookings || 0))) %></td>
                </tr>
              <% }) %>
              <% if (!(r.categoryBreakdown || []).length) { %><tr><td colspan="4" style="color:var(--muted);">No category revenue in this range.</td></tr><% } %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <section class="finance-panel">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
      <h5 style="font-weight:800;color:var(--ink);margin-bottom:0;">Recent Payments</h5>
      <span class="badge" style="background:var(--accent-light);color:var(--accent);font-weight:800;">Latest 12</span>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle finance-table mb-0" style="font-size:.8125rem;">
        <thead>
          <tr>
            <th>Payment</th>
            <th>Booking</th>
            <th>Customer</th>
            <th>Merchant</th>
            <th>Service</th>
            <th>Method</th>
            <th class="currency">Gross</th>
            <th class="currency">Gateway</th>
            <th class="currency">Refund</th>
            <th>Status</th>
            <th>Paid At</th>
          </tr>
        </thead>
        <tbody>
          <% (r.recentTransactions || []).forEach(row => { %>
            <tr>
              <td class="mono">#<%= row.payment_id %></td>
              <td class="mono">#<%= row.booking_id %></td>
              <td><%= row.customer_name %></td>
              <td><%= row.merchant_name %></td>
              <td><%= row.service_name %></td>
              <td><%= paymentMethod(row.payment_method) %></td>
              <td class="currency"><%= money(row.amount) %></td>
              <td class="currency"><%= money(row.gateway_fee) %></td>
              <td class="currency"><%= Number(row.refund_amount || 0) > 0 ? money(row.refund_amount) : '-' %></td>
              <td><span class="status-pill <%= statusClass(row.payment_status) %>"><%= row.payment_status %></span></td>
              <td><%= dateTime(row.paid_at) %></td>
            </tr>
          <% }) %>
          <% if (!(r.recentTransactions || []).length) { %>
            <tr><td colspan="11" style="color:var(--muted);">No payment records in this range.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </section>
</div>

<script>
(function () {
  var wrap = document.querySelector('.chart-wrap');
  if (!wrap) return;
  var svg = wrap.querySelector('.trend-chart');
  var tip = wrap.querySelector('.trend-tip');
  var points = [];
  try { points = JSON.parse(wrap.getAttribute('data-trend') || '[]'); } catch (err) { points = []; }
  var W = 900;
  var H = 220;
  var padX = 18;
  var padY = 18;
  var color = '#E11D48';

  if (!points.length) {
    svg.innerHTML = '<text x="450" y="112" text-anchor="middle" fill="var(--muted)" font-size="16">No paid revenue in this period.</text>';
    return;
  }

  var values = points.map(function (point) { return Number(point.gross || 0); });
  var max = Math.max.apply(null, values.concat([1]));
  function xAt(i) { return points.length > 1 ? padX + (i / (points.length - 1)) * (W - padX * 2) : W / 2; }
  function yAt(value) { return H - padY - (Number(value || 0) / max) * (H - padY * 2); }
  var coords = points.map(function (point, i) { return [xAt(i), yAt(point.gross)]; });
  var path = 'M ' + coords[0][0] + ' ' + coords[0][1];
  for (var i = 0; i < coords.length - 1; i += 1) {
    var c0 = coords[i - 1] || coords[i];
    var c1 = coords[i];
    var c2 = coords[i + 1];
    var c3 = coords[i + 2] || c2;
    var t = 0.28;
    var cp1x = c1[0] + (c2[0] - c0[0]) * t;
    var cp1y = c1[1] + (c2[1] - c0[1]) * t;
    var cp2x = c2[0] - (c3[0] - c1[0]) * t;
    var cp2y = c2[1] - (c3[1] - c1[1]) * t;
    path += ' C ' + cp1x + ' ' + cp1y + ', ' + cp2x + ' ' + cp2y + ', ' + c2[0] + ' ' + c2[1];
  }
  var area = path + ' L ' + coords[coords.length - 1][0] + ' ' + (H - padY) + ' L ' + coords[0][0] + ' ' + (H - padY) + ' Z';
  svg.innerHTML =
    '<defs><linearGradient id="adminRevenueTrend" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="' + color + '" stop-opacity=".22"></stop><stop offset="100%" stop-color="' + color + '" stop-opacity=".02"></stop></linearGradient></defs>' +
    '<line x1="' + padX + '" y1="' + (H - padY) + '" x2="' + (W - padX) + '" y2="' + (H - padY) + '" stroke="var(--border)" stroke-width="1"></line>' +
    '<path d="' + area + '" fill="url(#adminRevenueTrend)"></path>' +
    '<path d="' + path + '" fill="none" stroke="' + color + '" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>' +
    '<circle class="trend-dot" r="5" fill="' + color + '" stroke="var(--surface)" stroke-width="2" style="opacity:0"></circle>';
  var dot = svg.querySelector('.trend-dot');
  function showPoint(index) {
    var c = coords[index];
    var point = points[index];
    dot.setAttribute('cx', c[0]);
    dot.setAttribute('cy', c[1]);
    dot.style.opacity = '1';
    tip.hidden = false;
    tip.textContent = String(point.date).slice(0, 10) + ' - S$' + Number(point.gross || 0).toFixed(2);
    tip.style.left = ((c[0] / W) * 100) + '%';
    tip.style.top = ((c[1] / H) * 100) + '%';
  }
  svg.addEventListener('mousemove', function (event) {
    var rect = svg.getBoundingClientRect();
    var relX = ((event.clientX - rect.left) / rect.width) * W;
    var closest = 0;
    var dist = Infinity;
    coords.forEach(function (coord, index) {
      var next = Math.abs(coord[0] - relX);
      if (next < dist) {
        dist = next;
        closest = index;
      }
    });
    showPoint(closest);
  });
  svg.addEventListener('mouseleave', function () {
    dot.style.opacity = '0';
    tip.hidden = true;
  });
  showPoint(points.length - 1);
})();
</script>

