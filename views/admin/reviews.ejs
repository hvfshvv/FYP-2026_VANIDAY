<% locals.hideCatNav = true %>
<%- include('../partials/header') %>
<%
  const date = v => v ? new Date(v).toLocaleDateString('en-SG', {day:'numeric',month:'short',year:'numeric'}) : '-';
  const requestList = typeof requests !== 'undefined' && Array.isArray(requests) ? requests : [];
  const recentList = typeof recentReviews !== 'undefined' && Array.isArray(recentReviews) ? recentReviews : [];
%>
<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;"><div class="container" style="max-width:1200px;">
  <div class="mb-4"><p class="section-label mb-2"><%= t('admin.reviews.eyebrow') %></p><h2 style="font-weight:800;"><%= t('admin.reviews.title') %></h2><p style="color:var(--muted);"><%= t('admin.reviews.subtitle') %></p></div>
  <% if (success) { %><div class="rounded-xl p-3 mb-3" style="background:var(--success-bg);color:var(--success);"><%= success %></div><% } %>
  <% if (error) { %><div class="rounded-xl p-3 mb-3" style="background:var(--danger-bg);color:var(--danger);"><%= error %></div><% } %>

  <section class="mb-5"><div class="d-flex justify-content-between align-items-center mb-3"><div><p class="section-label mb-1"><%= t('admin.dashboard.actionRequired') %></p><h4 style="font-weight:800;margin:0;"><%= t('admin.reviews.photoRemovalTitle') %></h4></div><span class="badge rounded-pill" style="background:<%= requestList.length ? 'var(--danger-bg)' : 'var(--success-bg)' %>;color:<%= requestList.length ? 'var(--danger)' : 'var(--success)' %>;font-size:.85rem;"><%= t('admin.common.countPending', { count: requestList.length }) %></span></div>
    <% if (!requestList.length) { %><div class="card border-0 p-4 text-center" style="border-radius:var(--r-xl);"><i class="bi bi-check-circle" style="font-size:1.8rem;color:var(--success);"></i><h6 class="mt-2 mb-0"><%= t('admin.reviews.noRequests') %></h6></div><% } %>
    <% requestList.forEach(review => { %><%- include('partials/reviewCard', { review, date, showRequestActions:true, showModeration:false }) %><% }) %>
  </section>

  <section><div class="d-flex justify-content-between align-items-center mb-3"><div><p class="section-label mb-1"><%= t('admin.reviews.latestActivity') %></p><h4 style="font-weight:800;margin:0;"><%= t('admin.reviews.recentTitle') %></h4></div><a href="/admin/reviews/all" class="btn btn-primary btn-sm btn-pill"><%= t('admin.reviews.viewAll') %> <i class="bi bi-arrow-right ms-1"></i></a></div>
    <% if (!recentList.length) { %><div class="card border-0 p-4 text-center"><h6><%= t('admin.reviews.noneYet') %></h6></div><% } %>
    <% recentList.forEach(review => { %><%- include('partials/reviewCard', { review, date, showRequestActions:false, showModeration:false }) %><% }) %>
  </section>
</div></main>
<%- include('../partials/footer') %>
