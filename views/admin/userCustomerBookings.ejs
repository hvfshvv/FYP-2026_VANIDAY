<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  // Formatting helpers for booking dates, times and money values.
  const money = value => 'S$' + Number(value || 0).toFixed(2);
  const formatDate = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const formatTime = value => value ? String(value).slice(0, 5) : '-';
%>

<!-- Admin view of all bookings made by one customer. -->
<main class="container py-5">
  <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
    <div>
      <p class="section-label"><%= t('admin.customerBookings.eyebrow') %></p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= customer.full_name %></h2>
      <p style="color:var(--muted);margin:0;"><%= customer.email %> · <%= t('admin.accountStatus.' + customer.status, {}, customer.status) %></p>
    </div>
    <a href="/admin/user-management/customers" class="btn btn-outline-secondary btn-pill">
      <i class="bi bi-arrow-left me-1"></i><%= t('admin.userManagement.customerAccounts') %>
    </a>
  </div>

  <!-- Booking table joins merchant, service and payment details for audit use. -->
  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th><%= t('admin.dashboard.logs.colId') %></th>
            <th><%= t('common.merchant') %></th>
            <th><%= t('common.service') %></th>
            <th><%= t('admin.table.dateTime') %></th>
            <th><%= t('admin.table.source') %></th>
            <th><%= t('admin.table.bookingStatus') %></th>
            <th><%= t('admin.table.payment') %></th>
            <th><%= t('common.total') %></th>
          </tr>
        </thead>
        <tbody>
          <% if (!bookings.length) { %>
            <tr><td colspan="8" class="text-center py-5 text-muted"><%= t('admin.customerBookings.empty') %></td></tr>
          <% } %>
          <% bookings.forEach(booking => { %>
          <tr>
            <td class="mono">#<%= booking.booking_id %></td>
            <td><%= booking.merchant_name %></td>
            <td><%= booking.service_name %></td>
            <td><%= formatDate(booking.booking_date) %> <span class="text-muted"><%= formatTime(booking.booking_time) %></span></td>
            <td><span class="badge bg-secondary"><%= booking.source ? t('admin.source.' + booking.source, {}, booking.source) : '-' %></span></td>
            <td><span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);"><%= t('admin.bookingStatus.' + booking.status, {}, booking.status) %></span></td>
            <td><%= t('admin.paymentStatus.' + (booking.payment_status || 'unpaid'), {}, booking.payment_status || 'unpaid') %></td>
            <td class="mono"><%= money(booking.paid_amount || booking.total_amount) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
