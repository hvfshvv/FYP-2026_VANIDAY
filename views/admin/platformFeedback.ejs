<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const rows = Array.isArray(feedback) ? feedback : [];
  const fmtDate = value => value ? new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' }) : '-';
  const fmtDateTime = value => value ? new Date(value).toLocaleString('en-SG', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : '-';
  const typeLabel = value => String(value || 'general').replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase());
  const ratingStars = value => Array.from({ length: 5 }, (_, i) => i < Number(value || 0) ? 'bi-star-fill' : 'bi-star');
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:1180px;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
      <div>
        <p class="section-label">Platform Feedback</p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Uniday Reviews</h2>
        <p style="color:var(--muted);margin-bottom:0;">View customer feedback about the booking, payment, QR, and platform experience.</p>
      </div>
      <a href="/admin/dashboard" class="btn btn-outline-secondary btn-pill btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
      </a>
    </div>

    <% if (error) { %>
    <div class="rounded-xl p-3 mb-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
      <i class="bi bi-exclamation-circle me-2"></i><%= error %>
    </div>
    <% } %>

    <div class="row g-3 mb-4">
      <% [
        { label:'Total Feedback', value:summary.total_feedback || 0, icon:'bi-chat-square-heart', color:'var(--accent)' },
        { label:'Average Rating', value:Number(summary.average_rating || 0).toFixed(1) + '/5', icon:'bi-star', color:'#f59e0b' },
        { label:'Positive Ratings', value:summary.positive_count || 0, icon:'bi-emoji-smile', color:'var(--success)' },
        { label:'Low Ratings', value:summary.low_rating_count || 0, icon:'bi-exclamation-circle', color:'var(--danger)' },
      ].forEach(stat => { %>
      <div class="col-6 col-lg-3">
        <div class="stat-card">
          <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;"><%= stat.label %></p>
          <div class="d-flex justify-content-between align-items-center gap-3">
            <p class="stat-value" style="color:<%= stat.color %>;"><%= stat.value %></p>
            <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
              <i class="bi <%= stat.icon %>"></i>
            </div>
          </div>
        </div>
      </div>
      <% }) %>
    </div>

    <form method="GET" action="/admin/platform-feedback" class="card border-0 mb-4" style="box-shadow:var(--shadow-sm);border-radius:var(--r-lg);">
      <div class="card-body p-3">
        <div class="row g-2 align-items-end">
          <div class="col-md-4">
            <label class="form-label" style="font-size:.8rem;font-weight:700;">Search</label>
            <input type="search" name="search" value="<%= filters.search || '' %>" class="form-control rounded-xl" placeholder="Customer, merchant, service, message">
          </div>
          <div class="col-md-3">
            <label class="form-label" style="font-size:.8rem;font-weight:700;">Type</label>
            <select name="type" class="form-select rounded-xl">
              <% ['all','booking_experience','payment','qr_checkin','whatsapp','general'].forEach(type => { %>
              <option value="<%= type %>" <%= filters.type === type ? 'selected' : '' %>><%= type === 'all' ? 'All types' : typeLabel(type) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-2">
            <label class="form-label" style="font-size:.8rem;font-weight:700;">Rating</label>
            <select name="rating" class="form-select rounded-xl">
              <option value="all" <%= filters.rating === 'all' ? 'selected' : '' %>>All</option>
              <% [5,4,3,2,1].forEach(rating => { %>
              <option value="<%= rating %>" <%= String(filters.rating) === String(rating) ? 'selected' : '' %>><%= rating %> stars</option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary btn-pill flex-fill" style="font-weight:800;">
              <i class="bi bi-funnel me-1"></i>Filter
            </button>
            <a href="/admin/platform-feedback" class="btn btn-outline-secondary btn-pill">Clear</a>
          </div>
        </div>
      </div>
    </form>

    <% if (!rows.length) { %>
    <div class="card border-0 text-center p-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="icon-circle-lg mx-auto mb-3">
        <i class="bi bi-chat-square" style="font-size:2rem;color:var(--accent);"></i>
      </div>
      <h6 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">No feedback found</h6>
      <p style="color:var(--muted);margin:0;">Customer Uniday feedback will appear here after review submissions.</p>
    </div>
    <% } else { %>
    <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
          <thead style="background:var(--accent-light);">
            <tr>
              <th>Feedback</th>
              <th>Customer</th>
              <th>Booking Context</th>
              <th>Submitted</th>
            </tr>
          </thead>
          <tbody>
            <% rows.forEach(row => { %>
            <tr>
              <td style="min-width:320px;">
                <div class="d-flex align-items-center gap-2 mb-1">
                  <span class="badge" style="background:var(--accent-light);color:var(--accent);"><%= typeLabel(row.feedback_type) %></span>
                  <span style="color:#f59e0b;white-space:nowrap;">
                    <% ratingStars(row.rating).forEach(icon => { %><i class="bi <%= icon %>"></i><% }) %>
                  </span>
                </div>
                <p style="color:var(--ink);font-weight:700;margin:0 0 .2rem;"><%= row.rating %>/5 platform rating</p>
                <p style="color:var(--muted);margin:0;"><%= row.feedback_text || 'No written platform feedback.' %></p>
              </td>
              <td>
                <p style="font-weight:800;color:var(--ink);margin-bottom:.15rem;"><%= row.customer_name %></p>
                <p style="color:var(--muted);margin:0;"><%= row.customer_email %></p>
              </td>
              <td style="min-width:240px;">
                <% if (row.booking_id) { %>
                <p style="font-weight:800;color:var(--ink);margin-bottom:.15rem;">Booking #<%= row.booking_id %></p>
                <p style="color:var(--muted);margin:0;"><%= row.merchant_name || '-' %> · <%= row.service_name || '-' %></p>
                <p style="color:var(--muted);margin:.15rem 0 0;"><%= fmtDate(row.booking_date) %> <%= row.booking_time ? String(row.booking_time).slice(0,5) : '' %></p>
                <% } else { %>
                <span style="color:var(--muted);">General platform feedback</span>
                <% } %>
              </td>
              <td><%= fmtDateTime(row.created_at) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
