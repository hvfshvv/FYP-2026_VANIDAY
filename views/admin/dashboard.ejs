<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<style>
  .admin-module-header {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .admin-module-controls {
    display: flex;
    gap: .5rem;
  }

  .admin-module-btn {
    align-items: center;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--ink);
    display: inline-flex;
    height: 40px;
    justify-content: center;
    transition: .2s ease;
    width: 40px;
  }

  .admin-module-btn:hover {
    background: var(--accent-light);
    border-color: var(--accent-light);
    color: var(--accent);
  }

  .admin-module-carousel {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 3rem;
    overflow-x: auto;
    padding: .25rem .15rem 1rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
  }

  .admin-module-carousel::-webkit-scrollbar {
    height: 8px;
  }

  .admin-module-carousel::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 999px;
  }

  .admin-module-card {
    flex: 0 0 calc((100% - 5rem) / 5);
    min-width: 230px;
    scroll-snap-align: start;
  }

  .admin-module-card .action-card {
    min-height: 310px;
    padding: 1.75rem;
  }

  .stat-card.is-alert {
    background: #fee2e2;
    border-color: rgba(239, 68, 68, .35);
    box-shadow: 0 16px 40px rgba(239, 68, 68, .14);
  }

  .stat-card.is-alert:hover {
    border-color: rgba(239, 68, 68, .55);
    box-shadow: 0 18px 46px rgba(239, 68, 68, .22);
  }

  .stat-card.is-alert .stat-alert-label {
    color: #991b1b !important;
  }

  .stat-card.is-alert .icon-circle {
    background: #fff1f2 !important;
    color: #dc2626 !important;
  }

  @media (max-width: 1199.98px) {
    .admin-module-card {
      flex-basis: calc((100% - 2.5rem) / 3);
    }
  }

  @media (max-width: 767.98px) {
    .admin-module-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .admin-module-card {
      flex-basis: 82%;
      min-width: 260px;
    }
  }
</style>

<%
  const money = value => 'S$' + Number(value || 0).toFixed(2);
%>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-start mb-5 flex-wrap gap-3">
    <div>
      <p class="section-label">Platform Control</p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Admin Dashboard</h2>
      <p style="color:var(--muted);margin-bottom:0;">Welcome back, <strong><%= user.full_name %></strong></p>
    </div>
    <a href="/admin/revenue" class="btn btn-outline-secondary btn-pill" style="font-weight:800;">
      <i class="bi bi-graph-up me-1"></i>Revenue Report
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-warning mb-4">
    <i class="bi bi-exclamation-triangle"></i>
    <span><%= error %></span>
  </div>
  <% } %>

  <div class="row g-3 mb-5">
    <% [
      { label:'Customers', value:summary.total_customers || 0, icon:'bi-people', color:'var(--accent)' },
      { label:'Merchants', value:summary.total_merchants || 0, icon:'bi-shop', color:'var(--ink)' },
      { label:'Bookings', value:summary.total_bookings || 0, icon:'bi-calendar-check', color:'#1D4ED8' },
      { label:'Gross Revenue', value:money(summary.total_revenue), icon:'bi-credit-card', color:'var(--success)', href:'/admin/revenue' },
      { label:'Payments', value:summary.total_payments || 0, icon:'bi-receipt', color:'var(--accent)' },
      { label:'Services', value:summary.total_services || 0, icon:'bi-scissors', color:'var(--ink)' },
      { label:'Promotions', value:summary.total_promotions || 0, icon:'bi-tag', color:'var(--accent)' },
      { label:'Pending Merchant Validations', value:summary.pending_merchant_validations || 0, icon:'bi-shield-exclamation', color:'var(--warn)', href:'/admin/merchant-validations', alertWhenPositive:true },
      { label:'Validation Logs', value:summary.total_validation_errors || 0, icon:'bi-bug', color:'var(--danger)' },
    ].forEach(stat => { %>
    <div class="col-6 col-lg-3">
      <% const statTag = stat.href ? 'a' : 'div'; %>
      <% const isAlert = stat.alertWhenPositive && Number(stat.value) > 0; %>
      <<%= statTag %> class="stat-card<%= stat.href ? ' d-block text-decoration-none' : '' %><%= isAlert ? ' is-alert' : '' %>"<%- stat.href ? ` href="${stat.href}"` : '' %>>
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <p class="stat-alert-label" style="color:var(--muted);font-size:.8125rem;margin-bottom:.5rem;"><%= stat.label %></p>
            <p class="stat-value" style="color:<%= isAlert ? '#b91c1c' : stat.color %>;"><%= stat.value %></p>
          </div>
          <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
            <i class="bi <%= stat.icon %>"></i>
          </div>
        </div>
      </<%= statTag %>>
    </div>
    <% }) %>
  </div>

  <div class="admin-module-header">
    <div>
      <p class="section-label mb-1">Admin Modules</p>
      <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;">Platform Tools</h5>
    </div>
    <div class="admin-module-controls" aria-label="Module carousel controls">
      <button type="button" class="admin-module-btn" id="modulePrevBtn" aria-label="Previous modules">
        <i class="bi bi-chevron-left"></i>
      </button>
      <button type="button" class="admin-module-btn" id="moduleNextBtn" aria-label="Next modules">
        <i class="bi bi-chevron-right"></i>
      </button>
    </div>
  </div>

  <div class="admin-module-carousel" id="admin-modules">
    <% [
      {
        href:'/admin/customers',
        icon:'bi-person-lines-fill',
        label:'Customer Information',
        sub:'View customer profiles, booking history, loyalty points, vouchers, wallet balances, cancellations, and favourite merchants.'
      },
      {
        href:'/admin/merchants',
        icon:'bi-shop-window',
        label:'Merchant Information',
        sub:'Review merchant business details, services, staff, promotions, cancellation policies, revenue, QR bookings, and performance analytics.'
      },
      {
        href:'/admin/promotions',
        icon:'bi-megaphone',
        label:'Promotion Review',
        sub:'Review merchant-submitted promotions, approve valid campaigns, or reject requests with admin feedback.'
      },
      {
        href:'/admin/platform-feedback',
        icon:'bi-chat-square-heart',
        label:'Uniday Feedback',
        sub:'Read customer ratings and comments about booking, payment, QR check-in, WhatsApp, and platform experience.'
      },
      {
        href:'/admin/validation',
        icon:'bi-shield-exclamation',
        label:'Validation & Error Logs',
        sub:'Monitor booking failures, payment failures, WhatsApp/API issues, invalid vouchers, and backend validation errors.'
      },
      {
        href:'/admin/featured',
        icon:'bi-stars',
        label:'Featured Merchants',
        sub:'Select merchants to feature on the marketplace homepage and promotional sections.'
      },
      {
        href:'/admin/campaigns',
        icon:'bi-ticket-perforated',
        label:'Voucher Management',
        sub:'Manage loyalty wallet rewards, platform vouchers, seasonal campaigns, and eligibility rules.'
      },
    ].forEach(item => { %>
    <div class="admin-module-card">
      <a href="<%= item.href %>" class="action-card h-100">
        <div class="action-icon">
          <i class="bi <%= item.icon %>"></i>
        </div>
        <p style="font-weight:800;font-size:.95rem;color:var(--ink);margin-bottom:.4rem;line-height:1.25;"><%= item.label %></p>
        <p style="color:var(--muted);font-size:.8125rem;line-height:1.5;margin-bottom:1rem;"><%= item.sub %></p>
        <span style="margin-top:auto;color:var(--accent);font-size:.78rem;font-weight:700;display:inline-flex;align-items:center;gap:.35rem;">
          Open module <i class="bi bi-arrow-right"></i>
        </span>
      </a>
    </div>
    <% }) %>
  </div>

  <div class="row g-4">
    <div class="col-12">
      <div class="card border-0 overflow-hidden h-100" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="p-4" style="border-bottom:1px solid var(--border);">
          <p class="section-label mb-1">Validation</p>
          <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;">Recent Validation Errors</h5>
        </div>
        <% if (recentErrors.length === 0) { %>
        <div class="text-center py-5 px-4">
          <div class="icon-circle-lg mx-auto mb-3" style="width:64px;height:64px;">
            <i class="bi bi-shield-check" style="font-size:2rem;color:var(--success);"></i>
          </div>
          <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;">No validation errors</h6>
          <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;">Recent platform validation issues will appear here.</p>
        </div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
            <thead style="background:var(--accent-light);">
              <tr>
                <th>ID</th>
                <th>Module</th>
                <th>Type</th>
                <th>Resolved</th>
              </tr>
            </thead>
            <tbody>
              <% recentErrors.forEach(log => { %>
              <tr>
                <td style="font-weight:600;color:var(--muted);font-family:var(--font-mono);">#<%= log.log_id %></td>
                <td>
                  <p style="font-weight:600;margin-bottom:.1rem;"><%= log.module || '-' %></p>
                  <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;max-width:32ch;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= log.error_message || '-' %></p>
                </td>
                <td><%= log.error_type || '-' %></td>
                <td>
                  <span class="badge" style="<%= log.is_resolved ? 'background:var(--success-bg);color:var(--success);' : 'background:var(--warn-bg);color:var(--warn);' %>">
                    <%= log.is_resolved ? 'Resolved' : 'Open' %>
                  </span>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
  const adminModuleTrack = document.getElementById('admin-modules');
  const modulePrevBtn = document.getElementById('modulePrevBtn');
  const moduleNextBtn = document.getElementById('moduleNextBtn');

  function scrollAdminModules(direction) {
    if (!adminModuleTrack) return;
    const scrollAmount = Math.max(adminModuleTrack.clientWidth * 0.9, 280);
    adminModuleTrack.scrollBy({
      left: direction * scrollAmount,
      behavior: 'smooth'
    });
  }

  if (modulePrevBtn) {
    modulePrevBtn.addEventListener('click', () => scrollAdminModules(-1));
  }

  if (moduleNextBtn) {
    moduleNextBtn.addEventListener('click', () => scrollAdminModules(1));
  }
</script>

<%- include('../partials/footer') %>
