<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<style>
  .admin-dashboard-page {
    background: linear-gradient(180deg, #fff1f5 0%, var(--canvas) 58%, #fff 100%);
    min-height: 80vh;
    padding: clamp(1rem, 3vw, 3rem) 1rem;
  }

  .admin-dashboard-shell {
    background: linear-gradient(145deg, rgba(255,255,255,.98), #fff8fa);
    border: 1px solid rgba(225, 29, 72, .09);
    border-radius: clamp(20px, 2.6vw, 30px);
    box-shadow: 0 28px 70px rgba(136, 19, 55, .1);
    margin: 0 auto;
    max-width: 1320px;
    padding: clamp(1rem, 2.4vw, 2rem);
  }

  .admin-module-header {
    align-items: center;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .admin-hero {
    align-items: flex-start;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 2.25rem;
    padding: .25rem .1rem 0;
  }

  .admin-hero h2 {
    color: var(--ink);
    font-weight: 800;
    letter-spacing: -.03em;
    margin-bottom: .25rem;
  }

  .admin-hero p:last-child {
    color: var(--muted);
    margin-bottom: 0;
  }

  .admin-hero .btn {
    box-shadow: 0 10px 24px rgba(15, 23, 42, .06);
    white-space: nowrap;
  }

  .admin-section {
    margin-bottom: 2rem;
  }

  .admin-section-heading {
    align-items: flex-end;
    display: flex;
    gap: 1rem;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  .admin-section-heading h5 {
    color: var(--ink);
    font-weight: 850;
    letter-spacing: -.02em;
    margin: 0;
  }

  .admin-section-heading p:not(.section-label) {
    line-height: 1.45;
    max-width: 66ch;
  }

  .admin-dashboard-shell .stat-card {
    background: #fff;
    border: 1px solid rgba(225, 29, 72, .08);
    border-radius: 18px;
    box-shadow: 0 10px 28px rgba(136, 19, 55, .06);
    display: block;
    height: 100%;
    overflow: hidden;
    padding: 1.15rem;
    position: relative;
    transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
  }

  .admin-dashboard-shell .stat-card::before {
    background: var(--stat-color, var(--accent));
    border-radius: 999px;
    content: "";
    height: calc(100% - 1.5rem);
    left: 0;
    opacity: .75;
    position: absolute;
    top: .75rem;
    width: 4px;
  }

  .admin-dashboard-shell a.stat-card:hover,
  .admin-dashboard-shell a.stat-card:focus-visible,
  .admin-tool-card:hover,
  .admin-tool-card:focus-visible {
    border-color: rgba(225, 29, 72, .22);
    box-shadow: 0 16px 38px rgba(136, 19, 55, .1);
    transform: translateY(-2px);
  }

  .admin-dashboard-shell a.stat-card:focus-visible,
  .admin-tool-card:focus-visible,
  .admin-period-selector .filter-chip:focus-visible,
  .admin-module-btn:focus-visible {
    outline: 3px solid rgba(225, 29, 72, .22);
    outline-offset: 3px;
  }

  .stat-card.is-featured {
    background: linear-gradient(135deg, var(--accent), #fb7185);
    border-color: transparent;
    box-shadow: 0 18px 42px rgba(225, 29, 72, .2);
  }

  .stat-card.is-featured,
  .stat-card.is-featured .stat-alert-label,
  .stat-card.is-featured .stat-description,
  .stat-card.is-featured .stat-value {
    color: #fff !important;
  }

  .stat-card.is-featured .icon-circle {
    background: rgba(255,255,255,.2) !important;
    color: #fff !important;
  }

  .stat-card.is-quiet {
    background: linear-gradient(145deg, #fff, #fffafa);
  }

  .stat-description {
    color: var(--muted);
    font-size: .72rem;
    line-height: 1.4;
    margin: .5rem 0 0;
  }

  .status-dot {
    background: var(--stat-color, var(--accent));
    border-radius: 50%;
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--stat-color, var(--accent)) 12%, transparent);
    display: inline-block;
    height: 8px;
    margin-top: .35rem;
    width: 8px;
  }

  .admin-module-carousel {
    display: flex;
    gap: 1.25rem;
    margin-bottom: 2.25rem;
    overflow-x: auto;
    padding: .25rem .15rem .35rem;
    scroll-behavior: smooth;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .admin-module-carousel::-webkit-scrollbar {
    display: none;
  }

  .admin-module-card {
    flex: 0 0 calc((100% - 5rem) / 5);
    min-width: 230px;
    scroll-snap-align: start;
  }

  .admin-module-controls { display:flex;gap:.5rem; }
  .admin-module-btn { align-items:center;background:#fff;border:1px solid var(--border);border-radius:999px;color:var(--ink);display:inline-flex;height:42px;justify-content:center;transition:.2s ease;width:42px; }
  .admin-module-btn:hover:not(:disabled) { background:var(--accent-light);border-color:var(--accent);color:var(--accent); }
  .admin-module-btn:disabled { cursor:not-allowed;opacity:.35; }

  .admin-tool-card {
    background: #fff;
    border: 1px solid rgba(225, 29, 72, .08);
    border-radius: 18px;
    box-shadow: 0 10px 24px rgba(136, 19, 55, .06);
    display: flex;
    flex-direction: column;
    min-height: 250px;
    padding: 1.45rem;
    transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;
  }

  .admin-tool-card .action-icon {
    border-radius: 14px;
    box-shadow: inset 0 0 0 1px rgba(225, 29, 72, .07);
  }

  .admin-tool-card-title {
    color: var(--ink);
    font-size: .95rem;
    font-weight: 800;
    line-height: 1.25;
    margin: 0 0 .45rem;
  }

  .admin-tool-card-copy {
    color: var(--muted);
    font-size: .8rem;
    line-height: 1.45;
    margin: 0 0 1rem;
  }

  .admin-tool-card-link {
    align-items: center;
    color: var(--accent);
    display: inline-flex;
    font-size: .78rem;
    font-weight: 800;
    gap: .35rem;
    margin-top: auto;
  }

  .stat-card.is-alert {
    background: #fee2e2;
    border-color: rgba(239, 68, 68, .35);
    box-shadow: 0 16px 40px rgba(239, 68, 68, .14);
  }

  .stat-card.is-alert:hover {
    border-color: rgba(239, 68, 68, .55);
    box-shadow: 0 18px 46px rgba(239, 68, 68, .22);
  }

  .stat-card.is-alert .stat-alert-label {
    color: #991b1b !important;
  }

  .stat-card.is-alert .icon-circle {
    background: #fff1f2 !important;
    color: #dc2626 !important;
  }

  .admin-priority-grid,
  .admin-metric-grid {
    display: grid;
    gap: 1rem;
  }

  .admin-priority-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .admin-metric-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .admin-priority-grid .stat-card {
    min-height: 156px;
  }

  .admin-metric-grid .stat-card {
    min-height: 168px;
    min-width: 0;
  }

  .admin-metric-grid .stat-value {
    font-size: clamp(1.85rem, 2.4vw, 2.4rem);
    line-height: 1.1;
    max-width: 100%;
    white-space: nowrap;
  }

  .admin-metric-grid .icon-circle {
    flex: 0 0 auto;
    height: 38px !important;
    width: 38px !important;
  }

  .admin-metric-grid .stat-card > .d-flex > div:first-child {
    min-width: 0;
  }

  .admin-metric-grid .stat-card.is-money .stat-value {
    font-size: clamp(1.85rem, 2.25vw, 2.35rem);
  }

  .admin-metric-grid.is-performance {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .admin-period-selector {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: .5rem;
    justify-content: flex-end;
  }

  .admin-period-selector .filter-chip {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    cursor: pointer;
    font-family: inherit;
    font-size: .8125rem;
    font-weight: 800;
    padding: .5rem .85rem;
    text-decoration: none;
    transition: background .18s ease, border-color .18s ease, color .18s ease, box-shadow .18s ease;
  }

  .admin-period-selector .filter-chip:hover {
    background: var(--accent-light);
    border-color: rgba(225, 29, 72, .25);
    color: var(--accent);
  }

  .admin-period-selector .filter-chip.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .admin-dashboard-panel {
    background: #fff;
    border: 1px solid rgba(225, 29, 72, .08) !important;
    border-radius: 20px !important;
    box-shadow: 0 12px 32px rgba(136, 19, 55, .07) !important;
  }

  .admin-system-log-card .p-4 {
    padding: 1.25rem !important;
  }

  .admin-system-log-card table th,
  .admin-system-log-card table td {
    padding: .85rem 1rem;
  }

  .admin-system-log-card table p {
    line-height: 1.25;
  }

  @media (max-width: 1199.98px) {
    .admin-priority-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .admin-metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .admin-metric-grid.is-performance {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .admin-module-card {
      flex-basis: calc((100% - 2.5rem) / 3);
    }
  }

  @media (max-width: 767.98px) {
    .admin-hero,
    .admin-section-heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .admin-priority-grid,
    .admin-metric-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .admin-module-header {
      align-items: flex-start;
      flex-direction: column;
    }

    .admin-module-card {
      flex-basis: 82%;
      min-width: 260px;
    }

    .admin-period-selector {
      justify-content: flex-start;
      width: 100%;
    }
  }

  @media (max-width: 575.98px) {
    .admin-priority-grid,
    .admin-metric-grid,
    .admin-metric-grid.is-performance {
      grid-template-columns: 1fr;
    }

    .admin-metric-grid .stat-value {
      white-space: normal;
    }
  }
</style>

<%
  const money = value => 'S$' + Number(value || 0).toLocaleString('en-SG', {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });
  const period = dashboardPeriod || {
    key: 'this_month',
    label: 'This Month',
    startDate: null,
    endDate: null,
    isAllTime: false,
    asOfDate: new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Singapore' }),
    options: {
      this_month: 'This Month',
      last_30_days: 'Last 30 Days',
      this_year: 'This Year',
      all_time: 'All Time',
    },
  };
  const formatDate = value => value
    ? new Date(`${value}T00:00:00+08:00`).toLocaleDateString('en-SG', { day:'numeric', month:'short', year:'numeric', timeZone:'Asia/Singapore' })
    : '';
  const periodLabel = key => t(`admin.period.${key}`, {}, (period.options || {})[key]);
  const totalsAsOfLabel = t('admin.dashboard.totalsAsOf', { date: formatDate(period.asOfDate) });
  const performancePeriodLabel = period.isAllTime
    ? periodLabel('all_time')
    : t('admin.dashboard.performanceRange', {
        period: periodLabel(period.key),
        from: formatDate(period.startDate),
        to: formatDate(period.endDate),
      });
  const revenueReportHref = period.isAllTime || !period.startDate || !period.endDate
    ? null
    : `/admin/revenue?from=${encodeURIComponent(period.startDate)}&to=${encodeURIComponent(period.endDate)}`;
  const queueStats = [
    { label:t('admin.dashboard.queue.photoRemoval'), value:summary.pending_review_requests || 0, icon:'bi-image', color:'var(--warn)', href:'/admin/reviews', alertWhenPositive:true, description:t('admin.dashboard.queue.photoRemovalDesc') },
    { label:t('admin.dashboard.queue.merchantValidations'), value:summary.pending_merchant_validations || 0, icon:'bi-shield-exclamation', color:'var(--warn)', href:'/admin/merchant-validations', alertWhenPositive:true, description:t('admin.dashboard.queue.merchantValidationsDesc') },
    { label:t('admin.dashboard.queue.promotionApprovals'), value:summary.pending_promotion_approvals || 0, icon:'bi-megaphone', color:'var(--warn)', href:'/admin/promotions', alertWhenPositive:true, description:t('admin.dashboard.queue.promotionApprovalsDesc') },
    { label:t('admin.dashboard.queue.unresolvedLogs'), value:summary.total_validation_errors || 0, icon:'bi-bug', color:'var(--danger)', href:'/admin/validation?status=open', alertWhenPositive:true, description:t('admin.dashboard.queue.unresolvedLogsDesc') },
  ];
  const totalStats = [
    { label:t('admin.dashboard.totals.customers'), value:summary.total_customers || 0, icon:'bi-people', color:'var(--accent)', description:t('admin.dashboard.totals.customersDesc') },
    { label:t('admin.dashboard.totals.merchants'), value:summary.total_merchants || 0, icon:'bi-shop', color:'#0F172A', description:t('admin.dashboard.totals.merchantsDesc') },
    { label:t('admin.dashboard.totals.services'), value:summary.total_services || 0, icon:'bi-scissors', color:'#2563EB', description:t('admin.dashboard.totals.servicesDesc') },
    { label:t('admin.dashboard.totals.promotions'), value:summary.total_promotions || 0, icon:'bi-tag', color:'var(--accent)', description:t('admin.dashboard.totals.promotionsDesc') },
  ];
  const performanceStats = [
    { label:t('admin.dashboard.performance.bookings'), value:summary.total_bookings || 0, icon:'bi-calendar-check', color:'#1D4ED8', description:t('admin.dashboard.performance.bookingsDesc') },
    { label:t('admin.dashboard.performance.revenue'), value:money(summary.total_revenue), icon:'bi-credit-card', color:'var(--success)', href:revenueReportHref, money:true, description:t('admin.dashboard.performance.revenueDesc') },
    { label:t('admin.dashboard.performance.payments'), value:summary.total_payments || 0, icon:'bi-receipt', color:'var(--accent)', description:t('admin.dashboard.performance.paymentsDesc') },
  ];
%>

<main class="admin-dashboard-page">
<div class="admin-dashboard-shell">
  <div class="admin-hero">
    <div>
      <p class="section-label"><%= t('admin.dashboard.eyebrow') %></p>
      <h2><%= t('admin.dashboard.title') %></h2>
      <p><%= t('admin.dashboard.welcomeBack') %> <strong><%= user.full_name %></strong></p>
    </div>
    <a href="/admin/revenue" class="btn btn-outline-secondary btn-pill" style="font-weight:800;">
      <i class="bi bi-graph-up me-1"></i><%= t('admin.dashboard.revenueReport') %>
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-warning mb-4">
    <i class="bi bi-exclamation-triangle"></i>
    <span><%= error %></span>
  </div>
  <% } %>

  <section class="admin-section">
    <div class="admin-section-heading">
      <div>
        <p class="section-label mb-1"><%= t('admin.dashboard.actionRequired') %></p>
        <h5><%= t('admin.dashboard.needsAttention') %></h5>
        <p style="color:var(--muted);font-size:.875rem;margin:.25rem 0 0;"><%= t('admin.dashboard.needsAttentionDesc') %></p>
      </div>
    </div>
    <div class="admin-priority-grid">
      <% queueStats.forEach(stat => { %>
      <% const statTag = stat.href ? 'a' : 'div'; %>
      <% const isAlert = stat.alertWhenPositive && Number(stat.value) > 0; %>
      <<%= statTag %> class="stat-card<%= stat.href ? ' d-block text-decoration-none' : '' %><%= isAlert ? ' is-alert' : ' is-quiet' %><%= stat.money ? ' is-money' : '' %>" style="--stat-color:<%= stat.color %>;"<%- stat.href ? ` href="${stat.href}"` : '' %>>
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <p class="stat-alert-label" style="color:var(--muted);font-size:.8125rem;margin-bottom:.5rem;"><%= stat.label %></p>
            <p class="stat-value" style="color:<%= isAlert ? '#b91c1c' : stat.color %>;"><%= stat.value %></p>
            <p class="stat-description"><%= stat.description %></p>
          </div>
          <div class="d-flex flex-column align-items-end gap-3">
            <span class="status-dot" aria-hidden="true"></span>
            <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
              <i class="bi <%= stat.icon %>"></i>
            </div>
          </div>
        </div>
      </<%= statTag %>>
      <% }) %>
    </div>
  </section>

  <section class="admin-section">
    <div class="admin-section-heading">
      <div>
        <p class="section-label mb-1"><%= t('admin.dashboard.overview') %></p>
        <h5><%= t('admin.dashboard.platformTotals') %></h5>
        <p style="color:var(--muted);font-size:.875rem;margin:.25rem 0 0;"><%= totalsAsOfLabel %></p>
      </div>
    </div>
    <div class="admin-metric-grid">
      <% totalStats.forEach(stat => { %>
      <% const statTag = stat.href ? 'a' : 'div'; %>
      <% const isAlert = stat.alertWhenPositive && Number(stat.value) > 0; %>
      <<%= statTag %> class="stat-card<%= stat.href ? ' d-block text-decoration-none' : '' %><%= isAlert ? ' is-alert' : '' %><%= stat.wide ? ' is-wide' : '' %>" style="--stat-color:<%= stat.color %>;"<%- stat.href ? ` href="${stat.href}"` : '' %>>
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <p class="stat-alert-label" style="color:var(--muted);font-size:.8125rem;margin-bottom:.5rem;"><%= stat.label %></p>
            <p class="stat-value" style="color:<%= isAlert ? '#b91c1c' : stat.color %>;"><%= stat.value %></p>
            <p class="stat-description"><%= stat.description %></p>
          </div>
          <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
            <i class="bi <%= stat.icon %>"></i>
          </div>
        </div>
      </<%= statTag %>>
      <% }) %>
    </div>
  </section>

  <section class="admin-section">
    <div class="admin-section-heading">
      <div>
        <p class="section-label mb-1"><%= t('admin.dashboard.performance.eyebrow') %></p>
        <h5><%= t('admin.dashboard.performance.title') %></h5>
        <p style="color:var(--muted);font-size:.875rem;margin:.25rem 0 0;"><%= performancePeriodLabel %></p>
      </div>
      <form method="GET" action="/admin/dashboard" class="admin-period-selector" aria-label="<%= t('admin.dashboard.performance.periodAria') %>">
        <% Object.keys(period.options).forEach(value => { %>
          <button type="submit" name="period" value="<%= value %>" class="filter-chip<%= period.key === value ? ' is-active' : '' %>"><%= periodLabel(value) %></button>
        <% }) %>
      </form>
    </div>
    <div class="admin-metric-grid is-performance">
      <% performanceStats.forEach(stat => { %>
      <% const statTag = stat.href ? 'a' : 'div'; %>
      <% const isAlert = stat.alertWhenPositive && Number(stat.value) > 0; %>
      <<%= statTag %> class="stat-card<%= stat.href ? ' d-block text-decoration-none' : '' %><%= isAlert ? ' is-alert' : '' %><%= stat.money ? ' is-money' : '' %><%= stat.wide ? ' is-wide' : '' %>" style="--stat-color:<%= stat.color %>;"<%- stat.href ? ` href="${stat.href}"` : '' %>>
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <p class="stat-alert-label" style="color:var(--muted);font-size:.8125rem;margin-bottom:.5rem;"><%= stat.label %></p>
            <p class="stat-value" style="color:<%= isAlert ? '#b91c1c' : stat.color %>;"><%= stat.value %></p>
            <p class="stat-description"><%= stat.description %></p>
          </div>
          <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
            <i class="bi <%= stat.icon %>"></i>
          </div>
        </div>
      </<%= statTag %>>
      <% }) %>
    </div>
  </section>

  <section class="admin-section">
  <div class="admin-module-header">
    <div>
      <p class="section-label mb-1"><%= t('admin.dashboard.tools.eyebrow') %></p>
      <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;"><%= t('admin.dashboard.tools.title') %></h5>
      <p style="color:var(--muted);font-size:.875rem;margin:.25rem 0 0;"><%= t('admin.dashboard.tools.subtitle') %></p>
    </div>
    <div class="admin-module-controls" aria-label="<%= t('admin.dashboard.tools.sliderAria') %>">
      <button type="button" class="admin-module-btn" id="modulePrevBtn" aria-label="<%= t('admin.dashboard.tools.previousAria') %>"><i class="bi bi-chevron-left"></i></button>
      <button type="button" class="admin-module-btn" id="moduleNextBtn" aria-label="<%= t('admin.dashboard.tools.nextAria') %>"><i class="bi bi-chevron-right"></i></button>
    </div>
  </div>

  <div class="admin-module-carousel" id="admin-modules">
    <% [
      {
        href:'/admin/customers',
        icon:'bi-person-lines-fill',
        label:t('admin.dashboard.modules.customers.title'),
        sub:t('admin.dashboard.modules.customers.desc')
      },
      {
        href:'/admin/merchants',
        icon:'bi-shop-window',
        label:t('admin.dashboard.modules.merchants.title'),
        sub:t('admin.dashboard.modules.merchants.desc')
      },
      {
        href:'/admin/promotions',
        icon:'bi-megaphone',
        label:t('admin.dashboard.modules.promotions.title'),
        sub:t('admin.dashboard.modules.promotions.desc')
      },
      {
        href:'/admin/platform-feedback',
        icon:'bi-chat-square-heart',
        label:t('admin.dashboard.modules.feedback.title'),
        sub:t('admin.dashboard.modules.feedback.desc')
      },
      {
        href:'/admin/reviews',
        icon:'bi-images',
        label:t('admin.dashboard.modules.reviews.title'),
        sub:t('admin.dashboard.modules.reviews.desc')
      },
      {
        href:'/admin/validation',
        icon:'bi-shield-exclamation',
        label:t('admin.dashboard.modules.validation.title'),
        sub:t('admin.dashboard.modules.validation.desc')
      },
      {
        href:'/admin/featured',
        icon:'bi-stars',
        label:t('admin.dashboard.modules.featured.title'),
        sub:t('admin.dashboard.modules.featured.desc')
      },
      {
        href:'/admin/campaigns',
        icon:'bi-ticket-perforated',
        label:t('admin.dashboard.modules.campaigns.title'),
        sub:t('admin.dashboard.modules.campaigns.desc')
      },
    ].forEach(item => { %>
    <div class="admin-module-card">
      <a href="<%= item.href %>" class="action-card admin-tool-card h-100">
        <div class="action-icon">
          <i class="bi <%= item.icon %>"></i>
        </div>
        <p class="admin-tool-card-title"><%= item.label %></p>
        <p class="admin-tool-card-copy"><%= item.sub %></p>
        <span class="admin-tool-card-link">
          <%= t('admin.dashboard.tools.openModule') %> <i class="bi bi-arrow-right"></i>
        </span>
      </a>
    </div>
    <% }) %>
  </div>
  </section>

  <section class="admin-section">
  <div class="row g-4">
    <div class="col-12">
      <div class="card overflow-hidden h-100 admin-system-log-card admin-dashboard-panel">
        <div class="p-4" style="border-bottom:1px solid var(--border);">
          <p class="section-label mb-1"><%= t('admin.dashboard.logs.eyebrow') %></p>
          <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;"><%= t('admin.dashboard.logs.title') %></h5>
        </div>
        <% if (recentErrors.length === 0) { %>
        <div class="text-center py-5 px-4">
          <div class="icon-circle-lg mx-auto mb-3" style="width:64px;height:64px;">
            <i class="bi bi-shield-check" style="font-size:2rem;color:var(--success);"></i>
          </div>
          <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.dashboard.logs.emptyTitle') %></h6>
          <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;"><%= t('admin.dashboard.logs.emptyBody') %></p>
        </div>
        <% } else { %>
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
            <thead style="background:var(--accent-light);">
              <tr>
                <th><%= t('admin.dashboard.logs.colId') %></th>
                <th><%= t('admin.dashboard.logs.colModule') %></th>
                <th><%= t('admin.dashboard.logs.colType') %></th>
                <th><%= t('admin.dashboard.logs.colResolved') %></th>
              </tr>
            </thead>
            <tbody>
              <% recentErrors.forEach(log => { %>
              <tr>
                <td style="font-weight:600;color:var(--muted);font-family:var(--font-mono);">#<%= log.log_id %></td>
                <td>
                  <p style="font-weight:600;margin-bottom:.1rem;"><%= log.module || '-' %></p>
                  <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;max-width:32ch;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;"><%= log.error_message || '-' %></p>
                </td>
                <td><%= log.error_type || '-' %></td>
                <td>
                  <span class="badge" style="<%= log.is_resolved ? 'background:var(--success-bg);color:var(--success);' : 'background:var(--warn-bg);color:var(--warn);' %>">
                    <%= log.is_resolved ? t('admin.common.resolved') : t('admin.common.open') %>
                  </span>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <% } %>
      </div>
    </div>
  </div>
  </section>
</div>
</main>

<script>
  (() => {
    const carousel = document.getElementById('admin-modules');
    const previous = document.getElementById('modulePrevBtn');
    const next = document.getElementById('moduleNextBtn');
    if (!carousel || !previous || !next) return;

    const scrollAmount = () => {
      const card = carousel.querySelector('.admin-module-card');
      const gap = parseFloat(getComputedStyle(carousel).gap || 0);
      return card ? card.getBoundingClientRect().width + gap : carousel.clientWidth * .8;
    };
    const updateControls = () => {
      const maxScroll = Math.max(0, carousel.scrollWidth - carousel.clientWidth);
      previous.disabled = carousel.scrollLeft <= 2;
      next.disabled = carousel.scrollLeft >= maxScroll - 2;
    };
    previous.addEventListener('click', () => carousel.scrollBy({ left: -scrollAmount(), behavior: 'smooth' }));
    next.addEventListener('click', () => carousel.scrollBy({ left: scrollAmount(), behavior: 'smooth' }));
    carousel.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls);
    updateControls();
  })();
</script>

<%- include('../partials/footer') %>
