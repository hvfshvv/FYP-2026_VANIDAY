<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const formatDateTime = value => value
    ? new Date(value).toLocaleString('en-SG', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' })
    : '-';
  const statusBadge = status => {
    if (status === 'approved') return 'background:var(--success-bg);color:var(--success);';
    if (status === 'rejected') return 'background:var(--danger-bg);color:var(--danger);';
    return 'background:var(--warn-bg);color:var(--warn);';
  };
  const validationSummary = statusSummary || { pending: 0, approved: 0, rejected: 0 };
%>

<div class="container py-5">
  <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
      <p class="section-label"><%= t('admin.validations.eyebrow') %></p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.validations.title') %></h2>
      <p style="color:var(--muted);margin-bottom:0;"><%= t('admin.validations.subtitle') %></p>
    </div>
    <a href="/admin/dashboard" class="btn btn-outline-secondary btn-pill btn-sm">
      <i class="bi bi-arrow-left me-1"></i><%= t('nav.dashboard') %>
    </a>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-warning mb-4"><%= error %></div>
  <% } %>

  <% if (query && query.approved) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
    <i class="bi bi-check-circle me-2"></i><%= t('admin.validations.approvedMsg') %>
  </div>
  <% } %>

  <% if (query && query.rejected) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-shield-x me-2"></i><%= t('admin.validations.rejectedMsg') %>
  </div>
  <% } %>

  <% if (query && query.unchanged) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--warn-bg);color:var(--warn);font-size:.875rem;">
    <i class="bi bi-info-circle me-2"></i><%= t('admin.validations.unchangedMsg') %>
  </div>
  <% } %>

  <% if (query && query.error) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i><%= t('admin.validations.errorMsg') %>
  </div>
  <% } %>

  <div class="row g-3 mb-4">
    <% [
      { label:t('admin.validations.pendingReview'), value:validationSummary.pending || 0, icon:'bi-hourglass-split', color:'var(--warn)', sub:t('admin.validations.pendingReviewSub') },
      { label:t('admin.validations.approvedMerchants'), value:validationSummary.approved || 0, icon:'bi-shield-check', color:'var(--success)', sub:t('admin.validations.approvedMerchantsSub') },
      { label:t('admin.validations.rejectedApplications'), value:validationSummary.rejected || 0, icon:'bi-shield-x', color:'var(--danger)', sub:t('admin.validations.rejectedApplicationsSub') },
    ].forEach(stat => { %>
    <div class="col-12 col-md-4">
      <div class="stat-card h-100">
        <div class="d-flex justify-content-between align-items-start gap-3">
          <div>
            <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.45rem;"><%= stat.label %></p>
            <p class="stat-value" style="color:<%= stat.color %>;font-size:1.65rem;"><%= stat.value %></p>
            <p style="color:var(--ghost);font-size:.75rem;margin-bottom:0;"><%= stat.sub %></p>
          </div>
          <div class="icon-circle" style="width:42px;height:42px;background:var(--accent-light);color:var(--accent);">
            <i class="bi <%= stat.icon %>"></i>
          </div>
        </div>
      </div>
    </div>
    <% }) %>
  </div>

  <div class="card border-0 overflow-hidden mb-4" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="p-4 d-flex justify-content-between align-items-center flex-wrap gap-2" style="border-bottom:1px solid var(--border);">
      <div>
        <p class="section-label mb-1"><%= t('admin.validations.pendingReview') %></p>
        <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;"><%= t('admin.validations.queueTitle') %></h5>
      </div>
      <span class="badge" style="background:var(--warn-bg);color:var(--warn);"><%= t('admin.common.countPending', { count: pendingMerchants.length }) %></span>
    </div>

    <% if (pendingMerchants.length === 0) { %>
    <div class="text-center py-5 px-4">
      <div class="icon-circle-lg mx-auto mb-3" style="width:64px;height:64px;">
        <i class="bi bi-shield-check" style="font-size:2rem;color:var(--success);"></i>
      </div>
      <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;"><%= t('admin.validations.emptyTitle') %></h6>
      <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;"><%= t('admin.validations.emptyBody') %></p>
    </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th><%= t('common.merchant') %></th>
            <th><%= t('admin.table.owner') %></th>
            <th><%= t('admin.validations.businessDetails') %></th>
            <th><%= t('admin.feedback.colSubmitted') %></th>
            <th style="min-width:280px;"><%= t('admin.validations.decision') %></th>
          </tr>
        </thead>
        <tbody>
          <% pendingMerchants.forEach(m => { %>
          <tr>
            <td>
              <p style="font-weight:700;color:var(--ink);margin-bottom:.15rem;"><%= m.merchant_name %></p>
              <p style="color:var(--muted);margin-bottom:0;"><%= m.merchant_email || '-' %></p>
            </td>
            <td>
              <p style="font-weight:600;margin-bottom:.15rem;"><%= m.owner_name || '-' %></p>
              <p style="color:var(--muted);margin-bottom:0;"><%= m.owner_email || '-' %></p>
            </td>
            <td>
              <p style="margin-bottom:.15rem;"><strong><%= t('admin.validations.uen') %>:</strong> <%= m.business_uen || '-' %></p>
              <p style="color:var(--muted);margin-bottom:.15rem;"><i class="bi bi-telephone me-1"></i><%= m.contact_no || m.owner_phone || '-' %></p>
              <p style="color:var(--muted);margin-bottom:0;max-width:34ch;"><i class="bi bi-geo-alt me-1"></i><%= m.address || '-' %></p>
            </td>
            <td><%= formatDateTime(m.submitted_at || m.created_at) %></td>
            <td>
              <div class="d-flex gap-2 flex-wrap mb-2">
                <form action="/admin/merchant-validations/<%= m.merchant_id %>/approve" method="POST" class="m-0">
                  <button type="submit" class="btn btn-sm btn-success btn-pill">
                    <i class="bi bi-check2-circle me-1"></i><%= t('admin.common.approve') %>
                  </button>
                </form>
                <button
                  type="button"
                  class="btn btn-sm btn-outline-danger btn-pill"
                  data-bs-toggle="collapse"
                  data-bs-target="#rejectMerchant<%= m.merchant_id %>"
                  aria-expanded="false"
                  aria-controls="rejectMerchant<%= m.merchant_id %>"
                >
                  <i class="bi bi-x-circle me-1"></i><%= t('admin.common.reject') %>
                </button>
              </div>
              <div class="collapse" id="rejectMerchant<%= m.merchant_id %>">
                <form action="/admin/merchant-validations/<%= m.merchant_id %>/reject" method="POST">
                  <textarea name="notes" class="form-control rounded-xl mb-2" rows="2" placeholder="<%= t('admin.validations.rejectionNotes') %>"></textarea>
                  <button type="submit" class="btn btn-sm btn-danger btn-pill">
                    <%= t('admin.validations.confirmRejection') %>
                  </button>
                </form>
              </div>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>

  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="p-4" style="border-bottom:1px solid var(--border);">
      <p class="section-label mb-1"><%= t('admin.validations.recentDecisions') %></p>
      <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;"><%= t('admin.validations.historyTitle') %></h5>
    </div>

    <% if (recentDecisions.length === 0) { %>
    <div class="text-center py-5 px-4">
      <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;"><%= t('admin.validations.historyEmpty') %></p>
    </div>
    <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th><%= t('common.merchant') %></th>
            <th><%= t('admin.validations.uen') %></th>
            <th><%= t('admin.table.status') %></th>
            <th><%= t('admin.validations.reviewedBy') %></th>
            <th><%= t('admin.validations.reviewedAt') %></th>
          </tr>
        </thead>
        <tbody>
          <% recentDecisions.forEach(m => { %>
          <tr>
            <td>
              <p style="font-weight:700;color:var(--ink);margin-bottom:.15rem;"><%= m.merchant_name %></p>
              <p style="color:var(--muted);margin-bottom:0;"><%= m.merchant_email || '-' %></p>
            </td>
            <td><%= m.business_uen || '-' %></td>
            <td><span class="badge" style="<%= statusBadge(m.verification_status) %>"><%= t('admin.verification.' + m.verification_status, {}, m.verification_status) %></span></td>
            <td><%= m.verified_by_name || '-' %></td>
            <td><%= formatDateTime(m.verified_at) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
    <% } %>
  </div>
</div>

<%- include('../partials/footer') %>
