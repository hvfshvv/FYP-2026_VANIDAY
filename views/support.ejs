<% locals.hideCatNav = true %>
<%- include('partials/header') %>

<%
  const values = formData || {};
  const fieldErrors = errors || {};
  const fieldClass = name => fieldErrors[name] ? ' is-invalid' : '';
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:1120px;">
    <div class="row g-4 align-items-start">
      <div class="col-lg-5">
        <p class="section-label mb-2">Customer Support</p>
        <h1 style="font-weight:800;color:var(--ink);letter-spacing:-.03em;margin-bottom:.75rem;">Help &amp; Customer Support</h1>
        <p style="color:var(--muted);font-size:1rem;line-height:1.7;margin-bottom:1.5rem;">
          Find quick answers or send a support request to the Uniday team. Guests can submit with their contact details, and logged-in customers can update the pre-filled fields before sending.
        </p>

        <% if (successMessage) { %>
        <div class="alert alert-success mb-4">
          <i class="bi bi-check-circle me-1"></i>
          <span><%= successMessage %></span>
          <% if (reference) { %>
          <div style="font-weight:800;margin-top:.4rem;">Reference: <%= reference %></div>
          <% } %>
        </div>
        <% } %>

        <% if (fieldErrors.form) { %>
        <div class="alert alert-warning mb-4">
          <i class="bi bi-exclamation-triangle me-1"></i>
          <span><%= fieldErrors.form %></span>
        </div>
        <% } %>

        <% if (whatsappSupportUrl) { %>
        <a class="btn btn-outline-success btn-pill mb-4" href="<%= whatsappSupportUrl %>" target="_blank" rel="noopener noreferrer">
          <i class="bi bi-whatsapp me-1"></i>Chat with us on WhatsApp
        </a>
        <% } %>

        <section class="card border-0" style="box-shadow:var(--shadow-sm);border-radius:var(--r-lg);">
          <div class="card-body p-4">
            <h2 style="font-size:1.1rem;font-weight:800;color:var(--ink);margin-bottom:1rem;">Frequently Asked Questions</h2>
            <div class="accordion" id="supportFaqs">
              <% faqs.forEach((faq, index) => { %>
              <div class="accordion-item">
                <h3 class="accordion-header" id="faqHeading<%= index %>">
                  <button class="accordion-button <%= index === 0 ? '' : 'collapsed' %>" type="button" data-bs-toggle="collapse" data-bs-target="#faqPanel<%= index %>" aria-expanded="<%= index === 0 ? 'true' : 'false' %>" aria-controls="faqPanel<%= index %>">
                    <%= faq.question %>
                  </button>
                </h3>
                <div id="faqPanel<%= index %>" class="accordion-collapse collapse <%= index === 0 ? 'show' : '' %>" aria-labelledby="faqHeading<%= index %>" data-bs-parent="#supportFaqs">
                  <div class="accordion-body" style="color:var(--muted);line-height:1.65;">
                    <%= faq.answer %>
                  </div>
                </div>
              </div>
              <% }) %>
            </div>
          </div>
        </section>
      </div>

      <div class="col-lg-7">
        <form method="POST" action="/support" class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
          <div class="card-body p-4 p-lg-5">
            <div class="mb-4">
              <p class="section-label mb-2">Website Support Form</p>
              <h2 style="font-size:1.35rem;font-weight:800;color:var(--ink);margin-bottom:.35rem;">Tell us what happened</h2>
              <p style="color:var(--muted);margin:0;">We will use these details only to review and follow up on your support request.</p>
            </div>

            <div style="position:absolute;left:-10000px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
              <label>Leave this field blank
                <input type="text" name="website" value="" tabindex="-1" autocomplete="off">
              </label>
            </div>

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label" for="supportName" style="font-weight:800;">Name</label>
                <input id="supportName" class="form-control rounded-xl<%= fieldClass('name') %>" type="text" name="name" value="<%= values.name || '' %>" maxlength="100" required>
                <% if (fieldErrors.name) { %><div class="invalid-feedback"><%= fieldErrors.name %></div><% } %>
              </div>

              <div class="col-md-6">
                <label class="form-label" for="supportEmail" style="font-weight:800;">Email</label>
                <input id="supportEmail" class="form-control rounded-xl<%= fieldClass('email') %>" type="email" name="email" value="<%= values.email || '' %>" maxlength="254" required>
                <% if (fieldErrors.email) { %><div class="invalid-feedback"><%= fieldErrors.email %></div><% } %>
              </div>

              <div class="col-md-6">
                <label class="form-label" for="supportPhone" style="font-weight:800;">Phone <span style="color:var(--muted);font-weight:600;">optional</span></label>
                <input id="supportPhone" class="form-control rounded-xl<%= fieldClass('phone') %>" type="tel" name="phone" value="<%= values.phone || '' %>" maxlength="30">
                <% if (fieldErrors.phone) { %><div class="invalid-feedback"><%= fieldErrors.phone %></div><% } %>
              </div>

              <div class="col-md-6">
                <label class="form-label" for="supportCategory" style="font-weight:800;">Issue category</label>
                <select id="supportCategory" class="form-select rounded-xl<%= fieldClass('category') %>" name="category" required>
                  <option value="">Choose a category</option>
                  <% categories.forEach(category => { %>
                  <option value="<%= category.value %>" <%= values.category === category.value ? 'selected' : '' %>><%= category.label %></option>
                  <% }) %>
                </select>
                <% if (fieldErrors.category) { %><div class="invalid-feedback"><%= fieldErrors.category %></div><% } %>
              </div>

              <div class="col-12">
                <label class="form-label" for="supportMessage" style="font-weight:800;">Problem description</label>
                <textarea id="supportMessage" class="form-control rounded-xl<%= fieldClass('message') %>" name="message" rows="7" maxlength="2000" required><%= values.message || '' %></textarea>
                <% if (fieldErrors.message) { %><div class="invalid-feedback"><%= fieldErrors.message %></div><% } %>
              </div>
            </div>

            <button class="btn btn-primary btn-pill mt-4" type="submit" style="font-weight:800;">
              <i class="bi bi-send me-1"></i>Submit Support Request
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</main>

<%- include('partials/footer') %>
