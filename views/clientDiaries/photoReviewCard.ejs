<article class="diaries-card" id="diary-post-<%= post.review_id %>" style="scroll-margin-top:calc(var(--nav-h) + 1rem);">
  <header class="diaries-card-head">
    <div class="diaries-card-user">
      <span class="diaries-avatar"><%= String(post.customer_name || 'C').charAt(0).toUpperCase() %></span>
      <div>
        <p><%= post.customer_name %></p>
        <small><i class="bi bi-patch-check-fill"></i> Verified visit &middot; <%= post.merchant_name %></small>
      </div>
    </div>
    <div class="diaries-rating" aria-label="<%= post.rating %> star review">
      <% [1,2,3,4,5].forEach(i => { %><i class="bi <%= i <= Number(post.rating || 0) ? 'bi-star-fill' : 'bi-star' %>"></i><% }) %>
    </div>
  </header>

  <div class="diaries-photo">
    <img src="<%= post.image_path %>" alt="<%= post.service_name %> photo review by <%= post.customer_name %>">
  </div>

  <div class="diaries-copy">
    <div class="diaries-caption-wrap">
      <div class="diaries-caption"><strong><%= post.customer_name %></strong> <%= post.review_text || t('diaries.sharedPhoto') %></div>
      <button type="button" class="diaries-caption-toggle" aria-expanded="false"><%= t('diaries.readMore') %></button>
    </div>

    <div class="diaries-card-footer">
      <div class="diaries-service-tag">
        <div><span><%= post.service_category ? t('categories.' + post.service_category, {}, post.service_category) : t('diaries.defaultCategory') %></span><strong title="<%= post.service_name %>"><%= post.service_name %></strong></div>
        <i class="bi bi-patch-check-fill" title="<%= t('diaries.verified') %>"></i>
      </div>
      <div class="diaries-actions d-flex gap-2 mt-3">
        <a href="/marketplace/merchant/<%= post.merchant_id %>?from=client-diaries<%= selectedCategory ? '&returnCategory=' + encodeURIComponent(selectedCategory) : '' %>&returnPost=<%= post.review_id %>" class="btn btn-outline-secondary btn-sm btn-pill flex-grow-1"><%= t('diaries.viewMerchant') %></a>
        <a href="/book?merchantId=<%= post.merchant_id %>&serviceId=<%= post.service_id %>" class="btn btn-primary btn-sm btn-pill flex-grow-1"><%= t('diaries.bookService') %></a>
      </div>
      <p class="diaries-date"><%= new Date(post.created_at).toLocaleDateString('en-SG',{day:'numeric',month:'long',year:'numeric'}) %></p>
    </div>
  </div>
</article>
