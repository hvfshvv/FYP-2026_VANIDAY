<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div class="container py-5">
  <a href="/merchant/dashboard" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
    <i class="bi bi-arrow-left me-1"></i>Dashboard
  </a>
  <div class="d-flex align-items-center gap-3 mb-1">
    <div class="icon-circle flex-shrink-0" style="background:var(--accent-light);width:40px;height:40px;">
      <i class="bi bi-star" style="color:var(--accent);"></i>
    </div>
    <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:0;">Featured Listing</h2>
  </div>
  <p style="color:var(--muted);margin-bottom:1.5rem;margin-left:52px;">Highlight your business on the Uniday marketplace homepage.</p>

  <% if (error) { %>
  <div class="rounded-xl p-3 mb-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i><%= error %>
  </div>
  <% } %>
  <% if (typeof success !== 'undefined' && success) { %>
  <div class="rounded-xl p-3 mb-4" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
    <i class="bi bi-check-circle me-2"></i>Featured listing saved successfully!
  </div>
  <% } %>

  <div class="row g-4">
    <!-- Form -->
    <div class="col-md-6">
      <div class="card border-0 p-4" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <h5 style="font-weight:700;color:var(--ink);margin-bottom:1.25rem;"><%= listing ? 'Update' : 'Create' %> Featured Listing</h5>
        <form action="/merchant/featured/save" method="POST" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label" style="font-size:.875rem;font-weight:600;">Display Title</label>
            <input type="text" name="title" class="form-control rounded-xl"
              placeholder="e.g. Top Hair Salon in Orchard"
              value="<%= listing ? listing.title : '' %>" required />
          </div>
          <div class="mb-3">
            <label class="form-label" style="font-size:.875rem;font-weight:600;">Short Description</label>
            <textarea name="description" class="form-control rounded-xl" rows="3"
              placeholder="Briefly describe your business and what makes it special..."><%= listing ? listing.description || '' : '' %></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label" style="font-size:.875rem;font-weight:600;">Link to Promotion <span style="color:var(--muted);font-weight:400;">(optional)</span></label>
            <select name="promo_id" class="form-select rounded-xl">
              <option value="">— No promotion —</option>
              <% promotions.forEach(p => { %>
              <option value="<%= p.promo_id %>" <%= listing && listing.promo_id == p.promo_id ? 'selected' : '' %>>
                <%= p.title %> (<%= p.discount_pct %>% off)
              </option>
              <% }) %>
            </select>
          </div>
          <div class="mb-4">
            <label class="form-label" style="font-size:.875rem;font-weight:600;">Banner Image</label>
            <% if (listing && listing.image_path) { %>
            <div class="mb-2">
              <img src="<%= listing.image_path %>" class="rounded-xl" style="height:80px;object-fit:cover;border:2px solid var(--border);" />
            </div>
            <% } %>
            <input type="file" name="image" class="form-control rounded-xl" accept="image/*" />
            <small style="color:var(--muted);">Max 2MB · JPG or PNG recommended</small>
          </div>
          <button type="submit" class="btn btn-primary btn-pill w-100" style="font-weight:700;">
            <i class="bi bi-star me-2"></i><%= listing ? 'Update' : 'Save' %> Featured Listing
          </button>
        </form>
      </div>

      <div class="p-3 rounded-xl mt-3" style="background:var(--accent-light);border:1.5px solid rgba(225,29,72,.15);">
        <p style="font-size:.8125rem;font-weight:700;color:var(--accent);margin-bottom:.5rem;"><i class="bi bi-lightbulb me-1"></i>Tips for a great listing</p>
        <ul style="font-size:.8125rem;color:var(--muted);margin-bottom:0;padding-left:1.25rem;">
          <li>Use a high-quality photo that shows your salon or space</li>
          <li>Write a short, punchy description (1–2 sentences)</li>
          <li>Link an active promotion to attract more clicks</li>
          <li>Keep your listing visible to appear on the homepage</li>
        </ul>
      </div>
    </div>

    <!-- Preview -->
    <div class="col-md-6">
      <p style="font-weight:700;font-size:.75rem;color:var(--ghost);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.08em;">Listing Preview</p>
      <% if (listing) { %>
      <div class="merchant-card" style="cursor:default;">
        <% if (listing.image_path) { %>
        <img src="<%= listing.image_path %>" class="card-img" alt="<%= listing.title %>" />
        <% } else { %>
        <div class="card-no-img"><i class="bi bi-shop"></i></div>
        <% } %>
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start mb-1">
            <h6 class="card-title mb-0"><%= listing.title %></h6>
            <span class="featured-badge ms-2 flex-shrink-0">
              <i class="bi bi-star-fill" style="font-size:.55rem;"></i>Featured
            </span>
          </div>
          <p class="card-meta mb-2"><%= listing.description || 'Your business description' %></p>
          <% if (listing.promo_title) { %>
          <span class="badge mb-2" style="background:var(--accent-light);color:var(--accent);font-size:.75rem;">
            <i class="bi bi-tag me-1"></i><%= listing.promo_title %>
          </span>
          <% } %>
        </div>
      </div>

      <div class="card border-0 p-3 mt-3" style="box-shadow:var(--shadow-sm);border-radius:var(--r-lg);">
        <div class="d-flex justify-content-between align-items-center">
          <div>
            <p style="font-weight:700;font-size:.875rem;color:var(--ink);margin-bottom:.15rem;">Marketplace Visibility</p>
            <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;">
              <% if (listing.is_visible) { %>
              <span style="color:var(--success);"><i class="bi bi-eye me-1"></i>Currently visible on homepage</span>
              <% } else { %>
              <span><i class="bi bi-eye-slash me-1"></i>Hidden from marketplace</span>
              <% } %>
            </p>
          </div>
          <form action="/merchant/featured/toggle" method="POST">
            <button type="submit" class="btn btn-sm btn-pill <%= listing.is_visible ? 'btn-outline-secondary' : 'btn-primary' %>">
              <i class="bi bi-<%= listing.is_visible ? 'eye-slash' : 'eye' %> me-1"></i>
              <%= listing.is_visible ? 'Hide' : 'Show' %>
            </button>
          </form>
        </div>
      </div>
      <% } else { %>
      <div class="card border-0 text-center p-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="icon-circle-lg mx-auto mb-3">
          <i class="bi bi-star" style="font-size:2rem;color:var(--accent);"></i>
        </div>
        <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;">No listing yet</h6>
        <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;">Fill in the form and save to get your business featured on the Uniday marketplace homepage.</p>
      </div>
      <% } %>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
