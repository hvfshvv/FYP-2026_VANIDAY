<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<style>
  .merchant-bookings-shell { max-width: 1400px; }
  .merchant-bookings-table { min-width: 1240px; }
  .merchant-booking-actions { min-width: 210px; }
  .merchant-booking-actions-inner { display:flex;flex-direction:column;align-items:flex-start;gap:.45rem; }
  .booking-filter-bar { display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;margin-bottom:1rem; }
  .booking-filter-button { border:1px solid var(--border);border-radius:999px;background:#fff;color:var(--muted);padding:.45rem .8rem;font-size:.78rem;font-weight:700;transition:.15s ease; }
  .booking-filter-button:hover { border-color:var(--accent);color:var(--accent); }
  .booking-filter-button.is-active { border-color:var(--accent);background:var(--accent);color:#fff;box-shadow:0 5px 14px rgba(225,29,72,.18); }
  .booking-filter-count { display:inline-flex;align-items:center;justify-content:center;min-width:1.35rem;height:1.35rem;margin-left:.35rem;padding:0 .3rem;border-radius:999px;background:rgba(100,116,139,.12);font-size:.68rem; }
  .booking-filter-button.is-active .booking-filter-count { background:rgba(255,255,255,.2); }
  .booking-manage-overlay { position:fixed;inset:0;z-index:1080;display:none;align-items:center;justify-content:center;padding:1rem;background:rgba(15,23,42,.42); }
  .booking-manage-overlay.is-open { display:flex; }
  .booking-manage-dialog { width:min(100%,560px);max-height:calc(100vh - 2rem);overflow-y:auto;padding:1.5rem;border:1px solid var(--border);border-radius:var(--r-xl);background:#fff;box-shadow:0 24px 70px rgba(15,23,42,.24); }
  .booking-manage-header { display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem; }
  .booking-manage-close { width:36px;height:36px;border:0;border-radius:999px;background:var(--canvas);color:var(--muted);display:inline-flex;align-items:center;justify-content:center; }
  .booking-manage-section + .booking-manage-section { border-top:1px solid var(--border);margin-top:.8rem;padding-top:.8rem; }
  .booking-manage-label { color:var(--ink);font-size:.9rem;font-weight:800;margin-bottom:.45rem; }
  .merchant-booking-row { scroll-margin-top:110px; }
  .merchant-booking-row:target > td { animation:booking-target-pulse 2.4s ease-out; }
  @keyframes booking-target-pulse {
    0%, 18% { background:#FFE4EC;box-shadow:inset 4px 0 0 var(--accent),inset 0 0 0 1px rgba(225,29,72,.28); }
    42% { background:#FFF7F9;box-shadow:inset 4px 0 0 var(--accent),inset 0 0 0 1px rgba(225,29,72,.12); }
    70% { background:#FFEAF0;box-shadow:inset 2px 0 0 rgba(225,29,72,.45); }
    100% { background:transparent;box-shadow:none; }
  }
  @media (prefers-reduced-motion:reduce) {
    .merchant-booking-row:target > td { animation:none;background:#FFF0F4; }
  }
  @media (max-width: 767px) {
    .merchant-bookings-shell { padding-left: .25rem; padding-right: .25rem; }
  }
</style>

<%
  const escapeHtml = value => String(value ?? '').replace(/[&<>"']/g, char => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  }[char]));
  const bookingList = Array.isArray(bookings) ? bookings : [];
  const statusStyles = {
    pending_payment: { label: t('admin.bookingStatus.pending_payment'), bg: 'var(--warn-bg)', color: 'var(--warn)' },
    confirmed:       { label: t('admin.bookingStatus.confirmed'), bg: '#EFF6FF', color: '#2563EB' },
    rescheduled:     { label: t('admin.bookingStatus.rescheduled'), bg: '#EFF6FF', color: '#2563EB' },
    arrived:         { label: t('admin.bookingStatus.arrived'), bg: '#F5F3FF', color: '#7C3AED' },
    completed:       { label: t('admin.bookingStatus.completed'), bg: 'var(--success-bg)', color: 'var(--success)' },
    cancelled:       { label: t('admin.bookingStatus.cancelled'), bg: 'var(--danger-bg)', color: 'var(--danger)' },
    payment_failed:  { label: t('admin.bookingStatus.payment_failed'), bg: 'var(--danger-bg)', color: 'var(--danger)' },
    no_show:         { label: t('admin.bookingStatus.no_show'), bg: 'var(--warn-bg)', color: 'var(--warn)' },
  };

  function formatDate(value) {
    return new Date(value).toLocaleDateString('en-SG', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  function formatTime(value) {
    return String(value || '').slice(0, 5);
  }

  function bookingSource(value) {
    const source = String(value || '').toLowerCase();
    if (source === 'qr' || source === 'qr_scan') {
      return { label: t('merchant.bookings.sourceQr'), icon: 'bi-qr-code' };
    }
    if (source === 'whatsapp') {
      return { label: t('admin.source.whatsapp'), icon: 'bi-whatsapp' };
    }
    return { label: t('admin.source.web'), icon: 'bi-globe2' };
  }

  function appointmentDateTime(booking, time) {
    const date = booking.booking_date instanceof Date
      ? [
          booking.booking_date.getFullYear(),
          String(booking.booking_date.getMonth() + 1).padStart(2, '0'),
          String(booking.booking_date.getDate()).padStart(2, '0'),
        ].join('-')
      : String(booking.booking_date || '').slice(0, 10);
    return new Date(`${date}T${formatTime(time)}:00`);
  }

  function canMarkArrived(booking) {
    const appointmentStart = appointmentDateTime(booking, booking.booking_time);
    if (Number.isNaN(appointmentStart.getTime())) return false;
    return new Date() >= new Date(appointmentStart.getTime() - 15 * 60 * 1000);
  }

  function hasAppointmentStarted(booking) {
    const appointmentStart = appointmentDateTime(booking, booking.booking_time);
    return !Number.isNaN(appointmentStart.getTime()) && appointmentStart <= new Date();
  }

  function hasAppointmentEnded(booking) {
    const appointmentEnd = appointmentDateTime(booking, booking.booking_end_time);
    return !Number.isNaN(appointmentEnd.getTime()) && appointmentEnd <= new Date();
  }
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container merchant-bookings-shell">
    <a href="/merchant/dashboard" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
      <i class="bi bi-arrow-left me-1"></i><%= t('nav.dashboard') %>
    </a>

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <p class="section-label mb-2"><%= t('merchant.nav.bookings') %></p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--accent);margin-bottom:.25rem;"><%= t('merchant.bookings.title') %></h2>
        <p style="color:var(--muted);margin:0;"><%= t('merchant.bookings.subtitle') %></p>
      </div>
      <a href="/merchant/qr" class="btn btn-primary btn-pill">
        <i class="bi bi-qr-code me-1"></i><%= t('merchant.bookings.myQr') %>
      </a>
    </div>

    <div id="booking-list" class="d-flex flex-wrap gap-2 mb-3" aria-label="<%= t('merchant.bookings.statusColoursAria') %>">
      <% [
        statusStyles.confirmed,
        statusStyles.arrived,
        statusStyles.completed,
        statusStyles.cancelled,
        statusStyles.no_show,
      ].forEach(item => { %>
        <span class="badge rounded-pill" style="background:<%= item.bg %>;color:<%= item.color %>;padding:.45rem .7rem;">
          <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:<%= item.color %>;margin-right:.3rem;"></span><%= item.label %>
        </span>
      <% }) %>
    </div>

    <% if (bookingList.length) {
      const completedCount = bookingList.filter(item => item.status === 'completed').length;
      const cancelledCount = bookingList.filter(item => item.status === 'cancelled').length;
      const notCompletedCount = bookingList.length - completedCount - cancelledCount;
    %>
      <div class="booking-filter-bar" role="group" aria-label="<%= t('merchant.bookings.filterAria') %>">
        <span class="me-1" style="font-size:.8rem;font-weight:800;color:var(--ink);"><%= t('merchant.bookings.show') %></span>
        <button type="button" class="booking-filter-button is-active" data-booking-filter="all" aria-pressed="true">
          <%= t('merchant.bookings.filterAll') %> <span class="booking-filter-count"><%= bookingList.length %></span>
        </button>
        <button type="button" class="booking-filter-button" data-booking-filter="completed" aria-pressed="false">
          <%= t('bookings.completed') %> <span class="booking-filter-count"><%= completedCount %></span>
        </button>
        <button type="button" class="booking-filter-button" data-booking-filter="not-completed" aria-pressed="false">
          <%= t('merchant.bookings.filterNotCompleted') %> <span class="booking-filter-count"><%= notCompletedCount %></span>
        </button>
        <button type="button" class="booking-filter-button" data-booking-filter="cancelled" aria-pressed="false">
          <%= t('bookings.cancelled') %> <span class="booking-filter-count"><%= cancelledCount %></span>
        </button>
      </div>
    <% } %>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
        <i class="bi bi-check-circle me-2"></i><%= success %>
      </div>
    <% } %>

    <details class="card border-0 mb-4" style="box-shadow:var(--shadow-sm);border-radius:var(--r-xl);">
      <summary class="p-3" style="cursor:pointer;font-weight:800;color:var(--danger);">
        <i class="bi bi-exclamation-triangle me-2"></i><%= t('merchant.bookings.declareClosure') %>
      </summary>
      <form id="emergencyClosureForm" action="/merchant/emergency-closures" method="POST" class="p-4 pt-1" autocomplete="off">
        <p class="small text-muted"><%= t('merchant.bookings.closureWarning') %></p>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label fw-bold"><%= t('merchant.bookings.closureStarts') %></label><input id="closureStartsAt" class="form-control rounded-xl" type="datetime-local" name="starts_at" required></div>
          <div class="col-md-4"><label class="form-label fw-bold"><%= t('merchant.bookings.closureEnds') %></label><input id="closureEndsAt" class="form-control rounded-xl" type="datetime-local" name="ends_at" required></div>
          <div class="col-md-4">
            <label class="form-label fw-bold"><%= t('merchant.bookings.closureReason') %></label>
            <select id="closureReasonSuggestion" class="form-select rounded-xl mb-2" autocomplete="off">
              <option value=""><%= t('merchant.bookings.chooseSuggestion') %></option>
              <option value="<%= t('merchant.bookings.reasonBody.operational') %>"><%= t('merchant.bookings.reasonLabel.operational') %></option>
              <option value="<%= t('merchant.bookings.reasonBody.utilities') %>"><%= t('merchant.bookings.reasonLabel.utilities') %></option>
              <option value="<%= t('merchant.bookings.reasonBody.premises') %>"><%= t('merchant.bookings.reasonLabel.premises') %></option>
              <option value="<%= t('merchant.bookings.reasonBody.safety') %>"><%= t('merchant.bookings.reasonLabel.safety') %></option>
            </select>
            <label class="form-label fw-bold"><%= t('merchant.bookings.messageToCustomers') %></label>
            <textarea id="closureReason" class="form-control rounded-xl" name="reason" minlength="5" maxlength="500" required autocomplete="new-password" placeholder="<%= t('merchant.bookings.reasonPlaceholder') %>"></textarea>
          </div>
        </div>
        <button class="btn btn-danger btn-pill mt-3" type="submit"><%= t('merchant.bookings.confirmClosure') %></button>
      </form>
    </details>

    <% if (!bookingList.length) { %>
      <div class="card border-0 text-center py-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="icon-circle-lg mx-auto mb-3">
          <i class="bi bi-calendar2-x" style="font-size:2rem;color:var(--accent);"></i>
        </div>
        <h6 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;"><%= t('bookings.noBookingsTitle') %></h6>
        <p style="color:var(--muted);font-size:.875rem;margin:0 auto 1.25rem;max-width:420px;">
          <%= t('merchant.bookings.emptyBody') %>
        </p>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
          <a href="/merchant/qr" class="btn btn-primary btn-pill btn-sm"><%= t('merchant.bookings.getQr') %></a>
          <a href="/merchant/services" class="btn btn-outline-secondary btn-pill btn-sm"><%= t('merchant.insights.manageServices') %></a>
        </div>
      </div>
    <% } else { %>
      <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0 merchant-bookings-table" style="font-size:.8125rem;">
            <thead style="background:var(--accent-light);">
              <tr>
                <th><%= t('admin.dashboard.logs.colId') %></th>
                <th><%= t('admin.table.customer') %></th>
                <th><%= t('common.service') %></th>
                <th><%= t('common.staff') %></th>
                <th><%= t('admin.table.dateTime') %></th>
                <th><%= t('admin.table.source') %></th>
                <th><%= t('common.total') %></th>
                <th><%= t('admin.table.status') %></th>
                <th style="min-width:210px;"><%= t('admin.logs.colAction') %></th>
              </tr>
            </thead>
            <tbody>
              <% bookingList.forEach(booking => {
                const baseStatus = statusStyles[booking.status] || {
                  label: t('admin.bookingStatus.' + booking.status, {}, booking.status || t('bookings.booked')),
                  bg: 'var(--accent-light)',
                  color: 'var(--accent)',
                };
                const isFinalBookingStatus = ['cancelled', 'payment_failed', 'completed', 'no_show'].includes(booking.status);
                let status = baseStatus;
                if (!isFinalBookingStatus && booking.staff_change_status === 'pending') {
                  status = { label: t('merchant.bookings.awaitingReplacement'), bg: 'var(--warn-bg)', color: 'var(--warn)' };
                } else if (!isFinalBookingStatus && booking.staff_change_status === 'accepted') {
                  status = statusStyles.confirmed;
                } else if (!isFinalBookingStatus && booking.staff_change_status === 'reschedule_requested') {
                  status = { label: t('admin.bookingStatus.rescheduled'), bg: '#EFF6FF', color: '#2563EB' };
                }
                const arrivalAvailable = canMarkArrived(booking);
                const appointmentHasStarted = hasAppointmentStarted(booking);
                const appointmentHasEnded = hasAppointmentEnded(booking);
                const canMarkNoShow = ['confirmed', 'rescheduled'].includes(booking.status) && appointmentHasStarted;
                const source = bookingSource(booking.source);
                const availableReplacements = (typeof replacementStaff !== 'undefined' && replacementStaff[booking.booking_id]) || [];
              %>
                <tr id="booking-<%= booking.booking_id %>" class="merchant-booking-row" data-booking-status="<%= booking.status %>">
                  <td style="font-weight:600;color:var(--muted);font-family:var(--font-mono);">#<%= booking.booking_id %></td>
                  <td>
                    <p style="font-weight:700;margin-bottom:0;color:var(--ink);"><%= booking.customer_name %></p>
                    <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;"><%= booking.customer_phone || t('admin.customers.noPhone') %></p>
                  </td>
                  <td><%= booking.service_name %></td>
                  <td><%= booking.staff_name || t('merchant.bookings.unassigned') %></td>
                  <td>
                    <%= formatDate(booking.booking_date) %>
                    <br>
                    <span style="color:var(--muted);"><%= formatTime(booking.booking_time) %></span>
                  </td>
                  <td>
                    <span class="badge" style="background:var(--accent-light);color:var(--accent);">
                      <i class="bi <%= source.icon %> me-1"></i><%= source.label %>
                    </span>
                  </td>
                  <td style="font-weight:700;font-family:var(--font-mono);">
                    S$<%= Number(booking.total_amount || 0).toFixed(2) %>
                  </td>
                  <td>
                    <span class="badge rounded-pill" style="background:<%= status.bg %>;color:<%= status.color %>;">
                      <%= status.label %>
                    </span>
                    <% if (!isFinalBookingStatus && booking.staff_change_status === 'pending') { %>
                      <div style="color:var(--muted);font-size:.7rem;margin-top:.2rem;">
                        <%= t('merchant.bookings.proposed', { name: booking.proposed_staff_name || t('merchant.bookings.replacementStaff') }) %>
                      </div>
                    <% } %>
                  </td>
                  <td class="merchant-booking-actions">
                    <div class="merchant-booking-actions-inner">
                    <% if (booking.status === 'confirmed' || booking.status === 'rescheduled') { %>
                    <% if (arrivalAvailable) { %>
                      <form action="/merchant/bookings/<%= booking.booking_id %>/arrived" method="POST" class="d-inline">
                        <input type="hidden" name="returnTo" value="/merchant/bookings">
                        <button class="btn btn-sm btn-outline-secondary btn-pill" style="font-size:.72rem;padding:.2rem .6rem;">
                          <i class="bi bi-person-check me-1"></i><%= t('bookings.arrived') %>
                        </button>
                      </form>
                    <% } else { %>
                      <span style="color:var(--muted);font-size:.72rem;" title="<%= t('merchant.bookings.arrivalHint') %>">
                        <i class="bi bi-clock me-1"></i><%= t('merchant.bookings.awaitingAppointment') %>
                      </span>
                    <% } %>
                    <% if (canMarkNoShow) { %>
                      <form action="/merchant/bookings/<%= booking.booking_id %>/no-show" method="POST" class="d-inline"
                            onsubmit="return confirm('<%= t('merchant.bookings.noShowConfirm') %>');">
                        <button class="btn btn-sm btn-pill" style="font-size:.72rem;padding:.2rem .6rem;background:var(--warn-bg);color:var(--warn);border:1px solid rgba(217,119,6,.2);">
                          <i class="bi bi-person-x me-1"></i><%= t('bookings.noShow') %>
                        </button>
                      </form>
                    <% } %>
                    <% if (['confirmed', 'rescheduled'].includes(booking.status) && !appointmentHasStarted) { %>
                      <button type="button" class="btn btn-sm btn-outline-secondary btn-pill js-open-booking-modal" style="font-size:.75rem;" data-modal-id="bookingManageModal-<%= booking.booking_id %>">
                        <i class="bi bi-three-dots-vertical me-1"></i><%= t('merchant.bookings.manageBooking') %>
                      </button>
                      <div class="booking-manage-overlay" id="bookingManageModal-<%= booking.booking_id %>" role="dialog" aria-modal="true" aria-labelledby="bookingManageTitle-<%= booking.booking_id %>" aria-hidden="true">
                        <div class="booking-manage-dialog">
                          <div class="booking-manage-header">
                            <div>
                              <p class="section-label mb-1"><%= t('admin.reviews.bookingRef', { id: booking.booking_id }) %></p>
                              <h5 id="bookingManageTitle-<%= booking.booking_id %>" style="font-weight:800;color:var(--ink);margin:0;"><%= t('merchant.bookings.manageFor', { name: booking.customer_name }) %></h5>
                              <p style="color:var(--muted);font-size:.82rem;margin:.3rem 0 0;"><%= booking.service_name %> · <%= t('merchant.bookings.dateAtTime', { date: formatDate(booking.booking_date), time: formatTime(booking.booking_time) }) %></p>
                            </div>
                            <button type="button" class="booking-manage-close js-close-booking-modal" aria-label="<%= t('merchant.bookings.close') %>"><i class="bi bi-x-lg"></i></button>
                          </div>
                          <% if (booking.staff_change_status === 'pending') { %>
                          <div class="booking-manage-section">
                            <p class="booking-manage-label"><i class="bi bi-hourglass-split me-1"></i><%= t('merchant.bookings.proposalPending') %></p>
                            <div style="background:var(--warn-bg);color:var(--warn);border-radius:12px;padding:.8rem;font-size:.82rem;">
                              <%- t('merchant.bookings.proposedBody', { name: escapeHtml(booking.proposed_staff_name || t('merchant.bookings.replacementStaff')) }) %>
                              <% if (booking.staff_change_requested_at) { %>
                                <div class="mt-1" style="opacity:.8;"><%= t('merchant.bookings.sentAt', { time: new Date(booking.staff_change_requested_at).toLocaleString('en-SG', { dateStyle:'medium', timeStyle:'short' }) }) %></div>
                              <% } %>
                            </div>
                          </div>
                          <% } else if (availableReplacements.length) { %>
                          <div class="booking-manage-section">
                            <p class="booking-manage-label"><i class="bi bi-person-exclamation me-1"></i><%= t('merchant.bookings.staffUnavailable') %></p>
                            <p class="small text-muted"><%= t('merchant.bookings.proposeHint') %></p>
                            <form action="/merchant/bookings/<%= booking.booking_id %>/propose-replacement" method="POST">
                          <select name="proposed_staff_id" class="form-select form-select-sm mb-2" required>
                            <option value=""><%= t('merchant.bookings.chooseReplacement') %></option>
                            <% availableReplacements.forEach(member => { %><option value="<%= member.staff_id %>"><%= member.full_name %></option><% }) %>
                          </select>
                          <textarea name="reason" class="form-control form-control-sm mb-2" maxlength="500" required><%= t('merchant.bookings.defaultReplacementReason') %></textarea>
                              <button class="btn btn-primary btn-sm btn-pill w-100" type="submit"><%= t('merchant.bookings.sendOptions') %></button>
                            </form>
                          </div>
                          <% } %>
                          <div class="booking-manage-section">
                            <p class="booking-manage-label"><i class="bi bi-x-circle me-1"></i><%= t('merchant.bookings.cancelOther') %></p>
                            <p class="small text-muted"><%= t('merchant.bookings.cancelOtherHint') %></p>
                            <form action="/merchant/bookings/<%= booking.booking_id %>/cancel-other" method="POST" onsubmit="return confirm('<%= t('merchant.bookings.cancelConfirm') %>');">
                              <label class="form-label small fw-bold"><%= t('merchant.bookings.suggestedExplanation') %></label>
                              <select class="form-select form-select-sm mb-2 js-cancellation-suggestion">
                                <option value=""><%= t('merchant.bookings.chooseSuggestion') %></option>
                                <option value="<%= t('merchant.bookings.cancelBody.operational') %>"><%= t('merchant.bookings.cancelLabel.operational') %></option>
                                <option value="<%= t('merchant.bookings.cancelBody.conflict') %>"><%= t('merchant.bookings.cancelLabel.conflict') %></option>
                                <option value="<%= t('merchant.bookings.cancelBody.unavailable') %>"><%= t('merchant.bookings.cancelLabel.unavailable') %></option>
                                <option value="<%= t('merchant.bookings.cancelBody.unforeseen') %>"><%= t('merchant.bookings.cancelLabel.unforeseen') %></option>
                              </select>
                              <label class="form-label small fw-bold"><%= t('merchant.bookings.messageToCustomer') %></label>
                              <textarea name="reason" class="form-control form-control-sm mb-2 js-cancellation-reason" minlength="5" maxlength="500" required placeholder="<%= t('merchant.bookings.cancelPlaceholder') %>"></textarea>
                              <button class="btn btn-outline-danger btn-sm btn-pill w-100" type="submit"><%= t('merchant.bookings.cancelRefund') %></button>
                            </form>
                          </div>
                        </div>
                      </div>
                    <% } %>
                    <% } else if (booking.status === 'arrived' && appointmentHasEnded) { %>
                      <form action="/merchant/bookings/<%= booking.booking_id %>/complete" method="POST" class="d-inline">
                        <input type="hidden" name="returnTo" value="/merchant/bookings">
                        <button class="btn btn-sm btn-pill" style="font-size:.72rem;padding:.2rem .6rem;background:var(--success);color:#fff;border:none;">
                          <i class="bi bi-check2-all me-1"></i><%= t('merchant.bookings.complete') %>
                        </button>
                      </form>
                    <% } else if (booking.status === 'arrived') { %>
                      <span style="color:var(--muted);font-size:.72rem;">
                        <i class="bi bi-clock me-1"></i><%= t('merchant.bookings.awaitingEnd') %>
                      </span>
                    <% } else { %>
                      <span style="color:var(--muted);font-size:.75rem;">-</span>
                    <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div id="booking-filter-empty" class="text-center p-5" hidden>
          <i class="bi bi-funnel" style="font-size:1.5rem;color:var(--muted);"></i>
          <p class="mt-2 mb-0" style="font-weight:700;color:var(--ink);"><%= t('merchant.bookings.noFilterMatch') %></p>
        </div>
      </div>
    <% } %>
  </div>
</main>

<script>
  (() => {
    const buttons = [...document.querySelectorAll('[data-booking-filter]')];
    const rows = [...document.querySelectorAll('.merchant-booking-row[data-booking-status]')];
    const emptyState = document.getElementById('booking-filter-empty');
    if (!buttons.length || !rows.length) return;

    const matchesFilter = (status, filter) => {
      if (filter === 'all') return true;
      if (filter === 'completed') return status === 'completed';
      if (filter === 'cancelled') return status === 'cancelled';
      return status !== 'completed' && status !== 'cancelled';
    };

    buttons.forEach(button => {
      button.addEventListener('click', () => {
        const filter = button.dataset.bookingFilter;
        let visibleCount = 0;
        buttons.forEach(item => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        rows.forEach(row => {
          const visible = matchesFilter(row.dataset.bookingStatus, filter);
          row.hidden = !visible;
          if (visible) visibleCount += 1;
        });
        if (emptyState) emptyState.hidden = visibleCount !== 0;
      });
    });
  })();

  (() => {
    const closeModal = modal => {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };
    document.querySelectorAll('.js-open-booking-modal').forEach(button => {
      button.addEventListener('click', () => {
        const modal = document.getElementById(button.dataset.modalId);
        if (!modal) return;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        modal.querySelector('.js-close-booking-modal')?.focus();
      });
    });
    document.querySelectorAll('.booking-manage-overlay').forEach(modal => {
      modal.querySelector('.js-close-booking-modal')?.addEventListener('click', () => closeModal(modal));
      modal.addEventListener('click', event => { if (event.target === modal) closeModal(modal); });
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeModal(document.querySelector('.booking-manage-overlay.is-open'));
    });
    document.querySelectorAll('.js-cancellation-suggestion').forEach(select => {
      select.addEventListener('change', () => {
        const textarea = select.closest('form')?.querySelector('.js-cancellation-reason');
        if (textarea && select.value) {
          textarea.value = select.value;
          textarea.focus();
        }
      });
    });
  })();

  (() => {
    const form = document.getElementById('emergencyClosureForm');
    const startsAt = document.getElementById('closureStartsAt');
    const endsAt = document.getElementById('closureEndsAt');
    const reasonSuggestion = document.getElementById('closureReasonSuggestion');
    const reason = document.getElementById('closureReason');
    if (!form || !startsAt || !endsAt) return;

    const localDateTime = date => {
      const offset = date.getTimezoneOffset() * 60000;
      return new Date(date.getTime() - offset).toISOString().slice(0, 16);
    };
    const updateMinimums = () => {
      const now = localDateTime(new Date());
      startsAt.min = now;
      endsAt.min = startsAt.value && startsAt.value > now ? startsAt.value : now;
      if (endsAt.value && endsAt.value <= endsAt.min) endsAt.value = '';
    };
    startsAt.addEventListener('change', updateMinimums);
    startsAt.addEventListener('input', () => startsAt.setCustomValidity(''));
    endsAt.addEventListener('input', () => endsAt.setCustomValidity(''));
    reasonSuggestion?.addEventListener('change', () => {
      if (reasonSuggestion.value && reason) {
        reason.value = reasonSuggestion.value;
        reason.focus();
      }
    });
    updateMinimums();

    form.addEventListener('submit', event => {
      updateMinimums();
      const start = new Date(startsAt.value);
      const end = new Date(endsAt.value);
      if (!startsAt.value || start < new Date()) {
        event.preventDefault();
        startsAt.setCustomValidity('Closure start must be in the future.');
        startsAt.reportValidity();
        return;
      }
      startsAt.setCustomValidity('');
      if (!endsAt.value || end <= start) {
        event.preventDefault();
        endsAt.setCustomValidity('Closure end must be after the start time.');
        endsAt.reportValidity();
        return;
      }
      endsAt.setCustomValidity('');
      if (!confirm('This will block the closure period, cancel every affected booking, and initiate 100% refunds. Continue?')) event.preventDefault();
    });
  })();
</script>

<%- include('../partials/footer') %>
