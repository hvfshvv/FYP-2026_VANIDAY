<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<style>
  .merchant-booking-actions { min-width: 190px; }
  .merchant-booking-actions-inner { display:flex;flex-direction:column;align-items:flex-start;gap:.45rem; }
  .booking-manage-overlay { position:fixed;inset:0;z-index:1080;display:none;align-items:center;justify-content:center;padding:1rem;background:rgba(15,23,42,.42); }
  .booking-manage-overlay.is-open { display:flex; }
  .booking-manage-dialog { width:min(100%,560px);max-height:calc(100vh - 2rem);overflow-y:auto;padding:1.5rem;border:1px solid var(--border);border-radius:var(--r-xl);background:#fff;box-shadow:0 24px 70px rgba(15,23,42,.24); }
  .booking-manage-header { display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;margin-bottom:1rem; }
  .booking-manage-close { width:36px;height:36px;border:0;border-radius:999px;background:var(--canvas);color:var(--muted);display:inline-flex;align-items:center;justify-content:center; }
  .booking-manage-section + .booking-manage-section { border-top:1px solid var(--border);margin-top:.8rem;padding-top:.8rem; }
  .booking-manage-label { color:var(--ink);font-size:.9rem;font-weight:800;margin-bottom:.45rem; }
</style>

<%
  const bookingList = Array.isArray(bookings) ? bookings : [];
  const statusStyles = {
    pending_payment: { label: 'Pending Payment', bg: 'var(--warn-bg)', color: 'var(--warn)' },
    confirmed:       { label: 'Confirmed', bg: '#EFF6FF', color: '#2563EB' },
    rescheduled:     { label: 'Rescheduled', bg: '#EFF6FF', color: '#2563EB' },
    arrived:         { label: 'Arrived', bg: '#F5F3FF', color: '#7C3AED' },
    completed:       { label: 'Completed', bg: 'var(--success-bg)', color: 'var(--success)' },
    cancelled:       { label: 'Cancelled', bg: 'var(--danger-bg)', color: 'var(--danger)' },
    payment_failed:  { label: 'Payment Failed', bg: 'var(--danger-bg)', color: 'var(--danger)' },
    no_show:         { label: 'No Show', bg: 'var(--warn-bg)', color: 'var(--warn)' },
  };

  function formatDate(value) {
    return new Date(value).toLocaleDateString('en-SG', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  function formatTime(value) {
    return String(value || '').slice(0, 5);
  }

  function bookingSource(value) {
    const source = String(value || '').toLowerCase();
    if (source === 'qr' || source === 'qr_scan') {
      return { label: 'QR Booking', icon: 'bi-qr-code' };
    }
    if (source === 'whatsapp') {
      return { label: 'WhatsApp', icon: 'bi-whatsapp' };
    }
    return { label: 'Web', icon: 'bi-globe2' };
  }

  function appointmentDateTime(booking, time) {
    const date = booking.booking_date instanceof Date
      ? [
          booking.booking_date.getFullYear(),
          String(booking.booking_date.getMonth() + 1).padStart(2, '0'),
          String(booking.booking_date.getDate()).padStart(2, '0'),
        ].join('-')
      : String(booking.booking_date || '').slice(0, 10);
    return new Date(`${date}T${formatTime(time)}:00`);
  }

  function canMarkArrived(booking) {
    const appointmentStart = appointmentDateTime(booking, booking.booking_time);
    if (Number.isNaN(appointmentStart.getTime())) return false;
    return new Date() >= new Date(appointmentStart.getTime() - 15 * 60 * 1000);
  }

  function hasAppointmentStarted(booking) {
    const appointmentStart = appointmentDateTime(booking, booking.booking_time);
    return !Number.isNaN(appointmentStart.getTime()) && appointmentStart <= new Date();
  }

  function hasAppointmentEnded(booking) {
    const appointmentEnd = appointmentDateTime(booking, booking.booking_end_time);
    return !Number.isNaN(appointmentEnd.getTime()) && appointmentEnd <= new Date();
  }
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:1100px;">
    <a href="/merchant/dashboard" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
      <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <p class="section-label mb-2">Bookings</p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">All Merchant Bookings</h2>
        <p style="color:var(--muted);margin:0;">View and manage every booking made for your merchant account.</p>
      </div>
      <a href="/merchant/qr" class="btn btn-primary btn-pill">
        <i class="bi bi-qr-code me-1"></i>My QR Code
      </a>
    </div>

    <div id="booking-list" class="d-flex flex-wrap gap-2 mb-3" aria-label="Booking status colours">
      <% [
        statusStyles.confirmed,
        statusStyles.arrived,
        statusStyles.completed,
        statusStyles.cancelled,
        statusStyles.no_show,
      ].forEach(item => { %>
        <span class="badge rounded-pill" style="background:<%= item.bg %>;color:<%= item.color %>;padding:.45rem .7rem;">
          <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:<%= item.color %>;margin-right:.3rem;"></span><%= item.label %>
        </span>
      <% }) %>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
        <i class="bi bi-check-circle me-2"></i><%= success %>
      </div>
    <% } %>

    <details class="card border-0 mb-4" style="box-shadow:var(--shadow-sm);border-radius:var(--r-xl);">
      <summary class="p-3" style="cursor:pointer;font-weight:800;color:var(--danger);">
        <i class="bi bi-exclamation-triangle me-2"></i>Declare Emergency Closure
      </summary>
      <form id="emergencyClosureForm" action="/merchant/emergency-closures" method="POST" class="p-4 pt-1" autocomplete="off">
        <p class="small text-muted">All confirmed bookings overlapping this period will be cancelled and customers will be notified about their full refund.</p>
        <div class="row g-3">
          <div class="col-md-4"><label class="form-label fw-bold">Closure starts</label><input id="closureStartsAt" class="form-control rounded-xl" type="datetime-local" name="starts_at" required></div>
          <div class="col-md-4"><label class="form-label fw-bold">Closure ends</label><input id="closureEndsAt" class="form-control rounded-xl" type="datetime-local" name="ends_at" required></div>
          <div class="col-md-4">
            <label class="form-label fw-bold">Closure reason</label>
            <select id="closureReasonSuggestion" class="form-select rounded-xl mb-2" autocomplete="off">
              <option value="">Choose a suggestion or write your own</option>
              <option value="We need to close temporarily due to an unforeseen operational emergency. We sincerely apologise for the inconvenience caused.">Unforeseen operational emergency</option>
              <option value="We need to close temporarily due to an unexpected utilities disruption. We sincerely apologise for the inconvenience caused.">Utilities disruption</option>
              <option value="We need to close temporarily because the premises are currently inaccessible. We sincerely apologise for the inconvenience caused.">Premises inaccessible</option>
              <option value="We need to close temporarily due to an urgent health and safety concern. We sincerely apologise for the inconvenience caused.">Health and safety concern</option>
            </select>
            <label class="form-label fw-bold">Message sent to customers</label>
            <textarea id="closureReason" class="form-control rounded-xl" name="reason" minlength="5" maxlength="500" required autocomplete="new-password" placeholder="Explain why the business must close during this period"></textarea>
          </div>
        </div>
        <button class="btn btn-danger btn-pill mt-3" type="submit">Confirm closure and refund customers</button>
      </form>
    </details>

    <% if (!bookingList.length) { %>
      <div class="card border-0 text-center py-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="icon-circle-lg mx-auto mb-3">
          <i class="bi bi-calendar2-x" style="font-size:2rem;color:var(--accent);"></i>
        </div>
        <h6 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">No bookings yet</h6>
        <p style="color:var(--muted);font-size:.875rem;margin:0 auto 1.25rem;max-width:420px;">
          Bookings from customers will appear here once they reserve one of your services.
        </p>
        <div class="d-flex gap-2 justify-content-center flex-wrap">
          <a href="/merchant/qr" class="btn btn-primary btn-pill btn-sm">Get My QR Code</a>
          <a href="/merchant/services" class="btn btn-outline-secondary btn-pill btn-sm">Manage Services</a>
        </div>
      </div>
    <% } else { %>
      <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
            <thead style="background:var(--accent-light);">
              <tr>
                <th>ID</th>
                <th>Customer</th>
                <th>Service</th>
                <th>Date &amp; Time</th>
                <th>Source</th>
                <th>Total</th>
                <th>Status</th>
                <th style="min-width:210px;">Action</th>
              </tr>
            </thead>
            <tbody>
              <% bookingList.forEach(booking => {
                const status = statusStyles[booking.status] || {
                  label: booking.status || 'Booked',
                  bg: 'var(--accent-light)',
                  color: 'var(--accent)',
                };
                const arrivalAvailable = canMarkArrived(booking);
                const appointmentHasStarted = hasAppointmentStarted(booking);
                const appointmentHasEnded = hasAppointmentEnded(booking);
                const canMarkNoShow = ['confirmed', 'rescheduled'].includes(booking.status) && appointmentHasStarted;
                const source = bookingSource(booking.source);
                const availableReplacements = (typeof replacementStaff !== 'undefined' && replacementStaff[booking.booking_id]) || [];
              %>
                <tr>
                  <td style="font-weight:600;color:var(--muted);font-family:var(--font-mono);">#<%= booking.booking_id %></td>
                  <td>
                    <p style="font-weight:700;margin-bottom:0;color:var(--ink);"><%= booking.customer_name %></p>
                    <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;"><%= booking.customer_phone || 'No phone' %></p>
                  </td>
                  <td><%= booking.service_name %></td>
                  <td>
                    <%= formatDate(booking.booking_date) %>
                    <br>
                    <span style="color:var(--muted);"><%= formatTime(booking.booking_time) %></span>
                  </td>
                  <td>
                    <span class="badge" style="background:var(--accent-light);color:var(--accent);">
                      <i class="bi <%= source.icon %> me-1"></i><%= source.label %>
                    </span>
                  </td>
                  <td style="font-weight:700;font-family:var(--font-mono);">
                    S$<%= Number(booking.total_amount || 0).toFixed(2) %>
                  </td>
                  <td>
                    <span class="badge rounded-pill" style="background:<%= status.bg %>;color:<%= status.color %>;">
                      <%= status.label %>
                    </span>
                  </td>
                  <td class="merchant-booking-actions">
                    <div class="merchant-booking-actions-inner">
                    <% if (booking.status === 'confirmed' || booking.status === 'rescheduled') { %>
                    <% if (arrivalAvailable) { %>
                      <form action="/merchant/bookings/<%= booking.booking_id %>/arrived" method="POST" class="d-inline">
                        <input type="hidden" name="returnTo" value="/merchant/bookings">
                        <button class="btn btn-sm btn-outline-secondary btn-pill" style="font-size:.72rem;padding:.2rem .6rem;">
                          <i class="bi bi-person-check me-1"></i>Arrived
                        </button>
                      </form>
                    <% } else { %>
                      <span style="color:var(--muted);font-size:.72rem;" title="Available 15 minutes before the appointment">
                        <i class="bi bi-clock me-1"></i>Awaiting appointment
                      </span>
                    <% } %>
                    <% if (canMarkNoShow) { %>
                      <form action="/merchant/bookings/<%= booking.booking_id %>/no-show" method="POST" class="d-inline"
                            onsubmit="return confirm('Mark this appointment as a no-show?');">
                        <button class="btn btn-sm btn-pill" style="font-size:.72rem;padding:.2rem .6rem;background:var(--warn-bg);color:var(--warn);border:1px solid rgba(217,119,6,.2);">
                          <i class="bi bi-person-x me-1"></i>No Show
                        </button>
                      </form>
                    <% } %>
                    <% if (['confirmed', 'rescheduled'].includes(booking.status) && !appointmentHasStarted) { %>
                      <button type="button" class="btn btn-sm btn-outline-secondary btn-pill js-open-booking-modal" style="font-size:.75rem;" data-modal-id="bookingManageModal-<%= booking.booking_id %>">
                        <i class="bi bi-three-dots-vertical me-1"></i>Manage booking
                      </button>
                      <div class="booking-manage-overlay" id="bookingManageModal-<%= booking.booking_id %>" role="dialog" aria-modal="true" aria-labelledby="bookingManageTitle-<%= booking.booking_id %>" aria-hidden="true">
                        <div class="booking-manage-dialog">
                          <div class="booking-manage-header">
                            <div>
                              <p class="section-label mb-1">Booking #<%= booking.booking_id %></p>
                              <h5 id="bookingManageTitle-<%= booking.booking_id %>" style="font-weight:800;color:var(--ink);margin:0;">Manage <%= booking.customer_name %>'s booking</h5>
                              <p style="color:var(--muted);font-size:.82rem;margin:.3rem 0 0;"><%= booking.service_name %> · <%= formatDate(booking.booking_date) %> at <%= formatTime(booking.booking_time) %></p>
                            </div>
                            <button type="button" class="booking-manage-close js-close-booking-modal" aria-label="Close"><i class="bi bi-x-lg"></i></button>
                          </div>
                          <% if (availableReplacements.length) { %>
                          <div class="booking-manage-section">
                            <p class="booking-manage-label"><i class="bi bi-person-exclamation me-1"></i>Staff unavailable</p>
                            <p class="small text-muted">Propose an available replacement. The customer can accept, reschedule, or cancel for a full refund.</p>
                            <form action="/merchant/bookings/<%= booking.booking_id %>/propose-replacement" method="POST">
                          <select name="proposed_staff_id" class="form-select form-select-sm mb-2" required>
                            <option value="">Choose replacement staff</option>
                            <% availableReplacements.forEach(member => { %><option value="<%= member.staff_id %>"><%= member.full_name %></option><% }) %>
                          </select>
                          <textarea name="reason" class="form-control form-control-sm mb-2" maxlength="500" required>Assigned staff member is unexpectedly unavailable.</textarea>
                              <button class="btn btn-primary btn-sm btn-pill w-100" type="submit">Send customer options</button>
                            </form>
                          </div>
                          <% } %>
                          <div class="booking-manage-section">
                            <p class="booking-manage-label"><i class="bi bi-x-circle me-1"></i>Cancel for another reason</p>
                            <p class="small text-muted">This cancels the appointment, blocks its slot, and initiates a 100% refund.</p>
                            <form action="/merchant/bookings/<%= booking.booking_id %>/cancel-other" method="POST" onsubmit="return confirm('Cancel this booking, block its slot, and initiate a 100% refund?');">
                              <label class="form-label small fw-bold">Suggested explanation</label>
                              <select class="form-select form-select-sm mb-2 js-cancellation-suggestion">
                                <option value="">Choose a suggestion or write your own</option>
                                <option value="We are unable to fulfil this appointment due to an unexpected operational issue. We sincerely apologise for the inconvenience caused.">Unexpected operational issue</option>
                                <option value="We need to cancel this appointment due to an unavoidable scheduling conflict. We sincerely apologise for the inconvenience caused.">Unavoidable scheduling conflict</option>
                                <option value="The selected service is temporarily unavailable. We sincerely apologise for the inconvenience caused.">Service temporarily unavailable</option>
                                <option value="Due to unforeseen circumstances, we are unable to proceed with this appointment. We sincerely apologise for the inconvenience caused.">Unforeseen circumstances</option>
                              </select>
                              <label class="form-label small fw-bold">Message sent to customer</label>
                              <textarea name="reason" class="form-control form-control-sm mb-2 js-cancellation-reason" minlength="5" maxlength="500" required placeholder="Explain the cancellation to the customer"></textarea>
                              <button class="btn btn-outline-danger btn-sm btn-pill w-100" type="submit">Cancel and refund 100%</button>
                            </form>
                          </div>
                        </div>
                      </div>
                    <% } %>
                    <% } else if (booking.status === 'arrived' && appointmentHasEnded) { %>
                      <form action="/merchant/bookings/<%= booking.booking_id %>/complete" method="POST" class="d-inline">
                        <input type="hidden" name="returnTo" value="/merchant/bookings">
                        <button class="btn btn-sm btn-pill" style="font-size:.72rem;padding:.2rem .6rem;background:var(--success);color:#fff;border:none;">
                          <i class="bi bi-check2-all me-1"></i>Complete
                        </button>
                      </form>
                    <% } else if (booking.status === 'arrived') { %>
                      <span style="color:var(--muted);font-size:.72rem;">
                        <i class="bi bi-clock me-1"></i>Awaiting appointment end
                      </span>
                    <% } else { %>
                      <span style="color:var(--muted);font-size:.75rem;">-</span>
                    <% } %>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</main>

<script>
  (() => {
    const closeModal = modal => {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };
    document.querySelectorAll('.js-open-booking-modal').forEach(button => {
      button.addEventListener('click', () => {
        const modal = document.getElementById(button.dataset.modalId);
        if (!modal) return;
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        modal.querySelector('.js-close-booking-modal')?.focus();
      });
    });
    document.querySelectorAll('.booking-manage-overlay').forEach(modal => {
      modal.querySelector('.js-close-booking-modal')?.addEventListener('click', () => closeModal(modal));
      modal.addEventListener('click', event => { if (event.target === modal) closeModal(modal); });
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeModal(document.querySelector('.booking-manage-overlay.is-open'));
    });
    document.querySelectorAll('.js-cancellation-suggestion').forEach(select => {
      select.addEventListener('change', () => {
        const textarea = select.closest('form')?.querySelector('.js-cancellation-reason');
        if (textarea && select.value) {
          textarea.value = select.value;
          textarea.focus();
        }
      });
    });
  })();

  (() => {
    const form = document.getElementById('emergencyClosureForm');
    const startsAt = document.getElementById('closureStartsAt');
    const endsAt = document.getElementById('closureEndsAt');
    const reasonSuggestion = document.getElementById('closureReasonSuggestion');
    const reason = document.getElementById('closureReason');
    if (!form || !startsAt || !endsAt) return;

    const localDateTime = date => {
      const offset = date.getTimezoneOffset() * 60000;
      return new Date(date.getTime() - offset).toISOString().slice(0, 16);
    };
    const updateMinimums = () => {
      const now = localDateTime(new Date());
      startsAt.min = now;
      endsAt.min = startsAt.value && startsAt.value > now ? startsAt.value : now;
      if (endsAt.value && endsAt.value <= endsAt.min) endsAt.value = '';
    };
    startsAt.addEventListener('change', updateMinimums);
    startsAt.addEventListener('input', () => startsAt.setCustomValidity(''));
    endsAt.addEventListener('input', () => endsAt.setCustomValidity(''));
    reasonSuggestion?.addEventListener('change', () => {
      if (reasonSuggestion.value && reason) {
        reason.value = reasonSuggestion.value;
        reason.focus();
      }
    });
    updateMinimums();

    form.addEventListener('submit', event => {
      updateMinimums();
      const start = new Date(startsAt.value);
      const end = new Date(endsAt.value);
      if (!startsAt.value || start < new Date()) {
        event.preventDefault();
        startsAt.setCustomValidity('Closure start must be in the future.');
        startsAt.reportValidity();
        return;
      }
      startsAt.setCustomValidity('');
      if (!endsAt.value || end <= start) {
        event.preventDefault();
        endsAt.setCustomValidity('Closure end must be after the start time.');
        endsAt.reportValidity();
        return;
      }
      endsAt.setCustomValidity('');
      if (!confirm('This will block the closure period, cancel every affected booking, and initiate 100% refunds. Continue?')) event.preventDefault();
    });
  })();
</script>

<%- include('../partials/footer') %>
