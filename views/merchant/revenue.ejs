<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div class="container py-5">
  <a href="/merchant/dashboard?month=<%= selectedPeriod %>" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
    <i class="bi bi-arrow-left me-1"></i>Dashboard
  </a>
  <div class="d-flex justify-content-between align-items-end gap-3 mb-4 flex-wrap">
    <div class="d-flex align-items-center gap-3">
      <div class="icon-circle flex-shrink-0" style="background:var(--accent-light);width:40px;height:40px;">
        <i class="bi bi-graph-up" style="color:var(--accent);"></i>
      </div>
      <div>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:0;">Revenue Report</h2>
        <p style="color:var(--muted);margin-bottom:0;font-size:.875rem;">Showing successful payments for <strong><%= periodLabel %></strong>.</p>
      </div>
    </div>
    <form action="/merchant/revenue" method="GET" class="d-flex gap-2 align-items-center">
      <label for="revenueMonth" style="font-size:.75rem;font-weight:700;color:var(--muted);">View month</label>
      <input id="revenueMonth" type="month" name="month" value="<%= selectedPeriod %>" max="<%= currentPeriod %>"
             class="form-control form-control-sm" style="width:155px;border-radius:999px;" onchange="this.form.submit()">
    </form>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;"><%= periodLabel %> Revenue</p>
        <p class="stat-value" style="color:var(--accent);">S$<%= Number(summary.month_revenue || 0).toFixed(2) %></p>
        <p style="color:var(--ghost);font-size:.72rem;margin-bottom:0;">Successful customer payments</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;">Successful Payments</p>
        <p class="stat-value" style="color:var(--success);"><%= Number(summary.month_successful_payments || 0) %></p>
        <p style="color:var(--ghost);font-size:.72rem;margin-bottom:0;">Paid bookings in <%= periodLabel %></p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;">Your Earnings</p>
        <p class="stat-value" style="color:var(--success);">S$<%= Number(summary.month_merchant_earnings || 0).toFixed(2) %></p>
        <p style="color:var(--ghost);font-size:.72rem;margin-bottom:0;">From paid bookings in <%= periodLabel %></p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;">Avg. Order Value</p>
        <p class="stat-value" style="color:var(--ink);">S$<%= Number(summary.month_avg_order_value || 0).toFixed(2) %></p>
        <p style="color:var(--ghost);font-size:.72rem;margin-bottom:0;">Per booking</p>
      </div>
    </div>
  </div>

  <!-- Monthly Breakdown -->
  <% if (monthly.length > 0) { %>
  <div class="card border-0 p-4 mb-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <h6 style="font-weight:700;color:var(--ink);margin-bottom:1rem;">
      <i class="bi bi-calendar3 me-2" style="color:var(--accent);"></i>Monthly Revenue (Last 6 Months)
    </h6>
    <div class="table-responsive">
      <table class="table align-middle mb-0" style="font-size:.875rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th>Month</th>
            <th>Bookings</th>
            <th>Revenue</th>
            <th>Your Earnings</th>
          </tr>
        </thead>
        <tbody>
          <% monthly.forEach(m => { %>
          <tr style="<%= m.month === selectedPeriod ? 'background:var(--accent-light);' : '' %>">
            <td style="font-weight:600;"><%= m.month %></td>
            <td><%= m.bookings %></td>
            <td style="font-family:var(--font-mono);">S$<%= Number(m.revenue || 0).toFixed(2) %></td>
            <td style="font-weight:700;color:var(--success);font-family:var(--font-mono);">S$<%= Number(m.merchant_earnings || 0).toFixed(2) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <!-- Transaction History -->
  <h5 style="font-weight:700;color:var(--ink);margin-bottom:1rem;"><%= periodLabel %> Transaction History</h5>
  <% if (transactions.length === 0) { %>
  <div class="card border-0 text-center py-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="icon-circle-lg mx-auto mb-3">
      <i class="bi bi-receipt" style="font-size:2rem;color:var(--accent);"></i>
    </div>
    <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;">No transactions yet</h6>
    <p style="color:var(--muted);font-size:.875rem;">Complete bookings will appear here.</p>
  </div>
  <% } else { %>
  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Service</th>
            <th>Date</th>
            <th>Source</th>
            <th>Amount</th>
            <th>Your Earnings</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.forEach(t => { %>
          <tr>
            <td style="color:var(--muted);font-weight:600;font-family:var(--font-mono);">#<%= t.booking_id %></td>
            <td>
              <p style="font-weight:600;margin-bottom:0;"><%= t.customer_name %></p>
              <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;"><%= t.customer_email %></p>
            </td>
            <td>
              <p style="margin-bottom:0;"><%= t.service_name %></p>
              <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;"><%= t.duration_mins %> min</p>
            </td>
            <td>
              <%= new Date(t.booking_date).toLocaleDateString('en-SG',{day:'numeric',month:'short',year:'numeric'}) %>
              <br/><span style="color:var(--muted);"><%= String(t.booking_time).slice(0,5) %></span>
            </td>
            <td>
              <% if (t.source === 'qr' || t.source === 'qr_scan') { %>
              <span class="badge" style="background:var(--accent-light);color:var(--accent);">
                <i class="bi bi-qr-code me-1"></i>QR
              </span>
              <% } else { %>
              <span class="badge bg-secondary"><%= t.source %></span>
              <% } %>
            </td>
            <td style="font-family:var(--font-mono);font-weight:600;"><%= t.amount ? 'S$' + Number(t.amount).toFixed(2) : '—' %></td>
            <td style="font-weight:700;color:var(--success);font-family:var(--font-mono);"><%= t.merchant_earnings ? 'S$' + Number(t.merchant_earnings).toFixed(2) : '—' %></td>
            <td>
              <span class="badge" style="background:<%= t.payment_status==='paid'?'var(--success-bg)':t.payment_status==='pending'?'var(--warn-bg)':'var(--accent-light)' %>;color:<%= t.payment_status==='paid'?'var(--success)':t.payment_status==='pending'?'var(--warn)':'var(--accent)' %>;">
                <%= t.payment_status ? t.payment_status.charAt(0).toUpperCase() + t.payment_status.slice(1) : 'Unpaid' %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
