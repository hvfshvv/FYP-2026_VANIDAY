<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<style>
  .monthly-revenue-scroll {
    max-height: 390px;
    overflow: auto;
  }
  .monthly-revenue-scroll thead th {
    position: sticky;
    top: 0;
    z-index: 1;
  }
  .monthly-row {
    cursor: pointer;
    transition: background .15s ease, transform .15s ease;
  }
  .monthly-row:hover {
    background: var(--accent-light);
  }
  .monthly-row.selected {
    background: var(--accent-light);
    box-shadow: inset 4px 0 0 var(--accent);
  }
  .monthly-row.selected td {
    background: var(--accent-light);
  }
  .monthly-row.selected td:first-child {
    color: var(--accent);
  }
</style>

<div class="container py-5">
  <%
    const payout = payoutOverview || { eligibleBookings: [], eligibleAmount: 0, eligibleGross: 0, eligibleCommission: 0, payouts: [] };
    const stripeReady = stripeAccount && stripeAccount.stripe_account_id && Number(stripeAccount.stripe_account_details_submitted || 0) === 1;
    const money = value => 'S$' + Number(value || 0).toFixed(2);
    const dateTime = value => value ? new Date(value).toLocaleString('en-SG', { day:'numeric', month:'short', year:'numeric', hour:'2-digit', minute:'2-digit' }) : '-';
    const gatewayFees = row => Number(row.processor_fee_amount || 0) + Number(row.dispute_fee_amount || 0);
    const paymentStatusLabel = status => status ? status.charAt(0).toUpperCase() + status.slice(1) : 'Unpaid';
    const paymentStatusStyle = status => {
      if (status === 'paid') return 'background:var(--success-bg);color:var(--success);';
      if (status === 'pending') return 'background:var(--warn-bg);color:var(--warn);';
      return 'background:var(--accent-light);color:var(--accent);';
    };
    const monthFees = Number(summary.month_processor_fees || 0) + Number(summary.month_dispute_fees || 0);
  %>
  <a href="/merchant/dashboard?month=<%= selectedPeriod %>" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
    <i class="bi bi-arrow-left me-1"></i>Dashboard
  </a>
  <div class="d-flex justify-content-between align-items-end gap-3 mb-4 flex-wrap">
    <div class="d-flex align-items-center gap-3">
      <div class="icon-circle flex-shrink-0" style="background:var(--accent-light);width:40px;height:40px;">
        <i class="bi bi-graph-up" style="color:var(--accent);"></i>
      </div>
      <div>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:0;">Revenue Summary</h2>
        <p style="color:var(--muted);margin-bottom:0;font-size:.875rem;">This month summary for <strong><%= periodLabel %></strong>. Payout-ready bookings are shown separately below.</p>
      </div>
    </div>
    <form action="/merchant/revenue" method="GET" class="d-flex gap-2 align-items-center">
      <label for="revenueMonth" style="font-size:.75rem;font-weight:700;color:var(--muted);">View month</label>
      <input id="revenueMonth" type="month" name="month" value="<%= selectedPeriod %>" max="<%= currentPeriod %>"
             class="form-control form-control-sm" style="width:155px;border-radius:999px;" onchange="this.form.submit()">
    </form>
  </div>

  <% if (success) { %>
    <div class="alert alert-success mb-4"><%= success %></div>
  <% } %>
  <% if (error) { %>
    <div class="alert alert-danger mb-4"><%= error %></div>
  <% } %>

  <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-3">
    <div>
      <p class="section-label mb-1">Selected Month</p>
      <h5 style="font-weight:800;color:var(--ink);margin-bottom:0;"><%= periodLabel %> Paid Bookings</h5>
    </div>
  </div>

  <!-- Summary Cards -->
  <div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;"><%= periodLabel %> Gross Paid</p>
        <p class="stat-value" style="color:var(--accent);">S$<%= Number(summary.month_revenue || 0).toFixed(2) %></p>
        <p style="color:var(--ghost);font-size:.72rem;margin-bottom:0;">Customer payments received</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;"><%= periodLabel %> Uniday Fee</p>
        <p class="stat-value" style="color:var(--accent);">S$<%= Number(summary.month_platform_commission || 0).toFixed(2) %></p>
        <p style="color:var(--ghost);font-size:.72rem;margin-bottom:0;">10% platform fee</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;"><%= periodLabel %> Earnings</p>
        <p class="stat-value" style="color:var(--success);">S$<%= Number(summary.month_merchant_earnings || 0).toFixed(2) %></p>
        <p style="color:var(--ghost);font-size:.72rem;margin-bottom:0;">90% minus gateway/dispute fees</p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;"><%= periodLabel %> Gateway Fees</p>
        <p class="stat-value" style="color:var(--ink);">S$<%= monthFees.toFixed(2) %></p>
        <p style="color:var(--ghost);font-size:.72rem;margin-bottom:0;"><%= Number(summary.month_successful_payments || 0) %> paid bookings · avg <%= money(summary.month_avg_order_value) %></p>
      </div>
    </div>
  </div>

  <div class="card border-0 p-4 mb-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="rounded-xl p-4 mb-4" style="background:var(--canvas);border:1px solid var(--border);">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <p class="section-label mb-1">Payout Account</p>
          <h6 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">Stripe Connect Sandbox</h6>
          <p style="color:var(--muted);font-size:.84rem;margin-bottom:0;">
            <%= stripeReady ? 'Your Stripe payout account has been submitted for test payouts.' : 'Connect a Stripe sandbox account before real Stripe test transfers can be sent.' %>
          </p>
          <% if (stripeAccount && stripeAccount.stripe_account_id) { %>
            <p class="mono mt-2 mb-0" style="color:var(--ghost);font-size:.76rem;"><%= stripeAccount.stripe_account_id %></p>
          <% } %>
        </div>
        <form method="POST" action="/merchant/stripe/connect">
          <button class="btn btn-primary btn-pill" type="submit">
            <i class="bi bi-credit-card me-1"></i><%= stripeReady ? 'Update Stripe account' : 'Connect Stripe' %>
          </button>
        </form>
      </div>
    </div>

    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
      <div>
        <p class="section-label mb-1">Ready For Payout</p>
        <h5 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">Completed bookings before Monday, <%= payoutCutoffLabel %></h5>
        <p style="color:var(--muted);font-size:.875rem;margin-bottom:0;">Payouts are generated every Monday and include completed, paid, non-refunded bookings that are not in a payout batch yet.</p>
      </div>
      <span class="badge" style="background:var(--accent-light);color:var(--accent);font-weight:800;">Pending payout</span>
    </div>

    <div class="rounded-xl p-4 mb-4" style="background:var(--canvas);border:1px solid var(--border);">
      <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
          <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;">Pending payout</p>
          <strong class="mono" style="font-size:1.75rem;color:var(--success);"><%= money(payout.eligibleAmount) %></strong>
          <p style="color:var(--ghost);font-size:.78rem;margin-bottom:0;"><%= payout.eligibleBookings.length %> completed paid booking(s) ready for the next payout batch</p>
        </div>
      </div>
    </div>

    <h6 style="font-weight:800;color:var(--ink);margin-bottom:.85rem;">Payout history</h6>
    <div class="table-responsive">
      <table class="table align-middle mb-0" style="font-size:.82rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th>Payout</th>
            <th>Status</th>
            <th>Bookings</th>
            <th>Gross</th>
            <th>Uniday</th>
            <th>Paid to you</th>
            <th>Reference</th>
            <th>Created</th>
            <th>Paid</th>
          </tr>
        </thead>
        <tbody>
          <% (payout.payouts || []).slice(0, 8).forEach(row => { %>
          <tr>
            <td class="mono">#<%= row.payout_id %></td>
            <td>
              <span class="badge" style="background:<%= row.status === 'paid' ? 'var(--success-bg)' : 'var(--warn-bg)' %>;color:<%= row.status === 'paid' ? 'var(--success)' : 'var(--warn)' %>;text-transform:capitalize;"><%= row.status %></span>
            </td>
            <td><%= row.booking_count %></td>
            <td class="mono"><%= money(row.gross_amount) %></td>
            <td class="mono"><%= money(row.platform_commission) %></td>
            <td class="mono" style="font-weight:800;color:var(--success);"><%= money(row.payout_amount) %></td>
            <td class="mono" style="color:var(--muted);"><%= row.stripe_transfer_id || row.payout_reference || '-' %></td>
            <td style="color:var(--muted);"><%= dateTime(row.created_at) %></td>
            <td style="color:var(--muted);"><%= dateTime(row.paid_at) %></td>
          </tr>
          <% }) %>
          <% if (!(payout.payouts || []).length) { %>
          <tr><td colspan="9" class="text-center py-4" style="color:var(--muted);">No payout batches yet.</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Monthly Breakdown -->
  <% if (monthly.length > 0) { %>
  <div class="card border-0 p-4 mb-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <h6 style="font-weight:700;color:var(--ink);margin-bottom:1rem;">
      <i class="bi bi-calendar3 me-2" style="color:var(--accent);"></i>Monthly Paid Revenue (Last 6 Months)
    </h6>
    <p style="color:var(--muted);font-size:.82rem;margin-bottom:.75rem;">Select a month to update the transaction history below.</p>
    <div class="table-responsive monthly-revenue-scroll">
      <table class="table align-middle mb-0" style="font-size:.875rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th>Month</th>
            <th>Bookings</th>
            <th>Gross</th>
            <th>Uniday 10%</th>
            <th>Gateway Fees</th>
            <th>Your Earnings</th>
          </tr>
        </thead>
        <tbody>
          <% monthly.forEach(m => { %>
          <tr class="monthly-row <%= m.month === selectedPeriod ? 'selected' : '' %>" onclick="window.location.href='/merchant/revenue?month=<%= encodeURIComponent(m.month) %>'">
            <td style="font-weight:800;color:<%= m.month === selectedPeriod ? 'var(--accent)' : 'var(--ink)' %>;"><%= m.month %></td>
            <td><%= m.bookings %></td>
            <td style="font-family:var(--font-mono);">S$<%= Number(m.revenue || 0).toFixed(2) %></td>
            <td style="font-family:var(--font-mono);color:var(--accent);">S$<%= Number(m.platform_commission || 0).toFixed(2) %></td>
            <td style="font-family:var(--font-mono);">S$<%= gatewayFees(m).toFixed(2) %></td>
            <td style="font-weight:700;color:var(--success);font-family:var(--font-mono);">S$<%= Number(m.merchant_earnings || 0).toFixed(2) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>

  <!-- Transaction History -->
  <h5 style="font-weight:700;color:var(--ink);margin-bottom:1rem;"><%= periodLabel %> Paid Transaction History</h5>
  <% if (transactions.length === 0) { %>
  <div class="card border-0 text-center py-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="icon-circle-lg mx-auto mb-3">
      <i class="bi bi-receipt" style="font-size:2rem;color:var(--accent);"></i>
    </div>
    <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;">No transactions yet</h6>
    <p style="color:var(--muted);font-size:.875rem;">Complete bookings will appear here.</p>
  </div>
  <% } else { %>
  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th>Order ID</th>
            <th>Customer</th>
            <th>Service</th>
            <th>Appt Date</th>
            <th>Source</th>
            <th>Gross</th>
            <th>Gateway Fees</th>
            <th>Your Earnings</th>
            <th>Status</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.forEach(t => { %>
          <tr>
            <td style="color:var(--muted);font-weight:600;font-family:var(--font-mono);">#<%= t.booking_id %></td>
            <td>
              <p style="font-weight:600;margin-bottom:0;"><%= t.customer_name %></p>
              <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;"><%= t.customer_email %></p>
            </td>
            <td>
              <p style="margin-bottom:0;"><%= t.service_name %></p>
              <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;"><%= t.duration_mins %> min</p>
            </td>
            <td>
              <%= new Date(t.booking_date).toLocaleDateString('en-SG',{day:'numeric',month:'short',year:'numeric'}) %>
              <br/><span style="color:var(--muted);"><%= String(t.booking_time).slice(0,5) %></span>
            </td>
            <td>
              <% if (t.source === 'qr' || t.source === 'qr_scan') { %>
              <span class="badge" style="background:var(--accent-light);color:var(--accent);">
                <i class="bi bi-qr-code me-1"></i>QR
              </span>
              <% } else { %>
              <span class="badge bg-secondary"><%= t.source %></span>
              <% } %>
            </td>
            <td style="font-family:var(--font-mono);font-weight:600;"><%= t.amount ? 'S$' + Number(t.amount).toFixed(2) : '—' %></td>
            <td style="font-family:var(--font-mono);"><%= t.amount ? 'S$' + gatewayFees(t).toFixed(2) : '—' %></td>
            <td style="font-weight:700;color:var(--success);font-family:var(--font-mono);"><%= t.merchant_earnings ? 'S$' + Number(t.merchant_earnings).toFixed(2) : '—' %></td>
            <td>
              <span class="badge" style="<%= paymentStatusStyle(t.payment_status) %>">
                <%= paymentStatusLabel(t.payment_status) %>
              </span>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
