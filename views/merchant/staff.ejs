<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div class="container py-5">

  <a href="/merchant/dashboard" class="btn btn-outline-secondary btn-pill btn-sm mb-4">
    <i class="bi bi-arrow-left me-1"></i>Dashboard
  </a>

  <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">

    <div>
      <p class="section-label">Employees</p>

      <h2 style="font-weight:800; letter-spacing:-.03em; color:var(--ink); margin-bottom:.25rem;">
        Manage Staff
      </h2>

      <p style="color:var(--muted); margin-bottom:0;">
        Add employees that customers can choose during booking.
      </p>
    </div>

    <span class="badge" style="background:var(--accent-light); color:var(--accent);">
      <%= staff.filter(s => s.is_active).length %> active • <%= staff.length %> total
    </span>

  </div>

  <div class="row g-4">

    <!-- Add Staff Form -->
    <div class="col-lg-5">

      <div class="card border-0"
           style="box-shadow:var(--shadow); border-radius:var(--r-xl);">

        <div class="card-body p-4">

          <h5 style="font-weight:800; margin-bottom:1.25rem;">
            <i class="bi bi-person-plus me-2" style="color:var(--accent);"></i>
            Add New Staff
          </h5>

          <form id="staffForm" action="/merchant/staff/add" method="POST">

            <div class="mb-3">
              <label class="form-label">
                Staff Name <span style="color:var(--accent);">*</span>
              </label>

              <input
                id="staffName"
                type="text"
                name="full_name"
                class="form-control rounded-xl"
                placeholder="e.g. Amanda Tan"
                required
              >
            </div>

            <div class="mb-3">
              <label class="form-label">Role</label>

              <input
                id="staffRole"
                type="text"
                name="role"
                class="form-control rounded-xl"
                placeholder="e.g. Senior Stylist"
              >
            </div>

            <div class="mb-3">
              <label class="form-label">Bio</label>

              <textarea
                id="staffBio"
                name="bio"
                class="form-control rounded-xl"
                rows="3"
                placeholder="Short description of the staff member..."
              ></textarea>
            </div>

            <div class="mb-3">
              <label class="form-label">Experience Years</label>

              <input
                id="staffExperience"
                type="number"
                name="experience_years"
                class="form-control rounded-xl"
                min="0"
                placeholder="e.g. 3"
              >
            </div>

            <!-- Services Selection -->
            <div class="mb-4">

              <label class="form-label">
                Services Staff Can Perform
              </label>

              <% services.forEach(service => { %>

                <div class="form-check mb-2">

                  <input
                    class="form-check-input"
                    type="checkbox"
                    name="service_ids"
                    value="<%= service.service_id %>"
                    id="service_<%= service.service_id %>"
                  >

                  <label
                    class="form-check-label"
                    for="service_<%= service.service_id %>"
                  >
                    <%= service.service_name %>
                  </label>

                </div>

              <% }) %>

            </div>

            <button
              id="staffSubmitBtn"
              type="submit"
              class="btn btn-primary btn-pill w-100"
            >
              <i id="staffSubmitIcon" class="bi bi-plus me-1"></i>
              <span id="staffSubmitText">Add Staff</span>
            </button>

          </form>
        </div>
      </div>
    </div>

    <!-- Staff Table -->
    <div class="col-lg-7">

      <% if (staff.length === 0) { %>

        <div class="card border-0 text-center py-5"
             style="box-shadow:var(--shadow); border-radius:var(--r-xl);">

          <div class="icon-circle-lg mx-auto mb-3">
            <i class="bi bi-people"
               style="font-size:2rem; color:var(--accent);"></i>
          </div>

          <h6 style="font-weight:700; color:var(--ink); margin-bottom:.25rem;">
            No staff added yet
          </h6>

          <p style="color:var(--muted); font-size:.875rem; margin-bottom:0;">
            Add your first staff member so customers can choose their preferred employee.
          </p>

        </div>

      <% } else { %>

        <div class="card border-0 overflow-hidden"
             style="box-shadow:var(--shadow); border-radius:var(--r-xl);">

          <div class="table-responsive">

            <table class="table table-hover align-middle mb-0"
                   style="font-size:.8125rem;">

              <thead>
                <tr>
                  <th>Name</th>
                  <th>Role</th>
                  <th>Services</th>
                  <th>Experience</th>
                  <th>Status</th>
                  <th style="width:180px;">Action</th>
                </tr>
              </thead>

              <tbody>

                <% staff.forEach(s => { %>

                  <tr>

                    <td>
                      <p style="font-weight:700; margin-bottom:0;">
                        <%= s.full_name %>
                      </p>

                      <% if (s.bio) { %>
                        <p style="color:var(--muted); font-size:.75rem; margin-bottom:0;">
                          <%= s.bio %>
                        </p>
                      <% } %>
                    </td>

                    <td>
                      <%= s.role || '-' %>
                    </td>

                    <td style="max-width:220px;">
                      <% const assignedServices = services.filter(service => (s.service_id_list || []).includes(Number(service.service_id))); %>
                      <% if (assignedServices.length) { %>
                        <div class="d-flex flex-wrap gap-1">
                          <% assignedServices.forEach(service => { %>
                            <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);font-size:.7rem;">
                              <%= service.service_name %>
                            </span>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <span style="color:var(--muted);font-size:.75rem;">No services assigned</span>
                      <% } %>
                    </td>

                    <td>
                      <%= s.experience_years != null ? s.experience_years + ' year(s)' : '-' %>
                    </td>

                    <td>

                      <% if (s.is_active) { %>

                        <span class="badge"
                              style="background:var(--success-bg); color:var(--success);">
                          Active
                        </span>

                      <% } else { %>

                        <span class="badge bg-secondary">
                          Inactive
                        </span>

                      <% } %>

                    </td>

                    <td>

                      <div class="d-flex flex-column gap-2 align-items-start">

                        <button
                          type="button"
                          class="btn btn-sm btn-outline-secondary btn-pill edit-staff-btn"
                          style="font-size:.72rem; padding:.28rem .85rem; min-width:80px;"
                          data-id="<%= s.staff_id %>"
                          data-name="<%= s.full_name %>"
                          data-role="<%= s.role || '' %>"
                          data-bio="<%= s.bio || '' %>"
                          data-exp="<%= s.experience_years || '' %>"
                          data-services="<%= (s.service_id_list || []).join(',') %>"
                        >
                          Edit
                        </button>

                        <form action="/merchant/staff/<%= s.staff_id %>/toggle"
                              method="POST">

                          <button
                            class="btn btn-sm btn-outline-secondary btn-pill"
                            style="font-size:.72rem; padding:.28rem .85rem; min-width:80px;"
                          >
                            <%= s.is_active ? 'Disable' : 'Enable' %>
                          </button>

                        </form>

                        <form action="/merchant/staff/<%= s.staff_id %>/delete"
                              method="POST">

                          <button
                            class="btn btn-sm btn-outline-danger btn-pill"
                            style="font-size:.72rem; padding:.28rem .85rem; min-width:80px;"
                          >
                            Delete
                          </button>

                        </form>

                      </div>

                    </td>

                  </tr>

                <% }) %>

              </tbody>
            </table>
          </div>
        </div>

      <% } %>

    </div>
  </div>
</div>

<script>
  const staffForm = document.getElementById('staffForm');
  const staffName = document.getElementById('staffName');
  const staffRole = document.getElementById('staffRole');
  const staffBio = document.getElementById('staffBio');
  const staffExperience = document.getElementById('staffExperience');
  const staffSubmitText = document.getElementById('staffSubmitText');
  const staffSubmitIcon = document.getElementById('staffSubmitIcon');
  const serviceCheckboxes = Array.from(document.querySelectorAll('input[name="service_ids"]'));

  document.querySelectorAll('.edit-staff-btn').forEach(button => {
    button.addEventListener('click', () => {
      const staffId = button.dataset.id;

      staffForm.action = `/merchant/staff/${staffId}/edit`;

      staffName.value = button.dataset.name || '';
      staffRole.value = button.dataset.role || '';
      staffBio.value = button.dataset.bio || '';
      staffExperience.value = button.dataset.exp || '';
      const assignedServices = (button.dataset.services || '')
        .split(',')
        .filter(Boolean);

      serviceCheckboxes.forEach(checkbox => {
        checkbox.checked = assignedServices.includes(checkbox.value);
      });

      staffSubmitText.textContent = 'Save Changes';
      staffSubmitIcon.className = 'bi bi-check2 me-1';

      staffForm.scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
</script>

<%- include('../partials/footer') %>
