<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<!-- Merchant dashboard: overview of revenue, bookings, quick links and marketplace image. -->
<div class="container py-5">
  <div class="d-flex justify-content-between align-items-start mb-5 flex-wrap gap-3">
    <div>
      <p class="section-label">Overview</p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Merchant Dashboard</h2>
      <p style="color:var(--muted);margin-bottom:0;">Welcome back, <strong><%= user.full_name %></strong></p>
    </div>
    <div class="d-flex gap-2 flex-wrap justify-content-start justify-content-md-end" style="min-width:min(100%,360px);">
      <a href="/merchant/revenue" class="btn btn-outline-secondary btn-pill"
         style="font-weight:800;padding:.72rem 1.15rem;min-width:150px;">
        <i class="bi bi-graph-up me-1"></i>Revenue Report
      </a>
      <a href="/merchant/qr" class="btn btn-primary btn-pill"
         style="font-weight:800;padding:.72rem 1.15rem;min-width:150px;">
        <i class="bi bi-qr-code me-1"></i>My QR Code
      </a>
    </div>
  </div>

  <!-- Feedback after uploading the marketplace photo. -->
  <% if (imageError) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
    <i class="bi bi-exclamation-circle me-2"></i><%= imageError %>
  </div>
  <% } %>
  <% if (imageSuccess) { %>
  <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
    <i class="bi bi-check-circle me-2"></i><%= imageSuccess %>
  </div>
  <% } %>

  <!-- Marketplace photo card: controls the image shown on public merchant cards. -->
  <div class="card border-0 mb-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);overflow:hidden;">
    <div class="row g-0 align-items-stretch">
      <div class="col-md-4">
        <% if (merchant && merchant.profile_image) { %>
          <img src="<%= merchant.profile_image %>" alt="<%= merchant.merchant_name %>" style="width:100%;height:100%;min-height:220px;object-fit:cover;display:block;">
        <% } else { %>
          <div style="min-height:220px;height:100%;background:var(--accent-light);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:3rem;">
            <i class="bi bi-image"></i>
          </div>
        <% } %>
      </div>
      <div class="col-md-8">
        <div class="p-4 h-100 d-flex flex-column justify-content-center">
          <p class="section-label mb-2">Marketplace photo</p>
          <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;">Your merchant card image</h5>
          <p style="color:var(--muted);margin-bottom:1rem;">Upload the picture customers will see on your marketplace card.</p>
          <form action="/merchant/marketplace-image" method="POST" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
            <input type="file" name="marketplace_image" class="form-control rounded-xl" accept="image/*" required style="max-width:360px;">
            <button type="submit" class="btn btn-primary btn-pill">
              <i class="bi bi-upload me-1"></i>Update Photo
            </button>
          </form>
          <p class="small mt-2 mb-0" style="color:var(--muted);">Recommended: landscape photo, under 2MB.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Revenue Stats: summary numbers loaded from revenueModel.getMerchantRevenueSummary. -->
  <div class="row g-3 mb-5">
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;">Total Revenue</p>
        <p class="stat-value" style="color:var(--accent);">S$<%= Number(summary.total_revenue || 0).toFixed(2) %></p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;">Your Earnings</p>
        <p class="stat-value" style="color:var(--success);">S$<%= Number(summary.total_merchant_share || 0).toFixed(2) %></p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;">QR Bookings</p>
        <p class="stat-value" style="color:var(--accent);">
          <%= summary.qr_bookings || 0 %>
        </p>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="stat-card text-center">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.4rem;">Total Bookings</p>
        <p class="stat-value" style="color:var(--ink);"><%= summary.total_bookings || 0 %></p>
      </div>
    </div>
  </div>

  <!-- Quick Actions: shortcuts to the main merchant tools. -->
  <div class="row g-3 mb-5">
    <% [
      { href:'/merchant/services',    icon:'bi-scissors', label:'My Services',sub:'Add & manage'        },
      { href:'/merchant/bookings',    icon:'bi-calendar-check', label:'Bookings', sub:'View all'        },
      { href:'/merchant/staff',        icon:'bi-people',   label:'Staff',        sub:'Manage employees' },
      { href:'/merchant/availability', icon:'bi-clock',    label:'Availability', sub:'Set working hours' },
      { href:'/merchant/promotions',  icon:'bi-tag',      label:'Promotions', sub:'Create deals'        },
      { href:'/merchant/reviews',      icon:'bi-star',     label:'Reviews',      sub:'View & reply'      },
    ].forEach(a => { %>
    <div class="col-6 col-md-3">
      <a href="<%= a.href %>" class="action-card">
        <div class="action-icon">
          <i class="bi <%= a.icon %>"></i>
        </div>
        <p style="font-weight:700;font-size:.875rem;color:var(--ink);margin-bottom:.1rem;"><%= a.label %></p>
        <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;"><%= a.sub %></p>
      </a>
    </div>
    <% }) %>
  </div>

  <!-- Recent Bookings: latest bookings with action buttons for status updates. -->
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h5 style="font-weight:700;color:var(--ink);margin-bottom:0;">Recent Bookings</h5>
  </div>

  <% if (bookings.length === 0) { %>
  <div class="card border-0 text-center py-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="icon-circle-lg mx-auto mb-3">
      <i class="bi bi-inbox" style="font-size:2rem;color:var(--accent);"></i>
    </div>
    <h6 style="font-weight:700;color:var(--ink);margin-bottom:.25rem;">No bookings yet</h6>
    <p style="color:var(--muted);font-size:.875rem;margin-bottom:1rem;">Generate your QR code and share it to start receiving cashless bookings.</p>
    <div class="d-flex gap-2 justify-content-center">
      <a href="/merchant/qr" class="btn btn-primary btn-pill btn-sm">Get My QR Code</a>
      <a href="/merchant/services" class="btn btn-outline-secondary btn-pill btn-sm">Add Services</a>
    </div>
  </div>
  <% } else { %>
  <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
        <thead style="background:var(--accent-light);">
          <tr>
            <th>ID</th>
            <th>Customer</th>
            <th>Service</th>
            <th>Date &amp; Time</th>
            <th>Source</th>
            <th>Status</th>
            <th>Action</th>
          </tr>
        </thead>
        <tbody>
          <% bookings.slice(0,10).forEach(b => { %>
          <tr>
            <td style="font-weight:600;color:var(--muted);font-family:var(--font-mono);">#<%= b.booking_id %></td>
            <td>
              <p style="font-weight:600;margin-bottom:0;"><%= b.customer_name %></p>
              <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;"><%= b.customer_phone %></p>
            </td>
            <td><%= b.service_name %></td>
            <td>
              <%= new Date(b.booking_date).toLocaleDateString('en-SG',{day:'numeric',month:'short'}) %>
              <span style="color:var(--muted);margin-left:.25rem;"><%= String(b.booking_time).slice(0,5) %></span>
            </td>
            <td>
              <% if (b.source === 'qr' || b.source === 'qr_scan') { %>
              <span class="badge" style="background:var(--accent-light);color:var(--accent);">
                <i class="bi bi-qr-code me-1"></i>QR
              </span>
              <% } else { %>
              <span class="badge bg-secondary"><%= b.source %></span>
              <% } %>
            </td>
            <td>
              <%
                // Match each booking status to a badge colour.
                const statusMap = {
                  confirmed: { bg:'var(--success-bg)',  color:'var(--success)'  },
                  completed: { bg:'var(--neutral-bg)',  color:'var(--muted)'    },
                  arrived:   { bg:'#EFF6FF',            color:'#1D4ED8'         },
                  cancelled: { bg:'var(--danger-bg)',   color:'var(--danger)'   },
                  payment_failed: { bg:'var(--danger-bg)', color:'var(--danger)' },
                  pending:   { bg:'var(--warn-bg)',     color:'var(--warn)'     },
                };
                const st = statusMap[b.status] || statusMap.pending;
                const statusLabel = b.status === 'payment_failed'
                  ? 'Payment Failed'
                  : b.status.charAt(0).toUpperCase() + b.status.slice(1).replace('_', ' ');
              %>
              <span class="badge" style="background:<%= st.bg %>;color:<%= st.color %>">
                <%= statusLabel %>
              </span>
            </td>
            <td>
              <% if (b.status === 'confirmed') { %>
              <form action="/merchant/bookings/<%= b.booking_id %>/arrived" method="POST" class="d-inline">
                <button class="btn btn-sm btn-outline-secondary btn-pill" style="font-size:.72rem;padding:.2rem .6rem;">
                  <i class="bi bi-person-check me-1"></i>Arrived
                </button>
              </form>
              <% } else if (b.status === 'arrived') { %>
              <form action="/merchant/bookings/<%= b.booking_id %>/complete" method="POST" class="d-inline">
                <button class="btn btn-sm btn-pill" style="font-size:.72rem;padding:.2rem .6rem;background:var(--success);color:#fff;border:none;">
                  <i class="bi bi-check2-all me-1"></i>Complete
                </button>
              </form>
              <% } else { %>
              <span style="color:var(--muted);font-size:.75rem;">—</span>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
