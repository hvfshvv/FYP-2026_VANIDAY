<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<style>
  .merchant-analytics-shell {
    background:linear-gradient(145deg,#fff 0%,#fff8fa 100%);
    border:1px solid rgba(225,29,72,.08);
    border-radius:28px;
    box-shadow:0 24px 60px rgba(136,19,55,.09);
    padding:1.4rem;
  }
  .dashboard-panel {
    background:#fff;
    border:1px solid rgba(225,29,72,.08);
    border-radius:20px;
    box-shadow:0 10px 30px rgba(136,19,55,.07);
    overflow:hidden;
  }
  .dashboard-panel-head {
    display:flex;
    justify-content:space-between;
    align-items:flex-start;
    gap:1rem;
    padding:1rem 1.15rem;
    border-bottom:1px solid rgba(225,29,72,.08);
    background:linear-gradient(90deg,#fff7f9,#fff);
  }
  .dashboard-panel-body { padding:1.15rem; }
  .signal-pill {
    display:inline-flex;
    align-items:center;
    gap:.35rem;
    border-radius:999px;
    padding:.32rem .55rem;
    background:var(--neutral-bg);
    color:var(--muted);
    font-size:.62rem;
    font-weight:800;
  }
  .dashboard-kpi {
    position:relative;
    overflow:hidden;
    min-height:150px;
    border-radius:20px;
    padding:1.2rem;
    background:#fff;
    border:1px solid rgba(225,29,72,.09);
    box-shadow:0 10px 24px rgba(136,19,55,.07);
  }
  .dashboard-kpi::after {
    content:"";
    position:absolute;
    width:100px;
    height:100px;
    right:-38px;
    bottom:-48px;
    border-radius:50%;
    background:currentColor;
    opacity:.08;
  }
  .dashboard-kpi.featured {
    color:#fff !important;
    border:0;
    background:linear-gradient(135deg,var(--accent),#fb7185);
  }
  .dashboard-kpi.featured * { color:#fff !important; }
  .dashboard-kpi .kpi-signal {
    position:absolute;
    top:1rem;
    right:1rem;
    z-index:1;
    width:8px;
    height:8px;
    border-radius:50%;
    background:currentColor;
    box-shadow:0 0 0 5px color-mix(in srgb,currentColor 12%,transparent);
  }
  .metric-icon {
    width:38px;
    height:38px;
    border-radius:12px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:var(--accent-light);
    color:var(--accent);
  }
  .indicator-gauge-card {
    background:linear-gradient(145deg,#fff,#fff8fa);
    border:1px solid rgba(225,29,72,.08);
    border-radius:18px;
    padding:1rem;
    height:100%;
  }
  .indicator-gauge {
    --gauge-color:var(--accent);
    width:min(100%,210px);
    margin:0 auto;
    position:relative;
  }
  .indicator-gauge svg { width:100%;height:auto;display:block;overflow:visible; }
  .gauge-track,.gauge-progress {
    fill:none;
    stroke-width:23;
    stroke-linecap:round;
  }
  .gauge-track { stroke:var(--neutral-bg); }
  .gauge-progress {
    stroke:var(--gauge-color);
    stroke-dasharray:var(--gauge-value) 100;
    transition:stroke-dasharray .45s ease;
  }
  .gauge-needle { stroke:var(--ink);stroke-width:5;stroke-linecap:round; }
  .gauge-hub { fill:#fff;stroke:var(--ink);stroke-width:4; }
  .gauge-scale {
    display:flex;
    justify-content:space-between;
    color:var(--muted);
    font-size:.62rem;
    font-weight:700;
    margin:-.65rem .3rem 0;
  }
  .gauge-reading { text-align:center;margin-top:-.15rem; }
  .gauge-reading strong { display:block;color:var(--ink);font-size:1.55rem;line-height:1;font-family:var(--font-mono); }
  .gauge-reading span { color:var(--muted);font-size:.63rem;font-weight:700; }
  .capacity-meter { height:8px;border-radius:999px;background:#fff;overflow:hidden;margin-top:.65rem; }
  .capacity-meter > span { display:block;height:100%;border-radius:inherit;background:linear-gradient(90deg,var(--accent),#fb7185); }
  .outcome-track { display:flex;height:18px;border-radius:999px;overflow:hidden;background:var(--neutral-bg);box-shadow:inset 0 0 0 1px var(--border); }
  .outcome-track > span { min-width:0;transition:width .2s ease; }
  .outcome-row { display:grid;grid-template-columns:100px 1fr 34px;align-items:center;gap:.7rem; }
  .outcome-line { height:7px;border-radius:999px;background:var(--neutral-bg);overflow:hidden; }
  .outcome-line > span { display:block;height:100%;border-radius:inherit; }
  .mini-signal-card {
    display:block;
    height:100%;
    padding:1rem;
    border-radius:18px;
    background:#fff;
    border:1px solid rgba(225,29,72,.08);
    box-shadow:0 8px 20px rgba(136,19,55,.06);
    position:relative;
    overflow:hidden;
  }
  .mini-signal-card::before { content:"";position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--signal-color,var(--accent)); }
  .mini-signal-icon { width:34px;height:34px;border-radius:10px;display:grid;place-items:center;background:var(--accent-light);color:var(--accent); }
  .trend-chart { min-height:230px;display:flex;align-items:flex-end;gap:.65rem;padding-top:1.5rem; }
  .trend-column { flex:1;min-width:34px;text-align:center; }
  .trend-bar-track { height:165px;display:flex;align-items:flex-end;background:linear-gradient(to top,rgba(225,29,72,.04),transparent);border-bottom:1px solid var(--border);border-radius:10px 10px 0 0; }
  .trend-bar { width:100%;min-height:5px;border-radius:10px 10px 3px 3px;background:linear-gradient(180deg,#fb7185,var(--accent));box-shadow:0 8px 16px rgba(225,29,72,.18); }
  @media (max-width:767px) {
    .merchant-analytics-shell { padding:.75rem;border-radius:20px; }
    .outcome-row { grid-template-columns:82px 1fr 28px; }
  }
</style>

<%
  const bookings = bookingSummary || {};
  const revenue = revenueSummary || {};
  const reviews = reviewSummary || {};
  const metrics = dashboardMetrics || {};
  const schedule = Array.isArray(todaySchedule) ? todaySchedule : [];
  const revenueTrend = Array.isArray(monthlyRevenue) ? monthlyRevenue : [];
  const actions = Array.isArray(pendingActions) ? pendingActions : [];
  const activeWaitlists = Number(activeWaitlistCount || 0);
  const cancellationRate = Number(metrics.cancellationRate || 0);
  const hasFinalOutcomes = Number(bookings.month_completed || 0) + Number(bookings.month_cancelled || 0) + Number(bookings.month_no_show || 0) > 0;
  const hasReliableCancellationSample = Number(metrics.monthlyFinishedBookings || 0) >= 5;
  const cancellationColor = !hasReliableCancellationSample ? 'var(--muted)' : cancellationRate <= 10 ? 'var(--success)' : cancellationRate <= 20 ? 'var(--warn)' : 'var(--danger)';
  const cancellationInsight = !hasFinalOutcomes
    ? t('merchant.dashboard.cancelInsight.none')
    : !hasReliableCancellationSample
      ? t('merchant.dashboard.cancelInsight.limited', { cancelled: Number(metrics.monthlyCancelledBookings || 0), total: Number(metrics.monthlyFinishedBookings || 0) })
    : cancellationRate <= 10
      ? t('merchant.dashboard.cancelInsight.good')
      : cancellationRate <= 20
        ? t('merchant.dashboard.cancelInsight.watch')
        : t('merchant.dashboard.cancelInsight.risk');
  const hasPeriodReviews = Number(reviews.review_count || 0) > 0;
  const hasRating = hasPeriodReviews || reviews.latest_rating !== null && typeof reviews.latest_rating !== 'undefined';
  const rating = Number(hasPeriodReviews ? reviews.average_rating : reviews.latest_rating || 0);
  const ratingLabel = hasPeriodReviews ? t('admin.feedback.averageRating') : t('merchant.dashboard.latestRating');
  const ratingNote = hasPeriodReviews
    ? t('merchant.dashboard.reviewsInPeriod', { count: Number(reviews.review_count || 0), period: periodLabel })
    : hasRating
      ? t('merchant.dashboard.latestAvailableReview')
      : t('merchant.dashboard.noReviewsYet');
  const ratingColor = !hasRating ? 'var(--muted)' : rating >= 4.5 ? 'var(--success)' : rating >= 4 ? 'var(--warn)' : 'var(--danger)';
  const ratingInsight = !hasRating
    ? t('merchant.dashboard.ratingInsight.none')
    : !hasPeriodReviews
      ? t('merchant.dashboard.ratingInsight.noneInPeriod', { period: periodLabel })
    : rating >= 4.5
      ? t('merchant.dashboard.ratingInsight.great')
      : rating >= 4
        ? t('merchant.dashboard.ratingInsight.good')
        : t('merchant.dashboard.ratingInsight.needsAttention');
  const maxMonthlyRevenue = Math.max(...revenueTrend.map(item => Number(item.revenue || 0)), 1);
  const outcomeItems = [
    {label:t('bookings.completed'), value:Number(bookings.month_completed || 0), color:'var(--success)', bg:'var(--success-bg)', icon:'bi-check2-all'},
    {label:t('bookings.cancelled'), value:Number(bookings.month_cancelled || 0), color:'var(--danger)', bg:'var(--danger-bg)', icon:'bi-x-circle'},
    {label:t('merchant.dashboard.noShows'), value:Number(bookings.month_no_show || 0), color:'var(--warn)', bg:'var(--warn-bg)', icon:'bi-person-x'},
    {label:t('bookings.confirmed'), value:Number(bookings.confirmed || 0), color:'#2563EB', bg:'#EFF6FF', icon:'bi-calendar-check'},
  ];
  const outcomeTotal = outcomeItems.reduce((sum, item) => sum + item.value, 0);
  const maxOutcome = Math.max(...outcomeItems.map(item => item.value), 1);
  const totalServices = Number(operations.activeServices || 0) + Number(operations.inactiveServices || 0);
  const totalStaff = Number(operations.activeStaff || 0) + Number(operations.inactiveStaff || 0);
  const serviceCoverage = totalServices ? Math.round((Number(operations.activeServices || 0) / totalServices) * 100) : 0;
  const staffCoverage = totalStaff ? Math.round((Number(operations.activeStaff || 0) / totalStaff) * 100) : 0;
  const hoursCoverage = Math.round((Number(operations.activeAvailabilityDays || 0) / 7) * 100);
  function monthLabel(value) {
    const [year, month] = String(value || '').split('-').map(Number);
    if (!year || !month) return value || '';
    return new Date(year, month - 1, 1).toLocaleDateString('en-SG', { month:'short' });
  }
  const statusStyles = {
    confirmed: { label: t('admin.bookingStatus.confirmed'), bg: '#EFF6FF', color: '#2563EB' },
    rescheduled: { label: t('admin.bookingStatus.rescheduled'), bg: '#EFF6FF', color: '#2563EB' },
    arrived: { label: t('admin.bookingStatus.arrived'), bg: '#F5F3FF', color: '#7C3AED' },
  };
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container merchant-analytics-shell" style="max-width:1240px;">
    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
      <div>
        <p class="section-label"><%= t('merchant.dashboard.eyebrow') %></p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('merchant.dashboard.title', { name: merchant?.merchant_name || t('common.merchant') }) %></h2>
        <p style="color:var(--muted);margin-bottom:0;"><%- t('merchant.dashboard.subtitle', { period: periodLabel }) %></p>
      </div>
      <div class="d-flex gap-2 flex-wrap justify-content-end">
        <a href="/merchant/manage" class="btn btn-primary btn-pill" style="font-weight:800;padding:.72rem 1.15rem;">
          <i class="bi bi-sliders me-1"></i><%= t('merchant.manage.title') %>
        </a>
      </div>
    </div>

    <div class="d-flex justify-content-between align-items-end gap-2 mb-2">
      <div><p class="section-label mb-1"><%= t('merchant.dashboard.todayLabel', { date: todayLabel }) %></p><h5 style="font-weight:800;color:var(--ink);margin:0;"><%= t('merchant.dashboard.dailyOps') %></h5></div>
      <span style="color:var(--muted);font-size:.75rem;"><%= t('merchant.dashboard.liveInfo') %></span>
    </div>
    <div class="row g-3 mb-4">
      <% [
        { label:t('merchant.dashboard.todayBookings'), value:bookings.today_bookings, icon:'bi-calendar2-check', color:'var(--accent)', note:t('merchant.dashboard.todayBookingsNote'), featured:true },
        { label:t('merchant.dashboard.upcomingBookings'), value:bookings.upcoming_bookings, icon:'bi-calendar-week', color:'#1D4ED8', note:t('merchant.dashboard.upcomingNote') },
        { label:t('merchant.dashboard.needAttention'), value:actions.length, icon:'bi-exclamation-circle', color:actions.length ? 'var(--warn)' : 'var(--success)', note:actions.length ? t('merchant.dashboard.openAlerts') : t('merchant.dashboard.noActionNeeded') },
      ].forEach(item => { %>
        <div class="col-12 col-md-4">
          <div class="dashboard-kpi h-100 <%= item.featured ? 'featured' : '' %>" style="color:<%= item.color %>;">
            <span class="kpi-signal" aria-hidden="true"></span>
            <div class="metric-icon mb-3"><i class="bi <%= item.icon %>"></i></div>
            <p style="font-weight:700;color:var(--muted);font-size:.72rem;margin-bottom:.25rem;"><%= item.label %></p>
            <p class="stat-value mb-1" style="color:<%= item.color %>;font-size:1.65rem;"><%= item.value || 0 %></p>
            <p style="color:var(--muted);font-size:.66rem;margin:0;"><%= item.note %></p>
          </div>
        </div>
      <% }) %>
    </div>

    <div class="d-flex justify-content-between align-items-end gap-3 mb-2 flex-wrap">
      <div><p class="section-label mb-1"><%= periodLabel %></p><h5 style="font-weight:800;color:var(--ink);margin:0;"><%= t('merchant.dashboard.monthlyIndicators') %></h5></div>
      <div class="d-flex align-items-center gap-2 flex-wrap justify-content-end">
        <a href="<%= isCurrentPeriod ? '/merchant/insights?period=month' : '/merchant/revenue?month=' + selectedPeriod %>" style="font-size:.78rem;font-weight:800;white-space:nowrap;">
          <%= isCurrentPeriod ? t('merchant.dashboard.viewInsights') : t('merchant.dashboard.viewMonthReport') %> <i class="bi bi-arrow-right"></i>
        </a>
        <form action="/merchant/dashboard" method="GET" class="d-flex gap-2 align-items-center dashboard-panel p-2">
          <label for="dashboardMonth" style="font-size:.7rem;font-weight:800;color:var(--muted);padding-left:.35rem;white-space:nowrap;"><%= t('merchant.revenue.viewMonth') %></label>
          <input id="dashboardMonth" type="month" name="month" value="<%= selectedPeriod %>" max="<%= currentPeriod %>"
                 class="form-control form-control-sm" style="width:150px;border-radius:999px;" onchange="this.form.submit()">
          <% if (!isCurrentPeriod) { %><a href="/merchant/dashboard" class="btn btn-outline-secondary btn-sm btn-pill"><%= t('merchant.dashboard.current') %></a><% } %>
        </form>
      </div>
    </div>
    <div class="row g-3 mb-4">
      <% [
        { label:t('admin.table.bookings'), value:bookings.month_bookings, icon:'bi-calendar2-check', color:'var(--accent)', note:t('merchant.dashboard.scheduledNote', { period: periodLabel }), featured:true },
        { label:t('admin.table.revenue'), value:'S$' + Number(revenue.month_revenue || 0).toFixed(2), icon:'bi-cash-stack', color:'var(--success)', note:t('merchant.dashboard.paymentsNote', { period: periodLabel }) },
        { label:t('merchant.dashboard.cancellationRate'), value:hasFinalOutcomes ? cancellationRate + '%' : t('merchant.dashboard.na'), icon:'bi-x-circle', color:cancellationColor, note:hasFinalOutcomes ? t('merchant.dashboard.cancelledOf', { cancelled: Number(metrics.monthlyCancelledBookings || 0), total: Number(metrics.monthlyFinishedBookings || 0) }) + (!hasReliableCancellationSample ? t('merchant.dashboard.limitedDataSuffix') : '') : t('merchant.dashboard.noOutcomes') },
        { label:ratingLabel, value:hasRating ? rating.toFixed(1) : t('merchant.dashboard.na'), icon:'bi-star-fill', color:ratingColor, note:ratingNote },
      ].forEach(item => { %>
        <div class="col-6 col-lg-3">
          <div class="dashboard-kpi h-100 <%= item.featured ? 'featured' : '' %>" style="color:<%= item.color %>;">
            <span class="kpi-signal" aria-hidden="true"></span>
            <div class="metric-icon mb-3"><i class="bi <%= item.icon %>"></i></div>
            <p style="font-weight:700;color:var(--muted);font-size:.72rem;margin-bottom:.25rem;"><%= item.label %></p>
            <p class="stat-value mb-1" style="color:<%= item.color %>;font-size:1.65rem;"><%= item.value || 0 %></p>
            <p style="color:var(--muted);font-size:.66rem;margin:0;"><%= item.note %></p>
          </div>
        </div>
      <% }) %>
    </div>

    <% if (false) { /* Detailed analysis now lives on /merchant/insights. */ %>
    <!-- Legacy detailed performance panels retained temporarily for reference but intentionally not rendered. -->
    <div class="row g-4 mb-5">
      <div class="col-lg-8">
        <div class="dashboard-panel h-100">
          <div class="dashboard-panel-head">
            <div>
              <p class="section-label mb-2">Performance Insights</p>
              <h5 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">Business Performance Console</h5>
              <p style="color:var(--muted);font-size:.75rem;margin:0;">Demand, revenue, capacity, and risk signals for <%= periodLabel %>.</p>
            </div>
            <span class="signal-pill"><i class="bi bi-activity"></i><%= actions.length ? actions.length + ' live alert(s)' : 'Operations clear' %></span>
          </div>
          <div class="dashboard-panel-body">
          <div class="row g-3">
            <div class="col-md-6">
              <div class="indicator-gauge-card">
                <div class="indicator-gauge" style="--gauge-value:<%= hasFinalOutcomes ? cancellationRate : 0 %>;--gauge-color:<%= cancellationColor %>;">
                  <svg viewBox="0 0 200 118" aria-label="Cancellation rate gauge">
                    <path class="gauge-track" pathLength="100" d="M20 100 A80 80 0 0 1 180 100"></path>
                    <path class="gauge-progress" pathLength="100" d="M20 100 A80 80 0 0 1 180 100"></path>
                    <line class="gauge-needle" x1="100" y1="100" x2="100" y2="38" transform="rotate(<%= -90 + ((hasFinalOutcomes ? cancellationRate : 0) * 1.8) %> 100 100)"></line>
                    <circle class="gauge-hub" cx="100" cy="100" r="9"></circle>
                  </svg>
                  <div class="gauge-scale"><span>0%</span><span>100%</span></div>
                  <div class="gauge-reading">
                    <strong><%= hasFinalOutcomes ? cancellationRate + '%' : 'N/A' %></strong>
                    <span>Cancellation rate</span>
                  </div>
                </div>
                <div class="text-center mt-3">
                  <p style="font-weight:800;color:var(--ink);margin-bottom:.2rem;">Cancellation Risk</p>
                  <p style="font-size:.7rem;color:<%= cancellationColor %>;font-weight:700;margin-bottom:.2rem;"><%= !hasFinalOutcomes ? 'No outcome data' : !hasReliableCancellationSample ? 'Limited data' : cancellationRate <= 10 ? 'Good' : cancellationRate <= 20 ? 'Monitor' : 'Needs attention' %></p>
                  <p style="font-size:.63rem;color:var(--muted);margin:0;"><%= cancellationInsight %></p>
                </div>
              </div>
            </div>
            <div class="col-md-6">
              <div class="indicator-gauge-card">
                <% const ratingPercent = hasRating ? Math.round((rating / 5) * 100) : 0; %>
                <div class="indicator-gauge" style="--gauge-value:<%= ratingPercent %>;--gauge-color:<%= ratingColor %>;">
                  <svg viewBox="0 0 200 118" aria-label="Customer rating gauge">
                    <path class="gauge-track" pathLength="100" d="M20 100 A80 80 0 0 1 180 100"></path>
                    <path class="gauge-progress" pathLength="100" d="M20 100 A80 80 0 0 1 180 100"></path>
                    <line class="gauge-needle" x1="100" y1="100" x2="100" y2="38" transform="rotate(<%= -90 + (ratingPercent * 1.8) %> 100 100)"></line>
                    <circle class="gauge-hub" cx="100" cy="100" r="9"></circle>
                  </svg>
                  <div class="gauge-scale"><span>0%</span><span>100%</span></div>
                  <div class="gauge-reading">
                    <strong><%= hasRating ? ratingPercent + '%' : 'N/A' %></strong>
                    <span><%= hasRating ? rating.toFixed(1) + '/5 customer rating' : 'Customer rating' %></span>
                  </div>
                </div>
                <div class="text-center mt-3">
                  <p style="font-weight:800;color:var(--ink);margin-bottom:.2rem;">Customer Rating</p>
                  <p style="font-size:.7rem;color:<%= ratingColor %>;font-weight:700;margin-bottom:.2rem;"><%= !hasRating ? 'No reviews yet' : !hasPeriodReviews ? 'Latest available rating' : rating >= 4.5 ? 'Excellent' : rating >= 4 ? 'Good' : 'Needs attention' %></p>
                  <p style="font-size:.63rem;color:var(--muted);margin:0;"><%= ratingInsight %></p>
                </div>
              </div>
            </div>
          </div>
          <div class="row g-3 mt-1">
            <div class="col-md-6">
              <div class="rounded-xl p-4 h-100" style="background:var(--accent-light);">
                <i class="bi bi-graph-up-arrow" style="color:var(--accent);font-size:1.35rem;"></i>
                <p style="color:var(--muted);font-size:.7rem;margin:.8rem 0 .25rem;">Most Booked Service</p>
                <h6 style="font-weight:800;color:var(--ink);margin-bottom:.2rem;"><%= bookings.most_booked_service || 'No booking data yet' %></h6>
                <p style="color:var(--muted);font-size:.72rem;margin:0;"><%= Number(bookings.most_booked_service_count || 0) %> booking(s) in <%= periodLabel %></p>
              </div>
            </div>
            <div class="col-md-6">
              <div class="rounded-xl p-4 h-100" style="background:var(--success-bg);">
                <i class="bi bi-cash-coin" style="color:var(--success);font-size:1.35rem;"></i>
                <p style="color:var(--muted);font-size:.7rem;margin:.8rem 0 .25rem;">Top Revenue Service</p>
                <h6 style="font-weight:800;color:var(--ink);margin-bottom:.2rem;"><%= topRevenueService ? topRevenueService.service_name : 'No paid revenue yet' %></h6>
                <p style="color:var(--muted);font-size:.72rem;margin:0;"><%= topRevenueService ? 'S$' + Number(topRevenueService.revenue || 0).toFixed(2) + ' earned in ' + periodLabel : 'Successful payments will reveal the top earner.' %></p>
              </div>
            </div>
            <% [
              {label:'Service Coverage', value:operations.activeServices + ' active', note:operations.inactiveServices + ' disabled', percent:serviceCoverage, icon:'bi-scissors', href:'/merchant/services'},
              {label:'Staff Availability', value:operations.activeStaff + ' active', note:operations.inactiveStaff + ' inactive', percent:staffCoverage, icon:'bi-people', href:'/merchant/staff'},
              {label:'Operating Hours', value:operations.activeAvailabilityDays + ' days active', note:operations.missingAvailabilityDays.length ? 'Missing: ' + operations.missingAvailabilityDays.join(', ') : 'All days configured', percent:hoursCoverage, icon:'bi-clock', href:'/merchant/availability'},
            ].forEach(item => { %>
              <div class="col-md-4">
                <a href="<%= item.href %>" class="rounded-xl p-3 h-100 d-block text-decoration-none" style="background:var(--neutral-bg);">
                  <i class="bi <%= item.icon %>" style="color:var(--accent);"></i>
                  <p style="font-size:.7rem;color:var(--muted);margin:.55rem 0 .15rem;"><%= item.label %></p>
                  <strong style="font-size:.85rem;color:var(--ink);"><%= item.value %></strong>
                  <span style="float:right;font-size:.68rem;font-weight:800;color:var(--accent);"><%= item.percent %>%</span>
                  <div class="capacity-meter"><span style="width:<%= item.percent %>%;"></span></div>
                  <p style="font-size:.62rem;color:var(--muted);margin:.2rem 0 0;"><%= item.note %></p>
                </a>
              </div>
            <% }) %>
          </div>
          </div>
        </div>
      </div>

      <div class="col-lg-4">
        <div class="dashboard-panel h-100">
          <div class="dashboard-panel-head">
            <div>
          <p class="section-label mb-2"><%= periodLabel %></p>
          <h5 style="font-weight:800;color:var(--ink);"><i class="bi bi-trophy me-2" style="color:var(--warn);"></i>Top Performing Staff</h5>
          <p style="color:var(--muted);font-size:.75rem;">Ranked by completed appointments, then revenue.</p>
            </div>
          </div>
          <div class="dashboard-panel-body">
          <% if (!topPerformingStaff) { %>
            <div class="rounded-xl p-3 text-center mt-3" style="background:var(--neutral-bg);">
              <i class="bi bi-person-check" style="font-size:1.7rem;color:var(--accent);"></i>
              <p style="font-weight:700;color:var(--ink);margin:.6rem 0 .2rem;">No result yet</p>
              <p style="color:var(--muted);font-size:.72rem;margin:0;">No completed staff appointments were recorded for this period.</p>
            </div>
          <% } else { %>
            <div class="rounded-xl p-3 mt-3" style="background:var(--accent-light);">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="icon-circle flex-shrink-0"><i class="bi bi-person-fill" style="color:var(--accent);"></i></div>
                <div>
                  <p style="font-weight:800;color:var(--ink);margin:0;"><%= topPerformingStaff.full_name %></p>
                  <p style="color:var(--muted);font-size:.7rem;margin:0;"><%= topPerformingStaff.role || 'Staff member' %></p>
                </div>
              </div>
              <div class="d-flex justify-content-between py-2 border-top"><span style="font-size:.72rem;color:var(--muted);">Completed</span><strong><%= Number(topPerformingStaff.completed_bookings || 0) %></strong></div>
              <div class="d-flex justify-content-between py-2 border-top"><span style="font-size:.72rem;color:var(--muted);">Revenue</span><strong>S$<%= Number(topPerformingStaff.revenue || 0).toFixed(2) %></strong></div>
            </div>
          <% } %>
          <a href="/merchant/staff" class="btn btn-outline-secondary btn-pill btn-sm w-100 mt-3">Manage Staff</a>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <div class="row g-4 mb-5">
      <div class="col-lg-8">
        <div class="dashboard-panel h-100">
          <div class="dashboard-panel-head">
            <div>
              <p class="section-label mb-2"><%= t('merchant.dashboard.readiness') %></p>
              <h5 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;"><%= t('merchant.dashboard.setupStatus') %></h5>
              <p style="color:var(--muted);font-size:.75rem;margin:0;"><%= t('merchant.dashboard.setupSub') %></p>
            </div>
            <span class="signal-pill"><i class="bi bi-activity"></i><%= actions.length ? t('merchant.dashboard.alertCount', { count: actions.length }) : t('merchant.dashboard.ready') %></span>
          </div>
          <div class="dashboard-panel-body">
            <div class="row g-3">
              <% [
                {label:t('merchant.dashboard.serviceCoverage'), value:t('admin.common.countActive', { count: operations.activeServices }), note:t('admin.common.countDisabled', { count: operations.inactiveServices }), percent:serviceCoverage, icon:'bi-scissors', href:'/merchant/services'},
                {label:t('merchant.dashboard.staffAvailability'), value:t('admin.common.countActive', { count: operations.activeStaff }), note:t('merchant.dashboard.countInactive', { count: operations.inactiveStaff }), percent:staffCoverage, icon:'bi-people', href:'/merchant/staff'},
                {label:t('merchant.dashboard.operatingHours'), value:t('merchant.dashboard.daysActive', { count: operations.activeAvailabilityDays }), note:operations.missingAvailabilityDays.length ? t('merchant.dashboard.missingDays', { days: operations.missingAvailabilityDays.join(', ') }) : t('merchant.dashboard.allDaysConfigured'), percent:hoursCoverage, icon:'bi-clock', href:'/merchant/availability'},
              ].forEach(item => { %>
                <div class="col-md-4">
                  <a href="<%= item.href %>" class="rounded-xl p-3 h-100 d-block text-decoration-none" style="background:var(--neutral-bg);">
                    <i class="bi <%= item.icon %>" style="color:var(--accent);"></i>
                    <p style="font-size:.7rem;color:var(--muted);margin:.55rem 0 .15rem;"><%= item.label %></p>
                    <strong style="font-size:.85rem;color:var(--ink);"><%= item.value %></strong>
                    <span style="float:right;font-size:.68rem;font-weight:800;color:var(--accent);"><%= item.percent %>%</span>
                    <div class="capacity-meter"><span style="width:<%= item.percent %>%;"></span></div>
                    <p style="font-size:.62rem;color:var(--muted);margin:.2rem 0 0;"><%= item.note %></p>
                  </a>
                </div>
              <% }) %>
            </div>
          </div>
        </div>
      </div>
      <div class="col-lg-4">
        <div class="dashboard-panel h-100" style="background:linear-gradient(145deg,#fff,var(--accent-light));border-color:rgba(225,29,72,.18);">
          <div class="dashboard-panel-body h-100 d-flex flex-column justify-content-center">
            <div class="metric-icon mb-3"><i class="bi bi-graph-up-arrow"></i></div>
            <p class="section-label mb-2"><%= t('merchant.dashboard.reportingEyebrow') %></p>
            <h5 style="font-weight:800;color:var(--ink);"><%= t('merchant.dashboard.understandPerf') %></h5>
            <p style="color:var(--muted);font-size:.78rem;"><%= t('merchant.dashboard.exploreTrends') %></p>
            <a href="/merchant/insights?period=30d" class="btn btn-primary btn-pill mt-auto"><%= t('merchant.dashboard.openInsights') %> <i class="bi bi-arrow-right ms-1"></i></a>
          </div>
        </div>
      </div>
    </div>

    <div class="row g-4 mb-5">
      <!-- Warning lights appear only when the merchant needs to act. -->
      <div class="col-lg-5">
        <div class="dashboard-panel h-100">
          <div class="dashboard-panel-head">
            <div>
          <h5 style="font-weight:800;color:var(--ink);"><i class="bi bi-exclamation-circle me-2" style="color:var(--warn);"></i><%= t('merchant.dashboard.pendingActions') %></h5>
          <p style="color:var(--muted);font-size:.8rem;"><%= t('merchant.dashboard.pendingActionsSub') %></p>
            </div>
            <span class="signal-pill"><%= t('merchant.dashboard.alertCount', { count: actions.length }) %></span>
          </div>
          <div class="dashboard-panel-body">
          <% if (!actions.length) { %>
            <div class="rounded-xl p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
              <i class="bi bi-check-circle me-2"></i><%= t('merchant.dashboard.noActionNeeded') %>
            </div>
          <% } else { %>
            <div class="d-grid gap-2">
              <% actions.forEach(action => { %>
                <a href="<%= action.href %>" class="text-decoration-none rounded-xl p-3 d-flex align-items-start gap-3"
                   style="background:var(--warn-bg);color:var(--ink);">
                  <i class="bi <%= action.icon %>" style="color:var(--warn);"></i>
                  <span style="font-size:.82rem;font-weight:700;"><%= action.label %></span>
                  <i class="bi bi-chevron-right ms-auto" style="color:var(--muted);"></i>
                </a>
              <% }) %>
            </div>
          <% } %>
          </div>
        </div>
      </div>

      <div class="col-lg-7">
        <div class="dashboard-panel h-100 overflow-hidden">
          <div class="dashboard-panel-head">
            <div>
            <h5 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;"><%= t('merchant.dashboard.todaySchedule') %></h5>
            <p style="color:var(--muted);font-size:.8rem;"><%= t('merchant.dashboard.todayScheduleSub') %></p>
            </div>
            <span class="signal-pill"><i class="bi bi-calendar3"></i><%= t('merchant.dashboard.upcomingCount', { count: schedule.length }) %></span>
          </div>
          <% if (!schedule.length) { %>
            <div class="text-center px-4 pb-5 pt-3">
              <i class="bi bi-calendar2-check" style="font-size:2rem;color:var(--accent);"></i>
              <p style="font-weight:700;color:var(--ink);margin:.7rem 0 .2rem;"><%= t('merchant.dashboard.noMoreToday') %></p>
              <p style="color:var(--muted);font-size:.8rem;margin:0;"><%= t('merchant.dashboard.scheduleClear') %></p>
            </div>
          <% } else { %>
            <div class="table-responsive">
              <table class="table table-hover align-middle mb-0" style="font-size:.8rem;">
                <thead style="background:var(--accent-light);"><tr><th><%= t('common.time') %></th><th><%= t('admin.table.customer') %></th><th><%= t('common.service') %></th><th><%= t('common.staff') %></th><th><%= t('admin.table.status') %></th></tr></thead>
                <tbody>
                  <% schedule.forEach(item => { const style = statusStyles[item.status] || statusStyles.confirmed; %>
                    <tr>
                      <td style="font-weight:800;font-family:var(--font-mono);"><%= String(item.booking_time || '').slice(0,5) %></td>
                      <td><%= item.customer_name %></td>
                      <td><%= item.service_name %></td>
                      <td><%= item.staff_name %></td>
                      <td><span class="badge rounded-pill" style="background:<%= style.bg %>;color:<%= style.color %>;"><%= style.label %></span></td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <% if (false) { /* Booking-outcome and revenue-trend analysis moved to Business Insights. */ %>
    <div class="row g-4 mb-5">
      <div class="col-lg-6">
        <div class="dashboard-panel h-100">
          <div class="dashboard-panel-head">
            <div>
              <p class="section-label mb-2">Appointment Results</p>
              <h5 style="font-weight:800;color:var(--ink);"><%= periodLabel %> Booking Outcomes</h5>
              <p style="color:var(--muted);font-size:.75rem;">Direct counts make completed work and lost appointments easy to compare.</p>
            </div>
            <a href="/merchant/bookings" class="btn btn-outline-secondary btn-pill btn-sm">View</a>
          </div>
          <div class="dashboard-panel-body">
            <div class="outcome-track mb-4" aria-label="Booking outcome distribution">
              <% outcomeItems.forEach(item => { %>
                <span style="width:<%= outcomeTotal ? (item.value / outcomeTotal) * 100 : 0 %>%;background:<%= item.color %>;" title="<%= item.label %>: <%= item.value %>"></span>
              <% }) %>
            </div>
            <div class="d-grid gap-3">
              <% outcomeItems.forEach(item => { %>
                <div class="outcome-row">
                  <span style="font-size:.72rem;font-weight:700;color:var(--muted);"><i class="bi <%= item.icon %> me-1" style="color:<%= item.color %>;"></i><%= item.label %></span>
                  <div class="outcome-line"><span style="width:<%= (item.value / maxOutcome) * 100 %>%;background:<%= item.color %>;"></span></div>
                  <strong style="font-size:.8rem;color:<%= item.color %>;text-align:right;"><%= item.value %></strong>
                </div>
              <% }) %>
            </div>
            <p style="font-size:.65rem;color:var(--muted);margin:1.25rem 0 0;">The stacked bar shows the proportion of each appointment outcome.</p>
          </div>
        </div>
      </div>

      <div class="col-lg-6">
        <div class="dashboard-panel h-100">
          <div class="dashboard-panel-head">
            <div>
              <p class="section-label mb-2">Performance Trend</p>
              <h5 style="font-weight:800;color:var(--ink);">Six-Month Revenue</h5>
              <p style="color:var(--muted);font-size:.75rem;">Successful payments reveal the direction of demand.</p>
            </div>
            <a href="/merchant/revenue?month=<%= selectedPeriod %>" class="btn btn-outline-secondary btn-pill btn-sm align-self-start">Report</a>
          </div>
          <div class="dashboard-panel-body">
          <% if (!revenueTrend.length) { %>
            <div class="rounded-xl p-4 text-center mt-4" style="background:var(--neutral-bg);">
              <i class="bi bi-bar-chart" style="font-size:1.8rem;color:var(--accent);"></i>
              <p style="font-weight:700;color:var(--ink);margin:.6rem 0 .2rem;">No paid revenue trend yet</p>
              <p style="color:var(--muted);font-size:.7rem;margin:0;">Monthly bars will appear after successful payments.</p>
            </div>
          <% } else { %>
            <div class="trend-chart">
              <% revenueTrend.forEach(item => {
                const barHeight = Math.max(4, Math.round((Number(item.revenue || 0) / maxMonthlyRevenue) * 100));
              %>
                <div class="trend-column">
                  <span style="font-size:.6rem;color:var(--muted);">S$<%= Number(item.revenue || 0).toFixed(0) %></span>
                  <div class="trend-bar-track mt-1">
                    <div class="trend-bar" style="height:<%= barHeight %>%;" title="<%= item.month %>: S$<%= Number(item.revenue || 0).toFixed(2) %>"></div>
                  </div>
                  <span style="font-size:.62rem;color:var(--muted);"><%= monthLabel(item.month) %></span>
                </div>
              <% }) %>
            </div>
          <% } %>
          <div class="d-flex justify-content-between align-items-center rounded-xl p-3 mt-3" style="background:var(--accent-light);">
            <div>
              <p style="font-size:.68rem;color:var(--muted);margin-bottom:.1rem;"><%= periodLabel %></p>
              <strong style="color:var(--ink);">S$<%= Number(revenue.month_revenue || 0).toFixed(2) %></strong>
            </div>
            <% if (metrics.revenueGrowth === null || typeof metrics.revenueGrowth === 'undefined') { %>
              <strong style="font-size:.8rem;color:var(--muted);">No previous-month baseline yet</strong>
            <% } else { %>
              <strong style="font-size:.85rem;color:<%= Number(metrics.revenueGrowth) >= 0 ? 'var(--success)' : 'var(--danger)' %>;">
                <i class="bi bi-arrow-<%= Number(metrics.revenueGrowth) >= 0 ? 'up' : 'down' %>-right me-1"></i><%= Math.abs(Number(metrics.revenueGrowth)) %>%
              </strong>
              <span style="font-size:.72rem;color:var(--muted);"> vs previous month</span>
            <% } %>
          </div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Management shortcuts remain available without repeating dashboard indicators. -->
    <div class="d-flex justify-content-between align-items-end gap-2 mb-3">
      <div><h5 style="font-weight:800;color:var(--ink);margin:0;"><%= t('merchant.dashboard.quickActions') %></h5><p style="color:var(--muted);font-size:.8rem;margin:0;"><%= t('merchant.dashboard.quickActionsSub') %></p></div>
      <a href="/merchant/manage" class="btn btn-outline-secondary btn-pill btn-sm"><%= t('merchant.dashboard.allTools') %></a>
    </div>
    <div class="row g-3">
      <% [
        {href:'/merchant/bookings', icon:'bi-calendar-check', label:t('merchant.dashboard.qa.bookings')},
        {href:'/merchant/services', icon:'bi-scissors', label:t('merchant.insights.manageServices')},
        {href:'/merchant/staff', icon:'bi-people', label:t('merchant.insights.manageStaff')},
        {href:'/merchant/availability', icon:'bi-clock', label:t('merchant.dashboard.qa.availability')},
        {href:'/merchant/promotions', icon:'bi-tag', label:t('merchant.dashboard.qa.promotions')},
        {href:'/merchant/qr', icon:'bi-qr-code', label:t('merchant.dashboard.qa.qr')},
        {href:'/merchant/waitlists', icon:'bi-list-ol', label:t('merchant.dashboard.qa.waitlists'), badge:activeWaitlists},
        {href:'/merchant/revenue?month=' + selectedPeriod, icon:'bi-graph-up', label:t('merchant.dashboard.qa.revenue')},
      ].forEach(action => { %>
        <div class="col-6 col-md-3">
          <a href="<%= action.href %>" class="action-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-2 w-100">
              <div class="action-icon"><i class="bi <%= action.icon %>"></i></div>
              <% if (Number(action.badge || 0) > 0) { %>
                <span class="badge rounded-pill" style="background:var(--accent);color:#fff;"><%= action.badge %></span>
              <% } %>
            </div>
            <p style="font-weight:700;font-size:.82rem;color:var(--ink);margin:0;"><%= action.label %></p>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
