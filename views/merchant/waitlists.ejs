<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const waitlistRows = Array.isArray(waitlists) ? waitlists : [];
  const statusStyles = {
    waiting:   { label: 'Waiting', bg: 'var(--warn-bg)', color: 'var(--warn)' },
    offered:   { label: 'Offer Sent', bg: 'var(--success-bg)', color: 'var(--success)' },
    confirmed: { label: 'Confirmed', bg: 'var(--success-bg)', color: 'var(--success)' },
    expired:   { label: 'Expired', bg: 'var(--danger-bg)', color: 'var(--danger)' },
    cancelled: { label: 'Cancelled', bg: 'var(--canvas)', color: 'var(--muted)' },
    removed:   { label: 'Removed', bg: 'var(--canvas)', color: 'var(--muted)' },
  };

  function formatDate(value) {
    return new Date(value).toLocaleDateString('en-SG', {
      day: 'numeric',
      month: 'short',
      year: 'numeric',
    });
  }

  function formatTime(value) {
    return String(value || '').slice(0, 5);
  }
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:1100px;">
    <a href="/merchant/manage" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
      <i class="bi bi-arrow-left me-1"></i>Management
    </a>

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <p class="section-label mb-2">Waitlist</p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Slot Waitlists</h2>
        <p style="color:var(--muted);margin:0;">View customers waiting for fully booked service times.</p>
      </div>
      <a href="/merchant/bookings" class="btn btn-primary btn-pill">
        <i class="bi bi-calendar-check me-1"></i>Bookings
      </a>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>
    <% if (typeof success !== 'undefined' && success) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
        <i class="bi bi-check-circle me-2"></i><%= success %>
      </div>
    <% } %>

    <% if (!waitlistRows.length) { %>
      <div class="card border-0 text-center py-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="icon-circle-lg mx-auto mb-3">
          <i class="bi bi-list-ol" style="font-size:2rem;color:var(--accent);"></i>
        </div>
        <h6 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">No waitlist requests</h6>
        <p style="color:var(--muted);font-size:.875rem;margin:0 auto;max-width:420px;">
          Fully booked slot requests will appear here when customers join a waitlist.
        </p>
      </div>
    <% } else { %>
      <div class="card border-0 overflow-hidden" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0" style="font-size:.8125rem;">
            <thead style="background:var(--accent-light);">
              <tr>
                <th>Customer</th>
                <th>Service</th>
                <th>Date &amp; Time</th>
                <th>Queue Size</th>
                <th>Status</th>
                <th>Joined</th>
              </tr>
            </thead>
            <tbody>
              <% waitlistRows.forEach(entry => {
                const status = statusStyles[entry.status] || statusStyles.waiting;
              %>
              <tr>
                <td>
                  <p style="font-weight:700;margin-bottom:0;color:var(--ink);"><%= entry.customer_name %></p>
                  <p style="color:var(--muted);font-size:.75rem;margin-bottom:0;"><%= entry.customer_phone || entry.customer_email || 'No contact' %></p>
                </td>
                <td><%= entry.service_name %></td>
                <td>
                  <%= formatDate(entry.booking_date) %>
                  <br>
                  <span style="color:var(--muted);"><%= formatTime(entry.booking_time) %></span>
                </td>
                <td>
                  <span class="badge rounded-pill" style="background:var(--accent-light);color:var(--accent);">
                    <%= entry.waiting_count || 1 %> waiting
                  </span>
                </td>
                <td>
                  <span class="badge rounded-pill" style="background:<%= status.bg %>;color:<%= status.color %>;">
                    <%= status.label %>
                  </span>
                  <% if (entry.status === 'offered' && entry.offer_expires_at) { %>
                    <div style="font-size:.72rem;color:var(--muted);margin-top:.25rem;">Expires <%= new Date(entry.offer_expires_at).toLocaleTimeString('en-SG',{hour:'2-digit',minute:'2-digit'}) %></div>
                  <% } %>
                </td>
                <td style="color:var(--muted);"><%= new Date(entry.joined_at).toLocaleString('en-SG',{day:'numeric',month:'short',hour:'2-digit',minute:'2-digit'}) %></td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
