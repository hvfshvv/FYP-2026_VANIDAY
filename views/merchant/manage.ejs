<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:1100px;">
    <a href="/merchant/dashboard" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
      <i class="bi bi-arrow-left me-1"></i><%= t('merchant.manage.dashboardOverview') %>
    </a>

    <div class="mb-4">
      <p class="section-label"><%= t('merchant.manage.eyebrow') %></p>
      <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;"><%= t('merchant.manage.title') %></h2>
      <p style="color:var(--muted);margin:0;"><%= t('merchant.manage.subtitle') %></p>
    </div>

    <% if (imageError) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;"><i class="bi bi-exclamation-circle me-2"></i><%= imageError %></div>
    <% } %>
    <% if (imageSuccess) { %>
      <div class="rounded-xl mb-3 p-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;"><i class="bi bi-check-circle me-2"></i><%= imageSuccess %></div>
    <% } %>

    <div class="row g-3 mb-5">
      <% const activeWaitlists = Number(activeWaitlistCount || 0); %>
      <% [
        {href:'/merchant/services', icon:'bi-scissors', label:t('merchant.nav.services'), sub:t('merchant.manage.servicesSub')},
        {href:'/merchant/bookings', icon:'bi-calendar-check', label:t('merchant.nav.bookings'), sub:t('merchant.manage.bookingsSub')},
        {href:'/merchant/waitlists', icon:'bi-list-ol', label:t('merchant.nav.waitlists'), sub:t('merchant.manage.waitlistsSub'), badge:activeWaitlists},
        {href:'/merchant/staff', icon:'bi-people', label:t('merchant.nav.staff'), sub:t('merchant.manage.staffSub')},
        {href:'/merchant/availability', icon:'bi-clock', label:t('merchant.nav.availability'), sub:t('merchant.manage.availabilitySub')},
        {href:'/merchant/promotions', icon:'bi-tag', label:t('merchant.nav.promotions'), sub:t('merchant.manage.promotionsSub')},
        {href:'/merchant/reviews', icon:'bi-star', label:t('merchant.nav.reviews'), sub:t('merchant.manage.reviewsSub')},
        {href:'/merchant/qr', icon:'bi-qr-code', label:t('merchant.nav.qr'), sub:t('merchant.manage.qrSub')},
        {href:'/merchant/cancellation-policy', icon:'bi-hourglass-split', label:t('merchant.nav.cancellationPolicy'), sub:t('merchant.manage.policySub')},
        {href:'/merchant/revenue', icon:'bi-graph-up', label:t('merchant.nav.revenue'), sub:t('merchant.manage.revenueSub')},
      ].forEach(action => { %>
        <div class="col-6 col-md-4">
          <a href="<%= action.href %>?from=manage" class="action-card h-100">
            <div class="d-flex justify-content-between align-items-start gap-2 w-100">
              <div class="action-icon"><i class="bi <%= action.icon %>"></i></div>
              <% if (Number(action.badge || 0) > 0) { %>
                <span class="badge rounded-pill" style="background:var(--accent);color:#fff;"><%= action.badge %></span>
              <% } %>
            </div>
            <p style="font-weight:700;font-size:.875rem;color:var(--ink);margin-bottom:.1rem;"><%= action.label %></p>
            <p style="color:var(--muted);font-size:.72rem;margin:0;"><%= action.sub %></p>
          </a>
        </div>
      <% }) %>
    </div>

    <!-- Marketplace photo remains a management setting rather than a dashboard indicator. -->
    <div class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);overflow:hidden;">
      <div class="row g-0 align-items-stretch">
        <div class="col-md-4">
          <% if (merchant && merchant.profile_image) { %>
            <img src="<%= merchant.profile_image %>" alt="<%= merchant.merchant_name %>" style="width:100%;height:100%;min-height:220px;object-fit:cover;display:block;">
          <% } else { %>
            <div style="min-height:220px;height:100%;background:var(--accent-light);color:var(--accent);display:flex;align-items:center;justify-content:center;font-size:3rem;"><i class="bi bi-image"></i></div>
          <% } %>
        </div>
        <div class="col-md-8">
          <div class="p-4 h-100 d-flex flex-column justify-content-center">
            <p class="section-label mb-2"><%= t('merchant.manage.photoEyebrow') %></p>
            <h5 style="font-weight:800;color:var(--ink);"><%= t('merchant.manage.photoTitle') %></h5>
            <p style="color:var(--muted);"><%= t('merchant.manage.photoBody') %></p>
            <form action="/merchant/marketplace-image" method="POST" enctype="multipart/form-data" class="d-flex flex-wrap gap-2 align-items-center">
              <input type="file" name="marketplace_image" class="form-control rounded-xl" accept="image/*" required style="max-width:360px;">
              <button type="submit" class="btn btn-primary btn-pill"><i class="bi bi-upload me-1"></i><%= t('merchant.manage.updatePhoto') %></button>
            </form>
            <p class="small mt-2 mb-0" style="color:var(--muted);"><%= t('merchant.manage.photoHint') %></p>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
