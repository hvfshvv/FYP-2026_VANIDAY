<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:860px;">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
      <div>
        <p class="section-label mb-2">Merchant Policy</p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Cancellation Policy</h2>
        <p style="color:var(--muted);margin:0;"><%= t('merchantPolicy.subtitle') %></p>
      </div>
      <a href="/merchant/dashboard" class="btn btn-outline-secondary btn-pill">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
      </a>
    </div>

    <% if (error) { %>
      <div class="rounded-xl p-3 mb-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
        <i class="bi bi-exclamation-circle me-2"></i><%= error %>
      </div>
    <% } %>
    <% if (success) { %>
      <div class="rounded-xl p-3 mb-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
        <i class="bi bi-check-circle me-2"></i><%= success %>
      </div>
    <% } %>

    <div class="card border-0 mb-4" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="card-body p-4">
        <p class="section-label mb-2">Current customer message</p>
        <p style="color:var(--ink);font-weight:700;margin:0;">
          <i class="bi bi-hourglass-split me-2" style="color:var(--accent);"></i><%= policySummary %>
        </p>
        <p class="mt-3 mb-0" style="color:var(--muted);font-size:.875rem;">
          <%= t('merchantPolicy.baseline') %>
        </p>
      </div>
    </div>

    <form method="POST" action="/merchant/cancellation-policy" class="card border-0" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
      <div class="card-body p-4">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label" style="font-weight:700;">Minimum cancellation notice</label>
            <div class="input-group">
              <input
                type="number"
                name="min_cancel_hours"
                class="form-control rounded-start-xl"
                min="6"
                max="168"
                step="1"
                value="<%= policy.min_cancel_hours || 6 %>"
                required
              >
              <span class="input-group-text rounded-end-xl">hours</span>
            </div>
          </div>

          <div class="col-md-6">
            <label class="form-label" style="font-weight:700;">Refund percentage</label>
            <div class="input-group">
              <input
                type="number"
                name="refund_percentage"
                class="form-control rounded-start-xl"
                min="0"
                max="95"
                step="1"
                value="<%= Math.min(95, Number(policy.refund_percentage || 0)).toFixed(0) %>"
                required
              >
              <span class="input-group-text rounded-end-xl">%</span>
            </div>
            <p class="mt-2 mb-0" style="color:var(--muted);font-size:.82rem;"><%= t('merchantPolicy.refundCapHelp') %></p>
          </div>

          <div class="col-md-6">
            <label class="form-label" style="font-weight:700;">Allow rescheduling?</label>
            <select name="allow_reschedule" class="form-select rounded-xl">
              <option value="1" <%= policy.allow_reschedule ? 'selected' : '' %>>Yes</option>
              <option value="0" <%= !policy.allow_reschedule ? 'selected' : '' %>>No</option>
            </select>
          </div>

          <div class="col-md-6">
            <label class="form-label" style="font-weight:700;">Policy status</label>
            <select name="is_active" class="form-select rounded-xl">
              <option value="1" <%= policy.is_active ? 'selected' : '' %>>Active</option>
              <option value="0" <%= !policy.is_active ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>
        </div>

        <div class="d-flex justify-content-end mt-4">
          <button class="btn btn-primary btn-pill" type="submit">
            <i class="bi bi-save me-1"></i>Save Policy
          </button>
        </div>
      </div>
    </form>
  </div>
</main>

<%- include('../partials/footer') %>
