<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<%
  const reviewList = Array.isArray(reviews) ? reviews : [];
  const avg = Number(summary?.average_rating || 0);
  const count = Number(summary?.review_count || 0);
  const stars = value => {
    const rating = Math.round(Number(value || 0));
    return Array.from({ length: 5 }, (_, i) => i < rating ? 'bi-star-fill' : 'bi-star').join(',');
  };
  const formatDate = value => new Date(value).toLocaleDateString('en-SG', { day: 'numeric', month: 'short', year: 'numeric' });
%>

<main style="background:var(--canvas);min-height:80vh;padding:3rem 1rem;">
  <div class="container" style="max-width:980px;">
    <a href="/merchant/dashboard" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
      <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>

    <div class="d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
      <div>
        <p class="section-label mb-2">Reviews</p>
        <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">Customer Reviews</h2>
        <p style="color:var(--muted);margin:0;">Read verified booking reviews and reply to customers.</p>
      </div>
      <div class="stat-card text-center" style="min-width:170px;">
        <p style="color:var(--muted);font-size:.8125rem;margin-bottom:.35rem;">Average Rating</p>
        <p class="stat-value" style="color:#f59e0b;"><%= avg.toFixed(1) %>/5</p>
        <p style="color:var(--muted);font-size:.8rem;margin:0;"><%= count %> review<%= count === 1 ? '' : 's' %></p>
      </div>
    </div>

    <% if (success) { %>
    <div class="rounded-xl p-3 mb-3" style="background:var(--success-bg);color:var(--success);font-size:.875rem;">
      <i class="bi bi-check-circle me-2"></i><%= success %>
    </div>
    <% } %>
    <% if (error) { %>
    <div class="rounded-xl p-3 mb-3" style="background:var(--danger-bg);color:var(--danger);font-size:.875rem;">
      <i class="bi bi-exclamation-circle me-2"></i><%= error %>
    </div>
    <% } %>

    <% if (!reviewList.length) { %>
      <div class="card border-0 text-center p-5" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <div class="icon-circle-lg mx-auto mb-3">
          <i class="bi bi-star" style="font-size:2rem;color:var(--accent);"></i>
        </div>
        <h6 style="font-weight:800;color:var(--ink);margin-bottom:.25rem;">No reviews yet</h6>
        <p style="color:var(--muted);margin-bottom:0;">Completed bookings can leave verified reviews.</p>
      </div>
    <% } else { %>
      <div class="d-flex flex-column gap-3">
        <% reviewList.forEach(review => { %>
        <article class="card border-0" style="box-shadow:var(--shadow-sm);border-radius:var(--r-lg);">
          <div class="card-body p-4">
            <div class="d-flex flex-wrap justify-content-between gap-3 mb-2">
              <div>
                <p style="font-weight:800;color:var(--ink);margin-bottom:.15rem;"><%= review.customer_name %></p>
                <p style="color:var(--muted);font-size:.85rem;margin:0;">
                  <%= review.service_name %>
                  <% if (review.staff_name) { %> · <%= review.staff_name %><% } %>
                </p>
              </div>
              <div class="text-md-end">
                <div style="color:#f59e0b;">
                  <% stars(review.rating).split(',').forEach(icon => { %><i class="bi <%= icon %>"></i><% }) %>
                </div>
                <p style="color:var(--muted);font-size:.8rem;margin:.2rem 0 0;"><%= formatDate(review.created_at) %></p>
              </div>
            </div>

            <p style="color:var(--ink);margin:1rem 0;"><%= review.review_text || 'No written comment.' %></p>
            <% if (review.review_image_path) { %>
              <img src="<%= review.review_image_path %>" alt="Photo review by <%= review.customer_name %>" style="width:100%;max-height:360px;object-fit:contain;background:#111;border-radius:12px;margin-bottom:1rem;">
            <% } %>

            <% if (review.merchant_reply) { %>
              <div class="rounded-xl p-3" style="background:var(--accent-light);border:1px solid rgba(225,29,72,.12);">
                <p style="font-weight:800;color:var(--accent);font-size:.85rem;margin-bottom:.35rem;">Your reply</p>
                <p style="color:var(--ink);margin:0;"><%= review.merchant_reply %></p>
              </div>
            <% } else { %>
              <form action="/merchant/reviews/<%= review.review_id %>/reply" method="POST" class="mt-3">
                <label class="form-label" style="font-weight:700;font-size:.875rem;">Reply to this review</label>
                <textarea name="reply_text" class="form-control rounded-xl mb-2" rows="2" maxlength="1000" required placeholder="Thank the customer or address their feedback..."></textarea>
                <button class="btn btn-primary btn-sm btn-pill" style="font-weight:800;">
                  <i class="bi bi-reply me-1"></i>Save Reply
                </button>
              </form>
            <% } %>
          </div>
        </article>
        <% }) %>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
