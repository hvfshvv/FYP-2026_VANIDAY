<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div class="container py-5" style="max-width:1080px;">
  <a href="/merchant/dashboard" class="btn btn-outline-secondary btn-sm btn-pill mb-4">
    <i class="bi bi-arrow-left me-1"></i>Dashboard
  </a>

  <h2 style="font-weight:800;letter-spacing:-.03em;color:var(--ink);margin-bottom:.25rem;">QR Code Management</h2>
  <p style="color:var(--muted);margin-bottom:2rem;max-width:780px;">
    Use separate merchant-specific QR codes for booking and arrival confirmation. Print the booking QR where customers discover services, and place the arrival QR at your counter.
  </p>

  <div class="row g-4 align-items-start">
    <div class="col-lg-7">
      <div class="row g-4">
        <div class="col-md-6">
          <div class="card border-0 text-center p-4 h-100" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
            <% if (qr) { %>
              <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                <i class="bi bi-check-circle-fill" style="color:var(--success);font-size:1.1rem;"></i>
                <p style="font-weight:800;color:var(--success);margin-bottom:0;font-size:.9375rem;">Booking QR Code</p>
              </div>
              <div class="p-3 d-inline-block rounded-xl mx-auto mb-3" style="background:#fff;border:3px solid var(--accent);box-shadow:0 4px 20px rgba(225,29,72,.12);">
                <img src="<%= qr.qr_image_path %>" alt="Booking QR Code" style="width:210px;height:210px;" />
              </div>
              <p style="color:var(--muted);font-size:.875rem;margin-bottom:1rem;">Customers scan this to open your booking page.</p>
              <a href="<%= qr.qr_image_path %>" download="uniday-merchant-<%= qr.merchant_id %>-booking-qr.png" class="btn btn-primary btn-pill w-100 mb-2">
                <i class="bi bi-download me-2"></i>Download Booking QR
              </a>
              <button type="button" onclick="printQR('booking-qr-print-area', 'qr-printing-booking')" class="btn btn-outline-secondary btn-pill w-100 mb-2">
                <i class="bi bi-printer me-2"></i>Print Booking QR
              </button>
              <div class="mt-3 p-2 rounded-xl text-start" style="background:var(--accent-light);">
                <p style="font-size:.75rem;color:var(--accent);margin-bottom:.1rem;"><i class="bi bi-link-45deg me-1"></i>Booking URL</p>
                <p style="font-size:.78rem;font-family:var(--font-mono);font-weight:600;color:var(--ink);margin-bottom:0;word-break:break-all;"><%= qr.qr_url %></p>
              </div>
            <% } else { %>
              <div class="icon-circle-lg mx-auto mb-3">
                <i class="bi bi-qr-code" style="font-size:2rem;color:var(--accent);"></i>
              </div>
              <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;">No Booking QR Yet</h5>
              <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.5rem;">Unable to generate your booking QR automatically. Please refresh or contact support.</p>
            <% } %>
          </div>
        </div>

        <div class="col-md-6">
          <div class="card border-0 text-center p-4 h-100" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
            <% if (arrivalQr) { %>
              <div class="d-flex align-items-center justify-content-center gap-2 mb-3">
                <i class="bi bi-person-check-fill" style="color:var(--accent);font-size:1.1rem;"></i>
                <p style="font-weight:800;color:var(--accent);margin-bottom:0;font-size:.9375rem;">Arrival Confirmation QR Code</p>
              </div>
              <div class="p-3 d-inline-block rounded-xl mx-auto mb-3" style="background:#fff;border:3px solid var(--accent);box-shadow:0 4px 20px rgba(225,29,72,.12);">
                <img src="<%= arrivalQr.qr_image_path %>" alt="Arrival Confirmation QR Code" style="width:210px;height:210px;" />
              </div>
              <p style="color:var(--muted);font-size:.875rem;margin-bottom:1rem;">Customers scan this when they arrive for today's confirmed booking.</p>
              <a href="<%= arrivalQr.qr_image_path %>" download="uniday-merchant-<%= arrivalQr.merchant_id %>-arrival-qr.png" class="btn btn-primary btn-pill w-100 mb-2">
                <i class="bi bi-download me-2"></i>Download Arrival QR
              </a>
              <button type="button" onclick="printQR('arrival-qr-print-area', 'qr-printing-arrival')" class="btn btn-outline-secondary btn-pill w-100 mb-2">
                <i class="bi bi-printer me-2"></i>Print Arrival QR
              </button>
              <div class="mt-3 p-2 rounded-xl text-start" style="background:var(--accent-light);">
                <p style="font-size:.75rem;color:var(--accent);margin-bottom:.1rem;"><i class="bi bi-link-45deg me-1"></i>Arrival URL</p>
                <p style="font-size:.78rem;font-family:var(--font-mono);font-weight:600;color:var(--ink);margin-bottom:0;word-break:break-all;"><%= arrivalQr.qr_url %></p>
              </div>
            <% } else { %>
              <div class="icon-circle-lg mx-auto mb-3">
                <i class="bi bi-person-check" style="font-size:2rem;color:var(--accent);"></i>
              </div>
              <h5 style="font-weight:800;color:var(--ink);margin-bottom:.5rem;">No Arrival QR Yet</h5>
              <p style="color:var(--muted);font-size:.875rem;margin-bottom:1.5rem;">Unable to generate your arrival QR automatically. Please refresh or contact support.</p>
            <% } %>
          </div>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card border-0 p-4 mb-3" style="box-shadow:var(--shadow);border-radius:var(--r-xl);">
        <h6 style="font-weight:800;color:var(--ink);margin-bottom:1rem;">
          <i class="bi bi-list-check me-2" style="color:var(--accent);"></i>How to use your QR codes
        </h6>
        <div class="d-flex flex-column gap-3">
          <% [
            ['bi-calendar-plus', 'Booking QR', 'Place this on posters or social posts. It opens only your merchant booking page.'],
            ['bi-person-check', 'Arrival QR', 'Place this at your counter. It marks the logged-in customer arrived for today only.'],
            ['bi-shield-check', 'Merchant-specific', 'Each QR is tied to your merchant account and cannot update another merchant booking.'],
          ].forEach(([icon,title,desc]) => { %>
          <div class="d-flex gap-3 align-items-start">
            <div class="icon-circle flex-shrink-0" style="background:var(--accent-light);width:40px;height:40px;min-width:40px;">
              <i class="bi <%= icon %>" style="font-size:.9rem;color:var(--accent);"></i>
            </div>
            <div>
              <p style="font-weight:800;font-size:.875rem;color:var(--ink);margin-bottom:.1rem;"><%= title %></p>
              <p style="color:var(--muted);font-size:.8125rem;margin-bottom:0;"><%= desc %></p>
            </div>
          </div>
          <% }) %>
        </div>
      </div>
      <div class="p-3 rounded-xl" style="background:var(--accent-light);border:1.5px solid rgba(225,29,72,.15);">
        <p style="font-size:.8125rem;color:var(--accent);margin-bottom:0;">
          <i class="bi bi-shield-check me-1"></i>
          <strong>Note:</strong> Booking and arrival QR codes are created automatically and remain active until the system updates them.
        </p>
      </div>
    </div>
  </div>
</div>

<% if (qr) { %>
<div id="booking-qr-print-area" class="qr-print-area">
  <div class="qr-print-card">
    <p class="qr-print-kicker">Uniday Booking QR</p>
    <h1><%= qr.merchant_name || 'Uniday Partner' %></h1>
    <% if (qr.address) { %>
    <p class="qr-print-address"><%= qr.address %></p>
    <% } %>
    <div class="qr-print-code">
      <img src="<%= qr.qr_image_path %>" alt="Booking QR Code" />
    </div>
    <p class="qr-print-title">Scan to book an appointment</p>
    <p class="qr-print-note">Choose a service, date, and time directly from this QR.</p>
  </div>
</div>
<% } %>

<% if (arrivalQr) { %>
<div id="arrival-qr-print-area" class="qr-print-area">
  <div class="qr-print-card">
    <p class="qr-print-kicker">Uniday Arrival QR</p>
    <h1><%= arrivalQr.merchant_name || qr?.merchant_name || 'Uniday Partner' %></h1>
    <% if (arrivalQr.address || qr?.address) { %>
    <p class="qr-print-address"><%= arrivalQr.address || qr?.address %></p>
    <% } %>
    <div class="qr-print-code">
      <img src="<%= arrivalQr.qr_image_path %>" alt="Arrival Confirmation QR Code" />
    </div>
    <p class="qr-print-title">Scan on arrival to confirm your appointment</p>
    <p class="qr-print-note">Use this QR at the counter after your booking is confirmed.</p>
  </div>
</div>
<% } %>

<script>
function printQR(areaId, printClass) {
  const area = document.getElementById(areaId);
  if (!area) return;
  document.body.classList.add(printClass);
  area.style.display = 'block';
  window.print();
  area.style.display = 'none';
  document.body.classList.remove(printClass);
}
</script>

<%- include('../partials/footer') %>
