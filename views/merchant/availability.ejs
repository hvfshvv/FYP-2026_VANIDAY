<% locals.hideCatNav = true %>
<%- include('../partials/header') %>

<div class="container py-5">
  <a href="/merchant/dashboard" class="btn btn-outline-secondary btn-pill btn-sm mb-4">
    <i class="bi bi-arrow-left me-1"></i><%= t('nav.dashboard') %>
  </a>

  <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-3">
    <div>
      <p class="section-label"><%= t('merchant.availability.eyebrow') %></p>
      <h2
        style="
          font-weight: 800;
          letter-spacing: -.03em;
          color: var(--ink);
          margin-bottom: .25rem;
        "
      >
        <%= t('merchant.availability.title') %>
      </h2>
      <p style="color: var(--muted); margin-bottom: 0;">
        <%= t('merchant.availability.subtitle') %>
      </p>
    </div>

    <span
      class="badge"
      style="background: var(--accent-light); color: var(--accent);"
    >
      <%= t('merchant.availability.activeDays', { count: availability.filter(a => a.is_active).length }) %>
    </span>
  </div>

  <div class="row g-4">
    <!-- Form -->
    <div class="col-lg-5">
      <div
        class="card border-0"
        style="box-shadow: var(--shadow); border-radius: var(--r-xl);"
      >
        <div class="card-body p-4">
          <h5 style="font-weight: 800; margin-bottom: 1.25rem;">
            <i
              class="bi bi-clock me-2"
              style="color: var(--accent);"
            ></i>
            <%= t('merchant.availability.addUpdate') %>
          </h5>

          <form action="/merchant/availability/save" method="POST">
            <div class="mb-3">
              <label class="form-label"><%= t('merchant.availability.day') %></label>
              <select
                name="day_of_week"
                class="form-select rounded-xl"
                required
              >
                <% ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday',
                'Saturday', 'Sunday'].forEach(day => { %>
                  <option value="<%= day %>"><%= t('common.days.' + day, {}, day) %></option>
                <% }) %>
              </select>
            </div>

            <div class="row g-3 mb-3">
              <div class="col-6">
                <label class="form-label"><%= t('merchant.availability.startTime') %></label>
                <input
                  type="time"
                  name="start_time"
                  class="form-control rounded-xl"
                  required
                >
              </div>

              <div class="col-6">
                <label class="form-label"><%= t('merchant.availability.endTime') %></label>
                <input
                  type="time"
                  name="end_time"
                  class="form-control rounded-xl"
                  required
                >
              </div>
            </div>

            <div class="form-check mb-4">
              <input
                class="form-check-input"
                type="checkbox"
                name="is_active"
                id="is_active"
                checked
              >
              <label class="form-check-label" for="is_active">
                <%= t('merchant.availability.availableForBooking') %>
              </label>
            </div>

            <button class="btn btn-primary btn-pill w-100">
              <i class="bi bi-save me-1"></i><%= t('merchant.availability.save') %>
            </button>
          </form>
        </div>
      </div>
    </div>

    <!-- Table -->
    <div class="col-lg-7">
      <% if (availability.length === 0) { %>
        <div
          class="card border-0 text-center py-5"
          style="box-shadow: var(--shadow); border-radius: var(--r-xl);"
        >
          <div class="icon-circle-lg mx-auto mb-3">
            <i
              class="bi bi-clock"
              style="font-size: 2rem; color: var(--accent);"
            ></i>
          </div>

          <h6
            style="
              font-weight: 700;
              color: var(--ink);
              margin-bottom: .25rem;
            "
          >
            <%= t('merchant.availability.emptyTitle') %>
          </h6>

          <p
            style="
              color: var(--muted);
              font-size: .875rem;
              margin-bottom: 0;
            "
          >
            <%= t('merchant.availability.emptyBody') %>
          </p>
        </div>
      <% } else { %>
        <div
          class="card border-0 overflow-hidden"
          style="box-shadow: var(--shadow); border-radius: var(--r-xl);"
        >
          <div class="table-responsive">
            <table
              class="table table-hover align-middle mb-0"
              style="font-size: .8125rem;"
            >
              <thead>
                <tr>
                  <th><%= t('merchant.availability.day') %></th>
                  <th><%= t('merchant.availability.start') %></th>
                  <th><%= t('merchant.availability.end') %></th>
                  <th><%= t('admin.table.status') %></th>
                  <th style="width: 100px;"><%= t('admin.logs.colAction') %></th>
                </tr>
              </thead>

              <tbody>
                <% availability.forEach(a => { %>
                  <tr>
                    <td>
                      <strong><%= t('common.days.' + a.day_of_week, {}, a.day_of_week) %></strong>
                    </td>

                    <td><%= String(a.start_time).slice(0, 5) %></td>
                    <td><%= String(a.end_time).slice(0, 5) %></td>

                    <td>
                      <% if (a.is_active) { %>
                        <span
                          class="badge"
                          style="
                            background: var(--success-bg);
                            color: var(--success);
                          "
                        >
                          <%= t('merchant.availability.open') %>
                        </span>
                      <% } else { %>
                        <span class="badge bg-secondary"><%= t('merchant.availability.closed') %></span>
                      <% } %>
                    </td>

                    <td>
                      <div class="d-flex flex-column gap-2 align-items-start">
                        <button
                          class="btn btn-sm btn-outline-secondary btn-pill edit-availability-btn"
                          style="
                            font-size: .72rem;
                            padding: .28rem .85rem;
                            min-width: 72px;
                          "
                          data-day="<%= a.day_of_week %>"
                          data-start="<%= String(a.start_time).slice(0, 5) %>"
                          data-end="<%= String(a.end_time).slice(0, 5) %>"
                          data-active="<%= a.is_active %>"
                        >
                          <%= t('admin.common.edit') %>
                        </button>

                        <form
                          action="/merchant/availability/<%= a.availability_id %>/delete"
                          method="POST"
                        >
                          <button
                            class="btn btn-sm btn-outline-danger btn-pill"
                            style="
                              font-size: .72rem;
                              padding: .28rem .85rem;
                              min-width: 72px;
                            "
                          >
                            <%= t('merchant.services.delete') %>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>
    </div>
  </div>

  <div
    class="card border-0 mt-4"
    style="box-shadow: var(--shadow); border-radius: var(--r-xl);"
  >
    <div class="card-body p-4">
      <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
        <div>
          <h5 style="font-weight: 800; margin-bottom: .35rem;">
            <i class="bi bi-calendar-x me-2" style="color: var(--accent);"></i>
            <%= t('merchant.availability.closuresTitle') %>
          </h5>
          <p style="color: var(--muted); margin-bottom: 0;">
            <%= t('merchant.availability.closuresSubtitle') %>
          </p>
        </div>
        <a href="/merchant/bookings" class="btn btn-outline-danger btn-pill">
          <%= t('merchant.availability.declareClosure') %>
        </a>
      </div>

      <% const closureList = Array.isArray(closures) ? closures : []; %>
      <% if (closureList.length === 0) { %>
        <div class="rounded-xl bg-light p-4 text-center" style="color: var(--muted);">
          <%= t('merchant.availability.noClosures') %>
        </div>
      <% } else { %>
        <div class="d-grid gap-3">
          <% closureList.forEach((closure) => { %>
            <%
              const startsAt = new Date(closure.starts_at);
              const endsAt = new Date(closure.ends_at);
              const now = new Date();
              const isActive = startsAt <= now && endsAt > now;
              const displayOptions = {
                day: 'numeric', month: 'short', year: 'numeric',
                hour: 'numeric', minute: '2-digit'
              };
            %>
            <div class="border rounded-xl p-3 d-flex flex-wrap justify-content-between align-items-center gap-3">
              <div>
                <div style="font-weight: 700; color: var(--ink);">
                  <%= startsAt.toLocaleString('en-SG', displayOptions) %>
                  <span style="color: var(--muted);"> <%= t('admin.promotions.dateRangeTo') %> </span>
                  <%= endsAt.toLocaleString('en-SG', displayOptions) %>
                </div>
                <div class="small mt-1" style="color: var(--muted);">
                  <%= closure.reason || t('merchant.availability.defaultReason') %>
                </div>
              </div>
              <span
                class="badge"
                style="background: var(--danger-bg, #fff0f2); color: var(--danger, #ef4056); padding: .55rem .85rem;"
              >
                <%= isActive ? t('merchant.availability.activeNow') : t('merchant.availability.scheduled') %>
              </span>
            </div>
          <% }) %>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  const editButtons = document.querySelectorAll('.edit-availability-btn');

  editButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      document.querySelector('[name="day_of_week"]').value =
        btn.dataset.day;

      document.querySelector('[name="start_time"]').value =
        btn.dataset.start;

      document.querySelector('[name="end_time"]').value =
        btn.dataset.end;

      document.querySelector('[name="is_active"]').checked =
        btn.dataset.active == 1;

      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });
  });
</script>

<%- include('../partials/footer') %>
