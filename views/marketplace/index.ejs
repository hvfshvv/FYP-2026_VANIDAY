<%- include('../partials/header') %>

<!-- Page header -->
<div class="section" style="padding-top:2.5rem;padding-bottom:2rem;border-bottom:1px solid var(--border);">
  <div class="container">

    <div class="d-flex justify-content-between align-items-end flex-wrap gap-3">
      <div>
        <p class="section-label">Explore</p>

        <h1 style="
          font-size:2rem;
          font-weight:800;
          letter-spacing:-.03em;
          color:var(--ink);
          margin-bottom:.25rem;
        ">
          <%= selectedCategory ? selectedCategory + ' merchants' : 'Marketplace' %>
        </h1>

        <p style="
          color:var(--muted);
          margin-bottom:0;
          font-size:.9375rem;
        ">
          <%= selectedCategory
            ? 'Showing ' + selectedCategory.toLowerCase() + ' merchants and deals in Singapore.'
            : 'Discover top beauty & wellness merchants and exclusive deals in Singapore.' %>
        </p>
      </div>

      <div class="d-flex align-items-center gap-2 flex-wrap">
      <% if (selectedCategory) { %>
      <a href="/marketplace" class="btn btn-outline-secondary btn-sm btn-pill">
        <i class="bi bi-x-lg me-1"></i>Clear filter
      </a>
      <% } %>
      <% if (promotions.length > 0) { %>
      <span class="badge" style="
        background:var(--accent-light);
        color:var(--accent);
        font-size:.8125rem;
        padding:.45rem .9rem;
        border-radius:999px;
        font-weight:600;
      ">
        <i class="bi bi-fire me-1"></i>
        <%= promotions.length %> active deal<%= promotions.length !== 1 ? 's' : '' %>
      </span>
      <% } %>
      </div>
    </div>

  </div>
</div>

<div class="container" style="padding-top:2.5rem;padding-bottom:4rem;">

  <!-- FEATURED MERCHANTS -->
  <% if (featured.length > 0) { %>

  <div style="margin-bottom:3.5rem;">

    <div class="section-header">
      <div>
        <p class="section-label">Handpicked</p>

        <h2 class="section-title">
          Featured merchants
        </h2>

        <p class="section-sub">
          Top-rated salons and studios on Uniday.
        </p>
      </div>
    </div>

    <div class="row g-3">

      <% featured.forEach(listing => { %>

      <div class="col-lg-3 col-md-6">

        <a href="/marketplace/merchant/<%= listing.merchant_id %>"
           class="merchant-card">

          <!-- IMAGE -->
          <% if (listing.image_path) { %>

          <div class="card-img-wrapper">
            <img
              src="<%= listing.image_path %>"
              class="card-img"
              alt="<%= listing.merchant_name %>"
              loading="lazy"
            />
          </div>

          <% } else { %>

          <div class="card-no-img">
            <i class="bi bi-shop"></i>
          </div>

          <% } %>

          <!-- BODY -->
          <div class="card-body">

            <!-- TOP -->
            <div class="card-top">

              <h6 class="card-title">
                <%= listing.merchant_name %>
              </h6>

              <span class="featured-badge">
                <i class="bi bi-star-fill"></i>
                Featured
              </span>

            </div>

            <!-- DESCRIPTION -->
            <p class="card-meta">
              <%= listing.description || 'Top-rated beauty salon' %>
            </p>

            <!-- PROMOTION -->
            <% if (listing.promo_title) { %>

            <div class="discount-pill">
              <i class="bi bi-tag"></i>
              <%= listing.discount_pct %>% off
            </div>

            <% } %>

            <!-- ADDRESS -->
            <div class="info-row">
              <i class="bi bi-geo-alt"></i>

              <span>
                <%= listing.address || 'Singapore' %>
              </span>
            </div>

          </div>

        </a>

      </div>

      <% }) %>

    </div>

  </div>

  <% } %>

  <!-- ALL MERCHANTS -->
  <div style="margin-bottom:3.5rem;">

    <div class="section-header">
      <div>

        <p class="section-label">Browse</p>

        <h2 class="section-title">
          <%= selectedCategory ? selectedCategory + ' merchants' : 'All merchants' %>
        </h2>

        <p class="section-sub">
          <%= selectedCategory
            ? 'View services, prices and availability for ' + selectedCategory.toLowerCase() + ' merchants.'
            : 'View services, prices and availability across different merchants.' %>
        </p>

      </div>
    </div>

    <% if (!merchants || merchants.length === 0) { %>

    <div class="text-center py-5">

      <div class="icon-circle-lg mx-auto mb-3">
        <i class="bi bi-shop"
           style="font-size:2rem;color:var(--accent);"></i>
      </div>

      <h5 style="
        font-weight:700;
        color:var(--ink);
        margin-bottom:.25rem;
      ">
        <%= selectedCategory ? 'No ' + selectedCategory.toLowerCase() + ' merchants available' : 'No merchants available' %>
      </h5>

      <p style="color:var(--muted);">
        Please check back again soon.
      </p>

    </div>

    <% } else { %>

    <div class="row g-3">

      <% merchants.forEach(merchant => { %>

      <div class="col-lg-3 col-md-6">

        <a href="/marketplace/merchant/<%= merchant.merchant_id %>"
           class="merchant-card">

          <!-- IMAGE -->
          <% if (merchant.image_path) { %>

          <div class="card-img-wrapper">
            <img
              src="<%= merchant.image_path %>"
              class="card-img"
              alt="<%= merchant.merchant_name %>"
              loading="lazy"
            />
          </div>

          <% } else { %>

          <div class="card-no-img">
            <i class="bi bi-shop"></i>
          </div>

          <% } %>

          <!-- BODY -->
          <div class="card-body">

            <!-- TITLE -->
            <div class="card-top">

              <h6 class="card-title">
                <%= merchant.merchant_name %>
              </h6>

            </div>

            <!-- DESCRIPTION -->
            <p class="card-meta">
              <%= merchant.description || 'Beauty and wellness merchant' %>
            </p>

            <!-- CATEGORY -->
            <div class="discount-pill">
              <i class="bi bi-grid"></i>

              <%= merchant.category || 'General' %>
            </div>

            <!-- ADDRESS -->
            <div class="info-row">

              <i class="bi bi-geo-alt"></i>

              <span>
                <%= merchant.address || 'Singapore' %>
              </span>

            </div>

          </div>

        </a>

      </div>

      <% }) %>

    </div>

    <% } %>

  </div>

  <!-- PROMOTIONS -->
  <div>

    <div class="section-header">

      <div>

        <p class="section-label">
          Limited time
        </p>

        <h2 class="section-title">
          Current deals
        </h2>

        <p class="section-sub">
          Grab these promotions from our top merchants before they expire.
        </p>

      </div>

    </div>

    <% if (promotions.length === 0) { %>

    <div class="text-center py-5">

      <div class="icon-circle-lg mx-auto mb-3">
        <i class="bi bi-tag"
           style="font-size:2rem;color:var(--accent);"></i>
      </div>

      <h5 style="
        font-weight:700;
        color:var(--ink);
        margin-bottom:.25rem;
      ">
        No promotions yet
      </h5>

      <p style="color:var(--muted);">
        Check back soon for exciting deals from our merchants.
      </p>

    </div>

    <% } else { %>

    <div class="row g-3">

      <% promotions.forEach(promo => { %>

      <div class="col-md-6 col-lg-4">

        <div class="promo-card h-100">

          <div class="d-flex justify-content-between align-items-start mb-2">

            <div class="flex-grow-1 me-3">

              <p class="promo-title mb-0">
                <%= promo.title %>
              </p>

              <p class="promo-merchant mb-1">
                <i class="bi bi-shop me-1"></i>
                <%= promo.merchant_name %>
              </p>

            </div>

            <div class="promo-discount flex-shrink-0">

              <%= promo.discount_pct %>%<br>

              <span style="
                font-size:.7rem;
                font-weight:700;
              ">
                off
              </span>

            </div>

          </div>

          <p class="small text-muted mb-2">
            <%= promo.description || '' %>
          </p>

          <p class="promo-date mt-auto">

            <i class="bi bi-calendar3 me-1"></i>

            Until
            <%= promo.end_date.toISOString().slice(0,10) %>

          </p>

        </div>

      </div>

      <% }) %>

    </div>

    <% } %>

  </div>

</div>

<%- include('../partials/footer') %>
