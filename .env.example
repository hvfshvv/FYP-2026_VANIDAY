# Email
# Development default: no real emails are sent. Messages are logged to the console.
EMAIL_PROVIDER=noop
EMAIL_VERIFICATION_REQUIRED=auto
EMAIL_REMINDERS_ENABLED=true
EMAIL_REMINDER_INTERVAL_MINUTES=60

# Real email delivery: set EMAIL_PROVIDER=smtp and fill these with your own
# provider credentials, or use a shared development SMTP inbox/service.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password_or_app_password
# SMTP_FROM="Uniday <no-reply@example.com>"
# SMTP_DEBUG=false

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
